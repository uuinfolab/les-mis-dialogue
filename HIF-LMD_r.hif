  ],
  "edges": [
    {
      "edge": "M0",
      "attrs": {
        "text": "You can't sleep here.",
        "start_hhmmss": "00:03:01",
        "end_hhmmss": "00:03:03",
        "start": 181.348,
        "end": 182.82110344827584
      }
    },
    {
      "edge": "M1",
      "attrs": {
        "text": "Get away from me.",
        "start_hhmmss": "00:03:03",
        "end_hhmmss": "00:03:04",
        "start": 182.82110344827584,
        "end": 184.018
      }
    },
    {
      "edge": "M2",
      "attrs": {
        "text": "Why don't you go to an inn?",
        "start_hhmmss": "00:03:04",
        "end_hhmmss": "00:03:06",
        "start": 184.226,
        "end": 185.812
      }
    },
    {
      "edge": "M3",
      "attrs": {
        "text": "Why do you think?",
        "start_hhmmss": "00:03:06",
        "end_hhmmss": "00:03:07",
        "start": 186.02,
        "end": 187.063575
      }
    },
    {
      "edge": "M4",
      "attrs": {
        "text": "Did you knock on doors? Ask people?",
        "start_hhmmss": "00:03:07",
        "end_hhmmss": "00:03:09",
        "start": 187.063575,
        "end": 189.231
      }
    },
    {
      "edge": "M5",
      "attrs": {
        "text": "I asked. I asked everywhere. Leave me alone.",
        "start_hhmmss": "00:03:09",
        "end_hhmmss": "00:03:13",
        "start": 189.439,
        "end": 193.235
      }
    },
    {
      "edge": "M6",
      "attrs": {
        "text": "You didn't ask there.",
        "start_hhmmss": "00:03:13",
        "end_hhmmss": "00:03:15",
        "start": 193.443,
        "end": 194.779
      }
    },
    {
      "edge": "M7",
      "attrs": {
        "text": "Knock on that door.",
        "start_hhmmss": "00:03:19",
        "end_hhmmss": "00:03:21",
        "start": 199.282,
        "end": 200.785
      }
    },
    {
      "edge": "M8",
      "attrs": {
        "text": "Who can that be?",
        "start_hhmmss": "00:03:31",
        "end_hhmmss": "00:03:33",
        "start": 211.253,
        "end": 212.546
      }
    },
    {
      "edge": "M9",
      "attrs": {
        "text": "Do you have any food you can spare?",
        "start_hhmmss": "00:03:38",
        "end_hhmmss": "00:03:40",
        "start": 218.218,
        "end": 220.16281818181812
      }
    },
    {
      "edge": "M10",
      "attrs": {
        "text": "Come in.",
        "start_hhmmss": "00:03:40",
        "end_hhmmss": "00:03:41",
        "start": 220.16281818181812,
        "end": 220.595
      }
    },
    {
      "edge": "M11",
      "attrs": {
        "text": "Look, I'm a convict.",
        "start_hhmmss": "00:03:41",
        "end_hhmmss": "00:03:42",
        "start": 220.805,
        "end": 222.264
      }
    },
    {
      "edge": "M12",
      "attrs": {
        "text": "My name is Jean Valjean. I've served 19 years' hard labor.",
        "start_hhmmss": "00:03:43",
        "end_hhmmss": "00:03:47",
        "start": 222.849,
        "end": 226.643
      }
    },
    {
      "edge": "M13",
      "attrs": {
        "text": "They let me out four days ago. I'm on parole.",
        "start_hhmmss": "00:03:47",
        "end_hhmmss": "00:03:49",
        "start": 226.853,
        "end": 229.271
      }
    },
    {
      "edge": "M14",
      "attrs": {
        "text": "I have to go all the way to Dijon to report by Monday...",
        "start_hhmmss": "00:03:49",
        "end_hhmmss": "00:03:52",
        "start": 229.479,
        "end": 232.399
      }
    },
    {
      "edge": "M15",
      "attrs": {
        "text": "...or they send me back to prison. My passport.",
        "start_hhmmss": "00:03:53",
        "end_hhmmss": "00:03:55",
        "start": 232.607,
        "end": 235.069
      }
    },
    {
      "edge": "M16",
      "attrs": {
        "text": "I can't read, but it says I'm dangerous.",
        "start_hhmmss": "00:03:55",
        "end_hhmmss": "00:03:58",
        "start": 235.277,
        "end": 237.822
      }
    },
    {
      "edge": "M17",
      "attrs": {
        "text": "You're welcome to eat with us as my guest.",
        "start_hhmmss": "00:03:58",
        "end_hhmmss": "00:04:00",
        "start": 238.03,
        "end": 240.449
      }
    },
    {
      "edge": "M18",
      "attrs": {
        "text": "I'm a convict. You saw my passport.",
        "start_hhmmss": "00:04:01",
        "end_hhmmss": "00:04:04",
        "start": 240.657,
        "end": 244.453
      }
    },
    {
      "edge": "M19",
      "attrs": {
        "text": "I know who you are.",
        "start_hhmmss": "00:04:05",
        "end_hhmmss": "00:04:07",
        "start": 244.661,
        "end": 247.081
      }
    },
    {
      "edge": "M20",
      "attrs": {
        "text": "You're gonna let me inside your house?",
        "start_hhmmss": "00:04:09",
        "end_hhmmss": "00:04:12",
        "start": 248.623,
        "end": 252.003
      }
    },
    {
      "edge": "M21",
      "attrs": {
        "text": "What crime did you commit?",
        "start_hhmmss": "00:04:22",
        "end_hhmmss": "00:04:24",
        "start": 261.929,
        "end": 263.722
      }
    },
    {
      "edge": "M22",
      "attrs": {
        "text": "Maybe I killed someone.",
        "start_hhmmss": "00:04:27",
        "end_hhmmss": "00:04:29",
        "start": 267.143,
        "end": 268.685
      }
    },
    {
      "edge": "M23",
      "attrs": {
        "text": "How do you know I'm not going to murder you?",
        "start_hhmmss": "00:04:35",
        "end_hhmmss": "00:04:38",
        "start": 275.067,
        "end": 278.196
      }
    },
    {
      "edge": "M24",
      "attrs": {
        "text": "How do you know I'm not going to murder you?",
        "start_hhmmss": "00:04:38",
        "end_hhmmss": "00:04:41",
        "start": 278.403,
        "end": 281.157
      }
    },
    {
      "edge": "M25",
      "attrs": {
        "text": "What's that? A joke?",
        "start_hhmmss": "00:04:41",
        "end_hhmmss": "00:04:44",
        "start": 281.364,
        "end": 283.533
      }
    },
    {
      "edge": "M26",
      "attrs": {
        "text": "I suppose we'll have to trust each other.",
        "start_hhmmss": "00:04:44",
        "end_hhmmss": "00:04:48",
        "start": 284.451,
        "end": 287.872
      }
    },
    {
      "edge": "M27",
      "attrs": {
        "text": "I didn't kill anyone. I'm a thief.",
        "start_hhmmss": "00:04:50",
        "end_hhmmss": "00:04:54",
        "start": 289.623,
        "end": 293.92
      }
    },
    {
      "edge": "M28",
      "attrs": {
        "text": "I stole food. I stole, but I paid for it.",
        "start_hhmmss": "00:04:54",
        "end_hhmmss": "00:04:57",
        "start": 294.128,
        "end": 297.048
      }
    },
    {
      "edge": "M29",
      "attrs": {
        "text": "Nineteen years in chains.",
        "start_hhmmss": "00:04:57",
        "end_hhmmss": "00:05:00",
        "start": 297.256,
        "end": 299.758
      }
    },
    {
      "edge": "M30",
      "attrs": {
        "text": "So they let me out and give me a yellow passport.",
        "start_hhmmss": "00:05:00",
        "end_hhmmss": "00:05:03",
        "start": 299.967,
        "end": 302.511
      }
    },
    {
      "edge": "M31",
      "attrs": {
        "text": "What can I do with a yellow passport?",
        "start_hhmmss": "00:05:03",
        "end_hhmmss": "00:05:05",
        "start": 302.719,
        "end": 304.931
      }
    },
    {
      "edge": "M32",
      "attrs": {
        "text": "I have to go to my parole officer in Dijon and then what? Starve to death?",
        "start_hhmmss": "00:05:05",
        "end_hhmmss": "00:05:10",
        "start": 305.139,
        "end": 309.601
      }
    },
    {
      "edge": "M33",
      "attrs": {
        "text": "Nineteen years, and now the real punishment begins!",
        "start_hhmmss": "00:05:12",
        "end_hhmmss": "00:05:15",
        "start": 311.854,
        "end": 314.648
      }
    },
    {
      "edge": "M34",
      "attrs": {
        "text": "Man can be unjust.",
        "start_hhmmss": "00:05:16",
        "end_hhmmss": "00:05:17",
        "start": 315.607,
        "end": 317.193
      }
    },
    {
      "edge": "M35",
      "attrs": {
        "text": "Man? Not God?",
        "start_hhmmss": "00:05:17",
        "end_hhmmss": "00:05:20",
        "start": 317.4,
        "end": 319.611
      }
    },
    {
      "edge": "M36",
      "attrs": {
        "text": "All right, whoever you are. Thank you.",
        "start_hhmmss": "00:05:22",
        "end_hhmmss": "00:05:25",
        "start": 322.198,
        "end": 324.826
      }
    },
    {
      "edge": "M37",
      "attrs": {
        "text": "A meal and a bed to sleep in. A real bed.",
        "start_hhmmss": "00:05:26",
        "end_hhmmss": "00:05:31",
        "start": 326.202,
        "end": 331.165
      }
    },
    {
      "edge": "M38",
      "attrs": {
        "text": "And in the morning, I'll be a new man.",
        "start_hhmmss": "00:05:31",
        "end_hhmmss": "00:05:34",
        "start": 331.373,
        "end": 333.625
      }
    },
    {
      "edge": "M39",
      "attrs": {
        "text": "Is anybody there?",
        "start_hhmmss": "00:07:02",
        "end_hhmmss": "00:07:03",
        "start": 421.63,
        "end": 423.382
      }
    },
    {
      "edge": "M40",
      "attrs": {
        "text": "So we'll use wooden spoons. I don't want to hear anything more about it.",
        "start_hhmmss": "00:07:40",
        "end_hhmmss": "00:07:45",
        "start": 459.834,
        "end": 464.547
      }
    },
    {
      "edge": "M41",
      "attrs": {
        "text": "I'm sorry to disturb you.",
        "start_hhmmss": "00:07:48",
        "end_hhmmss": "00:07:49",
        "start": 467.801,
        "end": 469.3093548387097
      }
    },
    {
      "edge": "M42",
      "attrs": {
        "text": "You caught him.",
        "start_hhmmss": "00:07:49",
        "end_hhmmss": "00:07:50",
        "start": 469.3093548387097,
        "end": 470.262
      }
    },
    {
      "edge": "M43",
      "attrs": {
        "text": "But I had my eye on this man.",
        "start_hhmmss": "00:07:50",
        "end_hhmmss": "00:07:52",
        "start": 470.47,
        "end": 472.264
      }
    },
    {
      "edge": "M44",
      "attrs": {
        "text": "Oh, thank God.",
        "start_hhmmss": "00:07:52",
        "end_hhmmss": "00:07:54",
        "start": 472.472,
        "end": 473.530717948718
      }
    },
    {
      "edge": "M45",
      "attrs": {
        "text": "I'm very angry with you, Jean Valjean.",
        "start_hhmmss": "00:07:54",
        "end_hhmmss": "00:07:57",
        "start": 473.530717948718,
        "end": 476.601
      }
    },
    {
      "edge": "M46",
      "attrs": {
        "text": "What happened to your eye?",
        "start_hhmmss": "00:07:57",
        "end_hhmmss": "00:07:58",
        "start": 476.81,
        "end": 478.415625
      }
    },
    {
      "edge": "M47",
      "attrs": {
        "text": "Didn't he tell you he was our guest?",
        "start_hhmmss": "00:07:58",
        "end_hhmmss": "00:08:00",
        "start": 478.415625,
        "end": 480.48
      }
    },
    {
      "edge": "M48",
      "attrs": {
        "text": "Oh, yes. After we searched his knapsack and found all this silver.",
        "start_hhmmss": "00:08:01",
        "end_hhmmss": "00:08:06",
        "start": 480.689,
        "end": 486.32
      }
    },
    {
      "edge": "M49",
      "attrs": {
        "text": "He claimed that you gave it to him.",
        "start_hhmmss": "00:08:07",
        "end_hhmmss": "00:08:11",
        "start": 487.029,
        "end": 490.657
      }
    },
    {
      "edge": "M50",
      "attrs": {
        "text": "Yes, of course I gave him the silverware.",
        "start_hhmmss": "00:08:11",
        "end_hhmmss": "00:08:14",
        "start": 491.158,
        "end": 494.37
      }
    },
    {
      "edge": "M51",
      "attrs": {
        "text": "But why didn't you take the candlesticks? That was very foolish.",
        "start_hhmmss": "00:08:15",
        "end_hhmmss": "00:08:18",
        "start": 494.577,
        "end": 497.914
      }
    },
    {
      "edge": "M52",
      "attrs": {
        "text": "Madame Gilot, fetch the silver candlesticks.",
        "start_hhmmss": "00:08:18",
        "end_hhmmss": "00:08:21",
        "start": 498.124,
        "end": 501.168
      }
    },
    {
      "edge": "M53",
      "attrs": {
        "text": "They're worth at least 2,000 francs. Why did you leave them?",
        "start_hhmmss": "00:08:21",
        "end_hhmmss": "00:08:25",
        "start": 501.377,
        "end": 504.913
      }
    },
    {
      "edge": "M54",
      "attrs": {
        "text": "Hurry!",
        "start_hhmmss": "00:08:25",
        "end_hhmmss": "00:08:25",
        "start": 504.913,
        "end": 505.297
      }
    },
    {
      "edge": "M55",
      "attrs": {
        "text": "Monsieur Valjean has to get going. He's lost a lot of time.",
        "start_hhmmss": "00:08:26",
        "end_hhmmss": "00:08:31",
        "start": 505.505,
        "end": 511.178
      }
    },
    {
      "edge": "M56",
      "attrs": {
        "text": "Did you forget to take them?",
        "start_hhmmss": "00:08:32",
        "end_hhmmss": "00:08:34",
        "start": 511.886,
        "end": 513.66624
      }
    },
    {
      "edge": "M57",
      "attrs": {
        "text": "Are you saying he told us the truth?",
        "start_hhmmss": "00:08:34",
        "end_hhmmss": "00:08:36",
        "start": 513.66624,
        "end": 515.932
      }
    },
    {
      "edge": "M58",
      "attrs": {
        "text": "Of course. Thank you for bringing him back. I've very relieved.",
        "start_hhmmss": "00:08:36",
        "end_hhmmss": "00:08:40",
        "start": 516.142,
        "end": 519.686
      }
    },
    {
      "edge": "M59",
      "attrs": {
        "text": "Release him!",
        "start_hhmmss": "00:08:40",
        "end_hhmmss": "00:08:42",
        "start": 520.104,
        "end": 521.521
      }
    },
    {
      "edge": "M60",
      "attrs": {
        "text": "You're really letting me go?",
        "start_hhmmss": "00:08:44",
        "end_hhmmss": "00:08:46",
        "start": 524.066,
        "end": 525.5642448979592
      }
    },
    {
      "edge": "M61",
      "attrs": {
        "text": "Didn't you understand the Bishop?",
        "start_hhmmss": "00:08:46",
        "end_hhmmss": "00:08:47",
        "start": 525.5642448979592,
        "end": 527.403
      }
    },
    {
      "edge": "M62",
      "attrs": {
        "text": "Madame Gilot, offer these men some wine.",
        "start_hhmmss": "00:08:49",
        "end_hhmmss": "00:08:52",
        "start": 528.57,
        "end": 532.283
      }
    },
    {
      "edge": "M63",
      "attrs": {
        "text": "They must be thirsty.",
        "start_hhmmss": "00:08:52",
        "end_hhmmss": "00:08:55",
        "start": 532.491,
        "end": 534.84448
      }
    },
    {
      "edge": "M64",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "00:08:55",
        "end_hhmmss": "00:08:56",
        "start": 534.84448,
        "end": 535.952
      }
    },
    {
      "edge": "M65",
      "attrs": {
        "text": "And don't forget, don't ever forget...",
        "start_hhmmss": "00:09:08",
        "end_hhmmss": "00:09:13",
        "start": 548.132,
        "end": 552.594
      }
    },
    {
      "edge": "M66",
      "attrs": {
        "text": "...you've promised to become a new man.",
        "start_hhmmss": "00:09:13",
        "end_hhmmss": "00:09:15",
        "start": 552.802,
        "end": 555.347
      }
    },
    {
      "edge": "M67",
      "attrs": {
        "text": "I promise. Why are you doing this?",
        "start_hhmmss": "00:09:16",
        "end_hhmmss": "00:09:20",
        "start": 556.223,
        "end": 560.227
      }
    },
    {
      "edge": "M68",
      "attrs": {
        "text": "Jean Valjean, my brother, you no longer belong to evil.",
        "start_hhmmss": "00:09:20",
        "end_hhmmss": "00:09:24",
        "start": 560.436,
        "end": 564.19
      }
    },
    {
      "edge": "M69",
      "attrs": {
        "text": "With this silver, I bought your soul.",
        "start_hhmmss": "00:09:26",
        "end_hhmmss": "00:09:30",
        "start": 565.524,
        "end": 569.611
      }
    },
    {
      "edge": "M70",
      "attrs": {
        "text": "I've ransomed you from fear and hatred.",
        "start_hhmmss": "00:09:30",
        "end_hhmmss": "00:09:33",
        "start": 569.819,
        "end": 573.199
      }
    },
    {
      "edge": "M71",
      "attrs": {
        "text": "And now I give you back to God.",
        "start_hhmmss": "00:09:34",
        "end_hhmmss": "00:09:37",
        "start": 574.2,
        "end": 576.618
      }
    },
    {
      "edge": "M72",
      "attrs": {
        "text": "Good afternoon, captain. I'm Javert, the new police inspector.",
        "start_hhmmss": "00:10:29",
        "end_hhmmss": "00:10:33",
        "start": 629.003,
        "end": 632.674
      }
    },
    {
      "edge": "M73",
      "attrs": {
        "text": "Here are my orders from the Paris prefect.",
        "start_hhmmss": "00:10:33",
        "end_hhmmss": "00:10:35",
        "start": 632.882,
        "end": 635.051
      }
    },
    {
      "edge": "M74",
      "attrs": {
        "text": "Oh, yes. Hello, Inspector Javert. I've been expecting you.",
        "start_hhmmss": "00:10:35",
        "end_hhmmss": "00:10:39",
        "start": 635.261,
        "end": 639.39
      }
    },
    {
      "edge": "M75",
      "attrs": {
        "text": "I'm Captain Beauvais.",
        "start_hhmmss": "00:10:40",
        "end_hhmmss": "00:10:41",
        "start": 639.598,
        "end": 640.932
      }
    },
    {
      "edge": "M76",
      "attrs": {
        "text": "How was your journey?",
        "start_hhmmss": "00:10:41",
        "end_hhmmss": "00:10:43",
        "start": 641.142,
        "end": 642.5092857142857
      }
    },
    {
      "edge": "M77",
      "attrs": {
        "text": "You haven't looked at my orders.",
        "start_hhmmss": "00:10:43",
        "end_hhmmss": "00:10:45",
        "start": 642.5092857142857,
        "end": 644.52
      }
    },
    {
      "edge": "M78",
      "attrs": {
        "text": "Oh, I'm sure they're all right. Have you eaten, or would you--?",
        "start_hhmmss": "00:10:45",
        "end_hhmmss": "00:10:48",
        "start": 644.727,
        "end": 648.19
      }
    },
    {
      "edge": "M79",
      "attrs": {
        "text": "I'd like you to follow procedure.",
        "start_hhmmss": "00:10:48",
        "end_hhmmss": "00:10:51",
        "start": 648.399,
        "end": 651.067
      }
    },
    {
      "edge": "M80",
      "attrs": {
        "text": "Well...",
        "start_hhmmss": "00:10:58",
        "end_hhmmss": "00:10:59",
        "start": 657.991,
        "end": 659.243
      }
    },
    {
      "edge": "M81",
      "attrs": {
        "text": "...everything seems to be in order, inspector.",
        "start_hhmmss": "00:10:59",
        "end_hhmmss": "00:11:03",
        "start": 659.451,
        "end": 663.247
      }
    },
    {
      "edge": "M82",
      "attrs": {
        "text": "You are now in charge of the Vigau police.",
        "start_hhmmss": "00:11:03",
        "end_hhmmss": "00:11:06",
        "start": 663.455,
        "end": 666.167
      }
    },
    {
      "edge": "M83",
      "attrs": {
        "text": "In Paris, things are miserable.",
        "start_hhmmss": "00:11:06",
        "end_hhmmss": "00:11:08",
        "start": 666.375,
        "end": 668.377
      }
    },
    {
      "edge": "M84",
      "attrs": {
        "text": "Crime is rampant, the streets are filthy.",
        "start_hhmmss": "00:11:09",
        "end_hhmmss": "00:11:13",
        "start": 668.586,
        "end": 673.131
      }
    },
    {
      "edge": "M85",
      "attrs": {
        "text": "Conditions here are much better.",
        "start_hhmmss": "00:11:13",
        "end_hhmmss": "00:11:16",
        "start": 673.34,
        "end": 675.5718392857143
      }
    },
    {
      "edge": "M86",
      "attrs": {
        "text": "Life in Vigau has never been better.",
        "start_hhmmss": "00:11:16",
        "end_hhmmss": "00:11:18",
        "start": 675.5718392857143,
        "end": 677.969
      }
    },
    {
      "edge": "M87",
      "attrs": {
        "text": "Shall I take you to our tile-and-brick factory? Our biggest business.",
        "start_hhmmss": "00:11:18",
        "end_hhmmss": "00:11:22",
        "start": 678.179,
        "end": 681.806
      }
    },
    {
      "edge": "M88",
      "attrs": {
        "text": "Very well.",
        "start_hhmmss": "00:11:22",
        "end_hhmmss": "00:11:23",
        "start": 682.015,
        "end": 683.3056666666666
      }
    },
    {
      "edge": "M89",
      "attrs": {
        "text": "This way.",
        "start_hhmmss": "00:11:23",
        "end_hhmmss": "00:11:24",
        "start": 683.3056666666666,
        "end": 684.435
      }
    },
    {
      "edge": "M90",
      "attrs": {
        "text": "Who owns the factory?",
        "start_hhmmss": "00:11:26",
        "end_hhmmss": "00:11:28",
        "start": 686.187,
        "end": 687.91624
      }
    },
    {
      "edge": "M91",
      "attrs": {
        "text": "The mayor.",
        "start_hhmmss": "00:11:28",
        "end_hhmmss": "00:11:29",
        "start": 687.91624,
        "end": 688.73
      }
    },
    {
      "edge": "M92",
      "attrs": {
        "text": "He was just one of the workers. But when it went bankrupt five years ago...",
        "start_hhmmss": "00:11:29",
        "end_hhmmss": "00:11:33",
        "start": 688.938,
        "end": 692.984
      }
    },
    {
      "edge": "M93",
      "attrs": {
        "text": "...incredible to think of now, he bought the works for less than 500 francs.",
        "start_hhmmss": "00:11:33",
        "end_hhmmss": "00:11:38",
        "start": 693.194,
        "end": 697.78
      }
    },
    {
      "edge": "M94",
      "attrs": {
        "text": "On second thought, captain, I should report to the mayor first.",
        "start_hhmmss": "00:11:38",
        "end_hhmmss": "00:11:42",
        "start": 697.989,
        "end": 701.784
      }
    },
    {
      "edge": "M95",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:11:42",
        "end_hhmmss": "00:11:42",
        "start": 701.993,
        "end": 702.2208928571429
      }
    },
    {
      "edge": "M96",
      "attrs": {
        "text": "The mayor seems to be the force...",
        "start_hhmmss": "00:11:42",
        "end_hhmmss": "00:11:44",
        "start": 702.2208928571429,
        "end": 704.12
      }
    },
    {
      "edge": "M97",
      "attrs": {
        "text": "...behind everything. Must be a man of genius.",
        "start_hhmmss": "00:11:44",
        "end_hhmmss": "00:11:47",
        "start": 704.33,
        "end": 707.081
      }
    },
    {
      "edge": "M98",
      "attrs": {
        "text": "He is extraordinary. But I should warn you, he's also a little eccentric.",
        "start_hhmmss": "00:11:47",
        "end_hhmmss": "00:11:52",
        "start": 707.291,
        "end": 711.587
      }
    },
    {
      "edge": "M99",
      "attrs": {
        "text": "Eccentric? In what way?",
        "start_hhmmss": "00:11:52",
        "end_hhmmss": "00:11:53",
        "start": 711.794,
        "end": 713.4152272727273
      }
    },
    {
      "edge": "M100",
      "attrs": {
        "text": "Well, he's shy. Lives like a hermit.",
        "start_hhmmss": "00:11:53",
        "end_hhmmss": "00:11:56",
        "start": 713.4152272727273,
        "end": 715.757
      }
    },
    {
      "edge": "M101",
      "attrs": {
        "text": "Didn't even want to be mayor. Tried to refuse.",
        "start_hhmmss": "00:11:56",
        "end_hhmmss": "00:11:59",
        "start": 715.965,
        "end": 718.718
      }
    },
    {
      "edge": "M102",
      "attrs": {
        "text": "But the town fathers insisted.",
        "start_hhmmss": "00:11:59",
        "end_hhmmss": "00:12:01",
        "start": 718.927,
        "end": 720.929
      }
    },
    {
      "edge": "M103",
      "attrs": {
        "text": "Not ambitious, yet this successful?",
        "start_hhmmss": "00:12:01",
        "end_hhmmss": "00:12:04",
        "start": 721.137,
        "end": 724.00945
      }
    },
    {
      "edge": "M104",
      "attrs": {
        "text": "He's a mystery.",
        "start_hhmmss": "00:12:04",
        "end_hhmmss": "00:12:05",
        "start": 724.00945,
        "end": 725.099
      }
    },
    {
      "edge": "M105",
      "attrs": {
        "text": "Some people think he's crazy, but I like him.",
        "start_hhmmss": "00:12:05",
        "end_hhmmss": "00:12:08",
        "start": 725.309,
        "end": 727.852
      }
    },
    {
      "edge": "M106",
      "attrs": {
        "text": "I like him and I feel sorry for him.",
        "start_hhmmss": "00:12:08",
        "end_hhmmss": "00:12:11",
        "start": 728.061,
        "end": 730.51638
      }
    },
    {
      "edge": "M107",
      "attrs": {
        "text": "You feel sorry for the mayor?",
        "start_hhmmss": "00:12:11",
        "end_hhmmss": "00:12:13",
        "start": 730.51638,
        "end": 732.608
      }
    },
    {
      "edge": "M108",
      "attrs": {
        "text": "Because he's lonely. Here we are.",
        "start_hhmmss": "00:12:13",
        "end_hhmmss": "00:12:17",
        "start": 732.815,
        "end": 736.819
      }
    },
    {
      "edge": "M109",
      "attrs": {
        "text": "He lives here?",
        "start_hhmmss": "00:12:18",
        "end_hhmmss": "00:12:19",
        "start": 738.489,
        "end": 739.483125
      }
    },
    {
      "edge": "M110",
      "attrs": {
        "text": "Strange, isn't it?",
        "start_hhmmss": "00:12:19",
        "end_hhmmss": "00:12:21",
        "start": 739.483125,
        "end": 740.658
      }
    },
    {
      "edge": "M111",
      "attrs": {
        "text": "Little better than a worker's house.",
        "start_hhmmss": "00:12:21",
        "end_hhmmss": "00:12:23",
        "start": 740.865,
        "end": 742.951
      }
    },
    {
      "edge": "M112",
      "attrs": {
        "text": "Good afternoon, mayor. The new inspector has arrived.",
        "start_hhmmss": "00:12:27",
        "end_hhmmss": "00:12:30",
        "start": 746.829,
        "end": 749.625
      }
    },
    {
      "edge": "M113",
      "attrs": {
        "text": "He wants to report.",
        "start_hhmmss": "00:12:30",
        "end_hhmmss": "00:12:31",
        "start": 749.832,
        "end": 751.418
      }
    },
    {
      "edge": "M114",
      "attrs": {
        "text": "That's all right. He doesn't have to.",
        "start_hhmmss": "00:12:32",
        "end_hhmmss": "00:12:34",
        "start": 751.627,
        "end": 753.712
      }
    },
    {
      "edge": "M115",
      "attrs": {
        "text": "Monsieur le maire, if you don't permit the inspector to report...",
        "start_hhmmss": "00:12:34",
        "end_hhmmss": "00:12:38",
        "start": 753.92,
        "end": 757.508
      }
    },
    {
      "edge": "M116",
      "attrs": {
        "text": "...I think he will burst into tears.",
        "start_hhmmss": "00:12:38",
        "end_hhmmss": "00:12:41",
        "start": 757.716,
        "end": 760.927
      }
    },
    {
      "edge": "M117",
      "attrs": {
        "text": "Monsieur le maire, I'm Inspector Javert.",
        "start_hhmmss": "00:12:46",
        "end_hhmmss": "00:12:49",
        "start": 766.057,
        "end": 768.935
      }
    },
    {
      "edge": "M118",
      "attrs": {
        "text": "I have the honor of reporting to my post as your prefect of police.",
        "start_hhmmss": "00:12:49",
        "end_hhmmss": "00:12:54",
        "start": 769.143,
        "end": 773.649
      }
    },
    {
      "edge": "M119",
      "attrs": {
        "text": "I'm sorry. What's your name?",
        "start_hhmmss": "00:13:00",
        "end_hhmmss": "00:13:02",
        "start": 779.946,
        "end": 781.74
      }
    },
    {
      "edge": "M120",
      "attrs": {
        "text": "Inspector Javert. You were expecting me.",
        "start_hhmmss": "00:13:02",
        "end_hhmmss": "00:13:05",
        "start": 781.948,
        "end": 784.66
      }
    },
    {
      "edge": "M121",
      "attrs": {
        "text": "Paris should have--",
        "start_hhmmss": "00:13:05",
        "end_hhmmss": "00:13:06",
        "start": 784.867,
        "end": 785.9175357142857
      }
    },
    {
      "edge": "M122",
      "attrs": {
        "text": "You have papers?",
        "start_hhmmss": "00:13:06",
        "end_hhmmss": "00:13:07",
        "start": 785.9175357142857,
        "end": 786.828
      }
    },
    {
      "edge": "M123",
      "attrs": {
        "text": "Yes. I apologize. I should have presented them immediately.",
        "start_hhmmss": "00:13:07",
        "end_hhmmss": "00:13:10",
        "start": 787.036,
        "end": 790.123
      }
    },
    {
      "edge": "M124",
      "attrs": {
        "text": "Good. Thank you for coming.",
        "start_hhmmss": "00:13:10",
        "end_hhmmss": "00:13:13",
        "start": 790.332,
        "end": 792.834
      }
    },
    {
      "edge": "M125",
      "attrs": {
        "text": "Captain, make sure the inspector's settled comfortably.",
        "start_hhmmss": "00:13:14",
        "end_hhmmss": "00:13:17",
        "start": 793.793,
        "end": 796.63
      }
    },
    {
      "edge": "M126",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:13:17",
        "end_hhmmss": "00:13:17",
        "start": 796.838,
        "end": 797.2427
      }
    },
    {
      "edge": "M127",
      "attrs": {
        "text": "Good day.",
        "start_hhmmss": "00:13:17",
        "end_hhmmss": "00:13:18",
        "start": 797.2427,
        "end": 798.1874117647059
      }
    },
    {
      "edge": "M128",
      "attrs": {
        "text": "Good day.",
        "start_hhmmss": "00:13:18",
        "end_hhmmss": "00:13:19",
        "start": 798.1874117647059,
        "end": 799.132
      }
    },
    {
      "edge": "M129",
      "attrs": {
        "text": "The men and women work separately?",
        "start_hhmmss": "00:13:20",
        "end_hhmmss": "00:13:22",
        "start": 800.258,
        "end": 802.4158260869565
      }
    },
    {
      "edge": "M130",
      "attrs": {
        "text": "Yes. Monsieur le maire...",
        "start_hhmmss": "00:13:22",
        "end_hhmmss": "00:13:24",
        "start": 802.4158260869565,
        "end": 803.803
      }
    },
    {
      "edge": "M131",
      "attrs": {
        "text": "...redesigned the factory in order to keep the sexes apart.",
        "start_hhmmss": "00:13:24",
        "end_hhmmss": "00:13:28",
        "start": 804.012,
        "end": 807.766
      }
    },
    {
      "edge": "M132",
      "attrs": {
        "text": "I told you he's eccentric.",
        "start_hhmmss": "00:13:28",
        "end_hhmmss": "00:13:30",
        "start": 807.974,
        "end": 809.8257073170732
      }
    },
    {
      "edge": "M133",
      "attrs": {
        "text": "Not eccentric, captain, no.",
        "start_hhmmss": "00:13:30",
        "end_hhmmss": "00:13:32",
        "start": 809.8257073170732,
        "end": 811.77
      }
    },
    {
      "edge": "M134",
      "attrs": {
        "text": "He cares about honest working women and wants to protect their virtue.",
        "start_hhmmss": "00:13:32",
        "end_hhmmss": "00:13:36",
        "start": 812.186,
        "end": 816.274
      }
    },
    {
      "edge": "M135",
      "attrs": {
        "text": "Very proper, very wise.",
        "start_hhmmss": "00:13:36",
        "end_hhmmss": "00:13:40",
        "start": 816.483,
        "end": 820.069
      }
    },
    {
      "edge": "M136",
      "attrs": {
        "text": "I'm sorry.",
        "start_hhmmss": "00:13:42",
        "end_hhmmss": "00:13:43",
        "start": 822.071,
        "end": 822.7846111111111
      }
    },
    {
      "edge": "M137",
      "attrs": {
        "text": "Excuse me, sir.",
        "start_hhmmss": "00:13:43",
        "end_hhmmss": "00:13:44",
        "start": 822.7846111111111,
        "end": 823.906
      }
    },
    {
      "edge": "M138",
      "attrs": {
        "text": "I didn't mean to.",
        "start_hhmmss": "00:13:44",
        "end_hhmmss": "00:13:45",
        "start": 824.115,
        "end": 824.973
      }
    },
    {
      "edge": "M139",
      "attrs": {
        "text": "You ruined another!",
        "start_hhmmss": "00:13:45",
        "end_hhmmss": "00:13:46",
        "start": 824.973,
        "end": 826.117
      }
    },
    {
      "edge": "M140",
      "attrs": {
        "text": "They'll dock my wages--",
        "start_hhmmss": "00:13:46",
        "end_hhmmss": "00:13:48",
        "start": 826.327,
        "end": 827.5844516129032
      }
    },
    {
      "edge": "M141",
      "attrs": {
        "text": "All right. Enough!",
        "start_hhmmss": "00:13:48",
        "end_hhmmss": "00:13:49",
        "start": 827.5844516129032,
        "end": 828.62
      }
    },
    {
      "edge": "M142",
      "attrs": {
        "text": "Get your things. I'm going to move you.",
        "start_hhmmss": "00:13:49",
        "end_hhmmss": "00:13:51",
        "start": 828.828,
        "end": 830.913
      }
    },
    {
      "edge": "M143",
      "attrs": {
        "text": "It was an unforgettable--",
        "start_hhmmss": "00:13:51",
        "end_hhmmss": "00:13:53",
        "start": 831.122,
        "end": 832.582625
      }
    },
    {
      "edge": "M144",
      "attrs": {
        "text": "Good riddance!",
        "start_hhmmss": "00:13:53",
        "end_hhmmss": "00:13:53",
        "start": 832.582625,
        "end": 833.4590000000001
      }
    },
    {
      "edge": "M145",
      "attrs": {
        "text": "But I'll forget it anyway!",
        "start_hhmmss": "00:13:54",
        "end_hhmmss": "00:13:56",
        "start": 833.667,
        "end": 836.0070000000001
      }
    },
    {
      "edge": "M146",
      "attrs": {
        "text": "Let's go!",
        "start_hhmmss": "00:13:56",
        "end_hhmmss": "00:13:57",
        "start": 836.0070000000001,
        "end": 836.709
      }
    },
    {
      "edge": "M147",
      "attrs": {
        "text": "Back to work!",
        "start_hhmmss": "00:13:57",
        "end_hhmmss": "00:13:58",
        "start": 836.709,
        "end": 837.879
      }
    },
    {
      "edge": "M148",
      "attrs": {
        "text": "Come on. Fun's over.",
        "start_hhmmss": "00:13:58",
        "end_hhmmss": "00:14:01",
        "start": 838.087,
        "end": 840.716
      }
    },
    {
      "edge": "M149",
      "attrs": {
        "text": "Come on. Back to work.",
        "start_hhmmss": "00:14:01",
        "end_hhmmss": "00:14:03",
        "start": 840.923,
        "end": 842.509
      }
    },
    {
      "edge": "M150",
      "attrs": {
        "text": "I'd feel safer if you had an escort.",
        "start_hhmmss": "00:14:55",
        "end_hhmmss": "00:14:57",
        "start": 894.812,
        "end": 897.021
      }
    },
    {
      "edge": "M151",
      "attrs": {
        "text": "Don't worry, I can look after myself.",
        "start_hhmmss": "00:14:57",
        "end_hhmmss": "00:15:00",
        "start": 897.23,
        "end": 899.941
      }
    },
    {
      "edge": "M152",
      "attrs": {
        "text": "I haven't much time. I must leave right away.",
        "start_hhmmss": "00:15:00",
        "end_hhmmss": "00:15:02",
        "start": 900.149,
        "end": 902.486
      }
    },
    {
      "edge": "M153",
      "attrs": {
        "text": "I hope this urgency does not imply distress.",
        "start_hhmmss": "00:15:03",
        "end_hhmmss": "00:15:06",
        "start": 902.694,
        "end": 905.781
      }
    },
    {
      "edge": "M154",
      "attrs": {
        "text": "May I ask why you are withdrawing your entire fortune?",
        "start_hhmmss": "00:15:06",
        "end_hhmmss": "00:15:09",
        "start": 905.988,
        "end": 909.2
      }
    },
    {
      "edge": "M155",
      "attrs": {
        "text": "I trust you are aware this institution is at your service.",
        "start_hhmmss": "00:15:09",
        "end_hhmmss": "00:15:12",
        "start": 909.41,
        "end": 912.413
      }
    },
    {
      "edge": "M156",
      "attrs": {
        "text": "Thank you. But this is a business opportunity, no crisis.",
        "start_hhmmss": "00:15:13",
        "end_hhmmss": "00:15:17",
        "start": 912.621,
        "end": 917.418
      }
    },
    {
      "edge": "M157",
      "attrs": {
        "text": "I'll be back tomorrow.",
        "start_hhmmss": "00:15:19",
        "end_hhmmss": "00:15:20",
        "start": 918.627,
        "end": 919.8036170212764
      }
    },
    {
      "edge": "M158",
      "attrs": {
        "text": "I received disturbing information...",
        "start_hhmmss": "00:15:20",
        "end_hhmmss": "00:15:22",
        "start": 919.8036170212764,
        "end": 921.88
      }
    },
    {
      "edge": "M159",
      "attrs": {
        "text": "...about one of the girls. I have reason to believe...",
        "start_hhmmss": "00:15:22",
        "end_hhmmss": "00:15:26",
        "start": 922.088,
        "end": 925.843
      }
    },
    {
      "edge": "M160",
      "attrs": {
        "text": "...she has a child and is not married.",
        "start_hhmmss": "00:15:26",
        "end_hhmmss": "00:15:28",
        "start": 926.05,
        "end": 928.01
      }
    },
    {
      "edge": "M161",
      "attrs": {
        "text": "What? Is she a whore?",
        "start_hhmmss": "00:15:28",
        "end_hhmmss": "00:15:30",
        "start": 928.219,
        "end": 929.809625
      }
    },
    {
      "edge": "M162",
      "attrs": {
        "text": "I don't hire--",
        "start_hhmmss": "00:15:30",
        "end_hhmmss": "00:15:31",
        "start": 929.809625,
        "end": 930.764
      }
    },
    {
      "edge": "M163",
      "attrs": {
        "text": "I don't hire women who sell themselves.",
        "start_hhmmss": "00:15:31",
        "end_hhmmss": "00:15:33",
        "start": 930.972,
        "end": 933.015
      }
    },
    {
      "edge": "M164",
      "attrs": {
        "text": "Of course you don't, I apologize.",
        "start_hhmmss": "00:15:33",
        "end_hhmmss": "00:15:35",
        "start": 933.224,
        "end": 935.436
      }
    },
    {
      "edge": "M165",
      "attrs": {
        "text": "It's just I don't want our ladies to be exposed to corruption.",
        "start_hhmmss": "00:15:36",
        "end_hhmmss": "00:15:39",
        "start": 935.644,
        "end": 938.897
      }
    },
    {
      "edge": "M166",
      "attrs": {
        "text": "I suggest dismissal.",
        "start_hhmmss": "00:15:39",
        "end_hhmmss": "00:15:41",
        "start": 939.105,
        "end": 940.8069428571428
      }
    },
    {
      "edge": "M167",
      "attrs": {
        "text": "I trust your judgment.",
        "start_hhmmss": "00:15:41",
        "end_hhmmss": "00:15:43",
        "start": 940.8069428571428,
        "end": 942.609
      }
    },
    {
      "edge": "M168",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "00:15:43",
        "end_hhmmss": "00:15:45",
        "start": 942.818,
        "end": 944.862
      }
    },
    {
      "edge": "M169",
      "attrs": {
        "text": "Fantine, come with me, please. Come on.",
        "start_hhmmss": "00:16:21",
        "end_hhmmss": "00:16:24",
        "start": 980.689,
        "end": 984.275
      }
    },
    {
      "edge": "M170",
      "attrs": {
        "text": "She's caught the tart.",
        "start_hhmmss": "00:16:26",
        "end_hhmmss": "00:16:28",
        "start": 985.736,
        "end": 988.404
      }
    },
    {
      "edge": "M171",
      "attrs": {
        "text": "Please don't let me go now, madame. My little girl is sick.",
        "start_hhmmss": "00:16:29",
        "end_hhmmss": "00:16:32",
        "start": 988.614,
        "end": 991.7
      }
    },
    {
      "edge": "M172",
      "attrs": {
        "text": "You read it in that letter from the people who take care of her. The military fever.",
        "start_hhmmss": "00:16:32",
        "end_hhmmss": "00:16:37",
        "start": 991.909,
        "end": 997.163
      }
    },
    {
      "edge": "M173",
      "attrs": {
        "text": "They need 40 francs for medicine or she'll die.",
        "start_hhmmss": "00:16:37",
        "end_hhmmss": "00:16:40",
        "start": 997.371,
        "end": 999.958
      }
    },
    {
      "edge": "M174",
      "attrs": {
        "text": "Who are these people, the Thénardiers?",
        "start_hhmmss": "00:16:40",
        "end_hhmmss": "00:16:44",
        "start": 1000.166,
        "end": 1003.545
      }
    },
    {
      "edge": "M175",
      "attrs": {
        "text": "Are they relatives?",
        "start_hhmmss": "00:16:44",
        "end_hhmmss": "00:16:45",
        "start": 1003.754,
        "end": 1005.0212
      }
    },
    {
      "edge": "M176",
      "attrs": {
        "text": "No, not relatives.",
        "start_hhmmss": "00:16:45",
        "end_hhmmss": "00:16:46",
        "start": 1005.0212,
        "end": 1006.13
      }
    },
    {
      "edge": "M177",
      "attrs": {
        "text": "You deliberately left your child with strangers to conceal her?",
        "start_hhmmss": "00:16:46",
        "end_hhmmss": "00:16:50",
        "start": 1006.339,
        "end": 1009.635
      }
    },
    {
      "edge": "M178",
      "attrs": {
        "text": "You dismiss me for having a child, then you--",
        "start_hhmmss": "00:16:50",
        "end_hhmmss": "00:16:52",
        "start": 1009.843,
        "end": 1012.178
      }
    },
    {
      "edge": "M179",
      "attrs": {
        "text": "Not for having a child, for having a child out of wedlock...",
        "start_hhmmss": "00:16:52",
        "end_hhmmss": "00:16:56",
        "start": 1012.386,
        "end": 1015.599
      }
    },
    {
      "edge": "M180",
      "attrs": {
        "text": "...pretending to be honest.",
        "start_hhmmss": "00:16:56",
        "end_hhmmss": "00:16:57",
        "start": 1015.807,
        "end": 1017.225
      }
    },
    {
      "edge": "M181",
      "attrs": {
        "text": "I have to earn money to feed her.",
        "start_hhmmss": "00:16:57",
        "end_hhmmss": "00:16:59",
        "start": 1017.433,
        "end": 1019.185
      }
    },
    {
      "edge": "M182",
      "attrs": {
        "text": "How can I work and take care of her? I have to lie.",
        "start_hhmmss": "00:16:59",
        "end_hhmmss": "00:17:03",
        "start": 1019.393,
        "end": 1022.606
      }
    },
    {
      "edge": "M183",
      "attrs": {
        "text": "You make it sound like your lie is my fault.",
        "start_hhmmss": "00:17:03",
        "end_hhmmss": "00:17:05",
        "start": 1022.814,
        "end": 1025.233
      }
    },
    {
      "edge": "M184",
      "attrs": {
        "text": "Oh, I'm sorry. I'm upset. I don't mean to argue, madame.",
        "start_hhmmss": "00:17:05",
        "end_hhmmss": "00:17:10",
        "start": 1025.441,
        "end": 1029.863
      }
    },
    {
      "edge": "M185",
      "attrs": {
        "text": "My Cosette is a sweet little girl, an innocent little girl.",
        "start_hhmmss": "00:17:10",
        "end_hhmmss": "00:17:14",
        "start": 1030.071,
        "end": 1033.575
      }
    },
    {
      "edge": "M186",
      "attrs": {
        "text": "Don't punish her for my sin.",
        "start_hhmmss": "00:17:14",
        "end_hhmmss": "00:17:16",
        "start": 1033.784,
        "end": 1035.786
      }
    },
    {
      "edge": "M187",
      "attrs": {
        "text": "I was stupid. I fell in love.",
        "start_hhmmss": "00:17:16",
        "end_hhmmss": "00:17:18",
        "start": 1035.994,
        "end": 1037.5783829787233
      }
    },
    {
      "edge": "M188",
      "attrs": {
        "text": "\"In love.\" That's always the excuse.",
        "start_hhmmss": "00:17:18",
        "end_hhmmss": "00:17:20",
        "start": 1037.5783829787233,
        "end": 1039.54
      }
    },
    {
      "edge": "M189",
      "attrs": {
        "text": "Yes, you're right. I'm a bad person. But the Thénardiers are good people.",
        "start_hhmmss": "00:17:20",
        "end_hhmmss": "00:17:24",
        "start": 1039.748,
        "end": 1044.126
      }
    },
    {
      "edge": "M190",
      "attrs": {
        "text": "They have two daughters. My Cosette can play with them.",
        "start_hhmmss": "00:17:24",
        "end_hhmmss": "00:17:27",
        "start": 1044.335,
        "end": 1047.463
      }
    },
    {
      "edge": "M191",
      "attrs": {
        "text": "She won't be so lonely. She's better off with them.",
        "start_hhmmss": "00:17:28",
        "end_hhmmss": "00:17:30",
        "start": 1047.673,
        "end": 1050.341
      }
    },
    {
      "edge": "M192",
      "attrs": {
        "text": "Only I have to make money to pay for her medicine.",
        "start_hhmmss": "00:17:31",
        "end_hhmmss": "00:17:34",
        "start": 1050.551,
        "end": 1053.887
      }
    },
    {
      "edge": "M193",
      "attrs": {
        "text": "Please. Just a month. I'll work hard.",
        "start_hhmmss": "00:17:34",
        "end_hhmmss": "00:17:37",
        "start": 1054.095,
        "end": 1057.223
      }
    },
    {
      "edge": "M194",
      "attrs": {
        "text": "The mayor cares about his workers.",
        "start_hhmmss": "00:17:37",
        "end_hhmmss": "00:17:39",
        "start": 1057.431,
        "end": 1059.225
      }
    },
    {
      "edge": "M195",
      "attrs": {
        "text": "He cannot have women of questionable morals influencing the girls. I'm sorry.",
        "start_hhmmss": "00:17:39",
        "end_hhmmss": "00:17:45",
        "start": 1059.433,
        "end": 1065.023
      }
    },
    {
      "edge": "M196",
      "attrs": {
        "text": "What's going on?",
        "start_hhmmss": "00:17:50",
        "end_hhmmss": "00:17:51",
        "start": 1069.653,
        "end": 1070.992741935484
      }
    },
    {
      "edge": "M197",
      "attrs": {
        "text": "Five sous for the chair.",
        "start_hhmmss": "00:17:51",
        "end_hhmmss": "00:17:53",
        "start": 1070.992741935484,
        "end": 1073.114
      }
    },
    {
      "edge": "M198",
      "attrs": {
        "text": "Nice doing business with you.",
        "start_hhmmss": "00:17:53",
        "end_hhmmss": "00:17:55",
        "start": 1073.322,
        "end": 1074.866
      }
    },
    {
      "edge": "M199",
      "attrs": {
        "text": "Are you skipping out?",
        "start_hhmmss": "00:17:55",
        "end_hhmmss": "00:17:57",
        "start": 1075.074,
        "end": 1076.5111891891893
      }
    },
    {
      "edge": "M200",
      "attrs": {
        "text": "I sold it for extra money.",
        "start_hhmmss": "00:17:57",
        "end_hhmmss": "00:17:58",
        "start": 1076.5111891891893,
        "end": 1078.202
      }
    },
    {
      "edge": "M201",
      "attrs": {
        "text": "Well, you owe me a month's rent.",
        "start_hhmmss": "00:17:58",
        "end_hhmmss": "00:18:00",
        "start": 1078.411,
        "end": 1080.121
      }
    },
    {
      "edge": "M202",
      "attrs": {
        "text": "Not till next week.",
        "start_hhmmss": "00:18:00",
        "end_hhmmss": "00:18:01",
        "start": 1080.329,
        "end": 1081.4912857142856
      }
    },
    {
      "edge": "M203",
      "attrs": {
        "text": "Well, pay now or you're out.",
        "start_hhmmss": "00:18:01",
        "end_hhmmss": "00:18:03",
        "start": 1081.4912857142856,
        "end": 1083.041
      }
    },
    {
      "edge": "M204",
      "attrs": {
        "text": "Thirty francs. Come on, you've got 50 in your hand.",
        "start_hhmmss": "00:18:04",
        "end_hhmmss": "00:18:07",
        "start": 1083.709,
        "end": 1086.544
      }
    },
    {
      "edge": "M205",
      "attrs": {
        "text": "Fifteen. Get you the rest next week.",
        "start_hhmmss": "00:18:07",
        "end_hhmmss": "00:18:09",
        "start": 1086.753,
        "end": 1088.672
      }
    },
    {
      "edge": "M206",
      "attrs": {
        "text": "How? They fired you.",
        "start_hhmmss": "00:18:09",
        "end_hhmmss": "00:18:11",
        "start": 1088.88,
        "end": 1090.665
      }
    },
    {
      "edge": "M207",
      "attrs": {
        "text": "Who told you I was fired?",
        "start_hhmmss": "00:18:11",
        "end_hhmmss": "00:18:13",
        "start": 1090.665,
        "end": 1092.926
      }
    },
    {
      "edge": "M208",
      "attrs": {
        "text": "This is still a small town.",
        "start_hhmmss": "00:18:13",
        "end_hhmmss": "00:18:16",
        "start": 1093.134,
        "end": 1095.971
      }
    },
    {
      "edge": "M209",
      "attrs": {
        "text": "I have a job.",
        "start_hhmmss": "00:18:16",
        "end_hhmmss": "00:18:17",
        "start": 1096.304,
        "end": 1097.0549375
      }
    },
    {
      "edge": "M210",
      "attrs": {
        "text": "Don't lie.",
        "start_hhmmss": "00:18:17",
        "end_hhmmss": "00:18:18",
        "start": 1097.0549375,
        "end": 1097.639
      }
    },
    {
      "edge": "M211",
      "attrs": {
        "text": "Start next week as a washerwoman.",
        "start_hhmmss": "00:18:18",
        "end_hhmmss": "00:18:20",
        "start": 1097.848,
        "end": 1099.6
      }
    },
    {
      "edge": "M212",
      "attrs": {
        "text": "Everybody knows your story. You've got a bastard kid.",
        "start_hhmmss": "00:18:20",
        "end_hhmmss": "00:18:23",
        "start": 1099.808,
        "end": 1102.56
      }
    },
    {
      "edge": "M213",
      "attrs": {
        "text": "Nobody's gonna give you work.",
        "start_hhmmss": "00:18:23",
        "end_hhmmss": "00:18:25",
        "start": 1102.769,
        "end": 1105.396
      }
    },
    {
      "edge": "M214",
      "attrs": {
        "text": "Please take half. I'll get you the rest.",
        "start_hhmmss": "00:18:28",
        "end_hhmmss": "00:18:31",
        "start": 1107.983,
        "end": 1110.861
      }
    },
    {
      "edge": "M215",
      "attrs": {
        "text": "Don't look so worried. Things aren't that bad.",
        "start_hhmmss": "00:18:33",
        "end_hhmmss": "00:18:37",
        "start": 1112.738,
        "end": 1117.075
      }
    },
    {
      "edge": "M216",
      "attrs": {
        "text": "You've still got a bed.",
        "start_hhmmss": "00:18:38",
        "end_hhmmss": "00:18:40",
        "start": 1117.909,
        "end": 1120.411
      }
    },
    {
      "edge": "M217",
      "attrs": {
        "text": "Yes. Good hair quality.",
        "start_hhmmss": "00:18:59",
        "end_hhmmss": "00:19:02",
        "start": 1138.972,
        "end": 1141.725
      }
    },
    {
      "edge": "M218",
      "attrs": {
        "text": "Ten francs.",
        "start_hhmmss": "00:19:03",
        "end_hhmmss": "00:19:04",
        "start": 1142.516,
        "end": 1143.935
      }
    },
    {
      "edge": "M219",
      "attrs": {
        "text": "Dear Reverend Mother.",
        "start_hhmmss": "00:19:07",
        "end_hhmmss": "00:19:09",
        "start": 1146.897,
        "end": 1149.482
      }
    },
    {
      "edge": "M220",
      "attrs": {
        "text": "The Bishop of Digne, may he rest in peace...",
        "start_hhmmss": "00:19:10",
        "end_hhmmss": "00:19:13",
        "start": 1150.399,
        "end": 1152.736
      }
    },
    {
      "edge": "M221",
      "attrs": {
        "text": "...often told me of your convent and its good works.",
        "start_hhmmss": "00:19:13",
        "end_hhmmss": "00:19:17",
        "start": 1152.944,
        "end": 1157.406
      }
    },
    {
      "edge": "M222",
      "attrs": {
        "text": "In his memory, I would like to give a--",
        "start_hhmmss": "00:19:18",
        "end_hhmmss": "00:19:23",
        "start": 1157.615,
        "end": 1162.704
      }
    },
    {
      "edge": "M223",
      "attrs": {
        "text": "Or is it \"I should like\"?",
        "start_hhmmss": "00:19:23",
        "end_hhmmss": "00:19:25",
        "start": 1162.913,
        "end": 1164.538
      }
    },
    {
      "edge": "M224",
      "attrs": {
        "text": "\"Should\" is preferable. And \"endow\" is less brutal than \"give.\"",
        "start_hhmmss": "00:19:25",
        "end_hhmmss": "00:19:29",
        "start": 1164.748,
        "end": 1169.293
      }
    },
    {
      "edge": "M225",
      "attrs": {
        "text": "I should like to endow--",
        "start_hhmmss": "00:19:30",
        "end_hhmmss": "00:19:31",
        "start": 1169.502,
        "end": 1171.090846153846
      }
    },
    {
      "edge": "M226",
      "attrs": {
        "text": "Monsieur!",
        "start_hhmmss": "00:19:31",
        "end_hhmmss": "00:19:32",
        "start": 1171.090846153846,
        "end": 1171.797
      }
    },
    {
      "edge": "M227",
      "attrs": {
        "text": "There's been an accident. One of the workers. Lafitte!",
        "start_hhmmss": "00:19:32",
        "end_hhmmss": "00:19:36",
        "start": 1172.005,
        "end": 1176.3
      }
    },
    {
      "edge": "M228",
      "attrs": {
        "text": "Get me out! I can't breathe!",
        "start_hhmmss": "00:19:39",
        "end_hhmmss": "00:19:41",
        "start": 1179.012,
        "end": 1180.6798048780488
      }
    },
    {
      "edge": "M229",
      "attrs": {
        "text": "Stand back. Let me through.",
        "start_hhmmss": "00:19:41",
        "end_hhmmss": "00:19:42",
        "start": 1180.6798048780488,
        "end": 1182.431
      }
    },
    {
      "edge": "M230",
      "attrs": {
        "text": "Let him through.",
        "start_hhmmss": "00:19:43",
        "end_hhmmss": "00:19:44",
        "start": 1182.64,
        "end": 1183.8399393939394
      }
    },
    {
      "edge": "M231",
      "attrs": {
        "text": "Help us. We need leverage.",
        "start_hhmmss": "00:19:44",
        "end_hhmmss": "00:19:46",
        "start": 1183.8399393939394,
        "end": 1185.686
      }
    },
    {
      "edge": "M232",
      "attrs": {
        "text": "Come on, move!",
        "start_hhmmss": "00:19:46",
        "end_hhmmss": "00:19:47",
        "start": 1185.894,
        "end": 1186.9068571428572
      }
    },
    {
      "edge": "M233",
      "attrs": {
        "text": "Gather round!",
        "start_hhmmss": "00:19:47",
        "end_hhmmss": "00:19:48",
        "start": 1186.9068571428572,
        "end": 1188.021
      }
    },
    {
      "edge": "M234",
      "attrs": {
        "text": "Together. All together.",
        "start_hhmmss": "00:19:48",
        "end_hhmmss": "00:19:50",
        "start": 1188.229,
        "end": 1190.1152413793104
      }
    },
    {
      "edge": "M235",
      "attrs": {
        "text": "Let's go, boys!",
        "start_hhmmss": "00:19:50",
        "end_hhmmss": "00:19:51",
        "start": 1190.1152413793104,
        "end": 1191.108
      }
    },
    {
      "edge": "M236",
      "attrs": {
        "text": "Get me out! It's breaking my rib!",
        "start_hhmmss": "00:19:55",
        "end_hhmmss": "00:19:57",
        "start": 1194.61,
        "end": 1196.988
      }
    },
    {
      "edge": "M237",
      "attrs": {
        "text": "Get ready.",
        "start_hhmmss": "00:19:59",
        "end_hhmmss": "00:20:00",
        "start": 1199.074,
        "end": 1199.7816363636364
      }
    },
    {
      "edge": "M238",
      "attrs": {
        "text": "Come on, pull. All together. Pull!",
        "start_hhmmss": "00:20:00",
        "end_hhmmss": "00:20:02",
        "start": 1199.7816363636364,
        "end": 1201.993
      }
    },
    {
      "edge": "M239",
      "attrs": {
        "text": "Boys, push. Push. Come on, push.",
        "start_hhmmss": "00:20:05",
        "end_hhmmss": "00:20:10",
        "start": 1205.371,
        "end": 1209.5
      }
    },
    {
      "edge": "M240",
      "attrs": {
        "text": "Marla.",
        "start_hhmmss": "00:20:42",
        "end_hhmmss": "00:20:43",
        "start": 1242.241,
        "end": 1242.592875
      }
    },
    {
      "edge": "M241",
      "attrs": {
        "text": "Good evening.",
        "start_hhmmss": "00:20:43",
        "end_hhmmss": "00:20:43",
        "start": 1242.592875,
        "end": 1243.367
      }
    },
    {
      "edge": "M242",
      "attrs": {
        "text": "Where's Claudette tonight?",
        "start_hhmmss": "00:20:44",
        "end_hhmmss": "00:20:46",
        "start": 1243.576,
        "end": 1246.0709375
      }
    },
    {
      "edge": "M243",
      "attrs": {
        "text": "Oh, monsieur.",
        "start_hhmmss": "00:20:46",
        "end_hhmmss": "00:20:47",
        "start": 1246.0709375,
        "end": 1247.205
      }
    },
    {
      "edge": "M244",
      "attrs": {
        "text": "There are more than ever.",
        "start_hhmmss": "00:20:48",
        "end_hhmmss": " ",
        "start": 1248.247,
        "end": 1250.2611463414637
      }
    },
    {
      "edge": "M245",
      "attrs": {
        "text": "Inspector, you startle me.",
        "start_hhmmss": "00:20:50",
        "end_hhmmss": "00:20:52",
        "start": 1250.2611463414637,
        "end": 1252.376
      }
    },
    {
      "edge": "M246",
      "attrs": {
        "text": "Yes, I counted four new girls.",
        "start_hhmmss": "00:20:53",
        "end_hhmmss": "00:20:55",
        "start": 1252.585,
        "end": 1254.503
      }
    },
    {
      "edge": "M247",
      "attrs": {
        "text": "You see, captain, when a town grows, crime grows with it.",
        "start_hhmmss": "00:20:55",
        "end_hhmmss": "00:20:59",
        "start": 1254.712,
        "end": 1258.507
      }
    },
    {
      "edge": "M248",
      "attrs": {
        "text": "Shall I get the men and make arrests?",
        "start_hhmmss": "00:20:59",
        "end_hhmmss": "00:21:01",
        "start": 1258.716,
        "end": 1260.746
      }
    },
    {
      "edge": "M249",
      "attrs": {
        "text": "No. Did you check off the regulars?",
        "start_hhmmss": "00:21:01",
        "end_hhmmss": "00:21:03",
        "start": 1260.746,
        "end": 1262.636
      }
    },
    {
      "edge": "M250",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:21:03",
        "end_hhmmss": "00:21:05",
        "start": 1262.846,
        "end": 1264.513
      }
    },
    {
      "edge": "M251",
      "attrs": {
        "text": "And I've noted the new girls.",
        "start_hhmmss": "00:21:05",
        "end_hhmmss": "00:21:08",
        "start": 1265.264,
        "end": 1267.6803333333332
      }
    },
    {
      "edge": "M252",
      "attrs": {
        "text": "Good work.",
        "start_hhmmss": "00:21:08",
        "end_hhmmss": "00:21:09",
        "start": 1267.6803333333332,
        "end": 1268.559
      }
    },
    {
      "edge": "M253",
      "attrs": {
        "text": "Marla.",
        "start_hhmmss": "00:21:10",
        "end_hhmmss": "00:21:11",
        "start": 1270.311,
        "end": 1270.662875
      }
    },
    {
      "edge": "M254",
      "attrs": {
        "text": "Good evening.",
        "start_hhmmss": "00:21:11",
        "end_hhmmss": "00:21:11",
        "start": 1270.662875,
        "end": 1271.437
      }
    },
    {
      "edge": "M255",
      "attrs": {
        "text": "Is it 10:00? I didn't hear it ring.",
        "start_hhmmss": "00:21:12",
        "end_hhmmss": "00:21:14",
        "start": 1271.645,
        "end": 1273.7634615384616
      }
    },
    {
      "edge": "M256",
      "attrs": {
        "text": "I'm early. I was restless.",
        "start_hhmmss": "00:21:14",
        "end_hhmmss": "00:21:16",
        "start": 1273.7634615384616,
        "end": 1275.776
      }
    },
    {
      "edge": "M257",
      "attrs": {
        "text": "You heard about Lafitte and the cart?",
        "start_hhmmss": "00:21:16",
        "end_hhmmss": "00:21:18",
        "start": 1275.984,
        "end": 1277.9976585365855
      }
    },
    {
      "edge": "M258",
      "attrs": {
        "text": "Nothing else.",
        "start_hhmmss": "00:21:18",
        "end_hhmmss": "00:21:19",
        "start": 1277.9976585365855,
        "end": 1278.736
      }
    },
    {
      "edge": "M259",
      "attrs": {
        "text": "Incredible feat.",
        "start_hhmmss": "00:21:19",
        "end_hhmmss": "00:21:20",
        "start": 1278.945,
        "end": 1280.488
      }
    },
    {
      "edge": "M260",
      "attrs": {
        "text": "Has the mayor always been that strong?",
        "start_hhmmss": "00:21:21",
        "end_hhmmss": "00:21:23",
        "start": 1280.696,
        "end": 1282.74
      }
    },
    {
      "edge": "M261",
      "attrs": {
        "text": "Well, he's a big man, but I didn't know he was that strong.",
        "start_hhmmss": "00:21:23",
        "end_hhmmss": "00:21:27",
        "start": 1282.949,
        "end": 1286.744
      }
    },
    {
      "edge": "M262",
      "attrs": {
        "text": "Didn't he show it when he was young?",
        "start_hhmmss": "00:21:27",
        "end_hhmmss": "00:21:29",
        "start": 1286.953,
        "end": 1289.0385
      }
    },
    {
      "edge": "M263",
      "attrs": {
        "text": "I didn't know him when he was young.",
        "start_hhmmss": "00:21:29",
        "end_hhmmss": "00:21:31",
        "start": 1289.0385,
        "end": 1291.1240000000005
      }
    },
    {
      "edge": "M264",
      "attrs": {
        "text": "Oh, that's right. He moved here. Where's he from?",
        "start_hhmmss": "00:21:31",
        "end_hhmmss": "00:21:35",
        "start": 1291.332,
        "end": 1294.668
      }
    },
    {
      "edge": "M265",
      "attrs": {
        "text": "Well, he came here from Paris, but that's not where he was born.",
        "start_hhmmss": "00:21:35",
        "end_hhmmss": "00:21:38",
        "start": 1294.878,
        "end": 1298.215
      }
    },
    {
      "edge": "M266",
      "attrs": {
        "text": "You know, I think he told--",
        "start_hhmmss": "00:21:38",
        "end_hhmmss": "00:21:40",
        "start": 1298.422,
        "end": 1300.3354390243903
      }
    },
    {
      "edge": "M267",
      "attrs": {
        "text": "Didn't you check his papers?",
        "start_hhmmss": "00:21:40",
        "end_hhmmss": "00:21:43",
        "start": 1300.3354390243903,
        "end": 1302.551
      }
    },
    {
      "edge": "M268",
      "attrs": {
        "text": "I suppose I did. Don't remember.",
        "start_hhmmss": "00:21:43",
        "end_hhmmss": "00:21:46",
        "start": 1302.76,
        "end": 1305.5323076923078
      }
    },
    {
      "edge": "M269",
      "attrs": {
        "text": "Perhaps you didn't.",
        "start_hhmmss": "00:21:46",
        "end_hhmmss": "00:21:47",
        "start": 1305.5323076923078,
        "end": 1307.265
      }
    },
    {
      "edge": "M270",
      "attrs": {
        "text": "Why should you?",
        "start_hhmmss": "00:21:47",
        "end_hhmmss": "00:21:50",
        "start": 1307.473,
        "end": 1309.683
      }
    },
    {
      "edge": "M271",
      "attrs": {
        "text": "How about her?",
        "start_hhmmss": "00:21:54",
        "end_hhmmss": "00:21:56",
        "start": 1313.646,
        "end": 1315.816
      }
    },
    {
      "edge": "M272",
      "attrs": {
        "text": "Who are you?",
        "start_hhmmss": "00:21:57",
        "end_hhmmss": "00:21:59",
        "start": 1317.067,
        "end": 1318.86
      }
    },
    {
      "edge": "M273",
      "attrs": {
        "text": "Push off!",
        "start_hhmmss": "00:21:59",
        "end_hhmmss": "00:22:00",
        "start": 1319.069,
        "end": 1320.3055294117646
      }
    },
    {
      "edge": "M274",
      "attrs": {
        "text": "Yeah, get off.",
        "start_hhmmss": "00:22:00",
        "end_hhmmss": "00:22:02",
        "start": 1320.3055294117646,
        "end": 1322.072
      }
    },
    {
      "edge": "M275",
      "attrs": {
        "text": "Hi, dearie.",
        "start_hhmmss": "00:22:02",
        "end_hhmmss": "00:22:04",
        "start": 1322.488,
        "end": 1323.7018181818182
      }
    },
    {
      "edge": "M276",
      "attrs": {
        "text": "Oh, yes. Yes, yes, yes.",
        "start_hhmmss": "00:22:04",
        "end_hhmmss": "00:22:06",
        "start": 1323.7018181818182,
        "end": 1325.826
      }
    },
    {
      "edge": "M277",
      "attrs": {
        "text": "She's new.",
        "start_hhmmss": "00:22:06",
        "end_hhmmss": "00:22:09",
        "start": 1326.034,
        "end": 1328.87
      }
    },
    {
      "edge": "M278",
      "attrs": {
        "text": "Who is it?",
        "start_hhmmss": "00:22:25",
        "end_hhmmss": "00:22:26",
        "start": 1344.76,
        "end": 1346.304
      }
    },
    {
      "edge": "M279",
      "attrs": {
        "text": "I'm buying your horse and cart.",
        "start_hhmmss": "00:22:32",
        "end_hhmmss": "00:22:34",
        "start": 1351.977,
        "end": 1354.02
      }
    },
    {
      "edge": "M280",
      "attrs": {
        "text": "The doctor says your kneecap's broken. You won't be able to do your old job.",
        "start_hhmmss": "00:22:34",
        "end_hhmmss": "00:22:39",
        "start": 1354.229,
        "end": 1358.649
      }
    },
    {
      "edge": "M281",
      "attrs": {
        "text": "I've written to the Sainte Marie Convent in Paris.",
        "start_hhmmss": "00:22:39",
        "end_hhmmss": "00:22:42",
        "start": 1358.859,
        "end": 1362.112
      }
    },
    {
      "edge": "M282",
      "attrs": {
        "text": "The sisters need a new caretaker and gardener.",
        "start_hhmmss": "00:22:42",
        "end_hhmmss": "00:22:46",
        "start": 1362.32,
        "end": 1365.739
      }
    },
    {
      "edge": "M283",
      "attrs": {
        "text": "I'm sorry. I'm so sorry.",
        "start_hhmmss": "00:22:50",
        "end_hhmmss": "00:22:53",
        "start": 1370.328,
        "end": 1372.710857142857
      }
    },
    {
      "edge": "M284",
      "attrs": {
        "text": "Sorry for what?",
        "start_hhmmss": "00:22:53",
        "end_hhmmss": "00:22:54",
        "start": 1372.710857142857,
        "end": 1374.498
      }
    },
    {
      "edge": "M285",
      "attrs": {
        "text": "Monsieur, I used to--",
        "start_hhmmss": "00:22:55",
        "end_hhmmss": "00:22:59",
        "start": 1375.416,
        "end": 1378.669
      }
    },
    {
      "edge": "M286",
      "attrs": {
        "text": "I was angry at you.",
        "start_hhmmss": "00:22:59",
        "end_hhmmss": "00:23:01",
        "start": 1378.879,
        "end": 1381.172
      }
    },
    {
      "edge": "M287",
      "attrs": {
        "text": "Because when you came here, you were a worker like me...",
        "start_hhmmss": "00:23:01",
        "end_hhmmss": "00:23:06",
        "start": 1381.38,
        "end": 1385.718
      }
    },
    {
      "edge": "M288",
      "attrs": {
        "text": "...and you grew rich...",
        "start_hhmmss": "00:23:06",
        "end_hhmmss": "00:23:08",
        "start": 1385.927,
        "end": 1387.761
      }
    },
    {
      "edge": "M289",
      "attrs": {
        "text": "...while I had troubles.",
        "start_hhmmss": "00:23:08",
        "end_hhmmss": "00:23:09",
        "start": 1387.971,
        "end": 1389.422476190476
      }
    },
    {
      "edge": "M290",
      "attrs": {
        "text": "We've all had troubles, Lafitte.",
        "start_hhmmss": "00:23:09",
        "end_hhmmss": "00:23:12",
        "start": 1389.422476190476,
        "end": 1391.557
      }
    },
    {
      "edge": "M291",
      "attrs": {
        "text": "And we all need help from time to time. Rest.",
        "start_hhmmss": "00:23:12",
        "end_hhmmss": "00:23:15",
        "start": 1391.765,
        "end": 1394.936
      }
    },
    {
      "edge": "M292",
      "attrs": {
        "text": "And I'll let you know when I have word from the convent.",
        "start_hhmmss": "00:23:15",
        "end_hhmmss": "00:23:18",
        "start": 1395.145,
        "end": 1398.231
      }
    },
    {
      "edge": "M293",
      "attrs": {
        "text": "\"Thank you for...",
        "start_hhmmss": "00:23:26",
        "end_hhmmss": "00:23:30",
        "start": 1405.571,
        "end": 1409.867
      }
    },
    {
      "edge": "M294",
      "attrs": {
        "text": "...our new....\"",
        "start_hhmmss": "00:23:30",
        "end_hhmmss": "00:23:34",
        "start": 1410.076,
        "end": 1413.871
      }
    },
    {
      "edge": "M295",
      "attrs": {
        "text": "C-A-R-E. Caretaker.",
        "start_hhmmss": "00:23:36",
        "end_hhmmss": "00:23:40",
        "start": 1415.831,
        "end": 1419.961
      }
    },
    {
      "edge": "M296",
      "attrs": {
        "text": "That's it, caretaker.",
        "start_hhmmss": "00:23:40",
        "end_hhmmss": "00:23:41",
        "start": 1420.17,
        "end": 1421.338
      }
    },
    {
      "edge": "M297",
      "attrs": {
        "text": "Excuse me.",
        "start_hhmmss": "00:23:41",
        "end_hhmmss": "00:23:42",
        "start": 1421.338,
        "end": 1421.922
      }
    },
    {
      "edge": "M298",
      "attrs": {
        "text": "Inspector Javert is here to see you.",
        "start_hhmmss": "00:23:42",
        "end_hhmmss": "00:23:45",
        "start": 1422.13,
        "end": 1425.0672857142858
      }
    },
    {
      "edge": "M299",
      "attrs": {
        "text": "Tell him to wait.",
        "start_hhmmss": "00:23:45",
        "end_hhmmss": "00:23:46",
        "start": 1425.0672857142858,
        "end": 1426.384
      }
    },
    {
      "edge": "M300",
      "attrs": {
        "text": "I have exciting news, monsieur le maire. Paris is interested in my plan.",
        "start_hhmmss": "00:23:55",
        "end_hhmmss": "00:24:00",
        "start": 1435.101,
        "end": 1439.647
      }
    },
    {
      "edge": "M301",
      "attrs": {
        "text": "What plan's that?",
        "start_hhmmss": "00:24:01",
        "end_hhmmss": "00:24:02",
        "start": 1440.856,
        "end": 1441.9410666666663
      }
    },
    {
      "edge": "M302",
      "attrs": {
        "text": "It's in the letter, sir.",
        "start_hhmmss": "00:24:02",
        "end_hhmmss": "00:24:03",
        "start": 1441.9410666666663,
        "end": 1443.36
      }
    },
    {
      "edge": "M303",
      "attrs": {
        "text": "Why don't you tell me? You said it's your plan.",
        "start_hhmmss": "00:24:07",
        "end_hhmmss": "00:24:10",
        "start": 1447.238,
        "end": 1449.865
      }
    },
    {
      "edge": "M304",
      "attrs": {
        "text": "I forgot. I apologize.",
        "start_hhmmss": "00:24:10",
        "end_hhmmss": "00:24:12",
        "start": 1450.075,
        "end": 1451.575
      }
    },
    {
      "edge": "M305",
      "attrs": {
        "text": "Apologize? For what?",
        "start_hhmmss": "00:24:12",
        "end_hhmmss": "00:24:13",
        "start": 1451.784,
        "end": 1453.393882352941
      }
    },
    {
      "edge": "M306",
      "attrs": {
        "text": "I forgot you don't read.",
        "start_hhmmss": "00:24:13",
        "end_hhmmss": "00:24:15",
        "start": 1453.393882352941,
        "end": 1455.205
      }
    },
    {
      "edge": "M307",
      "attrs": {
        "text": "Your clerk mentioned it.",
        "start_hhmmss": "00:24:15",
        "end_hhmmss": "00:24:17",
        "start": 1455.413,
        "end": 1457.374
      }
    },
    {
      "edge": "M308",
      "attrs": {
        "text": "Neglected your education to make your fortune?",
        "start_hhmmss": "00:24:18",
        "end_hhmmss": "00:24:20",
        "start": 1457.581,
        "end": 1460.21
      }
    },
    {
      "edge": "M309",
      "attrs": {
        "text": "What is Paris interested in, inspector? I'm all ears.",
        "start_hhmmss": "00:24:20",
        "end_hhmmss": "00:24:24",
        "start": 1460.418,
        "end": 1463.754
      }
    },
    {
      "edge": "M310",
      "attrs": {
        "text": "Because of Vigau's extraordinary growth the past five years...",
        "start_hhmmss": "00:24:24",
        "end_hhmmss": "00:24:27",
        "start": 1463.964,
        "end": 1467.217
      }
    },
    {
      "edge": "M311",
      "attrs": {
        "text": "...I've proposed that we make a detailed census.",
        "start_hhmmss": "00:24:27",
        "end_hhmmss": "00:24:30",
        "start": 1467.425,
        "end": 1470.22
      }
    },
    {
      "edge": "M312",
      "attrs": {
        "text": "Well, that would be interesting. But how is it a police matter?",
        "start_hhmmss": "00:24:30",
        "end_hhmmss": "00:24:34",
        "start": 1470.428,
        "end": 1474.14
      }
    },
    {
      "edge": "M313",
      "attrs": {
        "text": "Modern law enforcement demands modern methods...",
        "start_hhmmss": "00:24:34",
        "end_hhmmss": "00:24:37",
        "start": 1474.349,
        "end": 1476.85
      }
    },
    {
      "edge": "M314",
      "attrs": {
        "text": "...and that means information.",
        "start_hhmmss": "00:24:37",
        "end_hhmmss": "00:24:39",
        "start": 1477.06,
        "end": 1479.354
      }
    },
    {
      "edge": "M315",
      "attrs": {
        "text": "For example, how many people have moved here in the last decade?",
        "start_hhmmss": "00:24:40",
        "end_hhmmss": "00:24:43",
        "start": 1479.561,
        "end": 1483.024
      }
    },
    {
      "edge": "M316",
      "attrs": {
        "text": "Where did they come from? What's their background?",
        "start_hhmmss": "00:24:43",
        "end_hhmmss": "00:24:47",
        "start": 1483.233,
        "end": 1486.694
      }
    },
    {
      "edge": "M317",
      "attrs": {
        "text": "Is our criminal population home-grown or are they outsiders?",
        "start_hhmmss": "00:24:47",
        "end_hhmmss": "00:24:51",
        "start": 1486.902,
        "end": 1490.698
      }
    },
    {
      "edge": "M318",
      "attrs": {
        "text": "Without information, we cannot know how to control the dangerous elements.",
        "start_hhmmss": "00:24:52",
        "end_hhmmss": "00:24:56",
        "start": 1491.532,
        "end": 1495.953
      }
    },
    {
      "edge": "M319",
      "attrs": {
        "text": "You might be making a mistake.",
        "start_hhmmss": "00:24:59",
        "end_hhmmss": "00:25:01",
        "start": 1499.124,
        "end": 1500.8173846153843
      }
    },
    {
      "edge": "M320",
      "attrs": {
        "text": "It's a mistake? What mistake is that?",
        "start_hhmmss": "00:25:01",
        "end_hhmmss": "00:25:03",
        "start": 1500.8173846153843,
        "end": 1502.793
      }
    },
    {
      "edge": "M321",
      "attrs": {
        "text": "Sometimes people move to a new town to start with a clean slate.",
        "start_hhmmss": "00:25:03",
        "end_hhmmss": "00:25:08",
        "start": 1503.003,
        "end": 1507.631
      }
    },
    {
      "edge": "M322",
      "attrs": {
        "text": "You might be doing more harm than good by prying into their lives.",
        "start_hhmmss": "00:25:08",
        "end_hhmmss": "00:25:11",
        "start": 1507.84,
        "end": 1511.302
      }
    },
    {
      "edge": "M323",
      "attrs": {
        "text": "An honest man has nothing to fear from the truth.",
        "start_hhmmss": "00:25:12",
        "end_hhmmss": "00:25:14",
        "start": 1511.51,
        "end": 1514.097
      }
    },
    {
      "edge": "M324",
      "attrs": {
        "text": "For example, Paris knows my father was a thief and my mother a prostitute.",
        "start_hhmmss": "00:25:15",
        "end_hhmmss": "00:25:21",
        "start": 1514.805,
        "end": 1521.021
      }
    },
    {
      "edge": "M325",
      "attrs": {
        "text": "If my mother or father moved here, I'd want everyone to know what they are.",
        "start_hhmmss": "00:25:21",
        "end_hhmmss": "00:25:27",
        "start": 1521.229,
        "end": 1526.859
      }
    },
    {
      "edge": "M326",
      "attrs": {
        "text": "Even if they had reformed themselves?",
        "start_hhmmss": "00:25:27",
        "end_hhmmss": "00:25:29",
        "start": 1527.068,
        "end": 1529.1861551724137
      }
    },
    {
      "edge": "M327",
      "attrs": {
        "text": "Reform is a discredited fantasy.",
        "start_hhmmss": "00:25:29",
        "end_hhmmss": "00:25:31",
        "start": 1529.1861551724137,
        "end": 1531.031
      }
    },
    {
      "edge": "M328",
      "attrs": {
        "text": "Modern science tells us that people are by nature law breakers or law abiders.",
        "start_hhmmss": "00:25:31",
        "end_hhmmss": "00:25:36",
        "start": 1531.239,
        "end": 1535.576
      }
    },
    {
      "edge": "M329",
      "attrs": {
        "text": "A wolf can wear sheep's clothing, but he's still a wolf.",
        "start_hhmmss": "00:25:37",
        "end_hhmmss": "00:25:41",
        "start": 1536.618,
        "end": 1540.998
      }
    },
    {
      "edge": "M330",
      "attrs": {
        "text": "I was just thinking, inspector, that you have been unlucky.",
        "start_hhmmss": "00:25:46",
        "end_hhmmss": "00:25:49",
        "start": 1545.753,
        "end": 1548.881
      }
    },
    {
      "edge": "M331",
      "attrs": {
        "text": "Unlucky? I don't understand.",
        "start_hhmmss": "00:25:49",
        "end_hhmmss": "00:25:51",
        "start": 1549.382,
        "end": 1550.966
      }
    },
    {
      "edge": "M332",
      "attrs": {
        "text": "Unfortunately, you've been assigned to a dull post.",
        "start_hhmmss": "00:25:51",
        "end_hhmmss": "00:25:54",
        "start": 1551.176,
        "end": 1553.927
      }
    },
    {
      "edge": "M333",
      "attrs": {
        "text": "You'd be happier in Paris, where everyone...",
        "start_hhmmss": "00:25:54",
        "end_hhmmss": "00:25:57",
        "start": 1554.137,
        "end": 1556.597
      }
    },
    {
      "edge": "M334",
      "attrs": {
        "text": "...either by nature or experience, is dishonest.",
        "start_hhmmss": "00:25:57",
        "end_hhmmss": "00:25:59",
        "start": 1556.805,
        "end": 1559.309
      }
    },
    {
      "edge": "M335",
      "attrs": {
        "text": "Indeed. Well, I'll see if I prefer Paris.",
        "start_hhmmss": "00:26:00",
        "end_hhmmss": "00:26:03",
        "start": 1559.517,
        "end": 1562.561
      }
    },
    {
      "edge": "M336",
      "attrs": {
        "text": "They've asked me to report to the deputy prefect to explain my idea.",
        "start_hhmmss": "00:26:03",
        "end_hhmmss": "00:26:07",
        "start": 1562.77,
        "end": 1566.857
      }
    },
    {
      "edge": "M337",
      "attrs": {
        "text": "I'll be gone for four days.",
        "start_hhmmss": "00:26:07",
        "end_hhmmss": "00:26:10",
        "start": 1567.067,
        "end": 1569.651
      }
    },
    {
      "edge": "M338",
      "attrs": {
        "text": "We'll miss you. Good luck.",
        "start_hhmmss": "00:26:10",
        "end_hhmmss": "00:26:13",
        "start": 1569.86,
        "end": 1572.571
      }
    },
    {
      "edge": "M339",
      "attrs": {
        "text": "Thank you. And goodbye.",
        "start_hhmmss": "00:26:13",
        "end_hhmmss": "00:26:16",
        "start": 1573.114,
        "end": 1575.699
      }
    },
    {
      "edge": "M340",
      "attrs": {
        "text": "Inspector? One moment.",
        "start_hhmmss": "00:26:18",
        "end_hhmmss": "00:26:20",
        "start": 1577.535,
        "end": 1580.288
      }
    },
    {
      "edge": "M341",
      "attrs": {
        "text": "Please.",
        "start_hhmmss": "00:26:23",
        "end_hhmmss": "00:26:25",
        "start": 1583.208,
        "end": 1584.875
      }
    },
    {
      "edge": "M342",
      "attrs": {
        "text": "Here's a farewell gift.",
        "start_hhmmss": "00:26:29",
        "end_hhmmss": "00:26:30",
        "start": 1588.754,
        "end": 1590.215789473684
      }
    },
    {
      "edge": "M343",
      "attrs": {
        "text": "You're offering me a gift?",
        "start_hhmmss": "00:26:30",
        "end_hhmmss": "00:26:32",
        "start": 1590.215789473684,
        "end": 1591.84
      }
    },
    {
      "edge": "M344",
      "attrs": {
        "text": "Yes, inspector, my papers.",
        "start_hhmmss": "00:26:32",
        "end_hhmmss": "00:26:34",
        "start": 1592.049,
        "end": 1594.385
      }
    },
    {
      "edge": "M345",
      "attrs": {
        "text": "Baptismal certificate, passport...",
        "start_hhmmss": "00:26:39",
        "end_hhmmss": "00:26:42",
        "start": 1598.639,
        "end": 1601.809
      }
    },
    {
      "edge": "M346",
      "attrs": {
        "text": "...working papers from the Marseille docks.",
        "start_hhmmss": "00:26:42",
        "end_hhmmss": "00:26:45",
        "start": 1602.017,
        "end": 1605.146
      }
    },
    {
      "edge": "M347",
      "attrs": {
        "text": "I want to get your census off on the right foot.",
        "start_hhmmss": "00:26:46",
        "end_hhmmss": "00:26:49",
        "start": 1605.646,
        "end": 1608.857
      }
    },
    {
      "edge": "M348",
      "attrs": {
        "text": "Pleasant journey, inspector.",
        "start_hhmmss": "00:26:50",
        "end_hhmmss": "00:26:52",
        "start": 1609.567,
        "end": 1612.362
      }
    },
    {
      "edge": "M349",
      "attrs": {
        "text": "Move on. Have your papers ready. It's Paris. We don't waste time.",
        "start_hhmmss": "00:27:04",
        "end_hhmmss": "00:27:08",
        "start": 1624.415,
        "end": 1627.793
      }
    },
    {
      "edge": "M350",
      "attrs": {
        "text": "Inspector Javert. Let me through.",
        "start_hhmmss": "00:27:08",
        "end_hhmmss": "00:27:11",
        "start": 1628.001,
        "end": 1630.5267272727272
      }
    },
    {
      "edge": "M351",
      "attrs": {
        "text": "Papers!",
        "start_hhmmss": "00:27:11",
        "end_hhmmss": "00:27:11",
        "start": 1630.5267272727272,
        "end": 1631.088
      }
    },
    {
      "edge": "M352",
      "attrs": {
        "text": "Inspector Javert, the prefect was impressed by your proposal.",
        "start_hhmmss": "00:27:23",
        "end_hhmmss": "00:27:28",
        "start": 1642.517,
        "end": 1647.605
      }
    },
    {
      "edge": "M353",
      "attrs": {
        "text": "I expect him to approve a budget for your census within the month.",
        "start_hhmmss": "00:27:28",
        "end_hhmmss": "00:27:32",
        "start": 1647.813,
        "end": 1651.65
      }
    },
    {
      "edge": "M354",
      "attrs": {
        "text": "Thank you, sir. That's excellent news.",
        "start_hhmmss": "00:27:32",
        "end_hhmmss": "00:27:34",
        "start": 1651.859,
        "end": 1654.404
      }
    },
    {
      "edge": "M355",
      "attrs": {
        "text": "You are known in Paris now, Javert. Your future is bright.",
        "start_hhmmss": "00:27:35",
        "end_hhmmss": "00:27:39",
        "start": 1654.612,
        "end": 1659.45
      }
    },
    {
      "edge": "M356",
      "attrs": {
        "text": "So I suggest you drop this request...",
        "start_hhmmss": "00:27:40",
        "end_hhmmss": "00:27:43",
        "start": 1659.658,
        "end": 1662.87
      }
    },
    {
      "edge": "M357",
      "attrs": {
        "text": "...for an investigation of the mayor.",
        "start_hhmmss": "00:27:43",
        "end_hhmmss": "00:27:46",
        "start": 1663.078,
        "end": 1665.623
      }
    },
    {
      "edge": "M358",
      "attrs": {
        "text": "Sir, I was a guard for a year in the quarries of Toulon.",
        "start_hhmmss": "00:27:46",
        "end_hhmmss": "00:27:50",
        "start": 1665.831,
        "end": 1670.295
      }
    },
    {
      "edge": "M359",
      "attrs": {
        "text": "I saw Jean Valjean perform the same feat of strength...",
        "start_hhmmss": "00:27:51",
        "end_hhmmss": "00:27:53",
        "start": 1670.503,
        "end": 1673.339
      }
    },
    {
      "edge": "M360",
      "attrs": {
        "text": "...as the mayor did with the cart.",
        "start_hhmmss": "00:27:54",
        "end_hhmmss": "00:27:55",
        "start": 1673.548,
        "end": 1675.341
      }
    },
    {
      "edge": "M361",
      "attrs": {
        "text": "The hard labor makes them incredibly strong.",
        "start_hhmmss": "00:27:56",
        "end_hhmmss": "00:27:59",
        "start": 1675.55,
        "end": 1678.553
      }
    },
    {
      "edge": "M362",
      "attrs": {
        "text": "Once the connection was made in my mind, no longer dazzled by his wealth...",
        "start_hhmmss": "00:27:59",
        "end_hhmmss": "00:28:03",
        "start": 1678.76,
        "end": 1683.015
      }
    },
    {
      "edge": "M363",
      "attrs": {
        "text": "...I've grown more certain every day.",
        "start_hhmmss": "00:28:04",
        "end_hhmmss": "00:28:06",
        "start": 1684.057,
        "end": 1686.018
      }
    },
    {
      "edge": "M364",
      "attrs": {
        "text": "Indeed, now I recognize his face and voice so clearly, I'm amazed...",
        "start_hhmmss": "00:28:06",
        "end_hhmmss": "00:28:10",
        "start": 1686.227,
        "end": 1690.105
      }
    },
    {
      "edge": "M365",
      "attrs": {
        "text": "...I didn't know him right away.",
        "start_hhmmss": "00:28:10",
        "end_hhmmss": "00:28:12",
        "start": 1690.315,
        "end": 1692.0921875
      }
    },
    {
      "edge": "M366",
      "attrs": {
        "text": "I don't doubt--",
        "start_hhmmss": "00:28:12",
        "end_hhmmss": "00:28:13",
        "start": 1692.0921875,
        "end": 1692.9
      }
    },
    {
      "edge": "M367",
      "attrs": {
        "text": "Sir.",
        "start_hhmmss": "00:28:13",
        "end_hhmmss": "00:28:14",
        "start": 1693.108,
        "end": 1694.485
      }
    },
    {
      "edge": "M368",
      "attrs": {
        "text": "I'm prepared to denounce him.",
        "start_hhmmss": "00:28:15",
        "end_hhmmss": "00:28:18",
        "start": 1695.361,
        "end": 1697.957294117647
      }
    },
    {
      "edge": "M369",
      "attrs": {
        "text": "Denounce him?",
        "start_hhmmss": "00:28:18",
        "end_hhmmss": "00:28:19",
        "start": 1697.957294117647,
        "end": 1699.199
      }
    },
    {
      "edge": "M370",
      "attrs": {
        "text": "Without proof?",
        "start_hhmmss": "00:28:19",
        "end_hhmmss": "00:28:22",
        "start": 1699.407,
        "end": 1701.867
      }
    },
    {
      "edge": "M371",
      "attrs": {
        "text": "If I force a trial, the evidence will be found.",
        "start_hhmmss": "00:28:23",
        "end_hhmmss": "00:28:28",
        "start": 1703.328,
        "end": 1707.873
      }
    },
    {
      "edge": "M372",
      "attrs": {
        "text": "He showed you papers and they were in order.",
        "start_hhmmss": "00:28:28",
        "end_hhmmss": "00:28:31",
        "start": 1708.081,
        "end": 1710.585
      }
    },
    {
      "edge": "M373",
      "attrs": {
        "text": "I checked the baptism certificate.",
        "start_hhmmss": "00:28:31",
        "end_hhmmss": "00:28:33",
        "start": 1710.792,
        "end": 1712.836
      }
    },
    {
      "edge": "M374",
      "attrs": {
        "text": "It's a copy. Eleven years ago, there was a fire at the parish.",
        "start_hhmmss": "00:28:33",
        "end_hhmmss": "00:28:38",
        "start": 1713.045,
        "end": 1717.55
      }
    },
    {
      "edge": "M375",
      "attrs": {
        "text": "The authentic records were destroyed. His documents are based on that copy.",
        "start_hhmmss": "00:28:38",
        "end_hhmmss": "00:28:42",
        "start": 1717.758,
        "end": 1721.762
      }
    },
    {
      "edge": "M376",
      "attrs": {
        "text": "Your identification alone is not enough to subject the mayor of Vigau to a trial.",
        "start_hhmmss": "00:28:42",
        "end_hhmmss": "00:28:47",
        "start": 1721.97,
        "end": 1727.435
      }
    },
    {
      "edge": "M377",
      "attrs": {
        "text": "File a report and I'll recommend we investigate.",
        "start_hhmmss": "00:28:48",
        "end_hhmmss": "00:28:51",
        "start": 1727.644,
        "end": 1731.146
      }
    },
    {
      "edge": "M378",
      "attrs": {
        "text": "Sir, Jean Valjean is a thief. It makes a mockery of our institutions...",
        "start_hhmmss": "00:28:51",
        "end_hhmmss": "00:28:56",
        "start": 1731.356,
        "end": 1735.984
      }
    },
    {
      "edge": "M379",
      "attrs": {
        "text": "...to have a corrupt and depraved man in charge--",
        "start_hhmmss": "00:28:56",
        "end_hhmmss": "00:28:59",
        "start": 1736.193,
        "end": 1738.779
      }
    },
    {
      "edge": "M380",
      "attrs": {
        "text": "Javert. I said file a report.",
        "start_hhmmss": "00:28:59",
        "end_hhmmss": "00:29:02",
        "start": 1738.987,
        "end": 1742.115
      }
    },
    {
      "edge": "M381",
      "attrs": {
        "text": "I'll investigate on this end, discreetly.",
        "start_hhmmss": "00:29:03",
        "end_hhmmss": "00:29:06",
        "start": 1743.075,
        "end": 1746.371
      }
    },
    {
      "edge": "M382",
      "attrs": {
        "text": "But do not denounce him without proof.",
        "start_hhmmss": "00:29:07",
        "end_hhmmss": "00:29:10",
        "start": 1746.704,
        "end": 1749.582
      }
    },
    {
      "edge": "M383",
      "attrs": {
        "text": "Be patient.",
        "start_hhmmss": "00:29:10",
        "end_hhmmss": "00:29:12",
        "start": 1749.79,
        "end": 1752.209
      }
    },
    {
      "edge": "M384",
      "attrs": {
        "text": "He's not going anywhere. Is he?",
        "start_hhmmss": "00:29:12",
        "end_hhmmss": "00:29:15",
        "start": 1752.418,
        "end": 1754.545
      }
    },
    {
      "edge": "M385",
      "attrs": {
        "text": "\"Madame, the 10 francs a month we agreed on is no longer enough.",
        "start_hhmmss": "00:29:33",
        "end_hhmmss": "00:29:37",
        "start": 1772.98,
        "end": 1777.402
      }
    },
    {
      "edge": "M386",
      "attrs": {
        "text": "Cosette grows bigger by the minute.",
        "start_hhmmss": "00:29:38",
        "end_hhmmss": "00:29:40",
        "start": 1777.61,
        "end": 1780.153
      }
    },
    {
      "edge": "M387",
      "attrs": {
        "text": "She enjoyed her sixth birthday party and the new doll we bought her.",
        "start_hhmmss": "00:29:40",
        "end_hhmmss": "00:29:44",
        "start": 1780.363,
        "end": 1783.907
      }
    },
    {
      "edge": "M388",
      "attrs": {
        "text": "We love her so we won't charge for her present...",
        "start_hhmmss": "00:29:44",
        "end_hhmmss": "00:29:47",
        "start": 1784.116,
        "end": 1786.785
      }
    },
    {
      "edge": "M389",
      "attrs": {
        "text": "...but she needs a new coat and shoes. We can't afford to pay for them.",
        "start_hhmmss": "00:29:47",
        "end_hhmmss": "00:29:51",
        "start": 1786.994,
        "end": 1790.789
      }
    },
    {
      "edge": "M390",
      "attrs": {
        "text": "And she eats more than both our daughters put together.",
        "start_hhmmss": "00:29:51",
        "end_hhmmss": "00:29:54",
        "start": 1790.998,
        "end": 1793.875
      }
    },
    {
      "edge": "M391",
      "attrs": {
        "text": "Beginning right away, you must send 20 francs a month...",
        "start_hhmmss": "00:29:54",
        "end_hhmmss": "00:29:57",
        "start": 1794.084,
        "end": 1797.38
      }
    },
    {
      "edge": "M392",
      "attrs": {
        "text": "...or come and fetch her.",
        "start_hhmmss": "00:29:58",
        "end_hhmmss": "00:29:59",
        "start": 1797.588,
        "end": 1799.299
      }
    },
    {
      "edge": "M393",
      "attrs": {
        "text": "Sincerely, Thénardier.\"",
        "start_hhmmss": "00:30:00",
        "end_hhmmss": "00:30:02",
        "start": 1799.59,
        "end": 1802.468
      }
    },
    {
      "edge": "M394",
      "attrs": {
        "text": "So, what's your answer?",
        "start_hhmmss": "00:30:10",
        "end_hhmmss": "00:30:12",
        "start": 1810.31,
        "end": 1812.3277692307693
      }
    },
    {
      "edge": "M395",
      "attrs": {
        "text": "I can't move.",
        "start_hhmmss": "00:30:12",
        "end_hhmmss": "00:30:13",
        "start": 1812.3277692307693,
        "end": 1813.396
      }
    },
    {
      "edge": "M396",
      "attrs": {
        "text": "I don't have money to pay in advance for a room.",
        "start_hhmmss": "00:30:14",
        "end_hhmmss": "00:30:16",
        "start": 1813.604,
        "end": 1816.316
      }
    },
    {
      "edge": "M397",
      "attrs": {
        "text": "Am I a charity? You haven't paid me in four months.",
        "start_hhmmss": "00:30:17",
        "end_hhmmss": "00:30:21",
        "start": 1816.524,
        "end": 1820.653
      }
    },
    {
      "edge": "M398",
      "attrs": {
        "text": "I paid you.",
        "start_hhmmss": "00:30:21",
        "end_hhmmss": "00:30:21",
        "start": 1820.861,
        "end": 1821.4968095238096
      }
    },
    {
      "edge": "M399",
      "attrs": {
        "text": "I have bills too...",
        "start_hhmmss": "00:30:21",
        "end_hhmmss": "00:30:23",
        "start": 1821.4968095238096,
        "end": 1822.53
      }
    },
    {
      "edge": "M400",
      "attrs": {
        "text": "...and I can't spread my legs. It's not good business to rent to a whore.",
        "start_hhmmss": "00:30:23",
        "end_hhmmss": "00:30:27",
        "start": 1822.739,
        "end": 1827.117
      }
    },
    {
      "edge": "M401",
      "attrs": {
        "text": "What about your necklace? That's worth something.",
        "start_hhmmss": "00:30:27",
        "end_hhmmss": "00:30:30",
        "start": 1827.327,
        "end": 1829.87
      }
    },
    {
      "edge": "M402",
      "attrs": {
        "text": "No, not this.",
        "start_hhmmss": "00:30:30",
        "end_hhmmss": "00:30:31",
        "start": 1830.078,
        "end": 1831.331
      }
    },
    {
      "edge": "M403",
      "attrs": {
        "text": "It's for my daughter.",
        "start_hhmmss": "00:30:32",
        "end_hhmmss": "00:30:33",
        "start": 1831.539,
        "end": 1832.721909090909
      }
    },
    {
      "edge": "M404",
      "attrs": {
        "text": "You better come up with something.",
        "start_hhmmss": "00:30:33",
        "end_hhmmss": "00:30:35",
        "start": 1832.721909090909,
        "end": 1834.792
      }
    },
    {
      "edge": "M405",
      "attrs": {
        "text": "I want 10 francs or you're out.",
        "start_hhmmss": "00:30:35",
        "end_hhmmss": "00:30:37",
        "start": 1835.0,
        "end": 1836.877
      }
    },
    {
      "edge": "M406",
      "attrs": {
        "text": "No.",
        "start_hhmmss": "00:30:44",
        "end_hhmmss": "00:30:45",
        "start": 1843.718,
        "end": 1845.386
      }
    },
    {
      "edge": "M407",
      "attrs": {
        "text": "This time I want cash.",
        "start_hhmmss": "00:30:47",
        "end_hhmmss": "00:30:50",
        "start": 1846.845,
        "end": 1849.766
      }
    },
    {
      "edge": "M408",
      "attrs": {
        "text": "Good evening, monsieur.",
        "start_hhmmss": "00:30:53",
        "end_hhmmss": "00:30:55",
        "start": 1852.976,
        "end": 1854.978
      }
    },
    {
      "edge": "M409",
      "attrs": {
        "text": "My God, you're hideous. Well, how much?",
        "start_hhmmss": "00:30:56",
        "end_hhmmss": "00:31:00",
        "start": 1855.979,
        "end": 1860.275
      }
    },
    {
      "edge": "M410",
      "attrs": {
        "text": "A franc.",
        "start_hhmmss": "00:31:00",
        "end_hhmmss": "00:31:02",
        "start": 1860.485,
        "end": 1861.527
      }
    },
    {
      "edge": "M411",
      "attrs": {
        "text": "You're joking.",
        "start_hhmmss": "00:31:02",
        "end_hhmmss": "00:31:03",
        "start": 1861.736,
        "end": 1862.6996
      }
    },
    {
      "edge": "M412",
      "attrs": {
        "text": "Fifty sous.",
        "start_hhmmss": "00:31:03",
        "end_hhmmss": "00:31:03",
        "start": 1862.6996,
        "end": 1863.488
      }
    },
    {
      "edge": "M413",
      "attrs": {
        "text": "Fifty sous? Fifty sous? To screw a corpse?",
        "start_hhmmss": "00:31:04",
        "end_hhmmss": "00:31:09",
        "start": 1863.696,
        "end": 1868.992
      }
    },
    {
      "edge": "M414",
      "attrs": {
        "text": "Hasn't got a drop of blood in her veins!",
        "start_hhmmss": "00:31:10",
        "end_hhmmss": "00:31:12",
        "start": 1869.702,
        "end": 1872.227
      }
    },
    {
      "edge": "M415",
      "attrs": {
        "text": "Mademoiselle. Mademoiselle.",
        "start_hhmmss": "00:31:12",
        "end_hhmmss": "00:31:14",
        "start": 1872.227,
        "end": 1874.247
      }
    },
    {
      "edge": "M416",
      "attrs": {
        "text": "How about a sou?",
        "start_hhmmss": "00:31:14",
        "end_hhmmss": "00:31:16",
        "start": 1874.457,
        "end": 1875.875
      }
    },
    {
      "edge": "M417",
      "attrs": {
        "text": "Stop it!",
        "start_hhmmss": "00:31:16",
        "end_hhmmss": "00:31:17",
        "start": 1875.875,
        "end": 1876.584
      }
    },
    {
      "edge": "M418",
      "attrs": {
        "text": "I have a sou. I have a sou to spend on you.",
        "start_hhmmss": "00:31:17",
        "end_hhmmss": "00:31:20",
        "start": 1876.793,
        "end": 1880.463
      }
    },
    {
      "edge": "M419",
      "attrs": {
        "text": "But first, let's give your tits a bit of color!",
        "start_hhmmss": "00:31:23",
        "end_hhmmss": "00:31:27",
        "start": 1882.673,
        "end": 1886.885
      }
    },
    {
      "edge": "M420",
      "attrs": {
        "text": "Something to drink!",
        "start_hhmmss": "00:31:29",
        "end_hhmmss": "00:31:33",
        "start": 1889.054,
        "end": 1892.683
      }
    },
    {
      "edge": "M421",
      "attrs": {
        "text": "Something to drink!",
        "start_hhmmss": "00:31:34",
        "end_hhmmss": "00:31:37",
        "start": 1893.684,
        "end": 1896.937
      }
    },
    {
      "edge": "M422",
      "attrs": {
        "text": "Down you go, tart.",
        "start_hhmmss": "00:31:42",
        "end_hhmmss": "00:31:43",
        "start": 1901.526,
        "end": 1903.068
      }
    },
    {
      "edge": "M423",
      "attrs": {
        "text": "She's attacking him.",
        "start_hhmmss": "00:31:46",
        "end_hhmmss": "00:31:48",
        "start": 1905.613,
        "end": 1907.906
      }
    },
    {
      "edge": "M424",
      "attrs": {
        "text": "Sir, this is a disturbance. May I?",
        "start_hhmmss": "00:31:49",
        "end_hhmmss": "00:31:53",
        "start": 1909.074,
        "end": 1912.62
      }
    },
    {
      "edge": "M425",
      "attrs": {
        "text": "I'll take care of this.",
        "start_hhmmss": "00:31:53",
        "end_hhmmss": "00:31:55",
        "start": 1912.829,
        "end": 1915.205
      }
    },
    {
      "edge": "M426",
      "attrs": {
        "text": "That's enough!",
        "start_hhmmss": "00:32:00",
        "end_hhmmss": "00:32:02",
        "start": 1919.544,
        "end": 1921.587
      }
    },
    {
      "edge": "M427",
      "attrs": {
        "text": "It's not my fault. They started it--",
        "start_hhmmss": "00:32:02",
        "end_hhmmss": "00:32:05",
        "start": 1921.796,
        "end": 1924.59
      }
    },
    {
      "edge": "M428",
      "attrs": {
        "text": "Go home! And be quick about it.",
        "start_hhmmss": "00:32:07",
        "end_hhmmss": "00:32:09",
        "start": 1927.008,
        "end": 1929.3112857142853
      }
    },
    {
      "edge": "M429",
      "attrs": {
        "text": "Come on, let's go.",
        "start_hhmmss": "00:32:09",
        "end_hhmmss": "00:32:11",
        "start": 1929.3112857142853,
        "end": 1930.513
      }
    },
    {
      "edge": "M430",
      "attrs": {
        "text": "Captain.",
        "start_hhmmss": "00:32:40",
        "end_hhmmss": "00:32:41",
        "start": 1960.208,
        "end": 1960.7359615384617
      }
    },
    {
      "edge": "M431",
      "attrs": {
        "text": "You asked me to tell you...",
        "start_hhmmss": "00:32:41",
        "end_hhmmss": "00:32:42",
        "start": 1960.7359615384617,
        "end": 1962.169
      }
    },
    {
      "edge": "M432",
      "attrs": {
        "text": "...if he went too far. Well, I've kept my mouth shut long enough.",
        "start_hhmmss": "00:32:42",
        "end_hhmmss": "00:32:47",
        "start": 1962.377,
        "end": 1967.09
      }
    },
    {
      "edge": "M433",
      "attrs": {
        "text": "Have her taken to the prison.",
        "start_hhmmss": "00:32:50",
        "end_hhmmss": "00:32:52",
        "start": 1970.26,
        "end": 1971.9
      }
    },
    {
      "edge": "M434",
      "attrs": {
        "text": "You get six months.",
        "start_hhmmss": "00:32:52",
        "end_hhmmss": "00:32:53",
        "start": 1971.9,
        "end": 1972.971
      }
    },
    {
      "edge": "M435",
      "attrs": {
        "text": "Six months? What about Cosette? What'll happen to her?",
        "start_hhmmss": "00:32:53",
        "end_hhmmss": "00:32:58",
        "start": 1973.18,
        "end": 1977.685
      }
    },
    {
      "edge": "M436",
      "attrs": {
        "text": "Who is Cosette?",
        "start_hhmmss": "00:32:58",
        "end_hhmmss": "00:32:59",
        "start": 1977.894,
        "end": 1978.936
      }
    },
    {
      "edge": "M437",
      "attrs": {
        "text": "My daughter. If I don't send them money, they'll turn her out!",
        "start_hhmmss": "00:32:59",
        "end_hhmmss": "00:33:03",
        "start": 1979.144,
        "end": 1983.483
      }
    },
    {
      "edge": "M438",
      "attrs": {
        "text": "Is your daughter here in Vigau?",
        "start_hhmmss": "00:33:04",
        "end_hhmmss": "00:33:05",
        "start": 1983.691,
        "end": 1985.358
      }
    },
    {
      "edge": "M439",
      "attrs": {
        "text": "No, sir, she lives with--",
        "start_hhmmss": "00:33:06",
        "end_hhmmss": "00:33:07",
        "start": 1985.568,
        "end": 1987.120054054054
      }
    },
    {
      "edge": "M440",
      "attrs": {
        "text": "Then she's not my concern.",
        "start_hhmmss": "00:33:07",
        "end_hhmmss": "00:33:09",
        "start": 1987.120054054054,
        "end": 1988.946
      }
    },
    {
      "edge": "M441",
      "attrs": {
        "text": "Inspector. Inspector. Inspector, please listen to my side.",
        "start_hhmmss": "00:33:10",
        "end_hhmmss": "00:33:14",
        "start": 1989.78,
        "end": 1994.034
      }
    },
    {
      "edge": "M442",
      "attrs": {
        "text": "I know I hit the gentleman. I know I was wrong.",
        "start_hhmmss": "00:33:15",
        "end_hhmmss": "00:33:18",
        "start": 1994.619,
        "end": 1997.955
      }
    },
    {
      "edge": "M443",
      "attrs": {
        "text": "But do they have the right to put snow down my dress...",
        "start_hhmmss": "00:33:18",
        "end_hhmmss": "00:33:21",
        "start": 1998.163,
        "end": 2000.999
      }
    },
    {
      "edge": "M444",
      "attrs": {
        "text": "...especially when it's the only one I have and I need it for work?",
        "start_hhmmss": "00:33:21",
        "end_hhmmss": "00:33:25",
        "start": 2001.208,
        "end": 2005.003
      }
    },
    {
      "edge": "M445",
      "attrs": {
        "text": "I'm sorry. I don't mean to argue.",
        "start_hhmmss": "00:33:26",
        "end_hhmmss": "00:33:28",
        "start": 2005.922,
        "end": 2008.423
      }
    },
    {
      "edge": "M446",
      "attrs": {
        "text": "It won't happen again.",
        "start_hhmmss": "00:33:30",
        "end_hhmmss": "00:33:32",
        "start": 2010.05,
        "end": 2011.886
      }
    },
    {
      "edge": "M447",
      "attrs": {
        "text": "Inspector, please. Please be merciful.",
        "start_hhmmss": "00:33:32",
        "end_hhmmss": "00:33:37",
        "start": 2012.177,
        "end": 2016.641
      }
    },
    {
      "edge": "M448",
      "attrs": {
        "text": "All right, I've listened to your side. You're still getting six months.",
        "start_hhmmss": "00:33:37",
        "end_hhmmss": "00:33:41",
        "start": 2016.849,
        "end": 2021.102
      }
    },
    {
      "edge": "M449",
      "attrs": {
        "text": "Not even eternal fire will change that.",
        "start_hhmmss": "00:33:42",
        "end_hhmmss": "00:33:44",
        "start": 2021.562,
        "end": 2023.9908
      }
    },
    {
      "edge": "M450",
      "attrs": {
        "text": "One moment, inspector.",
        "start_hhmmss": "00:33:44",
        "end_hhmmss": "00:33:45",
        "start": 2023.9908,
        "end": 2025.357
      }
    },
    {
      "edge": "M451",
      "attrs": {
        "text": "It was you. You did this to me. You fired me.",
        "start_hhmmss": "00:33:47",
        "end_hhmmss": "00:33:52",
        "start": 2027.234,
        "end": 2031.697
      }
    },
    {
      "edge": "M452",
      "attrs": {
        "text": "You slut! Come here.",
        "start_hhmmss": "00:33:52",
        "end_hhmmss": "00:33:53",
        "start": 2031.906,
        "end": 2033.061
      }
    },
    {
      "edge": "M453",
      "attrs": {
        "text": "Get over here.",
        "start_hhmmss": "00:33:53",
        "end_hhmmss": "00:33:54",
        "start": 2033.061,
        "end": 2033.908
      }
    },
    {
      "edge": "M454",
      "attrs": {
        "text": "Let her go.",
        "start_hhmmss": "00:33:55",
        "end_hhmmss": "00:33:56",
        "start": 2034.659,
        "end": 2036.368
      }
    },
    {
      "edge": "M455",
      "attrs": {
        "text": "What?",
        "start_hhmmss": "00:33:57",
        "end_hhmmss": "00:33:57",
        "start": 2036.577,
        "end": 2037.38452
      }
    },
    {
      "edge": "M456",
      "attrs": {
        "text": "Let me explain, inspector.",
        "start_hhmmss": "00:33:57",
        "end_hhmmss": "00:34:02",
        "start": 2037.38452,
        "end": 2041.624
      }
    },
    {
      "edge": "M457",
      "attrs": {
        "text": "I was crossing the square when you arrested her.",
        "start_hhmmss": "00:34:02",
        "end_hhmmss": "00:34:04",
        "start": 2041.832,
        "end": 2044.334
      }
    },
    {
      "edge": "M458",
      "attrs": {
        "text": "People said it was the fault of the men who attacked her.",
        "start_hhmmss": "00:34:05",
        "end_hhmmss": "00:34:08",
        "start": 2044.544,
        "end": 2047.797
      }
    },
    {
      "edge": "M459",
      "attrs": {
        "text": "In fact, they should be under arrest.",
        "start_hhmmss": "00:34:08",
        "end_hhmmss": "00:34:11",
        "start": 2048.005,
        "end": 2050.8
      }
    },
    {
      "edge": "M460",
      "attrs": {
        "text": "Now that you've heard this, I want you to release her.",
        "start_hhmmss": "00:34:11",
        "end_hhmmss": "00:34:14",
        "start": 2051.008,
        "end": 2053.678
      }
    },
    {
      "edge": "M461",
      "attrs": {
        "text": "He said I can go. He is the mayor, isn't he?",
        "start_hhmmss": "00:34:14",
        "end_hhmmss": "00:34:18",
        "start": 2053.886,
        "end": 2057.848
      }
    },
    {
      "edge": "M462",
      "attrs": {
        "text": "Well, I'll be going, then. I won't be any bother to anyone.",
        "start_hhmmss": "00:34:20",
        "end_hhmmss": "00:34:24",
        "start": 2059.725,
        "end": 2063.688
      }
    },
    {
      "edge": "M463",
      "attrs": {
        "text": "Sergeant, who said she could go?",
        "start_hhmmss": "00:34:24",
        "end_hhmmss": "00:34:26",
        "start": 2063.896,
        "end": 2066.160655172414
      }
    },
    {
      "edge": "M464",
      "attrs": {
        "text": "I did.",
        "start_hhmmss": "00:34:26",
        "end_hhmmss": "00:34:27",
        "start": 2066.160655172414,
        "end": 2066.523
      }
    },
    {
      "edge": "M465",
      "attrs": {
        "text": "I am the final judicial authority here in Vigau, and I say she's innocent.",
        "start_hhmmss": "00:34:27",
        "end_hhmmss": "00:34:32",
        "start": 2066.732,
        "end": 2071.696
      }
    },
    {
      "edge": "M466",
      "attrs": {
        "text": "She spat on you.",
        "start_hhmmss": "00:34:33",
        "end_hhmmss": "00:34:34",
        "start": 2072.822,
        "end": 2073.909826086957
      }
    },
    {
      "edge": "M467",
      "attrs": {
        "text": "She was upset.",
        "start_hhmmss": "00:34:34",
        "end_hhmmss": "00:34:35",
        "start": 2073.909826086957,
        "end": 2074.907
      }
    },
    {
      "edge": "M468",
      "attrs": {
        "text": "She insulted you. In front of my men, she defiled you.",
        "start_hhmmss": "00:34:35",
        "end_hhmmss": "00:34:38",
        "start": 2075.115,
        "end": 2077.952
      }
    },
    {
      "edge": "M469",
      "attrs": {
        "text": "That's my concern, inspector.",
        "start_hhmmss": "00:34:38",
        "end_hhmmss": "00:34:40",
        "start": 2078.159,
        "end": 2079.8326923076925
      }
    },
    {
      "edge": "M470",
      "attrs": {
        "text": "No, sir, you are wrong.",
        "start_hhmmss": "00:34:40",
        "end_hhmmss": "00:34:41",
        "start": 2079.8326923076925,
        "end": 2080.997
      }
    },
    {
      "edge": "M471",
      "attrs": {
        "text": "You personify order, morality, government. The whole of society.",
        "start_hhmmss": "00:34:41",
        "end_hhmmss": "00:34:46",
        "start": 2081.204,
        "end": 2086.293
      }
    },
    {
      "edge": "M472",
      "attrs": {
        "text": "You don't have the right to forgive. You haven't the authority to destroy justice.",
        "start_hhmmss": "00:34:47",
        "end_hhmmss": "00:34:51",
        "start": 2086.501,
        "end": 2091.007
      }
    },
    {
      "edge": "M473",
      "attrs": {
        "text": "I do have the authority. Under Articles 9 and 11, I can order her release.",
        "start_hhmmss": "00:34:51",
        "end_hhmmss": "00:34:56",
        "start": 2091.214,
        "end": 2095.97
      }
    },
    {
      "edge": "M474",
      "attrs": {
        "text": "Sergeant, she is free to go.",
        "start_hhmmss": "00:34:56",
        "end_hhmmss": "00:34:59",
        "start": 2096.177,
        "end": 2098.555
      }
    },
    {
      "edge": "M475",
      "attrs": {
        "text": "I cannot allow that, monsieur. I was there. She attacked a man.",
        "start_hhmmss": "00:34:59",
        "end_hhmmss": "00:35:02",
        "start": 2098.764,
        "end": 2102.142
      }
    },
    {
      "edge": "M476",
      "attrs": {
        "text": "The decision is mine. She's free.",
        "start_hhmmss": "00:35:02",
        "end_hhmmss": "00:35:04",
        "start": 2102.35,
        "end": 2104.185
      }
    },
    {
      "edge": "M477",
      "attrs": {
        "text": "She won't go free while I am in charge.",
        "start_hhmmss": "00:35:04",
        "end_hhmmss": "00:35:07",
        "start": 2104.394,
        "end": 2106.627
      }
    },
    {
      "edge": "M478",
      "attrs": {
        "text": "In that case...",
        "start_hhmmss": "00:35:07",
        "end_hhmmss": "00:35:07",
        "start": 2106.627,
        "end": 2107.397
      }
    },
    {
      "edge": "M479",
      "attrs": {
        "text": "...under Article 66, you are relieved of command until tomorrow.",
        "start_hhmmss": "00:35:08",
        "end_hhmmss": "00:35:11",
        "start": 2107.607,
        "end": 2110.985
      }
    },
    {
      "edge": "M480",
      "attrs": {
        "text": "You are dismissed, inspector. Leave! Now!",
        "start_hhmmss": "00:35:11",
        "end_hhmmss": "00:35:17",
        "start": 2111.192,
        "end": 2116.531
      }
    },
    {
      "edge": "M481",
      "attrs": {
        "text": "You're free to go.",
        "start_hhmmss": "00:35:29",
        "end_hhmmss": "00:35:31",
        "start": 2129.461,
        "end": 2130.796
      }
    },
    {
      "edge": "M482",
      "attrs": {
        "text": "Water.",
        "start_hhmmss": "00:35:35",
        "end_hhmmss": "00:35:37",
        "start": 2135.009,
        "end": 2136.802
      }
    },
    {
      "edge": "M483",
      "attrs": {
        "text": "Water!",
        "start_hhmmss": "00:35:37",
        "end_hhmmss": "00:35:39",
        "start": 2137.302,
        "end": 2139.22
      }
    },
    {
      "edge": "M484",
      "attrs": {
        "text": "I doubt she'll survive. She talks continually about Cosette.",
        "start_hhmmss": "00:35:51",
        "end_hhmmss": "00:35:54",
        "start": 2150.607,
        "end": 2154.07
      }
    },
    {
      "edge": "M485",
      "attrs": {
        "text": "Who's that?",
        "start_hhmmss": "00:35:54",
        "end_hhmmss": "00:35:55",
        "start": 2154.277,
        "end": 2154.857210526316
      }
    },
    {
      "edge": "M486",
      "attrs": {
        "text": "Her daughter.",
        "start_hhmmss": "00:35:55",
        "end_hhmmss": "00:35:56",
        "start": 2154.857210526316,
        "end": 2155.655
      }
    },
    {
      "edge": "M487",
      "attrs": {
        "text": "She needs all the will to fight the infection.",
        "start_hhmmss": "00:35:56",
        "end_hhmmss": "00:35:59",
        "start": 2155.863,
        "end": 2158.615
      }
    },
    {
      "edge": "M488",
      "attrs": {
        "text": "Perhaps if the girl were here....",
        "start_hhmmss": "00:35:59",
        "end_hhmmss": "00:36:01",
        "start": 2158.824,
        "end": 2161.284
      }
    },
    {
      "edge": "M489",
      "attrs": {
        "text": "I understand. Thank you, doctor.",
        "start_hhmmss": "00:36:01",
        "end_hhmmss": "00:36:04",
        "start": 2161.493,
        "end": 2163.604875
      }
    },
    {
      "edge": "M490",
      "attrs": {
        "text": "You'll need nurses.",
        "start_hhmmss": "00:36:04",
        "end_hhmmss": "00:36:05",
        "start": 2163.604875,
        "end": 2164.872
      }
    },
    {
      "edge": "M491",
      "attrs": {
        "text": "I can't arrange for them till morning. What about tonight?",
        "start_hhmmss": "00:36:05",
        "end_hhmmss": "00:36:08",
        "start": 2165.081,
        "end": 2168.5
      }
    },
    {
      "edge": "M492",
      "attrs": {
        "text": "I'll take care of her tonight.",
        "start_hhmmss": "00:36:10",
        "end_hhmmss": "00:36:12",
        "start": 2169.96,
        "end": 2172.462
      }
    },
    {
      "edge": "M493",
      "attrs": {
        "text": "Keep her body warm and her head cool. Good night.",
        "start_hhmmss": "00:36:13",
        "end_hhmmss": "00:36:17",
        "start": 2173.047,
        "end": 2176.926
      }
    },
    {
      "edge": "M494",
      "attrs": {
        "text": "Why did the gossip bother you? You didn't have to fire me.",
        "start_hhmmss": "00:36:52",
        "end_hhmmss": "00:36:56",
        "start": 2211.584,
        "end": 2216.132
      }
    },
    {
      "edge": "M495",
      "attrs": {
        "text": "Your clothes are damp. We have to get you some dry--",
        "start_hhmmss": "00:36:56",
        "end_hhmmss": "00:37:01",
        "start": 2216.339,
        "end": 2220.97
      }
    },
    {
      "edge": "M496",
      "attrs": {
        "text": "It's all right. There'll be no charge. You deserve it.",
        "start_hhmmss": "00:37:01",
        "end_hhmmss": "00:37:07",
        "start": 2221.178,
        "end": 2226.809
      }
    },
    {
      "edge": "M497",
      "attrs": {
        "text": "But I don't understand why you're being so kind.",
        "start_hhmmss": "00:37:15",
        "end_hhmmss": "00:37:18",
        "start": 2234.607,
        "end": 2238.028
      }
    },
    {
      "edge": "M498",
      "attrs": {
        "text": "I was preoccupied. I didn't know.",
        "start_hhmmss": "00:37:18",
        "end_hhmmss": "00:37:23",
        "start": 2238.236,
        "end": 2242.615
      }
    },
    {
      "edge": "M499",
      "attrs": {
        "text": "If you had come straight to me, none of this....",
        "start_hhmmss": "00:37:25",
        "end_hhmmss": "00:37:28",
        "start": 2244.869,
        "end": 2248.329
      }
    },
    {
      "edge": "M500",
      "attrs": {
        "text": "You need to rest.",
        "start_hhmmss": "00:37:31",
        "end_hhmmss": "00:37:34",
        "start": 2251.374,
        "end": 2253.501
      }
    },
    {
      "edge": "M501",
      "attrs": {
        "text": "You don't want a kiss?",
        "start_hhmmss": "00:37:35",
        "end_hhmmss": "00:37:37",
        "start": 2255.171,
        "end": 2257.150733333333
      }
    },
    {
      "edge": "M502",
      "attrs": {
        "text": "I want you to rest.",
        "start_hhmmss": "00:37:37",
        "end_hhmmss": "00:37:39",
        "start": 2257.150733333333,
        "end": 2258.883
      }
    },
    {
      "edge": "M503",
      "attrs": {
        "text": "And don't worry. I'll bring your daughter to you.",
        "start_hhmmss": "00:37:42",
        "end_hhmmss": "00:37:44",
        "start": 2261.761,
        "end": 2264.304
      }
    },
    {
      "edge": "M504",
      "attrs": {
        "text": "Are you going to the Thénardiers?",
        "start_hhmmss": "00:37:45",
        "end_hhmmss": "00:37:48",
        "start": 2264.512,
        "end": 2267.991029411765
      }
    },
    {
      "edge": "M505",
      "attrs": {
        "text": "No, I can't.",
        "start_hhmmss": "00:37:48",
        "end_hhmmss": "00:37:49",
        "start": 2267.991029411765,
        "end": 2268.893
      }
    },
    {
      "edge": "M506",
      "attrs": {
        "text": "I'll send the money to bring Cosette here.",
        "start_hhmmss": "00:37:49",
        "end_hhmmss": "00:37:53",
        "start": 2269.101,
        "end": 2272.645
      }
    },
    {
      "edge": "M507",
      "attrs": {
        "text": "She can't live with me.",
        "start_hhmmss": "00:37:53",
        "end_hhmmss": "00:37:56",
        "start": 2273.438,
        "end": 2275.6582894736844
      }
    },
    {
      "edge": "M508",
      "attrs": {
        "text": "Of course she can. She will.",
        "start_hhmmss": "00:37:56",
        "end_hhmmss": "00:37:58",
        "start": 2275.6582894736844,
        "end": 2278.401
      }
    },
    {
      "edge": "M509",
      "attrs": {
        "text": "She'll attend the school...",
        "start_hhmmss": "00:37:59",
        "end_hhmmss": "00:38:01",
        "start": 2278.61,
        "end": 2280.612
      }
    },
    {
      "edge": "M510",
      "attrs": {
        "text": "...and you won't have any more worries.",
        "start_hhmmss": "00:38:01",
        "end_hhmmss": "00:38:04",
        "start": 2280.821,
        "end": 2283.74
      }
    },
    {
      "edge": "M511",
      "attrs": {
        "text": "When you're better, I'll find work for you.",
        "start_hhmmss": "00:38:05",
        "end_hhmmss": "00:38:08",
        "start": 2285.325,
        "end": 2287.535
      }
    },
    {
      "edge": "M512",
      "attrs": {
        "text": "But you don't understand.",
        "start_hhmmss": "00:38:08",
        "end_hhmmss": "00:38:10",
        "start": 2287.744,
        "end": 2289.955
      }
    },
    {
      "edge": "M513",
      "attrs": {
        "text": "I'm a whore, and Cosette has no father.",
        "start_hhmmss": "00:38:10",
        "end_hhmmss": "00:38:14",
        "start": 2290.164,
        "end": 2293.708
      }
    },
    {
      "edge": "M514",
      "attrs": {
        "text": "She has the Lord. He is her father.",
        "start_hhmmss": "00:38:14",
        "end_hhmmss": "00:38:18",
        "start": 2293.918,
        "end": 2298.088
      }
    },
    {
      "edge": "M515",
      "attrs": {
        "text": "And you are his creation.",
        "start_hhmmss": "00:38:20",
        "end_hhmmss": "00:38:22",
        "start": 2299.547,
        "end": 2302.218
      }
    },
    {
      "edge": "M516",
      "attrs": {
        "text": "In his eyes you have never been anything but an innocent...",
        "start_hhmmss": "00:38:25",
        "end_hhmmss": "00:38:29",
        "start": 2304.929,
        "end": 2308.891
      }
    },
    {
      "edge": "M517",
      "attrs": {
        "text": "...and beautiful woman.",
        "start_hhmmss": "00:38:30",
        "end_hhmmss": "00:38:33",
        "start": 2309.934,
        "end": 2313.27
      }
    },
    {
      "edge": "M518",
      "attrs": {
        "text": "Monsieur.",
        "start_hhmmss": "00:38:49",
        "end_hhmmss": "00:38:51",
        "start": 2329.161,
        "end": 2331.121
      }
    },
    {
      "edge": "M519",
      "attrs": {
        "text": "You look better every day.",
        "start_hhmmss": "00:38:52",
        "end_hhmmss": "00:38:55",
        "start": 2332.248,
        "end": 2335.26108
      }
    },
    {
      "edge": "M520",
      "attrs": {
        "text": "Liar.",
        "start_hhmmss": "00:38:55",
        "end_hhmmss": "00:38:56",
        "start": 2335.26108,
        "end": 2335.835
      }
    },
    {
      "edge": "M521",
      "attrs": {
        "text": "Please.",
        "start_hhmmss": "00:38:56",
        "end_hhmmss": "00:38:58",
        "start": 2336.417,
        "end": 2337.6864285714287
      }
    },
    {
      "edge": "M522",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "00:38:58",
        "end_hhmmss": "00:38:59",
        "start": 2337.6864285714287,
        "end": 2339.379
      }
    },
    {
      "edge": "M523",
      "attrs": {
        "text": "Fantine, look.",
        "start_hhmmss": "00:39:04",
        "end_hhmmss": "00:39:06",
        "start": 2343.884,
        "end": 2346.22
      }
    },
    {
      "edge": "M524",
      "attrs": {
        "text": "Is that Thénardier's handwriting?",
        "start_hhmmss": "00:39:06",
        "end_hhmmss": "00:39:10",
        "start": 2346.427,
        "end": 2349.554870967742
      }
    },
    {
      "edge": "M525",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:39:10",
        "end_hhmmss": "00:39:10",
        "start": 2349.554870967742,
        "end": 2349.89
      }
    },
    {
      "edge": "M526",
      "attrs": {
        "text": "Is something wrong?",
        "start_hhmmss": "00:39:10",
        "end_hhmmss": "00:39:12",
        "start": 2350.099,
        "end": 2352.0088181818182
      }
    },
    {
      "edge": "M527",
      "attrs": {
        "text": "Read it.",
        "start_hhmmss": "00:39:12",
        "end_hhmmss": "00:39:13",
        "start": 2352.0088181818182,
        "end": 2352.725
      }
    },
    {
      "edge": "M528",
      "attrs": {
        "text": "I don't know how. Would you read it to me?",
        "start_hhmmss": "00:39:14",
        "end_hhmmss": "00:39:18",
        "start": 2354.311,
        "end": 2358.356
      }
    },
    {
      "edge": "M529",
      "attrs": {
        "text": "Well, I'm learning myself.",
        "start_hhmmss": "00:39:19",
        "end_hhmmss": "00:39:21",
        "start": 2358.565,
        "end": 2361.2698484848484
      }
    },
    {
      "edge": "M530",
      "attrs": {
        "text": "We're a fine pair.",
        "start_hhmmss": "00:39:21",
        "end_hhmmss": "00:39:23",
        "start": 2361.2698484848484,
        "end": 2363.028
      }
    },
    {
      "edge": "M531",
      "attrs": {
        "text": "My clerk tells me this man can't bring Cosette because you owe him money.",
        "start_hhmmss": "00:39:26",
        "end_hhmmss": "00:39:31",
        "start": 2366.24,
        "end": 2370.702
      }
    },
    {
      "edge": "M532",
      "attrs": {
        "text": "I don't. I paid him.",
        "start_hhmmss": "00:39:31",
        "end_hhmmss": "00:39:32",
        "start": 2370.911,
        "end": 2372.0217073170734
      }
    },
    {
      "edge": "M533",
      "attrs": {
        "text": "I've sent him money as well. It's a lie.",
        "start_hhmmss": "00:39:32",
        "end_hhmmss": "00:39:34",
        "start": 2372.0217073170734,
        "end": 2374.414
      }
    },
    {
      "edge": "M534",
      "attrs": {
        "text": "He could have brought Cosette and been paid.",
        "start_hhmmss": "00:39:35",
        "end_hhmmss": "00:39:37",
        "start": 2374.622,
        "end": 2377.209
      }
    },
    {
      "edge": "M535",
      "attrs": {
        "text": "I'll go get her.",
        "start_hhmmss": "00:39:37",
        "end_hhmmss": "00:39:39",
        "start": 2377.417,
        "end": 2378.56375
      }
    },
    {
      "edge": "M536",
      "attrs": {
        "text": "No, no, no. Stay where you are.",
        "start_hhmmss": "00:39:39",
        "end_hhmmss": "00:39:41",
        "start": 2378.56375,
        "end": 2380.753
      }
    },
    {
      "edge": "M537",
      "attrs": {
        "text": "It's all right. There's no need.",
        "start_hhmmss": "00:39:41",
        "end_hhmmss": "00:39:44",
        "start": 2380.963,
        "end": 2383.506
      }
    },
    {
      "edge": "M538",
      "attrs": {
        "text": "He thinks you've come into money. He's become a little greedy, that's all.",
        "start_hhmmss": "00:39:44",
        "end_hhmmss": "00:39:48",
        "start": 2383.715,
        "end": 2388.053
      }
    },
    {
      "edge": "M539",
      "attrs": {
        "text": "I've sent him what he's asked for and extra to bring Cosette.",
        "start_hhmmss": "00:39:48",
        "end_hhmmss": "00:39:51",
        "start": 2388.262,
        "end": 2391.431
      }
    },
    {
      "edge": "M540",
      "attrs": {
        "text": "She should be here in a few days.",
        "start_hhmmss": "00:39:52",
        "end_hhmmss": "00:39:54",
        "start": 2391.639,
        "end": 2394.226
      }
    },
    {
      "edge": "M541",
      "attrs": {
        "text": "How wonderful to see her.",
        "start_hhmmss": "00:39:56",
        "end_hhmmss": "00:39:58",
        "start": 2396.103,
        "end": 2398.025777777778
      }
    },
    {
      "edge": "M542",
      "attrs": {
        "text": "You must eat, my dear.",
        "start_hhmmss": "00:39:58",
        "end_hhmmss": "00:40:00",
        "start": 2398.025777777778,
        "end": 2399.564
      }
    },
    {
      "edge": "M543",
      "attrs": {
        "text": "I'll let you have your lunch.",
        "start_hhmmss": "00:40:00",
        "end_hhmmss": "00:40:02",
        "start": 2399.772,
        "end": 2401.879
      }
    },
    {
      "edge": "M544",
      "attrs": {
        "text": "What about you? Don't you eat?",
        "start_hhmmss": "00:40:02",
        "end_hhmmss": "00:40:04",
        "start": 2401.879,
        "end": 2403.986
      }
    },
    {
      "edge": "M545",
      "attrs": {
        "text": "\"Our little lark, our darling Cosette...",
        "start_hhmmss": "00:41:03",
        "end_hhmmss": "00:41:06",
        "start": 2463.337,
        "end": 2466.131
      }
    },
    {
      "edge": "M546",
      "attrs": {
        "text": "...is eager to be with her mother, but she has a cough.",
        "start_hhmmss": "00:41:06",
        "end_hhmmss": "00:41:09",
        "start": 2466.34,
        "end": 2469.385
      }
    },
    {
      "edge": "M547",
      "attrs": {
        "text": "'Like my mummy's,' the sweet angel said.",
        "start_hhmmss": "00:41:10",
        "end_hhmmss": "00:41:13",
        "start": 2469.592,
        "end": 2472.972
      }
    },
    {
      "edge": "M548",
      "attrs": {
        "text": "The physician advises she's not well enough to travel now.",
        "start_hhmmss": "00:41:13",
        "end_hhmmss": "00:41:19",
        "start": 2473.471,
        "end": 2478.601
      }
    },
    {
      "edge": "M549",
      "attrs": {
        "text": "I'll bring her when she's stronger.",
        "start_hhmmss": "00:41:19",
        "end_hhmmss": "00:41:21",
        "start": 2478.81,
        "end": 2480.645
      }
    },
    {
      "edge": "M550",
      "attrs": {
        "text": "Meanwhile the medicine is expensive and the doctors' bills are criminal.",
        "start_hhmmss": "00:41:21",
        "end_hhmmss": "00:41:26",
        "start": 2480.853,
        "end": 2485.858
      }
    },
    {
      "edge": "M551",
      "attrs": {
        "text": "Fantine owes us another 50 francs--\"",
        "start_hhmmss": "00:41:26",
        "end_hhmmss": "00:41:28",
        "start": 2486.068,
        "end": 2488.2599130434783
      }
    },
    {
      "edge": "M552",
      "attrs": {
        "text": "All right. I've had enough.",
        "start_hhmmss": "00:41:28",
        "end_hhmmss": "00:41:30",
        "start": 2488.2599130434783,
        "end": 2489.946
      }
    },
    {
      "edge": "M553",
      "attrs": {
        "text": "You want to dictate a reply?",
        "start_hhmmss": "00:41:30",
        "end_hhmmss": "00:41:33",
        "start": 2490.155,
        "end": 2492.98475
      }
    },
    {
      "edge": "M554",
      "attrs": {
        "text": "No.",
        "start_hhmmss": "00:41:33",
        "end_hhmmss": "00:41:33",
        "start": 2492.98475,
        "end": 2493.242
      }
    },
    {
      "edge": "M555",
      "attrs": {
        "text": "Instead, write this note for Fantine to sign:",
        "start_hhmmss": "00:41:33",
        "end_hhmmss": "00:41:36",
        "start": 2493.45,
        "end": 2495.952
      }
    },
    {
      "edge": "M556",
      "attrs": {
        "text": "Monsieur Thénardier. You will hand Cosette over to the bearer.",
        "start_hhmmss": "00:41:36",
        "end_hhmmss": "00:41:43",
        "start": 2496.161,
        "end": 2503.168
      }
    },
    {
      "edge": "M557",
      "attrs": {
        "text": "Regards.",
        "start_hhmmss": "00:41:44",
        "end_hhmmss": "00:41:46",
        "start": 2504.211,
        "end": 2506.463
      }
    },
    {
      "edge": "M558",
      "attrs": {
        "text": "I'll be leaving right away.",
        "start_hhmmss": "00:41:48",
        "end_hhmmss": "00:41:50",
        "start": 2507.88,
        "end": 2510.092
      }
    },
    {
      "edge": "M559",
      "attrs": {
        "text": "Javert.",
        "start_hhmmss": "00:41:52",
        "end_hhmmss": "00:41:53",
        "start": 2512.219,
        "end": 2512.9696
      }
    },
    {
      "edge": "M560",
      "attrs": {
        "text": "I need to see you immediately.",
        "start_hhmmss": "00:41:53",
        "end_hhmmss": "00:41:56",
        "start": 2512.9696,
        "end": 2515.972
      }
    },
    {
      "edge": "M561",
      "attrs": {
        "text": "Alone.",
        "start_hhmmss": "00:41:56",
        "end_hhmmss": "00:41:58",
        "start": 2516.181,
        "end": 2517.682
      }
    },
    {
      "edge": "M562",
      "attrs": {
        "text": "Thank you, Pierre.",
        "start_hhmmss": "00:41:58",
        "end_hhmmss": "00:42:00",
        "start": 2517.89,
        "end": 2519.6
      }
    },
    {
      "edge": "M563",
      "attrs": {
        "text": "I'm in a hurry, inspector.",
        "start_hhmmss": "00:42:09",
        "end_hhmmss": "00:42:11",
        "start": 2528.86,
        "end": 2531.28
      }
    },
    {
      "edge": "M564",
      "attrs": {
        "text": "Monsieur, a serious....",
        "start_hhmmss": "00:42:13",
        "end_hhmmss": "00:42:16",
        "start": 2532.739,
        "end": 2535.95
      }
    },
    {
      "edge": "M565",
      "attrs": {
        "text": "A grave violation of the public trust has been committed.",
        "start_hhmmss": "00:42:16",
        "end_hhmmss": "00:42:19",
        "start": 2536.16,
        "end": 2539.163
      }
    },
    {
      "edge": "M566",
      "attrs": {
        "text": "An inferior has shown a complete lack of respect for the law.",
        "start_hhmmss": "00:42:19",
        "end_hhmmss": "00:42:23",
        "start": 2539.371,
        "end": 2542.749
      }
    },
    {
      "edge": "M567",
      "attrs": {
        "text": "He must be exposed and punished.",
        "start_hhmmss": "00:42:23",
        "end_hhmmss": "00:42:25",
        "start": 2542.957,
        "end": 2544.79
      }
    },
    {
      "edge": "M568",
      "attrs": {
        "text": "Who is the offender?",
        "start_hhmmss": "00:42:25",
        "end_hhmmss": "00:42:26",
        "start": 2544.79,
        "end": 2545.918
      }
    },
    {
      "edge": "M569",
      "attrs": {
        "text": "I am.",
        "start_hhmmss": "00:42:27",
        "end_hhmmss": "00:42:29",
        "start": 2547.296,
        "end": 2549.298
      }
    },
    {
      "edge": "M570",
      "attrs": {
        "text": "I slandered you, monsieur. I'm here to ask that you demand my dismissal.",
        "start_hhmmss": "00:42:31",
        "end_hhmmss": "00:42:36",
        "start": 2551.3,
        "end": 2556.096
      }
    },
    {
      "edge": "M571",
      "attrs": {
        "text": "Inspector Javert, what are you talking about?",
        "start_hhmmss": "00:42:36",
        "end_hhmmss": "00:42:39",
        "start": 2556.305,
        "end": 2558.89
      }
    },
    {
      "edge": "M572",
      "attrs": {
        "text": "You may say I can resign. Resignation is honorable and I don't deserve it.",
        "start_hhmmss": "00:42:39",
        "end_hhmmss": "00:42:43",
        "start": 2559.099,
        "end": 2563.103
      }
    },
    {
      "edge": "M573",
      "attrs": {
        "text": "I must be punished. You treated me unjustly over the--",
        "start_hhmmss": "00:42:43",
        "end_hhmmss": "00:42:49",
        "start": 2563.312,
        "end": 2568.649
      }
    },
    {
      "edge": "M574",
      "attrs": {
        "text": "About the woman.",
        "start_hhmmss": "00:42:49",
        "end_hhmmss": "00:42:50",
        "start": 2568.9,
        "end": 2569.942
      }
    },
    {
      "edge": "M575",
      "attrs": {
        "text": "This time you must treat me justly. You must dismiss me.",
        "start_hhmmss": "00:42:50",
        "end_hhmmss": "00:42:53",
        "start": 2570.152,
        "end": 2573.447
      }
    },
    {
      "edge": "M576",
      "attrs": {
        "text": "God's sakes, Javert. For what?",
        "start_hhmmss": "00:42:54",
        "end_hhmmss": "00:42:56",
        "start": 2573.654,
        "end": 2576.075
      }
    },
    {
      "edge": "M577",
      "attrs": {
        "text": "I denounced you to the Paris prefect of police.",
        "start_hhmmss": "00:42:58",
        "end_hhmmss": "00:43:02",
        "start": 2577.95,
        "end": 2581.538
      }
    },
    {
      "edge": "M578",
      "attrs": {
        "text": "I swore that you were a convict.",
        "start_hhmmss": "00:43:02",
        "end_hhmmss": "00:43:04",
        "start": 2581.746,
        "end": 2583.831
      }
    },
    {
      "edge": "M579",
      "attrs": {
        "text": "You said I was what?",
        "start_hhmmss": "00:43:04",
        "end_hhmmss": "00:43:07",
        "start": 2584.04,
        "end": 2586.542391304348
      }
    },
    {
      "edge": "M580",
      "attrs": {
        "text": "A convict.",
        "start_hhmmss": "00:43:07",
        "end_hhmmss": "00:43:08",
        "start": 2586.542391304348,
        "end": 2587.877
      }
    },
    {
      "edge": "M581",
      "attrs": {
        "text": "I had no proof.",
        "start_hhmmss": "00:43:08",
        "end_hhmmss": "00:43:11",
        "start": 2588.212,
        "end": 2590.547
      }
    },
    {
      "edge": "M582",
      "attrs": {
        "text": "Only a memory of this man, Jean Valjean...",
        "start_hhmmss": "00:43:12",
        "end_hhmmss": "00:43:15",
        "start": 2591.548,
        "end": 2594.884
      }
    },
    {
      "edge": "M583",
      "attrs": {
        "text": "...whom I guarded 20 years ago in prison.",
        "start_hhmmss": "00:43:15",
        "end_hhmmss": "00:43:18",
        "start": 2595.094,
        "end": 2598.012
      }
    },
    {
      "edge": "M584",
      "attrs": {
        "text": "I denounced you without a shred of evidence.",
        "start_hhmmss": "00:43:18",
        "end_hhmmss": "00:43:21",
        "start": 2598.222,
        "end": 2600.723
      }
    },
    {
      "edge": "M585",
      "attrs": {
        "text": "You denounced me?",
        "start_hhmmss": "00:43:21",
        "end_hhmmss": "00:43:23",
        "start": 2600.932,
        "end": 2602.649058823529
      }
    },
    {
      "edge": "M586",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:43:23",
        "end_hhmmss": "00:43:23",
        "start": 2602.649058823529,
        "end": 2603.017
      }
    },
    {
      "edge": "M587",
      "attrs": {
        "text": "I was a fool.",
        "start_hhmmss": "00:43:23",
        "end_hhmmss": "00:43:25",
        "start": 2603.227,
        "end": 2604.811
      }
    },
    {
      "edge": "M588",
      "attrs": {
        "text": "They told me I was wrong, you couldn't be Jean Valjean, and they were right.",
        "start_hhmmss": "00:43:25",
        "end_hhmmss": "00:43:30",
        "start": 2605.019,
        "end": 2609.69
      }
    },
    {
      "edge": "M589",
      "attrs": {
        "text": "I've just returned from Arras, where I saw the real Jean Valjean.",
        "start_hhmmss": "00:43:30",
        "end_hhmmss": "00:43:34",
        "start": 2609.899,
        "end": 2613.861
      }
    },
    {
      "edge": "M590",
      "attrs": {
        "text": "The real Valjean?",
        "start_hhmmss": "00:43:34",
        "end_hhmmss": "00:43:36",
        "start": 2614.07,
        "end": 2615.8570588235293
      }
    },
    {
      "edge": "M591",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:43:36",
        "end_hhmmss": "00:43:36",
        "start": 2615.8570588235293,
        "end": 2616.24
      }
    },
    {
      "edge": "M592",
      "attrs": {
        "text": "Two weeks ago, a man who called himself Carnot...",
        "start_hhmmss": "00:43:36",
        "end_hhmmss": "00:43:39",
        "start": 2616.448,
        "end": 2618.991
      }
    },
    {
      "edge": "M593",
      "attrs": {
        "text": "...was arrested outside Arras for poaching apples.",
        "start_hhmmss": "00:43:39",
        "end_hhmmss": "00:43:42",
        "start": 2619.201,
        "end": 2622.412
      }
    },
    {
      "edge": "M594",
      "attrs": {
        "text": "At the prison, a convict took one look at him and said:",
        "start_hhmmss": "00:43:43",
        "end_hhmmss": "00:43:46",
        "start": 2622.745,
        "end": 2625.873
      }
    },
    {
      "edge": "M595",
      "attrs": {
        "text": "\"I know this man. We were in prison in Toulon 20 years ago.",
        "start_hhmmss": "00:43:46",
        "end_hhmmss": "00:43:50",
        "start": 2626.082,
        "end": 2630.044
      }
    },
    {
      "edge": "M596",
      "attrs": {
        "text": "He's Jean Valjean.\"",
        "start_hhmmss": "00:43:50",
        "end_hhmmss": "00:43:53",
        "start": 2630.254,
        "end": 2632.589
      }
    },
    {
      "edge": "M597",
      "attrs": {
        "text": "I didn't believe it.",
        "start_hhmmss": "00:43:53",
        "end_hhmmss": "00:43:55",
        "start": 2632.797,
        "end": 2634.55
      }
    },
    {
      "edge": "M598",
      "attrs": {
        "text": "I went there to see for myself.",
        "start_hhmmss": "00:43:55",
        "end_hhmmss": "00:43:58",
        "start": 2634.757,
        "end": 2637.677
      }
    },
    {
      "edge": "M599",
      "attrs": {
        "text": "Well, there's no question.",
        "start_hhmmss": "00:43:58",
        "end_hhmmss": "00:44:00",
        "start": 2637.885,
        "end": 2639.513
      }
    },
    {
      "edge": "M600",
      "attrs": {
        "text": "Carnot is Valjean.",
        "start_hhmmss": "00:44:00",
        "end_hhmmss": "00:44:03",
        "start": 2639.887,
        "end": 2642.807
      }
    },
    {
      "edge": "M601",
      "attrs": {
        "text": "I apologize, monsieur. I look at you now...",
        "start_hhmmss": "00:44:03",
        "end_hhmmss": "00:44:07",
        "start": 2643.475,
        "end": 2646.769
      }
    },
    {
      "edge": "M602",
      "attrs": {
        "text": "...and it's obvious you're not a convict.",
        "start_hhmmss": "00:44:07",
        "end_hhmmss": "00:44:10",
        "start": 2646.978,
        "end": 2649.814
      }
    },
    {
      "edge": "M603",
      "attrs": {
        "text": "So now you don't think I'm a convict?",
        "start_hhmmss": "00:44:12",
        "end_hhmmss": "00:44:15",
        "start": 2651.858,
        "end": 2654.611
      }
    },
    {
      "edge": "M604",
      "attrs": {
        "text": "Of course I don't. I've seen Valjean with my own eyes.",
        "start_hhmmss": "00:44:15",
        "end_hhmmss": "00:44:18",
        "start": 2654.819,
        "end": 2657.822
      }
    },
    {
      "edge": "M605",
      "attrs": {
        "text": "Must have been out of my mind to think you could be a criminal.",
        "start_hhmmss": "00:44:18",
        "end_hhmmss": "00:44:21",
        "start": 2658.03,
        "end": 2661.368
      }
    },
    {
      "edge": "M606",
      "attrs": {
        "text": "This man, he admits to being Valjean?",
        "start_hhmmss": "00:44:22",
        "end_hhmmss": "00:44:24",
        "start": 2661.577,
        "end": 2664.3588250000003
      }
    },
    {
      "edge": "M607",
      "attrs": {
        "text": "Of course not.",
        "start_hhmmss": "00:44:24",
        "end_hhmmss": "00:44:25",
        "start": 2664.3588250000003,
        "end": 2665.414
      }
    },
    {
      "edge": "M608",
      "attrs": {
        "text": "He pretends to be a half-wit who can't understand the charges.",
        "start_hhmmss": "00:44:26",
        "end_hhmmss": "00:44:29",
        "start": 2665.622,
        "end": 2669.334
      }
    },
    {
      "edge": "M609",
      "attrs": {
        "text": "Valjean has broken parole.",
        "start_hhmmss": "00:44:30",
        "end_hhmmss": "00:44:33",
        "start": 2670.335,
        "end": 2672.588
      }
    },
    {
      "edge": "M610",
      "attrs": {
        "text": "That calls for life imprisonment.",
        "start_hhmmss": "00:44:33",
        "end_hhmmss": "00:44:36",
        "start": 2672.795,
        "end": 2675.715
      }
    },
    {
      "edge": "M611",
      "attrs": {
        "text": "When is the trial?",
        "start_hhmmss": "00:44:36",
        "end_hhmmss": "00:44:38",
        "start": 2676.341,
        "end": 2677.6684545454546
      }
    },
    {
      "edge": "M612",
      "attrs": {
        "text": "Tomorrow.",
        "start_hhmmss": "00:44:38",
        "end_hhmmss": "00:44:38",
        "start": 2677.6684545454546,
        "end": 2678.427
      }
    },
    {
      "edge": "M613",
      "attrs": {
        "text": "Tomorrow.",
        "start_hhmmss": "00:44:39",
        "end_hhmmss": "00:44:40",
        "start": 2678.635,
        "end": 2679.927
      }
    },
    {
      "edge": "M614",
      "attrs": {
        "text": "How long will it take?",
        "start_hhmmss": "00:44:41",
        "end_hhmmss": "00:44:42",
        "start": 2680.596,
        "end": 2681.8830789473686
      }
    },
    {
      "edge": "M615",
      "attrs": {
        "text": "No more than an afternoon.",
        "start_hhmmss": "00:44:42",
        "end_hhmmss": "00:44:43",
        "start": 2681.8830789473686,
        "end": 2683.4730000000004
      }
    },
    {
      "edge": "M616",
      "attrs": {
        "text": "Tomorrow.",
        "start_hhmmss": "00:44:44",
        "end_hhmmss": "00:44:44",
        "start": 2683.681,
        "end": 2684.2979696969696
      }
    },
    {
      "edge": "M617",
      "attrs": {
        "text": "The evidence is overwhelming.",
        "start_hhmmss": "00:44:44",
        "end_hhmmss": "00:44:46",
        "start": 2684.2979696969696,
        "end": 2686.226
      }
    },
    {
      "edge": "M618",
      "attrs": {
        "text": "I returned so that you could dismiss me and press charges for slander.",
        "start_hhmmss": "00:44:46",
        "end_hhmmss": "00:44:52",
        "start": 2686.435,
        "end": 2691.607
      }
    },
    {
      "edge": "M619",
      "attrs": {
        "text": "I must consider.",
        "start_hhmmss": "00:44:53",
        "end_hhmmss": "00:44:55",
        "start": 2692.649,
        "end": 2694.859
      }
    },
    {
      "edge": "M620",
      "attrs": {
        "text": "I was just on my way home. Walk with me, Javert.",
        "start_hhmmss": "00:44:57",
        "end_hhmmss": "00:45:00",
        "start": 2696.819,
        "end": 2700.324
      }
    },
    {
      "edge": "M621",
      "attrs": {
        "text": "You are a stern man, but you're honorable.",
        "start_hhmmss": "00:45:01",
        "end_hhmmss": "00:45:04",
        "start": 2700.532,
        "end": 2704.16
      }
    },
    {
      "edge": "M622",
      "attrs": {
        "text": "I want you to remain prefect.",
        "start_hhmmss": "00:45:04",
        "end_hhmmss": "00:45:06",
        "start": 2704.369,
        "end": 2706.3385263157897
      }
    },
    {
      "edge": "M623",
      "attrs": {
        "text": "That's impossible.",
        "start_hhmmss": "00:45:06",
        "end_hhmmss": "00:45:08",
        "start": 2706.3385263157897,
        "end": 2707.623
      }
    },
    {
      "edge": "M624",
      "attrs": {
        "text": "You've exaggerated your offense.",
        "start_hhmmss": "00:45:08",
        "end_hhmmss": "00:45:09",
        "start": 2707.83,
        "end": 2709.499
      }
    },
    {
      "edge": "M625",
      "attrs": {
        "text": "I've not exaggerated, monsieur. I resented you.",
        "start_hhmmss": "00:45:10",
        "end_hhmmss": "00:45:14",
        "start": 2709.707,
        "end": 2713.503
      }
    },
    {
      "edge": "M626",
      "attrs": {
        "text": "I chafed at your authority.",
        "start_hhmmss": "00:45:14",
        "end_hhmmss": "00:45:16",
        "start": 2713.711,
        "end": 2715.589
      }
    },
    {
      "edge": "M627",
      "attrs": {
        "text": "And out of revenge, I slandered you.",
        "start_hhmmss": "00:45:16",
        "end_hhmmss": "00:45:18",
        "start": 2715.796,
        "end": 2718.383
      }
    },
    {
      "edge": "M628",
      "attrs": {
        "text": "If a subordinate of mine had done that, I would have broken him.",
        "start_hhmmss": "00:45:19",
        "end_hhmmss": "00:45:23",
        "start": 2718.592,
        "end": 2722.762
      }
    },
    {
      "edge": "M629",
      "attrs": {
        "text": "You must punish me, monsieur, or my life will have been meaningless.",
        "start_hhmmss": "00:45:23",
        "end_hhmmss": "00:45:27",
        "start": 2722.97,
        "end": 2727.183
      }
    },
    {
      "edge": "M630",
      "attrs": {
        "text": "Then blame me, Javert.",
        "start_hhmmss": "00:45:28",
        "end_hhmmss": "00:45:29",
        "start": 2727.892,
        "end": 2729.06
      }
    },
    {
      "edge": "M631",
      "attrs": {
        "text": "You, monsieur le maire?",
        "start_hhmmss": "00:45:31",
        "end_hhmmss": "00:45:32",
        "start": 2730.604,
        "end": 2732.071
      }
    },
    {
      "edge": "M632",
      "attrs": {
        "text": "I order you to forgive yourself.",
        "start_hhmmss": "00:45:32",
        "end_hhmmss": "00:45:34",
        "start": 2732.071,
        "end": 2734.19
      }
    },
    {
      "edge": "M633",
      "attrs": {
        "text": "Blame me for that mercy.",
        "start_hhmmss": "00:45:34",
        "end_hhmmss": "00:45:36",
        "start": 2734.399,
        "end": 2736.235
      }
    },
    {
      "edge": "M634",
      "attrs": {
        "text": "You will remain prefect. Those are my orders.",
        "start_hhmmss": "00:45:36",
        "end_hhmmss": "00:45:40",
        "start": 2736.443,
        "end": 2739.904
      }
    },
    {
      "edge": "M635",
      "attrs": {
        "text": "Will you go get her today?",
        "start_hhmmss": "00:46:06",
        "end_hhmmss": "00:46:08",
        "start": 2765.514,
        "end": 2767.932
      }
    },
    {
      "edge": "M636",
      "attrs": {
        "text": "Yes. Tonight.",
        "start_hhmmss": "00:46:08",
        "end_hhmmss": "00:46:11",
        "start": 2768.14,
        "end": 2771.185
      }
    },
    {
      "edge": "M637",
      "attrs": {
        "text": "Is something wrong?",
        "start_hhmmss": "00:46:15",
        "end_hhmmss": "00:46:16",
        "start": 2775.147,
        "end": 2776.358
      }
    },
    {
      "edge": "M638",
      "attrs": {
        "text": "I'm going to do my best.",
        "start_hhmmss": "00:46:25",
        "end_hhmmss": "00:46:27",
        "start": 2784.533,
        "end": 2787.034
      }
    },
    {
      "edge": "M639",
      "attrs": {
        "text": "I'm going to get better for my girl.",
        "start_hhmmss": "00:46:27",
        "end_hhmmss": "00:46:30",
        "start": 2787.243,
        "end": 2790.497
      }
    },
    {
      "edge": "M640",
      "attrs": {
        "text": "But if he chooses to take me, will you look after Cosette?",
        "start_hhmmss": "00:46:31",
        "end_hhmmss": "00:46:36",
        "start": 2790.706,
        "end": 2795.585
      }
    },
    {
      "edge": "M641",
      "attrs": {
        "text": "I know I have no right--",
        "start_hhmmss": "00:46:36",
        "end_hhmmss": "00:46:37",
        "start": 2795.793,
        "end": 2797.1167333333333
      }
    },
    {
      "edge": "M642",
      "attrs": {
        "text": "You and Cosette...",
        "start_hhmmss": "00:46:37",
        "end_hhmmss": "00:46:38",
        "start": 2797.1167333333333,
        "end": 2798.129
      }
    },
    {
      "edge": "M643",
      "attrs": {
        "text": "...will always be safe with me.",
        "start_hhmmss": "00:46:38",
        "end_hhmmss": "00:46:41",
        "start": 2798.338,
        "end": 2801.132
      }
    },
    {
      "edge": "M644",
      "attrs": {
        "text": "I swear it.",
        "start_hhmmss": "00:46:42",
        "end_hhmmss": "00:46:45",
        "start": 2802.301,
        "end": 2804.511
      }
    },
    {
      "edge": "M645",
      "attrs": {
        "text": "Is this the courthouse?",
        "start_hhmmss": "00:47:25",
        "end_hhmmss": "00:47:26",
        "start": 2844.76,
        "end": 2846.12268
      }
    },
    {
      "edge": "M646",
      "attrs": {
        "text": "Yes, sir.",
        "start_hhmmss": "00:47:26",
        "end_hhmmss": "00:47:27",
        "start": 2846.12268,
        "end": 2846.553
      }
    },
    {
      "edge": "M647",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "00:47:27",
        "end_hhmmss": "00:47:28",
        "start": 2846.762,
        "end": 2848.388
      }
    },
    {
      "edge": "M648",
      "attrs": {
        "text": "May I go in?",
        "start_hhmmss": "00:47:30",
        "end_hhmmss": "00:47:31",
        "start": 2849.765,
        "end": 2850.682142857143
      }
    },
    {
      "edge": "M649",
      "attrs": {
        "text": "I can't let you in. It's full.",
        "start_hhmmss": "00:47:31",
        "end_hhmmss": "00:47:33",
        "start": 2850.682142857143,
        "end": 2852.975
      }
    },
    {
      "edge": "M650",
      "attrs": {
        "text": "It's full? There are no seats?",
        "start_hhmmss": "00:47:33",
        "end_hhmmss": "00:47:36",
        "start": 2853.184,
        "end": 2855.562
      }
    },
    {
      "edge": "M651",
      "attrs": {
        "text": "Jammed. We've got two great cases.",
        "start_hhmmss": "00:47:36",
        "end_hhmmss": "00:47:40",
        "start": 2856.355,
        "end": 2860.107
      }
    },
    {
      "edge": "M652",
      "attrs": {
        "text": "So I can't get in?",
        "start_hhmmss": "00:47:41",
        "end_hhmmss": "00:47:42",
        "start": 2860.609,
        "end": 2861.943
      }
    },
    {
      "edge": "M653",
      "attrs": {
        "text": "No. Not a chance.",
        "start_hhmmss": "00:47:42",
        "end_hhmmss": "00:47:43",
        "start": 2861.943,
        "end": 2863.277
      }
    },
    {
      "edge": "M654",
      "attrs": {
        "text": "Unless.... Unless monsieur is a public official.",
        "start_hhmmss": "00:47:49",
        "end_hhmmss": "00:47:53",
        "start": 2868.784,
        "end": 2873.204
      }
    },
    {
      "edge": "M655",
      "attrs": {
        "text": "There is a seat reserved for them right beside the judge.",
        "start_hhmmss": "00:47:53",
        "end_hhmmss": "00:47:57",
        "start": 2873.413,
        "end": 2876.874
      }
    },
    {
      "edge": "M656",
      "attrs": {
        "text": "Best seat in the house.",
        "start_hhmmss": "00:47:57",
        "end_hhmmss": "00:47:59",
        "start": 2877.083,
        "end": 2878.752
      }
    },
    {
      "edge": "M657",
      "attrs": {
        "text": "I am the mayor of Vigau.",
        "start_hhmmss": "00:48:02",
        "end_hhmmss": "00:48:04",
        "start": 2881.755,
        "end": 2883.632
      }
    },
    {
      "edge": "M658",
      "attrs": {
        "text": "Gentlemen, you'll be so kind to remain seated...",
        "start_hhmmss": "00:48:05",
        "end_hhmmss": "00:48:08",
        "start": 2884.674,
        "end": 2887.677
      }
    },
    {
      "edge": "M659",
      "attrs": {
        "text": "...while my lords, the judges, re-examine the prisoner's records.",
        "start_hhmmss": "00:48:08",
        "end_hhmmss": "00:48:12",
        "start": 2887.885,
        "end": 2892.181
      }
    },
    {
      "edge": "M660",
      "attrs": {
        "text": "The prisoner to remain standing at the bar.",
        "start_hhmmss": "00:48:12",
        "end_hhmmss": "00:48:15",
        "start": 2892.391,
        "end": 2894.81
      }
    },
    {
      "edge": "M661",
      "attrs": {
        "text": "It is an honor, monsieur le maire.",
        "start_hhmmss": "00:48:24",
        "end_hhmmss": "00:48:26",
        "start": 2903.568,
        "end": 2906.188222222222
      }
    },
    {
      "edge": "M662",
      "attrs": {
        "text": "Welcome, sir.",
        "start_hhmmss": "00:48:26",
        "end_hhmmss": "00:48:27",
        "start": 2906.188222222222,
        "end": 2907.196
      }
    },
    {
      "edge": "M663",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "00:48:27",
        "end_hhmmss": "00:48:29",
        "start": 2907.406,
        "end": 2909.323
      }
    },
    {
      "edge": "M664",
      "attrs": {
        "text": "Continue the examination.",
        "start_hhmmss": "00:48:30",
        "end_hhmmss": "00:48:32",
        "start": 2910.324,
        "end": 2912.290380952381
      }
    },
    {
      "edge": "M665",
      "attrs": {
        "text": "You pretend to be simple...",
        "start_hhmmss": "00:48:32",
        "end_hhmmss": "00:48:34",
        "start": 2912.290380952381,
        "end": 2914.078
      }
    },
    {
      "edge": "M666",
      "attrs": {
        "text": "...so I give you a simple question to answer.",
        "start_hhmmss": "00:48:34",
        "end_hhmmss": "00:48:37",
        "start": 2914.286,
        "end": 2917.457
      }
    },
    {
      "edge": "M667",
      "attrs": {
        "text": "Are you or are you not the convict Jean Valjean?",
        "start_hhmmss": "00:48:38",
        "end_hhmmss": "00:48:41",
        "start": 2917.666,
        "end": 2920.71
      }
    },
    {
      "edge": "M668",
      "attrs": {
        "text": "In the first place.... What's the first place?",
        "start_hhmmss": "00:48:42",
        "end_hhmmss": "00:48:46",
        "start": 2922.044,
        "end": 2925.965
      }
    },
    {
      "edge": "M669",
      "attrs": {
        "text": "Answer the question.",
        "start_hhmmss": "00:48:46",
        "end_hhmmss": "00:48:48",
        "start": 2926.173,
        "end": 2928.092
      }
    },
    {
      "edge": "M670",
      "attrs": {
        "text": "You're wicked. That's what I was going to say. Only I forgot your name.",
        "start_hhmmss": "00:48:48",
        "end_hhmmss": "00:48:54",
        "start": 2928.3,
        "end": 2933.723
      }
    },
    {
      "edge": "M671",
      "attrs": {
        "text": "I'm a man who.... Oh, what's the word for it?",
        "start_hhmmss": "00:48:57",
        "end_hhmmss": "00:49:03",
        "start": 2937.309,
        "end": 2942.774
      }
    },
    {
      "edge": "M672",
      "attrs": {
        "text": "I'm one of those who doesn't eat every day. I'm....",
        "start_hhmmss": "00:49:03",
        "end_hhmmss": "00:49:08",
        "start": 2942.982,
        "end": 2948.237
      }
    },
    {
      "edge": "M673",
      "attrs": {
        "text": "I'm hungry. That's the word.",
        "start_hhmmss": "00:49:08",
        "end_hhmmss": "00:49:11",
        "start": 2948.447,
        "end": 2951.491
      }
    },
    {
      "edge": "M674",
      "attrs": {
        "text": "You've already been found guilty of poaching.",
        "start_hhmmss": "00:49:12",
        "end_hhmmss": "00:49:15",
        "start": 2952.324,
        "end": 2955.286
      }
    },
    {
      "edge": "M675",
      "attrs": {
        "text": "Answer the prosecutor's question.",
        "start_hhmmss": "00:49:16",
        "end_hhmmss": "00:49:19",
        "start": 2955.787,
        "end": 2958.7456666666667
      }
    },
    {
      "edge": "M676",
      "attrs": {
        "text": "Did he ask a question?",
        "start_hhmmss": "00:49:19",
        "end_hhmmss": "00:49:21",
        "start": 2958.7456666666667,
        "end": 2960.542
      }
    },
    {
      "edge": "M677",
      "attrs": {
        "text": "Are you or are you not Jean Valjean?",
        "start_hhmmss": "00:49:21",
        "end_hhmmss": "00:49:25",
        "start": 2961.375,
        "end": 2964.629
      }
    },
    {
      "edge": "M678",
      "attrs": {
        "text": "Well, you say I was born in Faverolles.",
        "start_hhmmss": "00:49:25",
        "end_hhmmss": "00:49:28",
        "start": 2965.254,
        "end": 2968.34
      }
    },
    {
      "edge": "M679",
      "attrs": {
        "text": "That's very clever, telling me where I come from. It's more than I know.",
        "start_hhmmss": "00:49:29",
        "end_hhmmss": "00:49:32",
        "start": 2968.55,
        "end": 2972.471
      }
    },
    {
      "edge": "M680",
      "attrs": {
        "text": "My parents were tramps.",
        "start_hhmmss": "00:49:33",
        "end_hhmmss": "00:49:36",
        "start": 2972.679,
        "end": 2975.682
      }
    },
    {
      "edge": "M681",
      "attrs": {
        "text": "Monsieur le président...",
        "start_hhmmss": "00:49:36",
        "end_hhmmss": "00:49:38",
        "start": 2975.891,
        "end": 2977.517
      }
    },
    {
      "edge": "M682",
      "attrs": {
        "text": "...in view of the shrewdly contrived denials of the accused, who is trying...",
        "start_hhmmss": "00:49:38",
        "end_hhmmss": "00:49:42",
        "start": 2977.726,
        "end": 2981.73
      }
    },
    {
      "edge": "M683",
      "attrs": {
        "text": "...to pass himself off as an idiot...",
        "start_hhmmss": "00:49:42",
        "end_hhmmss": "00:49:44",
        "start": 2981.938,
        "end": 2983.899
      }
    },
    {
      "edge": "M684",
      "attrs": {
        "text": "...I call the witness Brevet to the stand.",
        "start_hhmmss": "00:49:44",
        "end_hhmmss": "00:49:48",
        "start": 2984.106,
        "end": 2987.5981500000003
      }
    },
    {
      "edge": "M685",
      "attrs": {
        "text": "So ordered.",
        "start_hhmmss": "00:49:48",
        "end_hhmmss": "00:49:49",
        "start": 2987.5981500000003,
        "end": 2988.612
      }
    },
    {
      "edge": "M686",
      "attrs": {
        "text": "Brevet. I remind you...",
        "start_hhmmss": "00:49:54",
        "end_hhmmss": "00:49:57",
        "start": 2994.283,
        "end": 2997.203
      }
    },
    {
      "edge": "M687",
      "attrs": {
        "text": "...that what you say may destroy a man's life.",
        "start_hhmmss": "00:49:57",
        "end_hhmmss": "00:50:00",
        "start": 2997.411,
        "end": 3000.122
      }
    },
    {
      "edge": "M688",
      "attrs": {
        "text": "You must be absolutely certain of your testimony.",
        "start_hhmmss": "00:50:00",
        "end_hhmmss": "00:50:03",
        "start": 3000.331,
        "end": 3003.292
      }
    },
    {
      "edge": "M689",
      "attrs": {
        "text": "My memory is good.",
        "start_hhmmss": "00:50:04",
        "end_hhmmss": "00:50:05",
        "start": 3003.502,
        "end": 3005.002
      }
    },
    {
      "edge": "M690",
      "attrs": {
        "text": "The best thing I have.",
        "start_hhmmss": "00:50:06",
        "end_hhmmss": "00:50:08",
        "start": 3005.629,
        "end": 3007.7355428571427
      }
    },
    {
      "edge": "M691",
      "attrs": {
        "text": "The accused will rise.",
        "start_hhmmss": "00:50:08",
        "end_hhmmss": "00:50:10",
        "start": 3007.7355428571427,
        "end": 3009.966
      }
    },
    {
      "edge": "M692",
      "attrs": {
        "text": "Do you recognize this man?",
        "start_hhmmss": "00:50:10",
        "end_hhmmss": "00:50:12",
        "start": 3010.174,
        "end": 3012.38152
      }
    },
    {
      "edge": "M693",
      "attrs": {
        "text": "Yeah.",
        "start_hhmmss": "00:50:12",
        "end_hhmmss": "00:50:13",
        "start": 3012.38152,
        "end": 3012.802
      }
    },
    {
      "edge": "M694",
      "attrs": {
        "text": "I was the first to recognize him. I ought to get credit--",
        "start_hhmmss": "00:50:13",
        "end_hhmmss": "00:50:16",
        "start": 3013.01,
        "end": 3016.013
      }
    },
    {
      "edge": "M695",
      "attrs": {
        "text": "Never mind who was first. Who is he?",
        "start_hhmmss": "00:50:16",
        "end_hhmmss": "00:50:19",
        "start": 3016.222,
        "end": 3018.814627906977
      }
    },
    {
      "edge": "M696",
      "attrs": {
        "text": "That's Jean Valjean.",
        "start_hhmmss": "00:50:19",
        "end_hhmmss": "00:50:20",
        "start": 3018.814627906977,
        "end": 3020.351
      }
    },
    {
      "edge": "M697",
      "attrs": {
        "text": "We served 19 years together in prison.",
        "start_hhmmss": "00:50:21",
        "end_hhmmss": "00:50:23",
        "start": 3021.018,
        "end": 3023.479
      }
    },
    {
      "edge": "M698",
      "attrs": {
        "text": "He looks older of course. Looks stupider too.",
        "start_hhmmss": "00:50:25",
        "end_hhmmss": "00:50:29",
        "start": 3024.523,
        "end": 3029.068
      }
    },
    {
      "edge": "M699",
      "attrs": {
        "text": "That's probably age.",
        "start_hhmmss": "00:50:29",
        "end_hhmmss": "00:50:31",
        "start": 3029.276,
        "end": 3030.5272
      }
    },
    {
      "edge": "M700",
      "attrs": {
        "text": "Monsieur le président, I call...",
        "start_hhmmss": "00:50:31",
        "end_hhmmss": "00:50:32",
        "start": 3030.5272,
        "end": 3032.404
      }
    },
    {
      "edge": "M701",
      "attrs": {
        "text": "...the convict Lombard to the stand.",
        "start_hhmmss": "00:50:33",
        "end_hhmmss": "00:50:35",
        "start": 3032.614,
        "end": 3034.619243902439
      }
    },
    {
      "edge": "M702",
      "attrs": {
        "text": "You may step down.",
        "start_hhmmss": "00:50:35",
        "end_hhmmss": "00:50:36",
        "start": 3034.619243902439,
        "end": 3035.659
      }
    },
    {
      "edge": "M703",
      "attrs": {
        "text": "The accused should remain standing.",
        "start_hhmmss": "00:50:36",
        "end_hhmmss": "00:50:38",
        "start": 3035.867,
        "end": 3038.452
      }
    },
    {
      "edge": "M704",
      "attrs": {
        "text": "I repeat my warning: A man's life can be destroyed by your answer.",
        "start_hhmmss": "00:50:42",
        "end_hhmmss": "00:50:47",
        "start": 3042.122,
        "end": 3046.753
      }
    },
    {
      "edge": "M705",
      "attrs": {
        "text": "Do you recognize the accused?",
        "start_hhmmss": "00:50:47",
        "end_hhmmss": "00:50:49",
        "start": 3046.962,
        "end": 3049.296
      }
    },
    {
      "edge": "M706",
      "attrs": {
        "text": "I can't help but recognize him.",
        "start_hhmmss": "00:50:50",
        "end_hhmmss": "00:50:52",
        "start": 3050.13,
        "end": 3052.258
      }
    },
    {
      "edge": "M707",
      "attrs": {
        "text": "We did five years on one chain.",
        "start_hhmmss": "00:50:53",
        "end_hhmmss": "00:50:56",
        "start": 3052.926,
        "end": 3055.845
      }
    },
    {
      "edge": "M708",
      "attrs": {
        "text": "What's the matter with you, eh?",
        "start_hhmmss": "00:50:56",
        "end_hhmmss": "00:50:58",
        "start": 3056.053,
        "end": 3058.138
      }
    },
    {
      "edge": "M709",
      "attrs": {
        "text": "No hello, eh? Did you miss me, eh?",
        "start_hhmmss": "00:50:58",
        "end_hhmmss": "00:51:03",
        "start": 3058.347,
        "end": 3062.894
      }
    },
    {
      "edge": "M710",
      "attrs": {
        "text": "Hello.",
        "start_hhmmss": "00:51:04",
        "end_hhmmss": "00:51:06",
        "start": 3063.937,
        "end": 3065.564
      }
    },
    {
      "edge": "M711",
      "attrs": {
        "text": "I call Bertin to the stand.",
        "start_hhmmss": "00:51:08",
        "end_hhmmss": "00:51:12",
        "start": 3067.691,
        "end": 3071.736
      }
    },
    {
      "edge": "M712",
      "attrs": {
        "text": "I warn you as well: Your answer can ruin a man.",
        "start_hhmmss": "00:51:14",
        "end_hhmmss": "00:51:17",
        "start": 3073.613,
        "end": 3077.199
      }
    },
    {
      "edge": "M713",
      "attrs": {
        "text": "Do you recognize the accused?",
        "start_hhmmss": "00:51:17",
        "end_hhmmss": "00:51:20",
        "start": 3077.408,
        "end": 3079.953
      }
    },
    {
      "edge": "M714",
      "attrs": {
        "text": "Yeah. He's Jean Valjean.",
        "start_hhmmss": "00:51:22",
        "end_hhmmss": "00:51:24",
        "start": 3081.621,
        "end": 3084.456
      }
    },
    {
      "edge": "M715",
      "attrs": {
        "text": "Monsieur le président...",
        "start_hhmmss": "00:51:47",
        "end_hhmmss": "00:51:48",
        "start": 3106.771,
        "end": 3108.272
      }
    },
    {
      "edge": "M716",
      "attrs": {
        "text": "...may I address the court?",
        "start_hhmmss": "00:51:51",
        "end_hhmmss": "00:51:53",
        "start": 3111.275,
        "end": 3113.444
      }
    },
    {
      "edge": "M717",
      "attrs": {
        "text": "Yes, sir. Yes, certainly, monsieur le maire.",
        "start_hhmmss": "00:51:54",
        "end_hhmmss": "00:51:58",
        "start": 3113.653,
        "end": 3118.24
      }
    },
    {
      "edge": "M718",
      "attrs": {
        "text": "Brevet, Lombard, Bertin.",
        "start_hhmmss": "00:51:58",
        "end_hhmmss": "00:52:02",
        "start": 3118.449,
        "end": 3121.828
      }
    },
    {
      "edge": "M719",
      "attrs": {
        "text": "Look at me.",
        "start_hhmmss": "00:52:02",
        "end_hhmmss": "00:52:04",
        "start": 3122.037,
        "end": 3124.08
      }
    },
    {
      "edge": "M720",
      "attrs": {
        "text": "Do you recognize me?",
        "start_hhmmss": "00:52:05",
        "end_hhmmss": "00:52:06",
        "start": 3125.04,
        "end": 3126.29
      }
    },
    {
      "edge": "M721",
      "attrs": {
        "text": "I recognize you, Brevet.",
        "start_hhmmss": "00:52:06",
        "end_hhmmss": "00:52:09",
        "start": 3126.498,
        "end": 3129.293
      }
    },
    {
      "edge": "M722",
      "attrs": {
        "text": "You were an informer in Toulon. I see you're still a snitch.",
        "start_hhmmss": "00:52:10",
        "end_hhmmss": "00:52:14",
        "start": 3129.501,
        "end": 3133.505
      }
    },
    {
      "edge": "M723",
      "attrs": {
        "text": "Valjean.",
        "start_hhmmss": "00:52:14",
        "end_hhmmss": "00:52:15",
        "start": 3133.715,
        "end": 3134.7852222222223
      }
    },
    {
      "edge": "M724",
      "attrs": {
        "text": "Hello, Brevet.",
        "start_hhmmss": "00:52:15",
        "end_hhmmss": "00:52:16",
        "start": 3134.7852222222223,
        "end": 3136.467
      }
    },
    {
      "edge": "M725",
      "attrs": {
        "text": "And you, Lombard. Don't look at my fancy clothes.",
        "start_hhmmss": "00:52:17",
        "end_hhmmss": "00:52:19",
        "start": 3136.843,
        "end": 3139.386
      }
    },
    {
      "edge": "M726",
      "attrs": {
        "text": "Don't look at my scraped chin. Look at my eyes.",
        "start_hhmmss": "00:52:20",
        "end_hhmmss": "00:52:23",
        "start": 3139.595,
        "end": 3142.598
      }
    },
    {
      "edge": "M727",
      "attrs": {
        "text": "You called yourself godless, right?",
        "start_hhmmss": "00:52:23",
        "end_hhmmss": "00:52:26",
        "start": 3143.182,
        "end": 3146.185
      }
    },
    {
      "edge": "M728",
      "attrs": {
        "text": "You got a scar on your shoulder. I gave it to you the night you tried to kill me.",
        "start_hhmmss": "00:52:26",
        "end_hhmmss": "00:52:31",
        "start": 3146.393,
        "end": 3150.649
      }
    },
    {
      "edge": "M729",
      "attrs": {
        "text": "When I pinned you over the stove.",
        "start_hhmmss": "00:52:31",
        "end_hhmmss": "00:52:33",
        "start": 3150.857,
        "end": 3153.091424242424
      }
    },
    {
      "edge": "M730",
      "attrs": {
        "text": "It is you.",
        "start_hhmmss": "00:52:33",
        "end_hhmmss": "00:52:34",
        "start": 3153.091424242424,
        "end": 3153.693
      }
    },
    {
      "edge": "M731",
      "attrs": {
        "text": "Show the court your scar.",
        "start_hhmmss": "00:52:34",
        "end_hhmmss": "00:52:36",
        "start": 3153.902,
        "end": 3156.32
      }
    },
    {
      "edge": "M732",
      "attrs": {
        "text": "Bertin, the hollow of your left arm.",
        "start_hhmmss": "00:52:43",
        "end_hhmmss": "00:52:46",
        "start": 3163.243,
        "end": 3165.747
      }
    },
    {
      "edge": "M733",
      "attrs": {
        "text": "There's a date tattooed, 1789, the year of the revolution.",
        "start_hhmmss": "00:52:46",
        "end_hhmmss": "00:52:49",
        "start": 3165.955,
        "end": 3169.249
      }
    },
    {
      "edge": "M734",
      "attrs": {
        "text": "Show them.",
        "start_hhmmss": "00:52:49",
        "end_hhmmss": "00:52:51",
        "start": 3169.458,
        "end": 3171.335
      }
    },
    {
      "edge": "M735",
      "attrs": {
        "text": "I know these men, monsieur le président. And they know me.",
        "start_hhmmss": "00:53:00",
        "end_hhmmss": "00:53:05",
        "start": 3180.177,
        "end": 3184.724
      }
    },
    {
      "edge": "M736",
      "attrs": {
        "text": "I am the man you want.",
        "start_hhmmss": "00:53:06",
        "end_hhmmss": "00:53:08",
        "start": 3185.725,
        "end": 3187.894
      }
    },
    {
      "edge": "M737",
      "attrs": {
        "text": "I am Jean Valjean.",
        "start_hhmmss": "00:53:08",
        "end_hhmmss": "00:53:11",
        "start": 3188.103,
        "end": 3190.646
      }
    },
    {
      "edge": "M738",
      "attrs": {
        "text": "It's him!",
        "start_hhmmss": "00:53:16",
        "end_hhmmss": "00:53:17",
        "start": 3196.069,
        "end": 3197.0123846153847
      }
    },
    {
      "edge": "M739",
      "attrs": {
        "text": "Oh, my God!",
        "start_hhmmss": "00:53:17",
        "end_hhmmss": "00:53:18",
        "start": 3197.0123846153847,
        "end": 3198.113
      }
    },
    {
      "edge": "M740",
      "attrs": {
        "text": "Monsieur le maire, I know you to be a kind man...",
        "start_hhmmss": "00:53:18",
        "end_hhmmss": "00:53:21",
        "start": 3198.32,
        "end": 3201.365
      }
    },
    {
      "edge": "M741",
      "attrs": {
        "text": "A kind--? A kind man?",
        "start_hhmmss": "00:53:22",
        "end_hhmmss": "00:53:23",
        "start": 3201.573,
        "end": 3202.95685
      }
    },
    {
      "edge": "M742",
      "attrs": {
        "text": "...but this?",
        "start_hhmmss": "00:53:23",
        "end_hhmmss": "00:53:24",
        "start": 3202.95685,
        "end": 3203.702
      }
    },
    {
      "edge": "M743",
      "attrs": {
        "text": "In prison, I was as ignorant, mean and devious...",
        "start_hhmmss": "00:53:24",
        "end_hhmmss": "00:53:27",
        "start": 3203.91,
        "end": 3206.537
      }
    },
    {
      "edge": "M744",
      "attrs": {
        "text": "...as these men here, but not kind.",
        "start_hhmmss": "00:53:27",
        "end_hhmmss": "00:53:29",
        "start": 3206.746,
        "end": 3208.957
      }
    },
    {
      "edge": "M745",
      "attrs": {
        "text": "I wish I could keep my mouth shut and let this poor wretch suffer for me, but....",
        "start_hhmmss": "00:53:29",
        "end_hhmmss": "00:53:36",
        "start": 3209.165,
        "end": 3215.587
      }
    },
    {
      "edge": "M746",
      "attrs": {
        "text": "Continue with the investigation.",
        "start_hhmmss": "00:53:37",
        "end_hhmmss": "00:53:39",
        "start": 3216.505,
        "end": 3218.59
      }
    },
    {
      "edge": "M747",
      "attrs": {
        "text": "You will find further proof that I am Valjean.",
        "start_hhmmss": "00:53:39",
        "end_hhmmss": "00:53:42",
        "start": 3218.8,
        "end": 3222.095
      }
    },
    {
      "edge": "M748",
      "attrs": {
        "text": "I need you in the office right away.",
        "start_hhmmss": "00:54:17",
        "end_hhmmss": "00:54:21",
        "start": 3257.379,
        "end": 3260.507
      }
    },
    {
      "edge": "M749",
      "attrs": {
        "text": "Monsieur, you're back.",
        "start_hhmmss": "00:54:26",
        "end_hhmmss": "00:54:28",
        "start": 3266.263,
        "end": 3267.509054054054
      }
    },
    {
      "edge": "M750",
      "attrs": {
        "text": "I don't have the child yet.",
        "start_hhmmss": "00:54:28",
        "end_hhmmss": "00:54:29",
        "start": 3267.509054054054,
        "end": 3268.975
      }
    },
    {
      "edge": "M751",
      "attrs": {
        "text": "I'll leave in an hour. How is she?",
        "start_hhmmss": "00:54:30",
        "end_hhmmss": "00:54:31",
        "start": 3269.558,
        "end": 3271.349157894737
      }
    },
    {
      "edge": "M752",
      "attrs": {
        "text": "Her cough's worse.",
        "start_hhmmss": "00:54:31",
        "end_hhmmss": "00:54:32",
        "start": 3271.349157894737,
        "end": 3272.394
      }
    },
    {
      "edge": "M753",
      "attrs": {
        "text": "There's more blood now. She's....",
        "start_hhmmss": "00:54:33",
        "end_hhmmss": "00:54:35",
        "start": 3272.603,
        "end": 3275.231
      }
    },
    {
      "edge": "M754",
      "attrs": {
        "text": "I think she's just holding on to see her daughter.",
        "start_hhmmss": "00:54:35",
        "end_hhmmss": "00:54:39",
        "start": 3275.439,
        "end": 3279.194
      }
    },
    {
      "edge": "M755",
      "attrs": {
        "text": "Wait.",
        "start_hhmmss": "00:54:52",
        "end_hhmmss": "00:54:53",
        "start": 3292.498,
        "end": 3292.806484848485
      }
    },
    {
      "edge": "M756",
      "attrs": {
        "text": "I have an urgent message for Javert.",
        "start_hhmmss": "00:54:53",
        "end_hhmmss": "00:54:55",
        "start": 3292.806484848485,
        "end": 3295.043
      }
    },
    {
      "edge": "M757",
      "attrs": {
        "text": "I'll take it.",
        "start_hhmmss": "00:54:55",
        "end_hhmmss": "00:54:56",
        "start": 3295.251,
        "end": 3295.947857142857
      }
    },
    {
      "edge": "M758",
      "attrs": {
        "text": "To be delivered by hand.",
        "start_hhmmss": "00:54:56",
        "end_hhmmss": "00:54:57",
        "start": 3295.947857142857,
        "end": 3297.419
      }
    },
    {
      "edge": "M759",
      "attrs": {
        "text": "This is a special warrant from Arras.",
        "start_hhmmss": "00:54:58",
        "end_hhmmss": "00:55:01",
        "start": 3298.254,
        "end": 3300.882
      }
    },
    {
      "edge": "M760",
      "attrs": {
        "text": "I knew it.",
        "start_hhmmss": "00:55:09",
        "end_hhmmss": "00:55:10",
        "start": 3308.89,
        "end": 3310.432
      }
    },
    {
      "edge": "M761",
      "attrs": {
        "text": "I knew it.",
        "start_hhmmss": "00:55:11",
        "end_hhmmss": "00:55:12",
        "start": 3310.641,
        "end": 3312.309
      }
    },
    {
      "edge": "M762",
      "attrs": {
        "text": "I knew it!",
        "start_hhmmss": "00:55:13",
        "end_hhmmss": "00:55:14",
        "start": 3312.518,
        "end": 3314.478
      }
    },
    {
      "edge": "M763",
      "attrs": {
        "text": "Monsieur, you're back.",
        "start_hhmmss": "00:55:19",
        "end_hhmmss": "00:55:21",
        "start": 3318.69,
        "end": 3320.5085641025644
      }
    },
    {
      "edge": "M764",
      "attrs": {
        "text": "Fantine, if something were--",
        "start_hhmmss": "00:55:21",
        "end_hhmmss": "00:55:23",
        "start": 3320.5085641025644,
        "end": 3322.862
      }
    },
    {
      "edge": "M765",
      "attrs": {
        "text": "I was just dreaming.",
        "start_hhmmss": "00:55:23",
        "end_hhmmss": "00:55:25",
        "start": 3323.071,
        "end": 3325.24
      }
    },
    {
      "edge": "M766",
      "attrs": {
        "text": "About you and me and Cosette.",
        "start_hhmmss": "00:55:27",
        "end_hhmmss": "00:55:30",
        "start": 3327.158,
        "end": 3329.82543902439
      }
    },
    {
      "edge": "M767",
      "attrs": {
        "text": "Don't excite yourself.",
        "start_hhmmss": "00:55:30",
        "end_hhmmss": "00:55:32",
        "start": 3329.82543902439,
        "end": 3331.913
      }
    },
    {
      "edge": "M768",
      "attrs": {
        "text": "We were at her confirmation...",
        "start_hhmmss": "00:55:32",
        "end_hhmmss": "00:55:36",
        "start": 3332.121,
        "end": 3336.458
      }
    },
    {
      "edge": "M769",
      "attrs": {
        "text": "...and she looked so beautiful.",
        "start_hhmmss": "00:55:37",
        "end_hhmmss": "00:55:40",
        "start": 3336.667,
        "end": 3339.963
      }
    },
    {
      "edge": "M770",
      "attrs": {
        "text": "Fantine, if something were--",
        "start_hhmmss": "00:55:42",
        "end_hhmmss": "00:55:44",
        "start": 3342.339,
        "end": 3344.217186046512
      }
    },
    {
      "edge": "M771",
      "attrs": {
        "text": "But then she didn't know me.",
        "start_hhmmss": "00:55:44",
        "end_hhmmss": "00:55:46",
        "start": 3344.217186046512,
        "end": 3346.01
      }
    },
    {
      "edge": "M772",
      "attrs": {
        "text": "And I was crying.",
        "start_hhmmss": "00:55:46",
        "end_hhmmss": "00:55:49",
        "start": 3346.219,
        "end": 3348.888
      }
    },
    {
      "edge": "M773",
      "attrs": {
        "text": "I have to tell you.",
        "start_hhmmss": "00:55:51",
        "end_hhmmss": "00:55:52",
        "start": 3351.099,
        "end": 3352.308
      }
    },
    {
      "edge": "M774",
      "attrs": {
        "text": "I know I'm not going to live long.",
        "start_hhmmss": "00:55:53",
        "end_hhmmss": "00:55:56",
        "start": 3352.516,
        "end": 3355.781131578947
      }
    },
    {
      "edge": "M775",
      "attrs": {
        "text": "I won't be able to--",
        "start_hhmmss": "00:55:56",
        "end_hhmmss": "00:55:57",
        "start": 3355.781131578947,
        "end": 3357.479
      }
    },
    {
      "edge": "M776",
      "attrs": {
        "text": "Would you give this to her?",
        "start_hhmmss": "00:55:58",
        "end_hhmmss": "00:56:02",
        "start": 3358.273,
        "end": 3362.442
      }
    },
    {
      "edge": "M777",
      "attrs": {
        "text": "I saved it for her.",
        "start_hhmmss": "00:56:04",
        "end_hhmmss": "00:56:05",
        "start": 3363.61,
        "end": 3364.988
      }
    },
    {
      "edge": "M778",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:56:06",
        "end_hhmmss": "00:56:07",
        "start": 3365.529,
        "end": 3367.447
      }
    },
    {
      "edge": "M779",
      "attrs": {
        "text": "Could you give it to her, please?",
        "start_hhmmss": "00:56:09",
        "end_hhmmss": "00:56:11",
        "start": 3368.615,
        "end": 3370.807948717949
      }
    },
    {
      "edge": "M780",
      "attrs": {
        "text": "I'll give it to her.",
        "start_hhmmss": "00:56:11",
        "end_hhmmss": "00:56:12",
        "start": 3370.807948717949,
        "end": 3372.036
      }
    },
    {
      "edge": "M781",
      "attrs": {
        "text": "She can come and stay with you, can't she?",
        "start_hhmmss": "00:56:22",
        "end_hhmmss": "00:56:24",
        "start": 3381.837,
        "end": 3384.048
      }
    },
    {
      "edge": "M782",
      "attrs": {
        "text": "You will raise her, won't you?",
        "start_hhmmss": "00:56:24",
        "end_hhmmss": "00:56:27",
        "start": 3384.257,
        "end": 3387.093
      }
    },
    {
      "edge": "M783",
      "attrs": {
        "text": "Yes, I'll raise her.",
        "start_hhmmss": "00:56:27",
        "end_hhmmss": "00:56:29",
        "start": 3387.302,
        "end": 3389.2227096774195
      }
    },
    {
      "edge": "M784",
      "attrs": {
        "text": "Promise me, monsieur.",
        "start_hhmmss": "00:56:29",
        "end_hhmmss": "00:56:32",
        "start": 3389.2227096774195,
        "end": 3391.555
      }
    },
    {
      "edge": "M785",
      "attrs": {
        "text": "I promise.",
        "start_hhmmss": "00:56:32",
        "end_hhmmss": "00:56:34",
        "start": 3391.973,
        "end": 3394.058
      }
    },
    {
      "edge": "M786",
      "attrs": {
        "text": "He lies well, doesn't he?",
        "start_hhmmss": "00:56:35",
        "end_hhmmss": "00:56:36",
        "start": 3394.6,
        "end": 3395.935
      }
    },
    {
      "edge": "M787",
      "attrs": {
        "text": "He's had a lot of practice. A lifetime of lies.",
        "start_hhmmss": "00:56:36",
        "end_hhmmss": "00:56:41",
        "start": 3396.144,
        "end": 3401.065
      }
    },
    {
      "edge": "M788",
      "attrs": {
        "text": "Save me.",
        "start_hhmmss": "00:56:41",
        "end_hhmmss": "00:56:42",
        "start": 3401.44,
        "end": 3402.008727272728
      }
    },
    {
      "edge": "M789",
      "attrs": {
        "text": "It's all right. He's not here for you.",
        "start_hhmmss": "00:56:42",
        "end_hhmmss": "00:56:45",
        "start": 3402.008727272728,
        "end": 3404.568
      }
    },
    {
      "edge": "M790",
      "attrs": {
        "text": "He's not here for you.",
        "start_hhmmss": "00:56:45",
        "end_hhmmss": "00:56:47",
        "start": 3404.776,
        "end": 3406.988
      }
    },
    {
      "edge": "M791",
      "attrs": {
        "text": "He isn't mayor anymore.",
        "start_hhmmss": "00:56:49",
        "end_hhmmss": "00:56:50",
        "start": 3408.655,
        "end": 3410.449
      }
    },
    {
      "edge": "M792",
      "attrs": {
        "text": "Let's talk in private.",
        "start_hhmmss": "00:56:51",
        "end_hhmmss": "00:56:52",
        "start": 3410.657,
        "end": 3411.909
      }
    },
    {
      "edge": "M793",
      "attrs": {
        "text": "Speak up. Don't mumble.",
        "start_hhmmss": "00:56:52",
        "end_hhmmss": "00:56:53",
        "start": 3411.909,
        "end": 3413.161
      }
    },
    {
      "edge": "M794",
      "attrs": {
        "text": "I need a favor.",
        "start_hhmmss": "00:56:53",
        "end_hhmmss": "00:56:54",
        "start": 3413.369,
        "end": 3414.363277777778
      }
    },
    {
      "edge": "M795",
      "attrs": {
        "text": "Speak up.",
        "start_hhmmss": "00:56:54",
        "end_hhmmss": "00:56:55",
        "start": 3414.363277777778,
        "end": 3414.996
      }
    },
    {
      "edge": "M796",
      "attrs": {
        "text": "Give me two days to fetch her child.",
        "start_hhmmss": "00:56:55",
        "end_hhmmss": "00:56:57",
        "start": 3415.204,
        "end": 3417.3061
      }
    },
    {
      "edge": "M797",
      "attrs": {
        "text": "Are you joking?",
        "start_hhmmss": "00:56:57",
        "end_hhmmss": "00:56:58",
        "start": 3417.3061,
        "end": 3418.207
      }
    },
    {
      "edge": "M798",
      "attrs": {
        "text": "I'll pay you anything you want.",
        "start_hhmmss": "00:56:58",
        "end_hhmmss": "00:57:00",
        "start": 3418.415,
        "end": 3420.2992352941174
      }
    },
    {
      "edge": "M799",
      "attrs": {
        "text": "Do you think I'm that stupid? You do.",
        "start_hhmmss": "00:57:00",
        "end_hhmmss": "00:57:02",
        "start": 3420.2992352941174,
        "end": 3422.419
      }
    },
    {
      "edge": "M800",
      "attrs": {
        "text": "You must have laughed when you forgave me. Generous, kind mayor.",
        "start_hhmmss": "00:57:03",
        "end_hhmmss": "00:57:06",
        "start": 3422.628,
        "end": 3425.965
      }
    },
    {
      "edge": "M801",
      "attrs": {
        "text": "No. No, you can't fetch things for your whore.",
        "start_hhmmss": "00:57:06",
        "end_hhmmss": "00:57:09",
        "start": 3426.174,
        "end": 3428.675
      }
    },
    {
      "edge": "M802",
      "attrs": {
        "text": "You're going where you belong. This bitch is going to jail.",
        "start_hhmmss": "00:57:09",
        "end_hhmmss": "00:57:12",
        "start": 3428.884,
        "end": 3431.971
      }
    },
    {
      "edge": "M803",
      "attrs": {
        "text": "You'll never see your daughter. You're going to prison.",
        "start_hhmmss": "00:57:12",
        "end_hhmmss": "00:57:15",
        "start": 3432.18,
        "end": 3435.266
      }
    },
    {
      "edge": "M804",
      "attrs": {
        "text": "He can't save you.",
        "start_hhmmss": "00:57:15",
        "end_hhmmss": "00:57:17",
        "start": 3435.474,
        "end": 3436.558
      }
    },
    {
      "edge": "M805",
      "attrs": {
        "text": "Javert.",
        "start_hhmmss": "00:57:17",
        "end_hhmmss": "00:57:18",
        "start": 3436.767,
        "end": 3437.5053
      }
    },
    {
      "edge": "M806",
      "attrs": {
        "text": "Scum of the earth.",
        "start_hhmmss": "00:57:18",
        "end_hhmmss": "00:57:19",
        "start": 3437.5053,
        "end": 3439.228
      }
    },
    {
      "edge": "M807",
      "attrs": {
        "text": "Get up!",
        "start_hhmmss": "00:57:20",
        "end_hhmmss": "00:57:22",
        "start": 3440.479,
        "end": 3442.315
      }
    },
    {
      "edge": "M808",
      "attrs": {
        "text": "It's a pleasure to see you again, Valjean.",
        "start_hhmmss": "00:57:26",
        "end_hhmmss": "00:57:28",
        "start": 3445.776,
        "end": 3448.321
      }
    },
    {
      "edge": "M809",
      "attrs": {
        "text": "You killed her.",
        "start_hhmmss": "00:57:53",
        "end_hhmmss": "00:57:54",
        "start": 3473.137,
        "end": 3474.305
      }
    },
    {
      "edge": "M810",
      "attrs": {
        "text": "Where will you go, Valjean? You don't have papers.",
        "start_hhmmss": "00:57:59",
        "end_hhmmss": "00:58:02",
        "start": 3478.85,
        "end": 3482.188
      }
    },
    {
      "edge": "M811",
      "attrs": {
        "text": "I'll find you.",
        "start_hhmmss": "00:58:02",
        "end_hhmmss": "00:58:04",
        "start": 3482.479,
        "end": 3484.399
      }
    },
    {
      "edge": "M812",
      "attrs": {
        "text": "She repented, didn't she? She made her peace with God?",
        "start_hhmmss": "00:58:14",
        "end_hhmmss": "00:58:18",
        "start": 3493.907,
        "end": 3498.413
      }
    },
    {
      "edge": "M813",
      "attrs": {
        "text": "Yes, monsieur.",
        "start_hhmmss": "00:58:19",
        "end_hhmmss": "00:58:21",
        "start": 3498.62,
        "end": 3500.58
      }
    },
    {
      "edge": "M814",
      "attrs": {
        "text": "Are you a convict? Is that true?",
        "start_hhmmss": "00:58:41",
        "end_hhmmss": "00:58:44",
        "start": 3520.809,
        "end": 3523.645
      }
    },
    {
      "edge": "M815",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:58:44",
        "end_hhmmss": "00:58:45",
        "start": 3524.105,
        "end": 3525.398
      }
    },
    {
      "edge": "M816",
      "attrs": {
        "text": "Where's the inspector?",
        "start_hhmmss": "00:58:47",
        "end_hhmmss": "00:58:49",
        "start": 3526.606,
        "end": 3528.7652500000004
      }
    },
    {
      "edge": "M817",
      "attrs": {
        "text": "Inside.",
        "start_hhmmss": "00:58:49",
        "end_hhmmss": "00:58:49",
        "start": 3528.7652500000004,
        "end": 3529.4850000000006
      }
    },
    {
      "edge": "M818",
      "attrs": {
        "text": "Did you kill him?",
        "start_hhmmss": "00:58:50",
        "end_hhmmss": "00:58:51",
        "start": 3529.693,
        "end": 3530.819
      }
    },
    {
      "edge": "M819",
      "attrs": {
        "text": "That's a pity.",
        "start_hhmmss": "00:58:54",
        "end_hhmmss": "00:58:56",
        "start": 3533.613,
        "end": 3535.699
      }
    },
    {
      "edge": "M820",
      "attrs": {
        "text": "You'd better hit me hard enough to make a lump.",
        "start_hhmmss": "00:59:00",
        "end_hhmmss": "00:59:02",
        "start": 3539.911,
        "end": 3542.415
      }
    },
    {
      "edge": "M821",
      "attrs": {
        "text": "Where is he?",
        "start_hhmmss": "00:59:19",
        "end_hhmmss": "00:59:20",
        "start": 3559.014,
        "end": 3559.6713214285714
      }
    },
    {
      "edge": "M822",
      "attrs": {
        "text": "He left half an hour ago.",
        "start_hhmmss": "00:59:20",
        "end_hhmmss": "00:59:21",
        "start": 3559.6713214285714,
        "end": 3561.059
      }
    },
    {
      "edge": "M823",
      "attrs": {
        "text": "On foot?",
        "start_hhmmss": "00:59:21",
        "end_hhmmss": "00:59:22",
        "start": 3561.267,
        "end": 3561.945857142857
      }
    },
    {
      "edge": "M824",
      "attrs": {
        "text": "On a wagon.",
        "start_hhmmss": "00:59:22",
        "end_hhmmss": "00:59:23",
        "start": 3561.945857142857,
        "end": 3562.851
      }
    },
    {
      "edge": "M825",
      "attrs": {
        "text": "Which way?",
        "start_hhmmss": "00:59:23",
        "end_hhmmss": "00:59:24",
        "start": 3563.061,
        "end": 3563.669695652174
      }
    },
    {
      "edge": "M826",
      "attrs": {
        "text": "The southern road.",
        "start_hhmmss": "00:59:24",
        "end_hhmmss": "00:59:25",
        "start": 3563.669695652174,
        "end": 3564.811
      }
    },
    {
      "edge": "M827",
      "attrs": {
        "text": "Commandeer the mail coach.",
        "start_hhmmss": "00:59:25",
        "end_hhmmss": "00:59:26",
        "start": 3565.02,
        "end": 3566.48784
      }
    },
    {
      "edge": "M828",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "00:59:26",
        "end_hhmmss": "00:59:27",
        "start": 3566.48784,
        "end": 3566.688
      }
    },
    {
      "edge": "M829",
      "attrs": {
        "text": "Not you, Beauvais.",
        "start_hhmmss": "00:59:27",
        "end_hhmmss": "00:59:28",
        "start": 3566.897,
        "end": 3567.997
      }
    },
    {
      "edge": "M830",
      "attrs": {
        "text": "You two, go.",
        "start_hhmmss": "00:59:28",
        "end_hhmmss": "00:59:29",
        "start": 3567.997,
        "end": 3568.626115384616
      }
    },
    {
      "edge": "M831",
      "attrs": {
        "text": "Ask anybody. Everybody saw him leave.",
        "start_hhmmss": "00:59:29",
        "end_hhmmss": "00:59:31",
        "start": 3568.626115384616,
        "end": 3570.984
      }
    },
    {
      "edge": "M832",
      "attrs": {
        "text": "How much money has he taken?",
        "start_hhmmss": "00:59:31",
        "end_hhmmss": "00:59:33",
        "start": 3571.194,
        "end": 3572.694
      }
    },
    {
      "edge": "M833",
      "attrs": {
        "text": "He didn't take any.",
        "start_hhmmss": "00:59:33",
        "end_hhmmss": "00:59:34",
        "start": 3572.903,
        "end": 3574.2656666666667
      }
    },
    {
      "edge": "M834",
      "attrs": {
        "text": "Show me the book.",
        "start_hhmmss": "00:59:34",
        "end_hhmmss": "00:59:36",
        "start": 3574.2656666666667,
        "end": 3575.531
      }
    },
    {
      "edge": "M835",
      "attrs": {
        "text": "I don't understand. He transferred ownership.",
        "start_hhmmss": "00:59:45",
        "end_hhmmss": "00:59:47",
        "start": 3584.664,
        "end": 3587.21
      }
    },
    {
      "edge": "M836",
      "attrs": {
        "text": "To all the employees.",
        "start_hhmmss": "00:59:47",
        "end_hhmmss": "00:59:49",
        "start": 3587.418,
        "end": 3588.668
      }
    },
    {
      "edge": "M837",
      "attrs": {
        "text": "Shares have been apportioned by seniority. He took nothing for himself.",
        "start_hhmmss": "00:59:49",
        "end_hhmmss": "00:59:53",
        "start": 3588.877,
        "end": 3592.839
      }
    },
    {
      "edge": "M838",
      "attrs": {
        "text": "Quickly.",
        "start_hhmmss": "01:00:10",
        "end_hhmmss": "01:00:12",
        "start": 3609.898,
        "end": 3611.691
      }
    },
    {
      "edge": "M839",
      "attrs": {
        "text": "Faster! Faster! Come on, drive them there!",
        "start_hhmmss": "01:00:36",
        "end_hhmmss": "01:00:38",
        "start": 3635.674,
        "end": 3638.344
      }
    },
    {
      "edge": "M840",
      "attrs": {
        "text": "Morning, monsieur le maire.",
        "start_hhmmss": "01:00:48",
        "end_hhmmss": "01:00:50",
        "start": 3647.853,
        "end": 3649.771
      }
    },
    {
      "edge": "M841",
      "attrs": {
        "text": "Good morning.",
        "start_hhmmss": "01:00:50",
        "end_hhmmss": "01:00:51",
        "start": 3649.771,
        "end": 3650.73
      }
    },
    {
      "edge": "M842",
      "attrs": {
        "text": "What are you doing? Don't slow down. Give me the reins.",
        "start_hhmmss": "01:00:52",
        "end_hhmmss": "01:00:55",
        "start": 3652.107,
        "end": 3654.943
      }
    },
    {
      "edge": "M843",
      "attrs": {
        "text": "Come on!",
        "start_hhmmss": "01:00:57",
        "end_hhmmss": "01:00:59",
        "start": 3656.778,
        "end": 3658.655
      }
    },
    {
      "edge": "M844",
      "attrs": {
        "text": "Yes. Yes.",
        "start_hhmmss": "01:00:59",
        "end_hhmmss": "01:01:02",
        "start": 3659.157,
        "end": 3661.576
      }
    },
    {
      "edge": "M845",
      "attrs": {
        "text": "We're going too fast, sir!",
        "start_hhmmss": "01:01:03",
        "end_hhmmss": "01:01:05",
        "start": 3663.452,
        "end": 3664.828
      }
    },
    {
      "edge": "M846",
      "attrs": {
        "text": "Look out!",
        "start_hhmmss": "01:01:07",
        "end_hhmmss": "01:01:08",
        "start": 3666.872,
        "end": 3668.039
      }
    },
    {
      "edge": "M847",
      "attrs": {
        "text": "You're.... You're under arrest.",
        "start_hhmmss": "01:01:28",
        "end_hhmmss": "01:01:33",
        "start": 3688.143,
        "end": 3692.565
      }
    },
    {
      "edge": "M848",
      "attrs": {
        "text": "The whore, who did she write to? The address, give it to me.",
        "start_hhmmss": "01:01:42",
        "end_hhmmss": "01:01:45",
        "start": 3701.698,
        "end": 3704.826
      }
    },
    {
      "edge": "M849",
      "attrs": {
        "text": "There you are, you little slut. What took you so long?",
        "start_hhmmss": "01:01:59",
        "end_hhmmss": "01:02:02",
        "start": 3719.383,
        "end": 3722.47
      }
    },
    {
      "edge": "M850",
      "attrs": {
        "text": "It's heavy.",
        "start_hhmmss": "01:02:03",
        "end_hhmmss": "01:02:04",
        "start": 3722.969,
        "end": 3723.750942857143
      }
    },
    {
      "edge": "M851",
      "attrs": {
        "text": "Don't let me hear you complaining.",
        "start_hhmmss": "01:02:04",
        "end_hhmmss": "01:02:06",
        "start": 3723.750942857143,
        "end": 3726.39
      }
    },
    {
      "edge": "M852",
      "attrs": {
        "text": "You don't bring a sou.",
        "start_hhmmss": "01:02:07",
        "end_hhmmss": "01:02:08",
        "start": 3726.599,
        "end": 3727.807
      }
    },
    {
      "edge": "M853",
      "attrs": {
        "text": "The least you can do is clean the rooms. I feed your greedy mouth.",
        "start_hhmmss": "01:02:08",
        "end_hhmmss": "01:02:12",
        "start": 3728.016,
        "end": 3731.687
      }
    },
    {
      "edge": "M854",
      "attrs": {
        "text": "Do I get thanks? No, I get smart answers. Now get to work.",
        "start_hhmmss": "01:02:12",
        "end_hhmmss": "01:02:16",
        "start": 3731.895,
        "end": 3736.191
      }
    },
    {
      "edge": "M855",
      "attrs": {
        "text": "I want those stockings finished or no supper.",
        "start_hhmmss": "01:02:16",
        "end_hhmmss": "01:02:19",
        "start": 3736.4,
        "end": 3738.777
      }
    },
    {
      "edge": "M856",
      "attrs": {
        "text": "You have to earn your keep.",
        "start_hhmmss": "01:02:19",
        "end_hhmmss": "01:02:21",
        "start": 3738.985,
        "end": 3741.28
      }
    },
    {
      "edge": "M857",
      "attrs": {
        "text": "What do you want?",
        "start_hhmmss": "01:02:23",
        "end_hhmmss": "01:02:25",
        "start": 3742.531,
        "end": 3744.783
      }
    },
    {
      "edge": "M858",
      "attrs": {
        "text": "A room, please.",
        "start_hhmmss": "01:02:25",
        "end_hhmmss": "01:02:27",
        "start": 3745.158,
        "end": 3746.66324
      }
    },
    {
      "edge": "M859",
      "attrs": {
        "text": "A room costs 20 sous.",
        "start_hhmmss": "01:02:27",
        "end_hhmmss": "01:02:29",
        "start": 3746.66324,
        "end": 3748.579
      }
    },
    {
      "edge": "M860",
      "attrs": {
        "text": "I'll pay in advance.",
        "start_hhmmss": "01:02:29",
        "end_hhmmss": "01:02:30",
        "start": 3748.787,
        "end": 3749.996
      }
    },
    {
      "edge": "M861",
      "attrs": {
        "text": "Very well, monsieur.",
        "start_hhmmss": "01:02:33",
        "end_hhmmss": "01:02:34",
        "start": 3752.749,
        "end": 3753.792
      }
    },
    {
      "edge": "M862",
      "attrs": {
        "text": "My dear, my sweet, my precious, you've forgotten. Haven't you?",
        "start_hhmmss": "01:02:34",
        "end_hhmmss": "01:02:38",
        "start": 3754.0,
        "end": 3758.004
      }
    },
    {
      "edge": "M863",
      "attrs": {
        "text": "I've forgotten.",
        "start_hhmmss": "01:02:38",
        "end_hhmmss": "01:02:40",
        "start": 3758.213,
        "end": 3759.923
      }
    },
    {
      "edge": "M864",
      "attrs": {
        "text": "I do that.",
        "start_hhmmss": "01:02:40",
        "end_hhmmss": "01:02:41",
        "start": 3760.131,
        "end": 3760.6228
      }
    },
    {
      "edge": "M865",
      "attrs": {
        "text": "I forget things.",
        "start_hhmmss": "01:02:41",
        "end_hhmmss": "01:02:42",
        "start": 3760.6228,
        "end": 3761.536
      }
    },
    {
      "edge": "M866",
      "attrs": {
        "text": "What have I forgotten?",
        "start_hhmmss": "01:02:42",
        "end_hhmmss": "01:02:43",
        "start": 3761.536,
        "end": 3762.801
      }
    },
    {
      "edge": "M867",
      "attrs": {
        "text": "We've rented the regular room.",
        "start_hhmmss": "01:02:43",
        "end_hhmmss": "01:02:45",
        "start": 3763.009,
        "end": 3764.886
      }
    },
    {
      "edge": "M868",
      "attrs": {
        "text": "We've only got the wedding chamber left. I'm sorry, but that costs 40 sous.",
        "start_hhmmss": "01:02:45",
        "end_hhmmss": "01:02:50",
        "start": 3765.095,
        "end": 3769.725
      }
    },
    {
      "edge": "M869",
      "attrs": {
        "text": "You want a meal?",
        "start_hhmmss": "01:02:52",
        "end_hhmmss": "01:02:53",
        "start": 3772.143,
        "end": 3773.2599230769233
      }
    },
    {
      "edge": "M870",
      "attrs": {
        "text": "Bread and cheese.",
        "start_hhmmss": "01:02:53",
        "end_hhmmss": "01:02:55",
        "start": 3773.2599230769233,
        "end": 3774.563
      }
    },
    {
      "edge": "M871",
      "attrs": {
        "text": "Is that all? There's rabbit stew.",
        "start_hhmmss": "01:02:55",
        "end_hhmmss": "01:02:58",
        "start": 3774.771,
        "end": 3777.525
      }
    },
    {
      "edge": "M872",
      "attrs": {
        "text": "What's she knitting?",
        "start_hhmmss": "01:02:59",
        "end_hhmmss": "01:03:01",
        "start": 3778.734,
        "end": 3781.3327368421055
      }
    },
    {
      "edge": "M873",
      "attrs": {
        "text": "Who?",
        "start_hhmmss": "01:03:01",
        "end_hhmmss": "01:03:02",
        "start": 3781.3327368421055,
        "end": 3781.82
      }
    },
    {
      "edge": "M874",
      "attrs": {
        "text": "She's making stockings for my daughters.",
        "start_hhmmss": "01:03:03",
        "end_hhmmss": "01:03:05",
        "start": 3783.113,
        "end": 3785.156
      }
    },
    {
      "edge": "M875",
      "attrs": {
        "text": "She's not your daughter?",
        "start_hhmmss": "01:03:05",
        "end_hhmmss": "01:03:07",
        "start": 3785.366,
        "end": 3787.127194444444
      }
    },
    {
      "edge": "M876",
      "attrs": {
        "text": "Not that creature. No.",
        "start_hhmmss": "01:03:07",
        "end_hhmmss": "01:03:09",
        "start": 3787.127194444444,
        "end": 3788.703
      }
    },
    {
      "edge": "M877",
      "attrs": {
        "text": "Why? Does she interest you?",
        "start_hhmmss": "01:03:09",
        "end_hhmmss": "01:03:12",
        "start": 3788.91,
        "end": 3792.247
      }
    },
    {
      "edge": "M878",
      "attrs": {
        "text": "Perhaps.",
        "start_hhmmss": "01:03:13",
        "end_hhmmss": "01:03:14",
        "start": 3793.123,
        "end": 3794.249
      }
    },
    {
      "edge": "M879",
      "attrs": {
        "text": "What's her name?",
        "start_hhmmss": "01:03:14",
        "end_hhmmss": "01:03:17",
        "start": 3794.458,
        "end": 3796.539052631579
      }
    },
    {
      "edge": "M880",
      "attrs": {
        "text": "Cosette.",
        "start_hhmmss": "01:03:17",
        "end_hhmmss": "01:03:18",
        "start": 3796.539052631579,
        "end": 3797.753
      }
    },
    {
      "edge": "M881",
      "attrs": {
        "text": "What are they worth?",
        "start_hhmmss": "01:03:19",
        "end_hhmmss": "01:03:21",
        "start": 3799.338,
        "end": 3800.585304347826
      }
    },
    {
      "edge": "M882",
      "attrs": {
        "text": "The girl?",
        "start_hhmmss": "01:03:21",
        "end_hhmmss": "01:03:21",
        "start": 3800.585304347826,
        "end": 3801.131
      }
    },
    {
      "edge": "M883",
      "attrs": {
        "text": "The stockings.",
        "start_hhmmss": "01:03:21",
        "end_hhmmss": "01:03:23",
        "start": 3801.34,
        "end": 3802.6678461538463
      }
    },
    {
      "edge": "M884",
      "attrs": {
        "text": "Oh, the stockings.",
        "start_hhmmss": "01:03:23",
        "end_hhmmss": "01:03:24",
        "start": 3802.6678461538463,
        "end": 3804.217
      }
    },
    {
      "edge": "M885",
      "attrs": {
        "text": "I don't know.",
        "start_hhmmss": "01:03:24",
        "end_hhmmss": "01:03:26",
        "start": 3804.427,
        "end": 3805.802
      }
    },
    {
      "edge": "M886",
      "attrs": {
        "text": "You can buy the stockings.",
        "start_hhmmss": "01:03:26",
        "end_hhmmss": "01:03:28",
        "start": 3806.011,
        "end": 3808.0015454545455
      }
    },
    {
      "edge": "M887",
      "attrs": {
        "text": "Probably 30 sous.",
        "start_hhmmss": "01:03:28",
        "end_hhmmss": "01:03:29",
        "start": 3808.0015454545455,
        "end": 3809.139
      }
    },
    {
      "edge": "M888",
      "attrs": {
        "text": "I'll buy them.",
        "start_hhmmss": "01:03:29",
        "end_hhmmss": "01:03:30",
        "start": 3809.348,
        "end": 3810.474
      }
    },
    {
      "edge": "M889",
      "attrs": {
        "text": "I'm paying for her time. I want her to play.",
        "start_hhmmss": "01:03:31",
        "end_hhmmss": "01:03:34",
        "start": 3810.683,
        "end": 3813.686
      }
    },
    {
      "edge": "M890",
      "attrs": {
        "text": "Of course, understand I meant 30 sous for each stocking.",
        "start_hhmmss": "01:03:34",
        "end_hhmmss": "01:03:37",
        "start": 3813.893,
        "end": 3816.813
      }
    },
    {
      "edge": "M891",
      "attrs": {
        "text": "Cosette, get up. Come on. Get out of there.",
        "start_hhmmss": "01:03:37",
        "end_hhmmss": "01:03:40",
        "start": 3817.022,
        "end": 3820.359
      }
    },
    {
      "edge": "M892",
      "attrs": {
        "text": "Cosette! Get out. Get out of there!",
        "start_hhmmss": "01:03:41",
        "end_hhmmss": "01:03:44",
        "start": 3820.568,
        "end": 3824.07
      }
    },
    {
      "edge": "M893",
      "attrs": {
        "text": "Get out!",
        "start_hhmmss": "01:03:44",
        "end_hhmmss": "01:03:46",
        "start": 3824.279,
        "end": 3826.072
      }
    },
    {
      "edge": "M894",
      "attrs": {
        "text": "You're working for me now. You can rest or you can play.",
        "start_hhmmss": "01:03:49",
        "end_hhmmss": "01:03:53",
        "start": 3829.368,
        "end": 3833.079
      }
    },
    {
      "edge": "M895",
      "attrs": {
        "text": "What would you like?",
        "start_hhmmss": "01:03:53",
        "end_hhmmss": "01:03:54",
        "start": 3833.288,
        "end": 3834.332
      }
    },
    {
      "edge": "M896",
      "attrs": {
        "text": "Madame, is it true? Am I allowed to play?",
        "start_hhmmss": "01:03:58",
        "end_hhmmss": "01:04:00",
        "start": 3837.959,
        "end": 3840.421
      }
    },
    {
      "edge": "M897",
      "attrs": {
        "text": "You heard, didn't you? Yes, you must play. Go on, hurry up, start playing.",
        "start_hhmmss": "01:04:01",
        "end_hhmmss": "01:04:05",
        "start": 3840.629,
        "end": 3844.759
      }
    },
    {
      "edge": "M898",
      "attrs": {
        "text": "Perhaps monsieur would like Cosette to play on his lap.",
        "start_hhmmss": "01:04:14",
        "end_hhmmss": "01:04:17",
        "start": 3853.933,
        "end": 3857.312
      }
    },
    {
      "edge": "M899",
      "attrs": {
        "text": "I'm heading to Paris. Is there a mail carriage I can take?",
        "start_hhmmss": "01:04:21",
        "end_hhmmss": "01:04:24",
        "start": 3860.691,
        "end": 3863.694
      }
    },
    {
      "edge": "M900",
      "attrs": {
        "text": "It's gone already.",
        "start_hhmmss": "01:04:24",
        "end_hhmmss": "01:04:25",
        "start": 3863.902,
        "end": 3865.236
      }
    },
    {
      "edge": "M901",
      "attrs": {
        "text": "Next coach to Paris arrives at dawn.",
        "start_hhmmss": "01:04:25",
        "end_hhmmss": "01:04:29",
        "start": 3865.446,
        "end": 3868.865
      }
    },
    {
      "edge": "M902",
      "attrs": {
        "text": "You like our Cosette?",
        "start_hhmmss": "01:04:44",
        "end_hhmmss": "01:04:45",
        "start": 3883.672,
        "end": 3884.898297297297
      }
    },
    {
      "edge": "M903",
      "attrs": {
        "text": "I want to take her with me.",
        "start_hhmmss": "01:04:45",
        "end_hhmmss": "01:04:46",
        "start": 3884.898297297297,
        "end": 3886.341
      }
    },
    {
      "edge": "M904",
      "attrs": {
        "text": "Monsieur, I have to tell you the truth.",
        "start_hhmmss": "01:04:47",
        "end_hhmmss": "01:04:49",
        "start": 3886.55,
        "end": 3888.719
      }
    },
    {
      "edge": "M905",
      "attrs": {
        "text": "I adore that child.",
        "start_hhmmss": "01:04:49",
        "end_hhmmss": "01:04:50",
        "start": 3888.927,
        "end": 3890.105653846154
      }
    },
    {
      "edge": "M906",
      "attrs": {
        "text": "You adore her?",
        "start_hhmmss": "01:04:50",
        "end_hhmmss": "01:04:51",
        "start": 3890.105653846154,
        "end": 3890.97
      }
    },
    {
      "edge": "M907",
      "attrs": {
        "text": "Yes, it's true. I'm not rich.",
        "start_hhmmss": "01:04:51",
        "end_hhmmss": "01:04:54",
        "start": 3891.179,
        "end": 3894.057
      }
    },
    {
      "edge": "M908",
      "attrs": {
        "text": "I've had to pay over 400 francs for her medicine.",
        "start_hhmmss": "01:04:54",
        "end_hhmmss": "01:04:57",
        "start": 3894.265,
        "end": 3897.143
      }
    },
    {
      "edge": "M909",
      "attrs": {
        "text": "But I'm a stupid man. I have no sense...",
        "start_hhmmss": "01:04:57",
        "end_hhmmss": "01:05:00",
        "start": 3897.352,
        "end": 3900.271
      }
    },
    {
      "edge": "M910",
      "attrs": {
        "text": "...just a heart. A big heart.",
        "start_hhmmss": "01:05:00",
        "end_hhmmss": "01:05:04",
        "start": 3900.481,
        "end": 3903.942
      }
    },
    {
      "edge": "M911",
      "attrs": {
        "text": "You paid over 400 francs?",
        "start_hhmmss": "01:05:04",
        "end_hhmmss": "01:05:06",
        "start": 3904.15,
        "end": 3906.252535714286
      }
    },
    {
      "edge": "M912",
      "attrs": {
        "text": "Five hundred.",
        "start_hhmmss": "01:05:06",
        "end_hhmmss": "01:05:08",
        "start": 3906.252535714286,
        "end": 3907.613
      }
    },
    {
      "edge": "M913",
      "attrs": {
        "text": "Five hundred. All right. I want to leave right away.",
        "start_hhmmss": "01:05:11",
        "end_hhmmss": "01:05:15",
        "start": 3910.574,
        "end": 3914.994
      }
    },
    {
      "edge": "M914",
      "attrs": {
        "text": "I'm sorry, monsieur, but her mother gave her to us to protect.",
        "start_hhmmss": "01:05:15",
        "end_hhmmss": "01:05:20",
        "start": 3915.203,
        "end": 3919.5
      }
    },
    {
      "edge": "M915",
      "attrs": {
        "text": "I can't let a stranger take her.",
        "start_hhmmss": "01:05:20",
        "end_hhmmss": "01:05:21",
        "start": 3919.708,
        "end": 3921.483225806452
      }
    },
    {
      "edge": "M916",
      "attrs": {
        "text": "How much?",
        "start_hhmmss": "01:05:21",
        "end_hhmmss": "01:05:22",
        "start": 3921.483225806452,
        "end": 3922.001
      }
    },
    {
      "edge": "M917",
      "attrs": {
        "text": "This isn't a question of money. What right do you have to the girl?",
        "start_hhmmss": "01:05:22",
        "end_hhmmss": "01:05:26",
        "start": 3922.21,
        "end": 3925.964
      }
    },
    {
      "edge": "M918",
      "attrs": {
        "text": "You don't want money?",
        "start_hhmmss": "01:05:26",
        "end_hhmmss": "01:05:27",
        "start": 3926.172,
        "end": 3927.334074074074
      }
    },
    {
      "edge": "M919",
      "attrs": {
        "text": "Of course not.",
        "start_hhmmss": "01:05:27",
        "end_hhmmss": "01:05:28",
        "start": 3927.334074074074,
        "end": 3928.133
      }
    },
    {
      "edge": "M920",
      "attrs": {
        "text": "Even if you were to offer 1000 francs, even 1,200, I couldn't give her to you.",
        "start_hhmmss": "01:05:28",
        "end_hhmmss": "01:05:33",
        "start": 3928.341,
        "end": 3933.138
      }
    },
    {
      "edge": "M921",
      "attrs": {
        "text": "It's true, I owe 1,500 francs...",
        "start_hhmmss": "01:05:34",
        "end_hhmmss": "01:05:36",
        "start": 3933.889,
        "end": 3935.558
      }
    },
    {
      "edge": "M922",
      "attrs": {
        "text": "...and my whole life would be solved if only I had 1,500 francs, but....",
        "start_hhmmss": "01:05:36",
        "end_hhmmss": "01:05:40",
        "start": 3935.766,
        "end": 3939.936
      }
    },
    {
      "edge": "M923",
      "attrs": {
        "text": "No, I can't think about money. It's a question of law.",
        "start_hhmmss": "01:05:40",
        "end_hhmmss": "01:05:45",
        "start": 3940.145,
        "end": 3944.859
      }
    },
    {
      "edge": "M924",
      "attrs": {
        "text": "All that matters is who has the right to the child.",
        "start_hhmmss": "01:05:45",
        "end_hhmmss": "01:05:48",
        "start": 3945.066,
        "end": 3948.111
      }
    },
    {
      "edge": "M925",
      "attrs": {
        "text": "That's a relief.",
        "start_hhmmss": "01:05:48",
        "end_hhmmss": "01:05:49",
        "start": 3948.319,
        "end": 3949.488
      }
    },
    {
      "edge": "M926",
      "attrs": {
        "text": "Here's a letter from Cosette's mother authorizing me to take her.",
        "start_hhmmss": "01:05:51",
        "end_hhmmss": "01:05:55",
        "start": 3950.989,
        "end": 3954.743
      }
    },
    {
      "edge": "M927",
      "attrs": {
        "text": "Cosette, quick.",
        "start_hhmmss": "01:06:15",
        "end_hhmmss": "01:06:16",
        "start": 3974.889,
        "end": 3976.431
      }
    },
    {
      "edge": "M928",
      "attrs": {
        "text": "Do we have to walk all the way to Paris?",
        "start_hhmmss": "01:06:33",
        "end_hhmmss": "01:06:35",
        "start": 3992.781,
        "end": 3994.998954545455
      }
    },
    {
      "edge": "M929",
      "attrs": {
        "text": "Yes. Are you tired?",
        "start_hhmmss": "01:06:35",
        "end_hhmmss": "01:06:36",
        "start": 3994.998954545455,
        "end": 3996.034
      }
    },
    {
      "edge": "M930",
      "attrs": {
        "text": "No, monsieur. I'm all right.",
        "start_hhmmss": "01:06:36",
        "end_hhmmss": "01:06:38",
        "start": 3996.242,
        "end": 3997.745
      }
    },
    {
      "edge": "M931",
      "attrs": {
        "text": "Cosette, best not to call me \"monsieur.\"",
        "start_hhmmss": "01:06:38",
        "end_hhmmss": "01:06:41",
        "start": 3997.953,
        "end": 4000.664
      }
    },
    {
      "edge": "M932",
      "attrs": {
        "text": "People will think we're strangers.",
        "start_hhmmss": "01:06:41",
        "end_hhmmss": "01:06:43",
        "start": 4000.873,
        "end": 4002.900789473684
      }
    },
    {
      "edge": "M933",
      "attrs": {
        "text": "Then what shall I call you, monsieur?",
        "start_hhmmss": "01:06:43",
        "end_hhmmss": "01:06:45",
        "start": 4002.900789473684,
        "end": 4005.001
      }
    },
    {
      "edge": "M934",
      "attrs": {
        "text": "Well, \"papa.\" What about \"papa\"?",
        "start_hhmmss": "01:06:45",
        "end_hhmmss": "01:06:48",
        "start": 4005.21,
        "end": 4008.338
      }
    },
    {
      "edge": "M935",
      "attrs": {
        "text": "But you're not my father, monsieur, are you?",
        "start_hhmmss": "01:06:49",
        "end_hhmmss": "01:06:52",
        "start": 4008.547,
        "end": 4011.926
      }
    },
    {
      "edge": "M936",
      "attrs": {
        "text": "Want me to carry you?",
        "start_hhmmss": "01:06:53",
        "end_hhmmss": "01:06:55",
        "start": 4013.218,
        "end": 4015.178
      }
    },
    {
      "edge": "M937",
      "attrs": {
        "text": "I can reach the branches.",
        "start_hhmmss": "01:07:01",
        "end_hhmmss": "01:07:02",
        "start": 4020.726,
        "end": 4022.358765957447
      }
    },
    {
      "edge": "M938",
      "attrs": {
        "text": "You're the tallest lady in France.",
        "start_hhmmss": "01:07:02",
        "end_hhmmss": "01:07:05",
        "start": 4022.358765957447,
        "end": 4024.563
      }
    },
    {
      "edge": "M939",
      "attrs": {
        "text": "I'm the queen of France.",
        "start_hhmmss": "01:07:05",
        "end_hhmmss": "01:07:07",
        "start": 4024.772,
        "end": 4026.568142857143
      }
    },
    {
      "edge": "M940",
      "attrs": {
        "text": "That's right...",
        "start_hhmmss": "01:07:07",
        "end_hhmmss": "01:07:08",
        "start": 4026.568142857143,
        "end": 4027.566
      }
    },
    {
      "edge": "M941",
      "attrs": {
        "text": "...you're the queen of France.",
        "start_hhmmss": "01:07:08",
        "end_hhmmss": "01:07:10",
        "start": 4027.775,
        "end": 4029.902
      }
    },
    {
      "edge": "M942",
      "attrs": {
        "text": "You're the queen, Cosette.",
        "start_hhmmss": "01:07:10",
        "end_hhmmss": "01:07:12",
        "start": 4030.109,
        "end": 4032.237
      }
    },
    {
      "edge": "M943",
      "attrs": {
        "text": "You're the queen.",
        "start_hhmmss": "01:07:13",
        "end_hhmmss": "01:07:14",
        "start": 4032.905,
        "end": 4033.948
      }
    },
    {
      "edge": "M944",
      "attrs": {
        "text": "Have your papers out and ready to be inspected when it's your turn.",
        "start_hhmmss": "01:07:19",
        "end_hhmmss": "01:07:22",
        "start": 4038.911,
        "end": 4042.413
      }
    },
    {
      "edge": "M945",
      "attrs": {
        "text": "Wake up. This is Paris.",
        "start_hhmmss": "01:07:23",
        "end_hhmmss": "01:07:24",
        "start": 4042.623,
        "end": 4043.916
      }
    },
    {
      "edge": "M946",
      "attrs": {
        "text": "Form an orderly queue. Have your papers ready!",
        "start_hhmmss": "01:07:24",
        "end_hhmmss": "01:07:28",
        "start": 4044.123,
        "end": 4048.003
      }
    },
    {
      "edge": "M947",
      "attrs": {
        "text": "Keep in line back there!",
        "start_hhmmss": "01:07:34",
        "end_hhmmss": "01:07:36",
        "start": 4054.259,
        "end": 4055.623833333333
      }
    },
    {
      "edge": "M948",
      "attrs": {
        "text": "Have your papers out...",
        "start_hhmmss": "01:07:36",
        "end_hhmmss": "01:07:37",
        "start": 4055.623833333333,
        "end": 4056.845
      }
    },
    {
      "edge": "M949",
      "attrs": {
        "text": "...and ready for inspection!",
        "start_hhmmss": "01:07:37",
        "end_hhmmss": "01:07:40",
        "start": 4057.053,
        "end": 4059.932
      }
    },
    {
      "edge": "M950",
      "attrs": {
        "text": "Let these carriages through!",
        "start_hhmmss": "01:07:43",
        "end_hhmmss": "01:07:45",
        "start": 4062.643,
        "end": 4065.436
      }
    },
    {
      "edge": "M951",
      "attrs": {
        "text": "We must get to here.",
        "start_hhmmss": "01:07:47",
        "end_hhmmss": "01:07:48",
        "start": 4066.73,
        "end": 4067.773
      }
    },
    {
      "edge": "M952",
      "attrs": {
        "text": "Have your papers out and ready for inspection.",
        "start_hhmmss": "01:07:50",
        "end_hhmmss": "01:07:54",
        "start": 4070.025,
        "end": 4074.153
      }
    },
    {
      "edge": "M953",
      "attrs": {
        "text": "Cosette, listen.",
        "start_hhmmss": "01:07:55",
        "end_hhmmss": "01:07:58",
        "start": 4075.321,
        "end": 4077.575
      }
    },
    {
      "edge": "M954",
      "attrs": {
        "text": "Wait here. Wait here. I won't be long. All right?",
        "start_hhmmss": "01:07:58",
        "end_hhmmss": "01:08:01",
        "start": 4077.783,
        "end": 4080.995
      }
    },
    {
      "edge": "M955",
      "attrs": {
        "text": "Have your papers out and ready for inspection!",
        "start_hhmmss": "01:08:01",
        "end_hhmmss": "01:08:04",
        "start": 4081.202,
        "end": 4083.747
      }
    },
    {
      "edge": "M956",
      "attrs": {
        "text": "Don't leave me!",
        "start_hhmmss": "01:08:06",
        "end_hhmmss": "01:08:08",
        "start": 4085.958,
        "end": 4088.251
      }
    },
    {
      "edge": "M957",
      "attrs": {
        "text": "Wait your turn!",
        "start_hhmmss": "01:08:09",
        "end_hhmmss": "01:08:10",
        "start": 4088.586,
        "end": 4089.878
      }
    },
    {
      "edge": "M958",
      "attrs": {
        "text": "You have to be quiet. I'm just having a look at the wall.",
        "start_hhmmss": "01:08:10",
        "end_hhmmss": "01:08:13",
        "start": 4090.086,
        "end": 4093.381
      }
    },
    {
      "edge": "M959",
      "attrs": {
        "text": "I'm not leaving you.",
        "start_hhmmss": "01:08:14",
        "end_hhmmss": "01:08:15",
        "start": 4093.591,
        "end": 4095.3
      }
    },
    {
      "edge": "M960",
      "attrs": {
        "text": "Are we gonna climb that wall?",
        "start_hhmmss": "01:08:16",
        "end_hhmmss": "01:08:18",
        "start": 4095.508,
        "end": 4098.4608461538455
      }
    },
    {
      "edge": "M961",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "01:08:18",
        "end_hhmmss": "01:08:19",
        "start": 4098.4608461538455,
        "end": 4098.846
      }
    },
    {
      "edge": "M962",
      "attrs": {
        "text": "All right?",
        "start_hhmmss": "01:08:19",
        "end_hhmmss": "01:08:21",
        "start": 4099.054,
        "end": 4100.889
      }
    },
    {
      "edge": "M963",
      "attrs": {
        "text": "Come on, move along, then!",
        "start_hhmmss": "01:08:24",
        "end_hhmmss": "01:08:26",
        "start": 4103.767,
        "end": 4105.558782608696
      }
    },
    {
      "edge": "M964",
      "attrs": {
        "text": "Papa!",
        "start_hhmmss": "01:08:26",
        "end_hhmmss": "01:08:26",
        "start": 4105.558782608696,
        "end": 4105.936
      }
    },
    {
      "edge": "M965",
      "attrs": {
        "text": "But you told me to call you Papa.",
        "start_hhmmss": "01:08:26",
        "end_hhmmss": "01:08:29",
        "start": 4106.144,
        "end": 4108.856
      }
    },
    {
      "edge": "M966",
      "attrs": {
        "text": "You, where are your documents?",
        "start_hhmmss": "01:08:29",
        "end_hhmmss": "01:08:31",
        "start": 4109.064,
        "end": 4111.316
      }
    },
    {
      "edge": "M967",
      "attrs": {
        "text": "No luck yet.",
        "start_hhmmss": "01:08:32",
        "end_hhmmss": "01:08:33",
        "start": 4111.692,
        "end": 4113.172500000001
      }
    },
    {
      "edge": "M968",
      "attrs": {
        "text": "He's on foot.",
        "start_hhmmss": "01:08:33",
        "end_hhmmss": "01:08:35",
        "start": 4113.172500000001,
        "end": 4114.653
      }
    },
    {
      "edge": "M969",
      "attrs": {
        "text": "The little girl would slow him down.",
        "start_hhmmss": "01:08:35",
        "end_hhmmss": "01:08:37",
        "start": 4114.862,
        "end": 4117.405
      }
    },
    {
      "edge": "M970",
      "attrs": {
        "text": "Well, Javert...",
        "start_hhmmss": "01:08:38",
        "end_hhmmss": "01:08:41",
        "start": 4118.156,
        "end": 4120.784
      }
    },
    {
      "edge": "M971",
      "attrs": {
        "text": "...you said he was Valjean, and we ignored you.",
        "start_hhmmss": "01:08:41",
        "end_hhmmss": "01:08:44",
        "start": 4120.993,
        "end": 4123.912
      }
    },
    {
      "edge": "M972",
      "attrs": {
        "text": "Rather than apologize, I want you to know...",
        "start_hhmmss": "01:08:44",
        "end_hhmmss": "01:08:47",
        "start": 4124.12,
        "end": 4126.79
      }
    },
    {
      "edge": "M973",
      "attrs": {
        "text": "...that I've asked the prefect to transfer you to Paris...",
        "start_hhmmss": "01:08:47",
        "end_hhmmss": "01:08:51",
        "start": 4126.999,
        "end": 4130.753
      }
    },
    {
      "edge": "M974",
      "attrs": {
        "text": "...to work as my deputy.",
        "start_hhmmss": "01:08:51",
        "end_hhmmss": "01:08:54",
        "start": 4130.961,
        "end": 4133.631
      }
    },
    {
      "edge": "M975",
      "attrs": {
        "text": "Monsieur, I'm honored. Thank you.",
        "start_hhmmss": "01:08:56",
        "end_hhmmss": "01:08:59",
        "start": 4135.758,
        "end": 4138.612166666667
      }
    },
    {
      "edge": "M976",
      "attrs": {
        "text": "Have your papers out!",
        "start_hhmmss": "01:08:59",
        "end_hhmmss": "01:09:01",
        "start": 4138.612166666667,
        "end": 4140.553
      }
    },
    {
      "edge": "M977",
      "attrs": {
        "text": "Meanwhile, these men are at your disposal to find Valjean.",
        "start_hhmmss": "01:09:01",
        "end_hhmmss": "01:09:05",
        "start": 4140.763,
        "end": 4145.475
      }
    },
    {
      "edge": "M978",
      "attrs": {
        "text": "Have your papers out!",
        "start_hhmmss": "01:09:08",
        "end_hhmmss": "01:09:10",
        "start": 4147.728,
        "end": 4150.313
      }
    },
    {
      "edge": "M979",
      "attrs": {
        "text": "All right, Cosette, give me your doll. Now, climb on my back.",
        "start_hhmmss": "01:09:13",
        "end_hhmmss": "01:09:18",
        "start": 4153.358,
        "end": 4157.905
      }
    },
    {
      "edge": "M980",
      "attrs": {
        "text": "Go on. Here, put your foot here. Go on.",
        "start_hhmmss": "01:09:18",
        "end_hhmmss": "01:09:22",
        "start": 4158.113,
        "end": 4162.45
      }
    },
    {
      "edge": "M981",
      "attrs": {
        "text": "That's it. Big jump.",
        "start_hhmmss": "01:09:23",
        "end_hhmmss": "01:09:24",
        "start": 4162.66,
        "end": 4164.41
      }
    },
    {
      "edge": "M982",
      "attrs": {
        "text": "That's a girl. All right?",
        "start_hhmmss": "01:09:25",
        "end_hhmmss": "01:09:27",
        "start": 4164.619,
        "end": 4167.33
      }
    },
    {
      "edge": "M983",
      "attrs": {
        "text": "You, where are your documents?",
        "start_hhmmss": "01:09:33",
        "end_hhmmss": "01:09:36",
        "start": 4173.336,
        "end": 4175.798
      }
    },
    {
      "edge": "M984",
      "attrs": {
        "text": "Papa, I'm frightened.",
        "start_hhmmss": "01:09:43",
        "end_hhmmss": "01:09:44",
        "start": 4182.637,
        "end": 4184.449
      }
    },
    {
      "edge": "M985",
      "attrs": {
        "text": "Don't look down.",
        "start_hhmmss": "01:09:44",
        "end_hhmmss": "01:09:46",
        "start": 4184.449,
        "end": 4185.808
      }
    },
    {
      "edge": "M986",
      "attrs": {
        "text": "Of course he won't.",
        "start_hhmmss": "01:09:50",
        "end_hhmmss": "01:09:52",
        "start": 4190.478,
        "end": 4191.897
      }
    },
    {
      "edge": "M987",
      "attrs": {
        "text": "Pardon me, Javert. He won't what?",
        "start_hhmmss": "01:09:52",
        "end_hhmmss": "01:09:54",
        "start": 4192.106,
        "end": 4194.399
      }
    },
    {
      "edge": "M988",
      "attrs": {
        "text": "Have your papers ready!",
        "start_hhmmss": "01:09:55",
        "end_hhmmss": "01:09:57",
        "start": 4194.607,
        "end": 4197.152
      }
    },
    {
      "edge": "M989",
      "attrs": {
        "text": "I want three of you to walk around the wall.",
        "start_hhmmss": "01:09:57",
        "end_hhmmss": "01:10:00",
        "start": 4197.36,
        "end": 4200.114
      }
    },
    {
      "edge": "M990",
      "attrs": {
        "text": "Look for a gap where someone could jump onto a roof. Go!",
        "start_hhmmss": "01:10:00",
        "end_hhmmss": "01:10:03",
        "start": 4200.321,
        "end": 4203.324
      }
    },
    {
      "edge": "M991",
      "attrs": {
        "text": "I don't understand.",
        "start_hhmmss": "01:10:04",
        "end_hhmmss": "01:10:05",
        "start": 4203.533,
        "end": 4204.835162162162
      }
    },
    {
      "edge": "M992",
      "attrs": {
        "text": "He has no proper papers, sir.",
        "start_hhmmss": "01:10:05",
        "end_hhmmss": "01:10:07",
        "start": 4204.835162162162,
        "end": 4206.745
      }
    },
    {
      "edge": "M993",
      "attrs": {
        "text": "He won't come through here.",
        "start_hhmmss": "01:10:07",
        "end_hhmmss": "01:10:09",
        "start": 4206.954,
        "end": 4208.831
      }
    },
    {
      "edge": "M994",
      "attrs": {
        "text": "Watch here.",
        "start_hhmmss": "01:10:21",
        "end_hhmmss": "01:10:23",
        "start": 4221.217,
        "end": 4222.6432
      }
    },
    {
      "edge": "M995",
      "attrs": {
        "text": "Yes, sir.",
        "start_hhmmss": "01:10:23",
        "end_hhmmss": "01:10:24",
        "start": 4222.6432,
        "end": 4223.594
      }
    },
    {
      "edge": "M996",
      "attrs": {
        "text": "Stay down. Stay down.",
        "start_hhmmss": "01:10:28",
        "end_hhmmss": "01:10:30",
        "start": 4228.1,
        "end": 4230.018
      }
    },
    {
      "edge": "M997",
      "attrs": {
        "text": "We'll have to cross here.",
        "start_hhmmss": "01:10:47",
        "end_hhmmss": "01:10:49",
        "start": 4246.952,
        "end": 4248.661
      }
    },
    {
      "edge": "M998",
      "attrs": {
        "text": "Shut up! Do you wanna get us killed?",
        "start_hhmmss": "01:10:55",
        "end_hhmmss": "01:10:58",
        "start": 4255.334,
        "end": 4257.963
      }
    },
    {
      "edge": "M999",
      "attrs": {
        "text": "Cosette, I'm sorry. I'm sorry. It's all right.",
        "start_hhmmss": "01:10:58",
        "end_hhmmss": "01:11:01",
        "start": 4258.421,
        "end": 4260.841
      }
    },
    {
      "edge": "M1000",
      "attrs": {
        "text": "I'm sorry. But we have to be quiet. We can't make a noise.",
        "start_hhmmss": "01:11:01",
        "end_hhmmss": "01:11:04",
        "start": 4261.049,
        "end": 4264.385
      }
    },
    {
      "edge": "M1001",
      "attrs": {
        "text": "This is the only place we can get over.",
        "start_hhmmss": "01:11:05",
        "end_hhmmss": "01:11:08",
        "start": 4264.594,
        "end": 4267.931
      }
    },
    {
      "edge": "M1002",
      "attrs": {
        "text": "Listen to me. We have to jump.",
        "start_hhmmss": "01:11:08",
        "end_hhmmss": "01:11:11",
        "start": 4268.14,
        "end": 4271.434
      }
    },
    {
      "edge": "M1003",
      "attrs": {
        "text": "Valjean!",
        "start_hhmmss": "01:11:29",
        "end_hhmmss": "01:11:31",
        "start": 4289.244,
        "end": 4290.578
      }
    },
    {
      "edge": "M1004",
      "attrs": {
        "text": "Come on. Take my hand.",
        "start_hhmmss": "01:11:32",
        "end_hhmmss": "01:11:34",
        "start": 4292.039,
        "end": 4294.208
      }
    },
    {
      "edge": "M1005",
      "attrs": {
        "text": "What's on the other side of this wall?",
        "start_hhmmss": "01:11:51",
        "end_hhmmss": "01:11:53",
        "start": 4310.974,
        "end": 4313.27225
      }
    },
    {
      "edge": "M1006",
      "attrs": {
        "text": "It's a convent.",
        "start_hhmmss": "01:11:53",
        "end_hhmmss": "01:11:54",
        "start": 4313.27225,
        "end": 4314.144
      }
    },
    {
      "edge": "M1007",
      "attrs": {
        "text": "Javert, I am not going to wake up a building full of nuns...",
        "start_hhmmss": "01:12:01",
        "end_hhmmss": "01:12:05",
        "start": 4321.359,
        "end": 4324.654
      }
    },
    {
      "edge": "M1008",
      "attrs": {
        "text": "...and search their beds.",
        "start_hhmmss": "01:12:05",
        "end_hhmmss": "01:12:06",
        "start": 4324.863,
        "end": 4326.171461538462
      }
    },
    {
      "edge": "M1009",
      "attrs": {
        "text": "It's for their protection.",
        "start_hhmmss": "01:12:06",
        "end_hhmmss": "01:12:08",
        "start": 4326.171461538462,
        "end": 4327.698
      }
    },
    {
      "edge": "M1010",
      "attrs": {
        "text": "This is a strict order. The nuns aren't permitted to look or speak to a man.",
        "start_hhmmss": "01:12:08",
        "end_hhmmss": "01:12:12",
        "start": 4327.908,
        "end": 4331.912
      }
    },
    {
      "edge": "M1011",
      "attrs": {
        "text": "It's a school for girls. They must be protected.",
        "start_hhmmss": "01:12:12",
        "end_hhmmss": "01:12:15",
        "start": 4332.12,
        "end": 4334.622
      }
    },
    {
      "edge": "M1012",
      "attrs": {
        "text": "The girls are daughters of the aristocracy, whose parents would...",
        "start_hhmmss": "01:12:15",
        "end_hhmmss": "01:12:18",
        "start": 4334.832,
        "end": 4338.293
      }
    },
    {
      "edge": "M1013",
      "attrs": {
        "text": "...have you guillotined if you're wrong.",
        "start_hhmmss": "01:12:19",
        "end_hhmmss": "01:12:21",
        "start": 4338.501,
        "end": 4340.951
      }
    },
    {
      "edge": "M1014",
      "attrs": {
        "text": "Sir, I know he's in there.",
        "start_hhmmss": "01:12:21",
        "end_hhmmss": "01:12:22",
        "start": 4340.951,
        "end": 4342.421
      }
    },
    {
      "edge": "M1015",
      "attrs": {
        "text": "What?",
        "start_hhmmss": "01:12:26",
        "end_hhmmss": "01:12:27",
        "start": 4345.591,
        "end": 4347.052
      }
    },
    {
      "edge": "M1016",
      "attrs": {
        "text": "Who are you?",
        "start_hhmmss": "01:12:28",
        "end_hhmmss": "01:12:29",
        "start": 4347.886,
        "end": 4348.929
      }
    },
    {
      "edge": "M1017",
      "attrs": {
        "text": "Now I'm trapped under the cart, Lafitte.",
        "start_hhmmss": "01:12:31",
        "end_hhmmss": "01:12:34",
        "start": 4350.973,
        "end": 4353.934
      }
    },
    {
      "edge": "M1018",
      "attrs": {
        "text": "If you would collect all the nuns, sisters and schoolgirls...",
        "start_hhmmss": "01:12:36",
        "end_hhmmss": "01:12:40",
        "start": 4356.352,
        "end": 4359.522
      }
    },
    {
      "edge": "M1019",
      "attrs": {
        "text": "...in the chapel, my men could search everywhere else.",
        "start_hhmmss": "01:12:40",
        "end_hhmmss": "01:12:43",
        "start": 4359.73,
        "end": 4362.985
      }
    },
    {
      "edge": "M1020",
      "attrs": {
        "text": "We are not afraid of men. We are here to adore Christ.",
        "start_hhmmss": "01:12:43",
        "end_hhmmss": "01:12:46",
        "start": 4363.193,
        "end": 4366.238
      }
    },
    {
      "edge": "M1021",
      "attrs": {
        "text": "I can't protect you from here.",
        "start_hhmmss": "01:12:46",
        "end_hhmmss": "01:12:48",
        "start": 4366.445,
        "end": 4368.2298
      }
    },
    {
      "edge": "M1022",
      "attrs": {
        "text": "A search of our school or convent...",
        "start_hhmmss": "01:12:48",
        "end_hhmmss": "01:12:50",
        "start": 4368.2298,
        "end": 4370.325
      }
    },
    {
      "edge": "M1023",
      "attrs": {
        "text": "...is impossible. I'm sorry, inspector.",
        "start_hhmmss": "01:12:51",
        "end_hhmmss": "01:12:53",
        "start": 4370.533,
        "end": 4373.411
      }
    },
    {
      "edge": "M1024",
      "attrs": {
        "text": "I've told the mother superior you're my brother. You'll be the new gardener.",
        "start_hhmmss": "01:13:08",
        "end_hhmmss": "01:13:12",
        "start": 4387.675,
        "end": 4391.972
      }
    },
    {
      "edge": "M1025",
      "attrs": {
        "text": "Good, thank you. And tomorrow...",
        "start_hhmmss": "01:13:12",
        "end_hhmmss": "01:13:15",
        "start": 4392.18,
        "end": 4394.599
      }
    },
    {
      "edge": "M1026",
      "attrs": {
        "text": "...can you arrange for her to go to school here? I can pay.",
        "start_hhmmss": "01:13:15",
        "end_hhmmss": "01:13:18",
        "start": 4394.807,
        "end": 4398.477
      }
    },
    {
      "edge": "M1027",
      "attrs": {
        "text": "Who is she?",
        "start_hhmmss": "01:13:19",
        "end_hhmmss": "01:13:20",
        "start": 4398.686,
        "end": 4400.479
      }
    },
    {
      "edge": "M1028",
      "attrs": {
        "text": "She's an orphan.",
        "start_hhmmss": "01:13:24",
        "end_hhmmss": "01:13:25",
        "start": 4403.691,
        "end": 4405.36
      }
    },
    {
      "edge": "M1029",
      "attrs": {
        "text": "She'll be with me now.",
        "start_hhmmss": "01:13:26",
        "end_hhmmss": "01:13:29",
        "start": 4406.485,
        "end": 4409.031
      }
    },
    {
      "edge": "M1030",
      "attrs": {
        "text": "Pity.",
        "start_hhmmss": "01:14:32",
        "end_hhmmss": "01:14:34",
        "start": 4472.135,
        "end": 4473.532
      }
    },
    {
      "edge": "M1031",
      "attrs": {
        "text": "What?",
        "start_hhmmss": "01:14:34",
        "end_hhmmss": "01:14:35",
        "start": 4473.532,
        "end": 4474.929
      }
    },
    {
      "edge": "M1032",
      "attrs": {
        "text": "I was thinking of next year when it'll be Cosette's turn.",
        "start_hhmmss": "01:14:35",
        "end_hhmmss": "01:14:39",
        "start": 4475.138,
        "end": 4478.557
      }
    },
    {
      "edge": "M1033",
      "attrs": {
        "text": "Is it a pity to be devoted to Christ?",
        "start_hhmmss": "01:14:39",
        "end_hhmmss": "01:14:41",
        "start": 4478.766,
        "end": 4480.726
      }
    },
    {
      "edge": "M1034",
      "attrs": {
        "text": "A beautiful nun is a tragic waste.",
        "start_hhmmss": "01:14:42",
        "end_hhmmss": "01:14:44",
        "start": 4481.894,
        "end": 4484.231
      }
    },
    {
      "edge": "M1035",
      "attrs": {
        "text": "Well, even though Cosette will be stuck here...",
        "start_hhmmss": "01:14:46",
        "end_hhmmss": "01:14:49",
        "start": 4486.233,
        "end": 4488.734
      }
    },
    {
      "edge": "M1036",
      "attrs": {
        "text": "...at least you can see the world. Or Paris, anyway.",
        "start_hhmmss": "01:14:49",
        "end_hhmmss": "01:14:54",
        "start": 4488.943,
        "end": 4493.823
      }
    },
    {
      "edge": "M1037",
      "attrs": {
        "text": "Aren't you curious?",
        "start_hhmmss": "01:14:54",
        "end_hhmmss": "01:14:56",
        "start": 4494.032,
        "end": 4495.993
      }
    },
    {
      "edge": "M1038",
      "attrs": {
        "text": "You haven't been outside now in how many years?",
        "start_hhmmss": "01:14:56",
        "end_hhmmss": "01:14:59",
        "start": 4496.201,
        "end": 4499.162
      }
    },
    {
      "edge": "M1039",
      "attrs": {
        "text": "The world never changes, Lafitte.",
        "start_hhmmss": "01:14:59",
        "end_hhmmss": "01:15:01",
        "start": 4499.371,
        "end": 4501.123
      }
    },
    {
      "edge": "M1040",
      "attrs": {
        "text": "It is changing. You should have a look for yourself.",
        "start_hhmmss": "01:15:01",
        "end_hhmmss": "01:15:06",
        "start": 4501.331,
        "end": 4505.543
      }
    },
    {
      "edge": "M1041",
      "attrs": {
        "text": "You'll be surprised.",
        "start_hhmmss": "01:15:06",
        "end_hhmmss": "01:15:08",
        "start": 4505.751,
        "end": 4508.338
      }
    },
    {
      "edge": "M1042",
      "attrs": {
        "text": "What are you looking at?",
        "start_hhmmss": "01:15:25",
        "end_hhmmss": "01:15:27",
        "start": 4524.603,
        "end": 4526.800522727272
      }
    },
    {
      "edge": "M1043",
      "attrs": {
        "text": "Just watching the people go by.",
        "start_hhmmss": "01:15:27",
        "end_hhmmss": "01:15:30",
        "start": 4526.800522727272,
        "end": 4529.692
      }
    },
    {
      "edge": "M1044",
      "attrs": {
        "text": "I don't want to take my vows.",
        "start_hhmmss": "01:15:33",
        "end_hhmmss": "01:15:34",
        "start": 4532.903,
        "end": 4534.351571428571
      }
    },
    {
      "edge": "M1045",
      "attrs": {
        "text": "You promised the mother superior.",
        "start_hhmmss": "01:15:34",
        "end_hhmmss": "01:15:36",
        "start": 4534.351571428571,
        "end": 4536.283
      }
    },
    {
      "edge": "M1046",
      "attrs": {
        "text": "I want to leave. Please.",
        "start_hhmmss": "01:15:36",
        "end_hhmmss": "01:15:38",
        "start": 4536.491,
        "end": 4538.076
      }
    },
    {
      "edge": "M1047",
      "attrs": {
        "text": "But we're safe here.",
        "start_hhmmss": "01:15:38",
        "end_hhmmss": "01:15:40",
        "start": 4538.285,
        "end": 4539.515483870968
      }
    },
    {
      "edge": "M1048",
      "attrs": {
        "text": "Safe from what, Papa?",
        "start_hhmmss": "01:15:40",
        "end_hhmmss": "01:15:41",
        "start": 4539.515483870968,
        "end": 4540.828
      }
    },
    {
      "edge": "M1049",
      "attrs": {
        "text": "We have everything we need. I can work here, be near you.",
        "start_hhmmss": "01:15:41",
        "end_hhmmss": "01:15:44",
        "start": 4541.038,
        "end": 4544.041
      }
    },
    {
      "edge": "M1050",
      "attrs": {
        "text": "We have a good life here.",
        "start_hhmmss": "01:15:44",
        "end_hhmmss": "01:15:46",
        "start": 4544.249,
        "end": 4546.46151724138
      }
    },
    {
      "edge": "M1051",
      "attrs": {
        "text": "Please, Papa.",
        "start_hhmmss": "01:15:46",
        "end_hhmmss": "01:15:48",
        "start": 4546.46151724138,
        "end": 4547.626
      }
    },
    {
      "edge": "M1052",
      "attrs": {
        "text": "I'll think about it.",
        "start_hhmmss": "01:15:49",
        "end_hhmmss": "01:15:52",
        "start": 4549.212,
        "end": 4552.006
      }
    },
    {
      "edge": "M1053",
      "attrs": {
        "text": "We're very grateful for everything you've done...",
        "start_hhmmss": "01:15:53",
        "end_hhmmss": "01:15:56",
        "start": 4552.965,
        "end": 4555.634
      }
    },
    {
      "edge": "M1054",
      "attrs": {
        "text": "...but my daughter's happiness is what's most important to me.",
        "start_hhmmss": "01:15:56",
        "end_hhmmss": "01:16:00",
        "start": 4555.843,
        "end": 4559.514
      }
    },
    {
      "edge": "M1055",
      "attrs": {
        "text": "Naturally I'm disappointed Cosette has changed her mind.",
        "start_hhmmss": "01:16:00",
        "end_hhmmss": "01:16:03",
        "start": 4559.722,
        "end": 4563.268
      }
    },
    {
      "edge": "M1056",
      "attrs": {
        "text": "But I too want to see her happy.",
        "start_hhmmss": "01:16:04",
        "end_hhmmss": "01:16:06",
        "start": 4563.726,
        "end": 4566.447749999999
      }
    },
    {
      "edge": "M1057",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:16:06",
        "end_hhmmss": "01:16:07",
        "start": 4566.447749999999,
        "end": 4567.355
      }
    },
    {
      "edge": "M1058",
      "attrs": {
        "text": "We shall leave as soon as I can find a suitable home.",
        "start_hhmmss": "01:16:08",
        "end_hhmmss": "01:16:11",
        "start": 4567.563,
        "end": 4570.525
      }
    },
    {
      "edge": "M1059",
      "attrs": {
        "text": "I was wondering-- I don't know anyone in Paris.",
        "start_hhmmss": "01:16:11",
        "end_hhmmss": "01:16:15",
        "start": 4570.733,
        "end": 4574.737
      }
    },
    {
      "edge": "M1060",
      "attrs": {
        "text": "If you could help me find a house in a decent area.",
        "start_hhmmss": "01:16:15",
        "end_hhmmss": "01:16:19",
        "start": 4574.945,
        "end": 4578.949
      }
    },
    {
      "edge": "M1061",
      "attrs": {
        "text": "But, Lafitte, how could you afford such a house?",
        "start_hhmmss": "01:16:19",
        "end_hhmmss": "01:16:22",
        "start": 4579.159,
        "end": 4582.245
      }
    },
    {
      "edge": "M1062",
      "attrs": {
        "text": "Before we came here, I had money.",
        "start_hhmmss": "01:16:23",
        "end_hhmmss": "01:16:25",
        "start": 4582.787,
        "end": 4585.415
      }
    },
    {
      "edge": "M1063",
      "attrs": {
        "text": "Family money that I saved to help provide for us.",
        "start_hhmmss": "01:16:26",
        "end_hhmmss": "01:16:30",
        "start": 4585.623,
        "end": 4590.212
      }
    },
    {
      "edge": "M1064",
      "attrs": {
        "text": "Well, I hope you're certain that you've made the right decision.",
        "start_hhmmss": "01:16:30",
        "end_hhmmss": "01:16:34",
        "start": 4590.42,
        "end": 4594.299
      }
    },
    {
      "edge": "M1065",
      "attrs": {
        "text": "I am.",
        "start_hhmmss": "01:16:35",
        "end_hhmmss": "01:16:37",
        "start": 4594.508,
        "end": 4596.592
      }
    },
    {
      "edge": "M1066",
      "attrs": {
        "text": "Look, Papa.",
        "start_hhmmss": "01:16:44",
        "end_hhmmss": "01:16:46",
        "start": 4604.142,
        "end": 4606.06
      }
    },
    {
      "edge": "M1067",
      "attrs": {
        "text": "I shan't be long.",
        "start_hhmmss": "01:17:05",
        "end_hhmmss": "01:17:06",
        "start": 4625.497,
        "end": 4626.43247826087
      }
    },
    {
      "edge": "M1068",
      "attrs": {
        "text": "I'll wait here.",
        "start_hhmmss": "01:17:06",
        "end_hhmmss": "01:17:07",
        "start": 4626.43247826087,
        "end": 4627.29
      }
    },
    {
      "edge": "M1069",
      "attrs": {
        "text": "All right. Don't leave the cab.",
        "start_hhmmss": "01:17:07",
        "end_hhmmss": "01:17:09",
        "start": 4627.499,
        "end": 4629.468918918919
      }
    },
    {
      "edge": "M1070",
      "attrs": {
        "text": "I'll stay put, Papa.",
        "start_hhmmss": "01:17:09",
        "end_hhmmss": "01:17:11",
        "start": 4629.468918918919,
        "end": 4630.668
      }
    },
    {
      "edge": "M1071",
      "attrs": {
        "text": "I'll be back soon.",
        "start_hhmmss": "01:17:24",
        "end_hhmmss": "01:17:27",
        "start": 4644.391,
        "end": 4646.56
      }
    },
    {
      "edge": "M1072",
      "attrs": {
        "text": "Ma'am, you got any money? Spare some money?",
        "start_hhmmss": "01:17:39",
        "end_hhmmss": "01:17:42",
        "start": 4659.322,
        "end": 4661.533
      }
    },
    {
      "edge": "M1073",
      "attrs": {
        "text": "--can't provide for your family. Strike for a decent wage. Why not?",
        "start_hhmmss": "01:17:43",
        "end_hhmmss": "01:17:48",
        "start": 4662.867,
        "end": 4668.038
      }
    },
    {
      "edge": "M1074",
      "attrs": {
        "text": "Because it's against the law to strike.",
        "start_hhmmss": "01:17:48",
        "end_hhmmss": "01:17:50",
        "start": 4668.248,
        "end": 4670.375
      }
    },
    {
      "edge": "M1075",
      "attrs": {
        "text": "The king has declared that everything is a crime. Writing is a crime.",
        "start_hhmmss": "01:17:51",
        "end_hhmmss": "01:17:55",
        "start": 4670.584,
        "end": 4675.38
      }
    },
    {
      "edge": "M1076",
      "attrs": {
        "text": "Two weeks ago, the police destroyed Égalité, the workers' newspaper.",
        "start_hhmmss": "01:17:56",
        "end_hhmmss": "01:17:59",
        "start": 4675.589,
        "end": 4679.426
      }
    },
    {
      "edge": "M1077",
      "attrs": {
        "text": "They smashed the press.",
        "start_hhmmss": "01:18:00",
        "end_hhmmss": "01:18:01",
        "start": 4679.634,
        "end": 4681.3645
      }
    },
    {
      "edge": "M1078",
      "attrs": {
        "text": "The man making a speech...",
        "start_hhmmss": "01:18:01",
        "end_hhmmss": "01:18:03",
        "start": 4681.3645,
        "end": 4683.094999999999
      }
    },
    {
      "edge": "M1079",
      "attrs": {
        "text": "...he's the leader of the ABC Society...",
        "start_hhmmss": "01:18:03",
        "end_hhmmss": "01:18:06",
        "start": 4683.305,
        "end": 4686.056
      }
    },
    {
      "edge": "M1080",
      "attrs": {
        "text": "...the largest and most dangerous of the student groups.",
        "start_hhmmss": "01:18:06",
        "end_hhmmss": "01:18:11",
        "start": 4686.266,
        "end": 4690.728
      }
    },
    {
      "edge": "M1081",
      "attrs": {
        "text": "They want the king out. They want suffrage without limitation.",
        "start_hhmmss": "01:18:11",
        "end_hhmmss": "01:18:15",
        "start": 4690.936,
        "end": 4694.857
      }
    },
    {
      "edge": "M1082",
      "attrs": {
        "text": "I don't care what they want. I want to know who they are.",
        "start_hhmmss": "01:18:15",
        "end_hhmmss": "01:18:18",
        "start": 4695.065,
        "end": 4698.445
      }
    },
    {
      "edge": "M1083",
      "attrs": {
        "text": "Speaking out is a crime.",
        "start_hhmmss": "01:18:19",
        "end_hhmmss": "01:18:20",
        "start": 4698.653,
        "end": 4700.145058823529
      }
    },
    {
      "edge": "M1084",
      "attrs": {
        "text": "Marius Pontmercy.",
        "start_hhmmss": "01:18:20",
        "end_hhmmss": "01:18:21",
        "start": 4700.145058823529,
        "end": 4701.323
      }
    },
    {
      "edge": "M1085",
      "attrs": {
        "text": "Rents a room above the Café Musain.",
        "start_hhmmss": "01:18:22",
        "end_hhmmss": "01:18:24",
        "start": 4701.531,
        "end": 4703.559280701755
      }
    },
    {
      "edge": "M1086",
      "attrs": {
        "text": "Being poor is the worst crime of all.",
        "start_hhmmss": "01:18:24",
        "end_hhmmss": "01:18:26",
        "start": 4703.559280701755,
        "end": 4705.66
      }
    },
    {
      "edge": "M1087",
      "attrs": {
        "text": "And if you commit these crimes, you are condemned for life.",
        "start_hhmmss": "01:18:26",
        "end_hhmmss": "01:18:30",
        "start": 4705.868,
        "end": 4709.747
      }
    },
    {
      "edge": "M1088",
      "attrs": {
        "text": "Concentrate on him.",
        "start_hhmmss": "01:18:30",
        "end_hhmmss": "01:18:31",
        "start": 4709.955,
        "end": 4711.067615384615
      }
    },
    {
      "edge": "M1089",
      "attrs": {
        "text": "Our government has no mercy...",
        "start_hhmmss": "01:18:31",
        "end_hhmmss": "01:18:33",
        "start": 4711.067615384615,
        "end": 4712.667
      }
    },
    {
      "edge": "M1090",
      "attrs": {
        "text": "...no pity, no forgiveness.",
        "start_hhmmss": "01:18:33",
        "end_hhmmss": "01:18:34",
        "start": 4712.875,
        "end": 4714.294
      }
    },
    {
      "edge": "M1091",
      "attrs": {
        "text": "And it has no work for us!",
        "start_hhmmss": "01:18:35",
        "end_hhmmss": "01:18:36",
        "start": 4714.502,
        "end": 4715.923647058824
      }
    },
    {
      "edge": "M1092",
      "attrs": {
        "text": "And there's no work.",
        "start_hhmmss": "01:18:36",
        "end_hhmmss": "01:18:37",
        "start": 4715.923647058824,
        "end": 4717.046
      }
    },
    {
      "edge": "M1093",
      "attrs": {
        "text": "And because there is no work, our children are starving. Tell me...",
        "start_hhmmss": "01:18:37",
        "end_hhmmss": "01:18:42",
        "start": 4717.255,
        "end": 4721.635
      }
    },
    {
      "edge": "M1094",
      "attrs": {
        "text": "...why are we powerless to save the people we love?",
        "start_hhmmss": "01:18:42",
        "end_hhmmss": "01:18:45",
        "start": 4721.842,
        "end": 4724.803
      }
    },
    {
      "edge": "M1095",
      "attrs": {
        "text": "You know. Tell me why.",
        "start_hhmmss": "01:18:45",
        "end_hhmmss": "01:18:46",
        "start": 4725.012,
        "end": 4726.223
      }
    },
    {
      "edge": "M1096",
      "attrs": {
        "text": "The king lied!",
        "start_hhmmss": "01:18:46",
        "end_hhmmss": "01:18:47",
        "start": 4726.431,
        "end": 4727.2175
      }
    },
    {
      "edge": "M1097",
      "attrs": {
        "text": "The king betrayed us.",
        "start_hhmmss": "01:18:47",
        "end_hhmmss": "01:18:48",
        "start": 4727.2175,
        "end": 4728.433
      }
    },
    {
      "edge": "M1098",
      "attrs": {
        "text": "We were promised the vote.",
        "start_hhmmss": "01:18:49",
        "end_hhmmss": "01:18:50",
        "start": 4728.642,
        "end": 4730.31
      }
    },
    {
      "edge": "M1099",
      "attrs": {
        "text": "Do we have the vote?",
        "start_hhmmss": "01:18:51",
        "end_hhmmss": "01:18:52",
        "start": 4730.518,
        "end": 4732.211235294118
      }
    },
    {
      "edge": "M1100",
      "attrs": {
        "text": "No!",
        "start_hhmmss": "01:18:52",
        "end_hhmmss": "01:18:52",
        "start": 4732.211235294118,
        "end": 4732.437
      }
    },
    {
      "edge": "M1101",
      "attrs": {
        "text": "Where is the Republic our fathers died for?",
        "start_hhmmss": "01:18:53",
        "end_hhmmss": "01:18:55",
        "start": 4732.646,
        "end": 4735.232
      }
    },
    {
      "edge": "M1102",
      "attrs": {
        "text": "Where?",
        "start_hhmmss": "01:18:55",
        "end_hhmmss": "01:18:57",
        "start": 4735.44,
        "end": 4736.528888888888
      }
    },
    {
      "edge": "M1103",
      "attrs": {
        "text": "Here.",
        "start_hhmmss": "01:18:57",
        "end_hhmmss": "01:18:57",
        "start": 4736.528888888888,
        "end": 4737.4
      }
    },
    {
      "edge": "M1104",
      "attrs": {
        "text": "It's here, my brothers. It lives here in our heads.",
        "start_hhmmss": "01:19:01",
        "end_hhmmss": "01:19:05",
        "start": 4740.945,
        "end": 4745.115
      }
    },
    {
      "edge": "M1105",
      "attrs": {
        "text": "But most of all, best of all, it lives in our hearts.",
        "start_hhmmss": "01:19:06",
        "end_hhmmss": "01:19:12",
        "start": 4745.659,
        "end": 4751.747
      }
    },
    {
      "edge": "M1106",
      "attrs": {
        "text": "In our hearts, we are the Republic!",
        "start_hhmmss": "01:19:12",
        "end_hhmmss": "01:19:15",
        "start": 4751.956,
        "end": 4755.335
      }
    },
    {
      "edge": "M1107",
      "attrs": {
        "text": "We are the Republic! We are the Republic!",
        "start_hhmmss": "01:19:16",
        "end_hhmmss": "01:19:20",
        "start": 4755.543,
        "end": 4759.838
      }
    },
    {
      "edge": "M1108",
      "attrs": {
        "text": "Where have you been? I told you not to leave the cab.",
        "start_hhmmss": "01:20:03",
        "end_hhmmss": "01:20:06",
        "start": 4803.341,
        "end": 4806.093
      }
    },
    {
      "edge": "M1109",
      "attrs": {
        "text": "I was just going out for some air.",
        "start_hhmmss": "01:20:06",
        "end_hhmmss": "01:20:08",
        "start": 4806.303,
        "end": 4808.095
      }
    },
    {
      "edge": "M1110",
      "attrs": {
        "text": "Who's that?",
        "start_hhmmss": "01:20:10",
        "end_hhmmss": "01:20:10",
        "start": 4809.514,
        "end": 4810.467371428572
      }
    },
    {
      "edge": "M1111",
      "attrs": {
        "text": "I don't know. He was making a speech.",
        "start_hhmmss": "01:20:10",
        "end_hhmmss": "01:20:14",
        "start": 4810.467371428572,
        "end": 4813.685
      }
    },
    {
      "edge": "M1112",
      "attrs": {
        "text": "Come, we're going home.",
        "start_hhmmss": "01:20:14",
        "end_hhmmss": "01:20:16",
        "start": 4813.892,
        "end": 4816.186
      }
    },
    {
      "edge": "M1113",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:21:08",
        "end_hhmmss": "01:21:09",
        "start": 4867.572,
        "end": 4868.864
      }
    },
    {
      "edge": "M1114",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:21:12",
        "end_hhmmss": "01:21:13",
        "start": 4871.867,
        "end": 4872.91
      }
    },
    {
      "edge": "M1115",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:21:15",
        "end_hhmmss": "01:21:16",
        "start": 4874.662,
        "end": 4875.8505000000005
      }
    },
    {
      "edge": "M1116",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:21:16",
        "end_hhmmss": "01:21:17",
        "start": 4875.8505000000005,
        "end": 4877.039000000001
      }
    },
    {
      "edge": "M1117",
      "attrs": {
        "text": "You again. I looked this time. You weren't at Mass.",
        "start_hhmmss": "01:21:23",
        "end_hhmmss": "01:21:26",
        "start": 4883.045,
        "end": 4885.715
      }
    },
    {
      "edge": "M1118",
      "attrs": {
        "text": "I was, Father.",
        "start_hhmmss": "01:21:26",
        "end_hhmmss": "01:21:27",
        "start": 4885.923,
        "end": 4886.901275862069
      }
    },
    {
      "edge": "M1119",
      "attrs": {
        "text": "Go on, get out of the line.",
        "start_hhmmss": "01:21:27",
        "end_hhmmss": "01:21:29",
        "start": 4886.901275862069,
        "end": 4888.76
      }
    },
    {
      "edge": "M1120",
      "attrs": {
        "text": "They won't let us in.",
        "start_hhmmss": "01:21:29",
        "end_hhmmss": "01:21:30",
        "start": 4888.967,
        "end": 4890.1704615384615
      }
    },
    {
      "edge": "M1121",
      "attrs": {
        "text": "He's all right. Let him through.",
        "start_hhmmss": "01:21:30",
        "end_hhmmss": "01:21:32",
        "start": 4890.1704615384615,
        "end": 4892.096
      }
    },
    {
      "edge": "M1122",
      "attrs": {
        "text": "We made extra today.",
        "start_hhmmss": "01:21:32",
        "end_hhmmss": "01:21:33",
        "start": 4892.304,
        "end": 4893.477333333333
      }
    },
    {
      "edge": "M1123",
      "attrs": {
        "text": "How are you, Gavroche?",
        "start_hhmmss": "01:21:33",
        "end_hhmmss": "01:21:35",
        "start": 4893.477333333333,
        "end": 4894.724
      }
    },
    {
      "edge": "M1124",
      "attrs": {
        "text": "Thank you. No one is as kind and as beautiful as you.",
        "start_hhmmss": "01:21:35",
        "end_hhmmss": "01:21:38",
        "start": 4894.932,
        "end": 4897.727
      }
    },
    {
      "edge": "M1125",
      "attrs": {
        "text": "You're such a convincing liar. I fear for your mortal soul.",
        "start_hhmmss": "01:21:38",
        "end_hhmmss": "01:21:41",
        "start": 4897.935,
        "end": 4901.398
      }
    },
    {
      "edge": "M1126",
      "attrs": {
        "text": "Who are your little friends?",
        "start_hhmmss": "01:21:42",
        "end_hhmmss": "01:21:43",
        "start": 4901.606,
        "end": 4903.401769230769
      }
    },
    {
      "edge": "M1127",
      "attrs": {
        "text": "These are my babies.",
        "start_hhmmss": "01:21:43",
        "end_hhmmss": "01:21:45",
        "start": 4903.401769230769,
        "end": 4904.651
      }
    },
    {
      "edge": "M1128",
      "attrs": {
        "text": "I found them wandering the streets.",
        "start_hhmmss": "01:21:45",
        "end_hhmmss": "01:21:47",
        "start": 4904.859,
        "end": 4906.944
      }
    },
    {
      "edge": "M1129",
      "attrs": {
        "text": "Don't I make a good father?",
        "start_hhmmss": "01:21:47",
        "end_hhmmss": "01:21:49",
        "start": 4907.152,
        "end": 4908.655
      }
    },
    {
      "edge": "M1130",
      "attrs": {
        "text": "You'd make a better father, Gavroche, with a real coat. Wait a minute.",
        "start_hhmmss": "01:21:49",
        "end_hhmmss": "01:21:54",
        "start": 4908.863,
        "end": 4913.785
      }
    },
    {
      "edge": "M1131",
      "attrs": {
        "text": "My friend wants to know if you'll take a walk in the park with him.",
        "start_hhmmss": "01:21:55",
        "end_hhmmss": "01:21:59",
        "start": 4915.453,
        "end": 4919.039
      }
    },
    {
      "edge": "M1132",
      "attrs": {
        "text": "Here you are. Bring your babies back tomorrow and I'll give them jackets.",
        "start_hhmmss": "01:22:13",
        "end_hhmmss": "01:22:17",
        "start": 4933.178,
        "end": 4937.015
      }
    },
    {
      "edge": "M1133",
      "attrs": {
        "text": "Thank you, sir.",
        "start_hhmmss": "01:22:17",
        "end_hhmmss": "01:22:18",
        "start": 4937.224,
        "end": 4938.262052631579
      }
    },
    {
      "edge": "M1134",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:22:18",
        "end_hhmmss": "01:22:19",
        "start": 4938.262052631579,
        "end": 4939.017
      }
    },
    {
      "edge": "M1135",
      "attrs": {
        "text": "He never leaves her alone.",
        "start_hhmmss": "01:22:23",
        "end_hhmmss": "01:22:25",
        "start": 4943.23,
        "end": 4944.942454545454
      }
    },
    {
      "edge": "M1136",
      "attrs": {
        "text": "He's not a father, he's a jailer.",
        "start_hhmmss": "01:22:25",
        "end_hhmmss": "01:22:27",
        "start": 4944.942454545454,
        "end": 4946.818
      }
    },
    {
      "edge": "M1137",
      "attrs": {
        "text": "Go. Go on, here they come. Go. Go, go, go.",
        "start_hhmmss": "01:22:28",
        "end_hhmmss": "01:22:31",
        "start": 4948.277,
        "end": 4950.822
      }
    },
    {
      "edge": "M1138",
      "attrs": {
        "text": "Come on, boys. Hurry up.",
        "start_hhmmss": "01:22:31",
        "end_hhmmss": "01:22:33",
        "start": 4951.029,
        "end": 4952.824
      }
    },
    {
      "edge": "M1139",
      "attrs": {
        "text": "Let's go home.",
        "start_hhmmss": "01:22:53",
        "end_hhmmss": "01:22:54",
        "start": 4972.594,
        "end": 4973.7784
      }
    },
    {
      "edge": "M1140",
      "attrs": {
        "text": "May we go for a walk?",
        "start_hhmmss": "01:22:54",
        "end_hhmmss": "01:22:56",
        "start": 4973.7784,
        "end": 4975.555
      }
    },
    {
      "edge": "M1141",
      "attrs": {
        "text": "It's so sunny and mild.",
        "start_hhmmss": "01:22:56",
        "end_hhmmss": "01:22:57",
        "start": 4975.763,
        "end": 4977.097
      }
    },
    {
      "edge": "M1142",
      "attrs": {
        "text": "I'm tired. Would you read to me in the garden?",
        "start_hhmmss": "01:22:57",
        "end_hhmmss": "01:23:00",
        "start": 4977.306,
        "end": 4980.058
      }
    },
    {
      "edge": "M1143",
      "attrs": {
        "text": "Why don't you go lie down? I'll go for a walk.",
        "start_hhmmss": "01:23:00",
        "end_hhmmss": "01:23:03",
        "start": 4980.267,
        "end": 4982.645
      }
    },
    {
      "edge": "M1144",
      "attrs": {
        "text": "Alone?",
        "start_hhmmss": "01:23:03",
        "end_hhmmss": "01:23:03",
        "start": 4982.854,
        "end": 4983.319666666667
      }
    },
    {
      "edge": "M1145",
      "attrs": {
        "text": "I'll have to walk alone some day.",
        "start_hhmmss": "01:23:03",
        "end_hhmmss": "01:23:06",
        "start": 4983.319666666667,
        "end": 4985.648
      }
    },
    {
      "edge": "M1146",
      "attrs": {
        "text": "Some day, not today.",
        "start_hhmmss": "01:23:06",
        "end_hhmmss": "01:23:07",
        "start": 4985.857,
        "end": 4986.982
      }
    },
    {
      "edge": "M1147",
      "attrs": {
        "text": "I know.",
        "start_hhmmss": "01:23:07",
        "end_hhmmss": "01:23:07",
        "start": 4986.982,
        "end": 4987.357
      }
    },
    {
      "edge": "M1148",
      "attrs": {
        "text": "Why don't you sit and relax...?",
        "start_hhmmss": "01:23:08",
        "end_hhmmss": "01:23:09",
        "start": 4987.567,
        "end": 4989.128945945946
      }
    },
    {
      "edge": "M1149",
      "attrs": {
        "text": "Stop playing games.",
        "start_hhmmss": "01:23:09",
        "end_hhmmss": "01:23:10",
        "start": 4989.128945945946,
        "end": 4990.319
      }
    },
    {
      "edge": "M1150",
      "attrs": {
        "text": "I'm not playing games.",
        "start_hhmmss": "01:23:11",
        "end_hhmmss": "01:23:12",
        "start": 4990.528,
        "end": 4991.709757575758
      }
    },
    {
      "edge": "M1151",
      "attrs": {
        "text": "Are you disobeying?",
        "start_hhmmss": "01:23:12",
        "end_hhmmss": "01:23:13",
        "start": 4991.709757575758,
        "end": 4992.822
      }
    },
    {
      "edge": "M1152",
      "attrs": {
        "text": "I'm your father. Get in!",
        "start_hhmmss": "01:23:13",
        "end_hhmmss": "01:23:15",
        "start": 4993.03,
        "end": 4995.449
      }
    },
    {
      "edge": "M1153",
      "attrs": {
        "text": "It's Thursday. Madame Toussaint made your favorite dessert.",
        "start_hhmmss": "01:23:38",
        "end_hhmmss": "01:23:43",
        "start": 5017.847,
        "end": 5022.56
      }
    },
    {
      "edge": "M1154",
      "attrs": {
        "text": "What do you say, Cosette?",
        "start_hhmmss": "01:23:43",
        "end_hhmmss": "01:23:45",
        "start": 5022.769,
        "end": 5025.27
      }
    },
    {
      "edge": "M1155",
      "attrs": {
        "text": "Strangers can be dangerous.",
        "start_hhmmss": "01:23:53",
        "end_hhmmss": "01:23:56",
        "start": 5033.237,
        "end": 5036.031
      }
    },
    {
      "edge": "M1156",
      "attrs": {
        "text": "Will that be all?",
        "start_hhmmss": "01:24:05",
        "end_hhmmss": "01:24:07",
        "start": 5044.874,
        "end": 5046.878757575757
      }
    },
    {
      "edge": "M1157",
      "attrs": {
        "text": "Yes. Thank you, Toussaint.",
        "start_hhmmss": "01:24:07",
        "end_hhmmss": "01:24:10",
        "start": 5046.878757575757,
        "end": 5049.963
      }
    },
    {
      "edge": "M1158",
      "attrs": {
        "text": "You're not, you know.",
        "start_hhmmss": "01:24:20",
        "end_hhmmss": "01:24:23",
        "start": 5059.847,
        "end": 5062.559
      }
    },
    {
      "edge": "M1159",
      "attrs": {
        "text": "Pardon?",
        "start_hhmmss": "01:24:23",
        "end_hhmmss": "01:24:23",
        "start": 5062.767,
        "end": 5063.347090909091
      }
    },
    {
      "edge": "M1160",
      "attrs": {
        "text": "You're not my father.",
        "start_hhmmss": "01:24:23",
        "end_hhmmss": "01:24:25",
        "start": 5063.347090909091,
        "end": 5064.894
      }
    },
    {
      "edge": "M1161",
      "attrs": {
        "text": "You never said you were until you became angry and behaved...",
        "start_hhmmss": "01:24:25",
        "end_hhmmss": "01:24:28",
        "start": 5065.102,
        "end": 5068.272
      }
    },
    {
      "edge": "M1162",
      "attrs": {
        "text": "...so strangely today. That was the first time you said it.",
        "start_hhmmss": "01:24:28",
        "end_hhmmss": "01:24:32",
        "start": 5068.48,
        "end": 5071.943
      }
    },
    {
      "edge": "M1163",
      "attrs": {
        "text": "The very first time.",
        "start_hhmmss": "01:24:32",
        "end_hhmmss": "01:24:34",
        "start": 5072.15,
        "end": 5073.738413793104
      }
    },
    {
      "edge": "M1164",
      "attrs": {
        "text": "Yes, you're right.",
        "start_hhmmss": "01:24:34",
        "end_hhmmss": "01:24:35",
        "start": 5073.738413793104,
        "end": 5075.029
      }
    },
    {
      "edge": "M1165",
      "attrs": {
        "text": "Well, are you my father?",
        "start_hhmmss": "01:24:35",
        "end_hhmmss": "01:24:40",
        "start": 5075.237,
        "end": 5079.909
      }
    },
    {
      "edge": "M1166",
      "attrs": {
        "text": "Cosette, I promised your mother I would take care of you.",
        "start_hhmmss": "01:24:41",
        "end_hhmmss": "01:24:45",
        "start": 5080.91,
        "end": 5084.747
      }
    },
    {
      "edge": "M1167",
      "attrs": {
        "text": "I know you think I worry too much...",
        "start_hhmmss": "01:24:45",
        "end_hhmmss": "01:24:47",
        "start": 5084.956,
        "end": 5087.082
      }
    },
    {
      "edge": "M1168",
      "attrs": {
        "text": "...but strangers can be danger--",
        "start_hhmmss": "01:24:47",
        "end_hhmmss": "01:24:49",
        "start": 5087.291,
        "end": 5089.055322580645
      }
    },
    {
      "edge": "M1169",
      "attrs": {
        "text": "All right.",
        "start_hhmmss": "01:24:49",
        "end_hhmmss": "01:24:50",
        "start": 5089.055322580645,
        "end": 5089.669
      }
    },
    {
      "edge": "M1170",
      "attrs": {
        "text": "What?",
        "start_hhmmss": "01:24:50",
        "end_hhmmss": "01:24:50",
        "start": 5089.877,
        "end": 5090.166411764706
      }
    },
    {
      "edge": "M1171",
      "attrs": {
        "text": "I don't want to hear that speech again.",
        "start_hhmmss": "01:24:50",
        "end_hhmmss": "01:24:52",
        "start": 5090.166411764706,
        "end": 5092.337
      }
    },
    {
      "edge": "M1172",
      "attrs": {
        "text": "There's something shameful. It must be me.",
        "start_hhmmss": "01:24:53",
        "end_hhmmss": "01:24:55",
        "start": 5092.546,
        "end": 5094.716
      }
    },
    {
      "edge": "M1173",
      "attrs": {
        "text": "My child, no.",
        "start_hhmmss": "01:24:55",
        "end_hhmmss": "01:24:56",
        "start": 5094.924,
        "end": 5096.184
      }
    },
    {
      "edge": "M1174",
      "attrs": {
        "text": "Or you.",
        "start_hhmmss": "01:24:56",
        "end_hhmmss": "01:24:57",
        "start": 5096.184,
        "end": 5096.884
      }
    },
    {
      "edge": "M1175",
      "attrs": {
        "text": "You're the shameful secret. Or maybe both of us.",
        "start_hhmmss": "01:24:57",
        "end_hhmmss": "01:25:00",
        "start": 5097.092,
        "end": 5099.637
      }
    },
    {
      "edge": "M1176",
      "attrs": {
        "text": "It doesn't matter. I can't go out.",
        "start_hhmmss": "01:25:00",
        "end_hhmmss": "01:25:02",
        "start": 5099.846,
        "end": 5101.639
      }
    },
    {
      "edge": "M1177",
      "attrs": {
        "text": "I can't talk to people.",
        "start_hhmmss": "01:25:02",
        "end_hhmmss": "01:25:03",
        "start": 5101.848,
        "end": 5103.0958
      }
    },
    {
      "edge": "M1178",
      "attrs": {
        "text": "Stop this.",
        "start_hhmmss": "01:25:03",
        "end_hhmmss": "01:25:04",
        "start": 5103.0958,
        "end": 5103.683
      }
    },
    {
      "edge": "M1179",
      "attrs": {
        "text": "I think you're lying. I know the secret.",
        "start_hhmmss": "01:25:04",
        "end_hhmmss": "01:25:07",
        "start": 5103.891,
        "end": 5106.518
      }
    },
    {
      "edge": "M1180",
      "attrs": {
        "text": "The secret is you want me with you night and day...",
        "start_hhmmss": "01:25:07",
        "end_hhmmss": "01:25:09",
        "start": 5106.728,
        "end": 5109.396
      }
    },
    {
      "edge": "M1181",
      "attrs": {
        "text": "...because you're lonely and you want me to be alone forever.",
        "start_hhmmss": "01:25:10",
        "end_hhmmss": "01:25:13",
        "start": 5109.606,
        "end": 5113.067
      }
    },
    {
      "edge": "M1182",
      "attrs": {
        "text": "Cosette.",
        "start_hhmmss": "01:25:21",
        "end_hhmmss": "01:25:22",
        "start": 5121.241,
        "end": 5122.409
      }
    },
    {
      "edge": "M1183",
      "attrs": {
        "text": "Cosette.",
        "start_hhmmss": "01:25:25",
        "end_hhmmss": "01:25:26",
        "start": 5125.038,
        "end": 5126.08
      }
    },
    {
      "edge": "M1184",
      "attrs": {
        "text": "You're right. I'm not a father. I don't--",
        "start_hhmmss": "01:25:30",
        "end_hhmmss": "01:25:33",
        "start": 5129.541,
        "end": 5133.337
      }
    },
    {
      "edge": "M1185",
      "attrs": {
        "text": "I just want to protect you, that's all.",
        "start_hhmmss": "01:25:35",
        "end_hhmmss": "01:25:37",
        "start": 5134.672,
        "end": 5136.924
      }
    },
    {
      "edge": "M1186",
      "attrs": {
        "text": "The world isn't a safe place, believe me.",
        "start_hhmmss": "01:25:38",
        "end_hhmmss": "01:25:41",
        "start": 5137.675,
        "end": 5140.51
      }
    },
    {
      "edge": "M1187",
      "attrs": {
        "text": "You're the only person I have...",
        "start_hhmmss": "01:25:41",
        "end_hhmmss": "01:25:44",
        "start": 5140.72,
        "end": 5143.89
      }
    },
    {
      "edge": "M1188",
      "attrs": {
        "text": "...and this is the only way I know how to do it. I'm sorry.",
        "start_hhmmss": "01:25:45",
        "end_hhmmss": "01:25:48",
        "start": 5144.556,
        "end": 5148.102
      }
    },
    {
      "edge": "M1189",
      "attrs": {
        "text": "It's all right.",
        "start_hhmmss": "01:25:51",
        "end_hhmmss": "01:25:53",
        "start": 5150.938,
        "end": 5153.107
      }
    },
    {
      "edge": "M1190",
      "attrs": {
        "text": "Come, have your meal.",
        "start_hhmmss": "01:25:53",
        "end_hhmmss": "01:25:55",
        "start": 5153.315,
        "end": 5155.267592592592
      }
    },
    {
      "edge": "M1191",
      "attrs": {
        "text": "I won't be long.",
        "start_hhmmss": "01:25:55",
        "end_hhmmss": "01:25:57",
        "start": 5155.267592592592,
        "end": 5156.61
      }
    },
    {
      "edge": "M1192",
      "attrs": {
        "text": "Fine. Toussaint will save it.",
        "start_hhmmss": "01:25:57",
        "end_hhmmss": "01:26:00",
        "start": 5156.819,
        "end": 5159.656
      }
    },
    {
      "edge": "M1193",
      "attrs": {
        "text": "Hello.",
        "start_hhmmss": "01:26:24",
        "end_hhmmss": "01:26:26",
        "start": 5184.055,
        "end": 5185.66
      }
    },
    {
      "edge": "M1194",
      "attrs": {
        "text": "Hello.",
        "start_hhmmss": "01:26:26",
        "end_hhmmss": "01:26:27",
        "start": 5185.66,
        "end": 5187.264999999999
      }
    },
    {
      "edge": "M1195",
      "attrs": {
        "text": "What's your name?",
        "start_hhmmss": "01:26:30",
        "end_hhmmss": "01:26:33",
        "start": 5190.435,
        "end": 5192.889947368421
      }
    },
    {
      "edge": "M1196",
      "attrs": {
        "text": "Marius.",
        "start_hhmmss": "01:26:33",
        "end_hhmmss": "01:26:34",
        "start": 5192.889947368421,
        "end": 5194.023
      }
    },
    {
      "edge": "M1197",
      "attrs": {
        "text": "And yours?",
        "start_hhmmss": "01:26:35",
        "end_hhmmss": "01:26:37",
        "start": 5195.44,
        "end": 5197.069647058824
      }
    },
    {
      "edge": "M1198",
      "attrs": {
        "text": "I'm Cosette.",
        "start_hhmmss": "01:26:37",
        "end_hhmmss": "01:26:39",
        "start": 5197.069647058824,
        "end": 5198.903
      }
    },
    {
      "edge": "M1199",
      "attrs": {
        "text": "Cosette.",
        "start_hhmmss": "01:26:39",
        "end_hhmmss": "01:26:41",
        "start": 5199.112,
        "end": 5201.196
      }
    },
    {
      "edge": "M1200",
      "attrs": {
        "text": "I have something for you.",
        "start_hhmmss": "01:26:46",
        "end_hhmmss": "01:26:48",
        "start": 5205.743,
        "end": 5208.126571428572
      }
    },
    {
      "edge": "M1201",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:26:48",
        "end_hhmmss": "01:26:49",
        "start": 5208.126571428572,
        "end": 5209.08
      }
    },
    {
      "edge": "M1202",
      "attrs": {
        "text": "Cosette!",
        "start_hhmmss": "01:26:59",
        "end_hhmmss": "01:27:01",
        "start": 5219.132,
        "end": 5220.925
      }
    },
    {
      "edge": "M1203",
      "attrs": {
        "text": "I can warm up your soup.",
        "start_hhmmss": "01:27:02",
        "end_hhmmss": "01:27:04",
        "start": 5221.718,
        "end": 5224.033828571428
      }
    },
    {
      "edge": "M1204",
      "attrs": {
        "text": "I'm coming, Toussaint.",
        "start_hhmmss": "01:27:04",
        "end_hhmmss": "01:27:06",
        "start": 5224.033828571428,
        "end": 5226.221
      }
    },
    {
      "edge": "M1205",
      "attrs": {
        "text": "I'll be here.",
        "start_hhmmss": "01:27:09",
        "end_hhmmss": "01:27:11",
        "start": 5229.183,
        "end": 5230.6
      }
    },
    {
      "edge": "M1206",
      "attrs": {
        "text": "Tomorrow night. Outside.",
        "start_hhmmss": "01:27:11",
        "end_hhmmss": "01:27:15",
        "start": 5231.309,
        "end": 5234.814
      }
    },
    {
      "edge": "M1207",
      "attrs": {
        "text": "See you tomorrow.",
        "start_hhmmss": "01:27:16",
        "end_hhmmss": "01:27:18",
        "start": 5235.605,
        "end": 5237.859
      }
    },
    {
      "edge": "M1208",
      "attrs": {
        "text": "Any guns?",
        "start_hhmmss": "01:27:44",
        "end_hhmmss": "01:27:45",
        "start": 5264.135,
        "end": 5265.178
      }
    },
    {
      "edge": "M1209",
      "attrs": {
        "text": "Maybe this is moving too fast.",
        "start_hhmmss": "01:27:53",
        "end_hhmmss": "01:27:55",
        "start": 5273.06,
        "end": 5274.645
      }
    },
    {
      "edge": "M1210",
      "attrs": {
        "text": "Revolution should be rushed.",
        "start_hhmmss": "01:27:55",
        "end_hhmmss": "01:27:56",
        "start": 5274.645,
        "end": 5276.23
      }
    },
    {
      "edge": "M1211",
      "attrs": {
        "text": "Progress doesn't have time to waste.",
        "start_hhmmss": "01:27:56",
        "end_hhmmss": "01:27:58",
        "start": 5276.438,
        "end": 5278.356
      }
    },
    {
      "edge": "M1212",
      "attrs": {
        "text": "This is pathetic. Two weeks and what have we got?",
        "start_hhmmss": "01:27:59",
        "end_hhmmss": "01:28:01",
        "start": 5278.565,
        "end": 5281.11
      }
    },
    {
      "edge": "M1213",
      "attrs": {
        "text": "Barely enough guns for ourselves.",
        "start_hhmmss": "01:28:01",
        "end_hhmmss": "01:28:03",
        "start": 5281.318,
        "end": 5283.07
      }
    },
    {
      "edge": "M1214",
      "attrs": {
        "text": "Then we'll tear up the streets and we throw stones.",
        "start_hhmmss": "01:28:03",
        "end_hhmmss": "01:28:06",
        "start": 5283.278,
        "end": 5286.406
      }
    },
    {
      "edge": "M1215",
      "attrs": {
        "text": "Oh, come on, Marius, throw stones? They won't attack us with sticks!",
        "start_hhmmss": "01:28:07",
        "end_hhmmss": "01:28:10",
        "start": 5286.615,
        "end": 5290.368
      }
    },
    {
      "edge": "M1216",
      "attrs": {
        "text": "Well?",
        "start_hhmmss": "01:28:11",
        "end_hhmmss": "01:28:12",
        "start": 5291.204,
        "end": 5291.6044
      }
    },
    {
      "edge": "M1217",
      "attrs": {
        "text": "They have two kegs of gunpowder...",
        "start_hhmmss": "01:28:12",
        "end_hhmmss": "01:28:14",
        "start": 5291.6044,
        "end": 5294.207
      }
    },
    {
      "edge": "M1218",
      "attrs": {
        "text": "...stored in the back. Guns are another story.",
        "start_hhmmss": "01:28:14",
        "end_hhmmss": "01:28:17",
        "start": 5294.414,
        "end": 5296.918
      }
    },
    {
      "edge": "M1219",
      "attrs": {
        "text": "Is there a plan?",
        "start_hhmmss": "01:28:17",
        "end_hhmmss": "01:28:18",
        "start": 5297.126,
        "end": 5298.071333333333
      }
    },
    {
      "edge": "M1220",
      "attrs": {
        "text": "No one can agree on...",
        "start_hhmmss": "01:28:18",
        "end_hhmmss": "01:28:19",
        "start": 5298.071333333333,
        "end": 5299.253
      }
    },
    {
      "edge": "M1221",
      "attrs": {
        "text": "...how to make a move. They argue about whether the people...",
        "start_hhmmss": "01:28:19",
        "end_hhmmss": "01:28:23",
        "start": 5299.461,
        "end": 5302.631
      }
    },
    {
      "edge": "M1222",
      "attrs": {
        "text": "...are ready. Truth is, they're scared.",
        "start_hhmmss": "01:28:23",
        "end_hhmmss": "01:28:25",
        "start": 5302.84,
        "end": 5304.782941176471
      }
    },
    {
      "edge": "M1223",
      "attrs": {
        "text": "These puppies seem harmless.",
        "start_hhmmss": "01:28:25",
        "end_hhmmss": "01:28:27",
        "start": 5304.782941176471,
        "end": 5306.51
      }
    },
    {
      "edge": "M1224",
      "attrs": {
        "text": "We should move you to another group.",
        "start_hhmmss": "01:28:27",
        "end_hhmmss": "01:28:29",
        "start": 5306.718,
        "end": 5308.72
      }
    },
    {
      "edge": "M1225",
      "attrs": {
        "text": "Thank you.",
        "start_hhmmss": "01:28:29",
        "end_hhmmss": "01:28:30",
        "start": 5309.222,
        "end": 5309.765085714285
      }
    },
    {
      "edge": "M1226",
      "attrs": {
        "text": "What about this Marius? Anything?",
        "start_hhmmss": "01:28:30",
        "end_hhmmss": "01:28:32",
        "start": 5309.765085714285,
        "end": 5311.598
      }
    },
    {
      "edge": "M1227",
      "attrs": {
        "text": "He's in love. He has to go to the food tent to get a glimpse of his beloved.",
        "start_hhmmss": "01:28:32",
        "end_hhmmss": "01:28:36",
        "start": 5311.808,
        "end": 5316.02
      }
    },
    {
      "edge": "M1228",
      "attrs": {
        "text": "Who is the father?",
        "start_hhmmss": "01:28:36",
        "end_hhmmss": "01:28:37",
        "start": 5316.229,
        "end": 5317.271
      }
    },
    {
      "edge": "M1229",
      "attrs": {
        "text": "I know you like me to be thorough, so I checked. He's behind the charity.",
        "start_hhmmss": "01:28:37",
        "end_hhmmss": "01:28:42",
        "start": 5317.479,
        "end": 5322.276
      }
    },
    {
      "edge": "M1230",
      "attrs": {
        "text": "I didn't find out much, only his name. Lafitte.",
        "start_hhmmss": "01:28:42",
        "end_hhmmss": "01:28:47",
        "start": 5322.484,
        "end": 5326.864
      }
    },
    {
      "edge": "M1231",
      "attrs": {
        "text": "Do you know him?",
        "start_hhmmss": "01:28:47",
        "end_hhmmss": "01:28:49",
        "start": 5327.073,
        "end": 5329.179
      }
    },
    {
      "edge": "M1232",
      "attrs": {
        "text": "I don't think so.",
        "start_hhmmss": "01:28:49",
        "end_hhmmss": "01:28:51",
        "start": 5329.179,
        "end": 5331.285
      }
    },
    {
      "edge": "M1233",
      "attrs": {
        "text": "Aren't we going for our walk?",
        "start_hhmmss": "01:28:53",
        "end_hhmmss": "01:28:54",
        "start": 5332.954,
        "end": 5334.454
      }
    },
    {
      "edge": "M1234",
      "attrs": {
        "text": "Not tonight. I want to finish my book.",
        "start_hhmmss": "01:28:56",
        "end_hhmmss": "01:28:58",
        "start": 5335.998,
        "end": 5338.084
      }
    },
    {
      "edge": "M1235",
      "attrs": {
        "text": "But we missed it last night and you've been in. You need your exercise.",
        "start_hhmmss": "01:28:58",
        "end_hhmmss": "01:29:02",
        "start": 5338.292,
        "end": 5342.088
      }
    },
    {
      "edge": "M1236",
      "attrs": {
        "text": "I'm too tired.",
        "start_hhmmss": "01:29:02",
        "end_hhmmss": "01:29:04",
        "start": 5342.296,
        "end": 5343.860166666667
      }
    },
    {
      "edge": "M1237",
      "attrs": {
        "text": "Are you all right?",
        "start_hhmmss": "01:29:04",
        "end_hhmmss": "01:29:06",
        "start": 5343.860166666667,
        "end": 5346.05
      }
    },
    {
      "edge": "M1238",
      "attrs": {
        "text": "Yes, of course. I have my book and Toussaint is here.",
        "start_hhmmss": "01:29:06",
        "end_hhmmss": "01:29:10",
        "start": 5346.259,
        "end": 5350.054
      }
    },
    {
      "edge": "M1239",
      "attrs": {
        "text": "Goodnight, my dear.",
        "start_hhmmss": "01:29:11",
        "end_hhmmss": "01:29:13",
        "start": 5351.388,
        "end": 5353.348
      }
    },
    {
      "edge": "M1240",
      "attrs": {
        "text": "Your letter was beautiful.",
        "start_hhmmss": "01:29:55",
        "end_hhmmss": "01:29:57",
        "start": 5395.266,
        "end": 5397.018
      }
    },
    {
      "edge": "M1241",
      "attrs": {
        "text": "It was really beautiful.",
        "start_hhmmss": "01:30:00",
        "end_hhmmss": "01:30:02",
        "start": 5399.937,
        "end": 5401.813
      }
    },
    {
      "edge": "M1242",
      "attrs": {
        "text": "Tell me everything.",
        "start_hhmmss": "01:30:05",
        "end_hhmmss": "01:30:07",
        "start": 5404.733,
        "end": 5406.525000000001
      }
    },
    {
      "edge": "M1243",
      "attrs": {
        "text": "Everything? About what?",
        "start_hhmmss": "01:30:07",
        "end_hhmmss": "01:30:09",
        "start": 5406.525000000001,
        "end": 5408.653
      }
    },
    {
      "edge": "M1244",
      "attrs": {
        "text": "About you.",
        "start_hhmmss": "01:30:09",
        "end_hhmmss": "01:30:10",
        "start": 5408.862,
        "end": 5410.260095238095
      }
    },
    {
      "edge": "M1245",
      "attrs": {
        "text": "There's nothing.",
        "start_hhmmss": "01:30:10",
        "end_hhmmss": "01:30:13",
        "start": 5410.260095238095,
        "end": 5412.532
      }
    },
    {
      "edge": "M1246",
      "attrs": {
        "text": "There's nothing to tell.",
        "start_hhmmss": "01:30:13",
        "end_hhmmss": "01:30:14",
        "start": 5412.741,
        "end": 5414.409
      }
    },
    {
      "edge": "M1247",
      "attrs": {
        "text": "I'm a very simple girl.",
        "start_hhmmss": "01:30:16",
        "end_hhmmss": "01:30:18",
        "start": 5415.702,
        "end": 5418.08
      }
    },
    {
      "edge": "M1248",
      "attrs": {
        "text": "I live a very simple life.",
        "start_hhmmss": "01:30:18",
        "end_hhmmss": "01:30:21",
        "start": 5418.289,
        "end": 5421.375
      }
    },
    {
      "edge": "M1249",
      "attrs": {
        "text": "I grew up in a convent...",
        "start_hhmmss": "01:30:22",
        "end_hhmmss": "01:30:24",
        "start": 5421.918,
        "end": 5424.003
      }
    },
    {
      "edge": "M1250",
      "attrs": {
        "text": "...with lots of other girls, of course.",
        "start_hhmmss": "01:30:24",
        "end_hhmmss": "01:30:27",
        "start": 5424.211,
        "end": 5426.964
      }
    },
    {
      "edge": "M1251",
      "attrs": {
        "text": "My father lived there too. My father's a very good man.",
        "start_hhmmss": "01:30:28",
        "end_hhmmss": "01:30:32",
        "start": 5427.547,
        "end": 5432.469
      }
    },
    {
      "edge": "M1252",
      "attrs": {
        "text": "I grew up in his love. His love was my home.",
        "start_hhmmss": "01:30:33",
        "end_hhmmss": "01:30:36",
        "start": 5432.677,
        "end": 5436.431
      }
    },
    {
      "edge": "M1253",
      "attrs": {
        "text": "You know what I mean?",
        "start_hhmmss": "01:30:37",
        "end_hhmmss": "01:30:38",
        "start": 5436.64,
        "end": 5437.849
      }
    },
    {
      "edge": "M1254",
      "attrs": {
        "text": "And then I met you.",
        "start_hhmmss": "01:30:38",
        "end_hhmmss": "01:30:41",
        "start": 5438.059,
        "end": 5440.602
      }
    },
    {
      "edge": "M1255",
      "attrs": {
        "text": "And you, what about you? You're a genius, aren't you?",
        "start_hhmmss": "01:30:41",
        "end_hhmmss": "01:30:45",
        "start": 5440.81,
        "end": 5444.814
      }
    },
    {
      "edge": "M1256",
      "attrs": {
        "text": "A genius?",
        "start_hhmmss": "01:30:45",
        "end_hhmmss": "01:30:47",
        "start": 5445.024,
        "end": 5447.234
      }
    },
    {
      "edge": "M1257",
      "attrs": {
        "text": "A poor student. No brighter or smarter than anyone else.",
        "start_hhmmss": "01:30:47",
        "end_hhmmss": "01:30:51",
        "start": 5447.442,
        "end": 5451.446
      }
    },
    {
      "edge": "M1258",
      "attrs": {
        "text": "Your speech was wonderful. I didn't breathe while you talked.",
        "start_hhmmss": "01:30:52",
        "end_hhmmss": "01:30:56",
        "start": 5451.655,
        "end": 5455.825
      }
    },
    {
      "edge": "M1259",
      "attrs": {
        "text": "I was afraid I'd miss a word.",
        "start_hhmmss": "01:30:56",
        "end_hhmmss": "01:30:59",
        "start": 5456.035,
        "end": 5458.745
      }
    },
    {
      "edge": "M1260",
      "attrs": {
        "text": "This week was the same as last? Every night?",
        "start_hhmmss": "01:32:27",
        "end_hhmmss": "01:32:29",
        "start": 5546.916,
        "end": 5549.211
      }
    },
    {
      "edge": "M1261",
      "attrs": {
        "text": "Inspector, they're in love. It's perfectly nauseating.",
        "start_hhmmss": "01:32:29",
        "end_hhmmss": "01:32:34",
        "start": 5549.42,
        "end": 5553.882
      }
    },
    {
      "edge": "M1262",
      "attrs": {
        "text": "She sneaks out the door and they're together till dawn.",
        "start_hhmmss": "01:32:34",
        "end_hhmmss": "01:32:37",
        "start": 5554.091,
        "end": 5557.219
      }
    },
    {
      "edge": "M1263",
      "attrs": {
        "text": "They even stay out there when it rains.",
        "start_hhmmss": "01:32:38",
        "end_hhmmss": "01:32:41",
        "start": 5558.095,
        "end": 5561.39
      }
    },
    {
      "edge": "M1264",
      "attrs": {
        "text": "I haven't caught a gun supplier, I've caught pneumonia.",
        "start_hhmmss": "01:32:43",
        "end_hhmmss": "01:32:46",
        "start": 5563.1,
        "end": 5566.27
      }
    },
    {
      "edge": "M1265",
      "attrs": {
        "text": "And the father knows nothing?",
        "start_hhmmss": "01:32:46",
        "end_hhmmss": "01:32:48",
        "start": 5566.479,
        "end": 5568.337775510205
      }
    },
    {
      "edge": "M1266",
      "attrs": {
        "text": "This too to me is not a surprise.",
        "start_hhmmss": "01:32:48",
        "end_hhmmss": "01:32:50",
        "start": 5568.337775510205,
        "end": 5570.274
      }
    },
    {
      "edge": "M1267",
      "attrs": {
        "text": "I admit the whole experience has disillusioned me.",
        "start_hhmmss": "01:32:51",
        "end_hhmmss": "01:32:53",
        "start": 5570.69,
        "end": 5573.319
      }
    },
    {
      "edge": "M1268",
      "attrs": {
        "text": "I certainly don't plan on having any children, especially not a daughter.",
        "start_hhmmss": "01:32:54",
        "end_hhmmss": "01:32:58",
        "start": 5573.527,
        "end": 5578.282
      }
    },
    {
      "edge": "M1269",
      "attrs": {
        "text": "Can I be reassigned?",
        "start_hhmmss": "01:33:01",
        "end_hhmmss": "01:33:03",
        "start": 5581.368,
        "end": 5583.079
      }
    },
    {
      "edge": "M1270",
      "attrs": {
        "text": "Perhaps I could infiltrate...",
        "start_hhmmss": "01:33:03",
        "end_hhmmss": "01:33:05",
        "start": 5583.412,
        "end": 5585.206
      }
    },
    {
      "edge": "M1271",
      "attrs": {
        "text": "...some nice anarchists with a roof over their heads?",
        "start_hhmmss": "01:33:05",
        "end_hhmmss": "01:33:08",
        "start": 5585.414,
        "end": 5588.167
      }
    },
    {
      "edge": "M1272",
      "attrs": {
        "text": "Yes. Yes, I'll handle this. You're relieved.",
        "start_hhmmss": "01:33:08",
        "end_hhmmss": "01:33:12",
        "start": 5588.375,
        "end": 5591.504
      }
    },
    {
      "edge": "M1273",
      "attrs": {
        "text": "Take two days off and report to me. You'll be reassigned.",
        "start_hhmmss": "01:33:12",
        "end_hhmmss": "01:33:15",
        "start": 5591.711,
        "end": 5595.006
      }
    },
    {
      "edge": "M1274",
      "attrs": {
        "text": "Thank you. Just out of curiosity, sir, what are you going to do?",
        "start_hhmmss": "01:33:15",
        "end_hhmmss": "01:33:19",
        "start": 5595.216,
        "end": 5599.345
      }
    },
    {
      "edge": "M1275",
      "attrs": {
        "text": "From what you've said, Lafitte is respectable and well-off.",
        "start_hhmmss": "01:33:20",
        "end_hhmmss": "01:33:23",
        "start": 5599.553,
        "end": 5602.639
      }
    },
    {
      "edge": "M1276",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "01:33:23",
        "end_hhmmss": "01:33:23",
        "start": 5602.847,
        "end": 5603.0615
      }
    },
    {
      "edge": "M1277",
      "attrs": {
        "text": "A little soft-hearted perhaps...",
        "start_hhmmss": "01:33:23",
        "end_hhmmss": "01:33:25",
        "start": 5603.0615,
        "end": 5604.849
      }
    },
    {
      "edge": "M1278",
      "attrs": {
        "text": "...but a churchgoer, a loving father?",
        "start_hhmmss": "01:33:25",
        "end_hhmmss": "01:33:28",
        "start": 5605.058,
        "end": 5607.644
      }
    },
    {
      "edge": "M1279",
      "attrs": {
        "text": "The neighborhood speaks well of him.",
        "start_hhmmss": "01:33:28",
        "end_hhmmss": "01:33:30",
        "start": 5607.852,
        "end": 5609.687
      }
    },
    {
      "edge": "M1280",
      "attrs": {
        "text": "Then he deserves to know his daughter...",
        "start_hhmmss": "01:33:30",
        "end_hhmmss": "01:33:32",
        "start": 5609.896,
        "end": 5611.94
      }
    },
    {
      "edge": "M1281",
      "attrs": {
        "text": "...has been seduced by a dangerous radical.",
        "start_hhmmss": "01:33:32",
        "end_hhmmss": "01:33:35",
        "start": 5612.149,
        "end": 5614.943
      }
    },
    {
      "edge": "M1282",
      "attrs": {
        "text": "Monsieur.",
        "start_hhmmss": "01:33:44",
        "end_hhmmss": "01:33:45",
        "start": 5624.203,
        "end": 5625.027
      }
    },
    {
      "edge": "M1283",
      "attrs": {
        "text": "Toussaint...",
        "start_hhmmss": "01:33:45",
        "end_hhmmss": "01:33:46",
        "start": 5625.027,
        "end": 5625.954
      }
    },
    {
      "edge": "M1284",
      "attrs": {
        "text": "...leave your cooking. Come sit in the garden. It's a glorious day.",
        "start_hhmmss": "01:33:46",
        "end_hhmmss": "01:33:50",
        "start": 5626.163,
        "end": 5629.666
      }
    },
    {
      "edge": "M1285",
      "attrs": {
        "text": "There's someone here to see you.",
        "start_hhmmss": "01:33:50",
        "end_hhmmss": "01:33:52",
        "start": 5629.874,
        "end": 5631.89509375
      }
    },
    {
      "edge": "M1286",
      "attrs": {
        "text": "Who is it?",
        "start_hhmmss": "01:33:52",
        "end_hhmmss": "01:33:52",
        "start": 5631.89509375,
        "end": 5632.461
      }
    },
    {
      "edge": "M1287",
      "attrs": {
        "text": "Ins....",
        "start_hhmmss": "01:33:53",
        "end_hhmmss": "01:33:53",
        "start": 5632.669,
        "end": 5632.945631578948
      }
    },
    {
      "edge": "M1288",
      "attrs": {
        "text": "Oh, it doesn't matter.",
        "start_hhmmss": "01:33:53",
        "end_hhmmss": "01:33:54",
        "start": 5632.945631578948,
        "end": 5634.421
      }
    },
    {
      "edge": "M1289",
      "attrs": {
        "text": "Inspector Javert. From the police.",
        "start_hhmmss": "01:33:55",
        "end_hhmmss": "01:33:59",
        "start": 5634.629,
        "end": 5638.675
      }
    },
    {
      "edge": "M1290",
      "attrs": {
        "text": "Could you w....",
        "start_hhmmss": "01:34:18",
        "end_hhmmss": "01:34:20",
        "start": 5657.57,
        "end": 5659.634375
      }
    },
    {
      "edge": "M1291",
      "attrs": {
        "text": "I'll wait.",
        "start_hhmmss": "01:34:20",
        "end_hhmmss": "01:34:21",
        "start": 5659.634375,
        "end": 5661.24
      }
    },
    {
      "edge": "M1292",
      "attrs": {
        "text": "Who was that?",
        "start_hhmmss": "01:34:25",
        "end_hhmmss": "01:34:27",
        "start": 5664.535,
        "end": 5667.204333333333
      }
    },
    {
      "edge": "M1293",
      "attrs": {
        "text": "That w....",
        "start_hhmmss": "01:34:27",
        "end_hhmmss": "01:34:29",
        "start": 5667.204333333333,
        "end": 5668.539
      }
    },
    {
      "edge": "M1294",
      "attrs": {
        "text": "Yes?",
        "start_hhmmss": "01:34:29",
        "end_hhmmss": "01:34:30",
        "start": 5668.913,
        "end": 5669.7724
      }
    },
    {
      "edge": "M1295",
      "attrs": {
        "text": "Was a gardener.",
        "start_hhmmss": "01:34:30",
        "end_hhmmss": "01:34:33",
        "start": 5669.7724,
        "end": 5673.21
      }
    },
    {
      "edge": "M1296",
      "attrs": {
        "text": "But why? Why say you're away?",
        "start_hhmmss": "01:34:33",
        "end_hhmmss": "01:34:35",
        "start": 5673.419,
        "end": 5674.962
      }
    },
    {
      "edge": "M1297",
      "attrs": {
        "text": "There's no time to explain.",
        "start_hhmmss": "01:34:35",
        "end_hhmmss": "01:34:37",
        "start": 5674.962,
        "end": 5676.504999999999
      }
    },
    {
      "edge": "M1298",
      "attrs": {
        "text": "Tell him I've gone away for a week.",
        "start_hhmmss": "01:34:37",
        "end_hhmmss": "01:34:39",
        "start": 5676.921,
        "end": 5678.923
      }
    },
    {
      "edge": "M1299",
      "attrs": {
        "text": "If he asks about your past...",
        "start_hhmmss": "01:34:39",
        "end_hhmmss": "01:34:41",
        "start": 5679.132,
        "end": 5680.842
      }
    },
    {
      "edge": "M1300",
      "attrs": {
        "text": "...say you have a headache and excuse yourself.",
        "start_hhmmss": "01:34:41",
        "end_hhmmss": "01:34:44",
        "start": 5681.05,
        "end": 5683.803
      }
    },
    {
      "edge": "M1301",
      "attrs": {
        "text": "All right? No details.",
        "start_hhmmss": "01:34:44",
        "end_hhmmss": "01:34:45",
        "start": 5684.012,
        "end": 5685.472
      }
    },
    {
      "edge": "M1302",
      "attrs": {
        "text": "You're frightened.",
        "start_hhmmss": "01:34:46",
        "end_hhmmss": "01:34:47",
        "start": 5685.68,
        "end": 5686.877391304348
      }
    },
    {
      "edge": "M1303",
      "attrs": {
        "text": "No. No, no, no.",
        "start_hhmmss": "01:34:47",
        "end_hhmmss": "01:34:48",
        "start": 5686.877391304348,
        "end": 5687.516
      }
    },
    {
      "edge": "M1304",
      "attrs": {
        "text": "Please, just go.",
        "start_hhmmss": "01:34:48",
        "end_hhmmss": "01:34:50",
        "start": 5687.724,
        "end": 5689.726
      }
    },
    {
      "edge": "M1305",
      "attrs": {
        "text": "Try not to be nervous. He'll sense it.",
        "start_hhmmss": "01:34:50",
        "end_hhmmss": "01:34:52",
        "start": 5689.934,
        "end": 5691.895
      }
    },
    {
      "edge": "M1306",
      "attrs": {
        "text": "Stay calm and composed.",
        "start_hhmmss": "01:34:52",
        "end_hhmmss": "01:34:54",
        "start": 5692.103,
        "end": 5694.398
      }
    },
    {
      "edge": "M1307",
      "attrs": {
        "text": "My father instructed Toussaint to say he's out when he's on one of his trips...",
        "start_hhmmss": "01:35:00",
        "end_hhmmss": "01:35:04",
        "start": 5700.153,
        "end": 5704.325
      }
    },
    {
      "edge": "M1308",
      "attrs": {
        "text": "...so that no one will know we're two women here by ourselves.",
        "start_hhmmss": "01:35:05",
        "end_hhmmss": "01:35:08",
        "start": 5704.533,
        "end": 5708.329
      }
    },
    {
      "edge": "M1309",
      "attrs": {
        "text": "Isn't it ridiculous that he worried about it with you, a police inspector?",
        "start_hhmmss": "01:35:09",
        "end_hhmmss": "01:35:13",
        "start": 5708.537,
        "end": 5713.292
      }
    },
    {
      "edge": "M1310",
      "attrs": {
        "text": "When will he return?",
        "start_hhmmss": "01:35:14",
        "end_hhmmss": "01:35:15",
        "start": 5713.5,
        "end": 5714.709
      }
    },
    {
      "edge": "M1311",
      "attrs": {
        "text": "Oh, a week? Hard to say.",
        "start_hhmmss": "01:35:16",
        "end_hhmmss": "01:35:20",
        "start": 5715.586,
        "end": 5719.548
      }
    },
    {
      "edge": "M1312",
      "attrs": {
        "text": "I'll leave him a note. Have an envelope?",
        "start_hhmmss": "01:35:20",
        "end_hhmmss": "01:35:23",
        "start": 5719.756,
        "end": 5722.8036923076925
      }
    },
    {
      "edge": "M1313",
      "attrs": {
        "text": "Right here.",
        "start_hhmmss": "01:35:23",
        "end_hhmmss": "01:35:24",
        "start": 5722.8036923076925,
        "end": 5723.718
      }
    },
    {
      "edge": "M1314",
      "attrs": {
        "text": "Lafitte. I knew a Lafitte. Where did your people come from?",
        "start_hhmmss": "01:35:38",
        "end_hhmmss": "01:35:42",
        "start": 5738.275,
        "end": 5742.404
      }
    },
    {
      "edge": "M1315",
      "attrs": {
        "text": "Here. Paris.",
        "start_hhmmss": "01:35:44",
        "end_hhmmss": "01:35:46",
        "start": 5743.78,
        "end": 5745.763857142857
      }
    },
    {
      "edge": "M1316",
      "attrs": {
        "text": "Paris?",
        "start_hhmmss": "01:35:46",
        "end_hhmmss": "01:35:47",
        "start": 5745.763857142857,
        "end": 5746.866
      }
    },
    {
      "edge": "M1317",
      "attrs": {
        "text": "Probably no relation.",
        "start_hhmmss": "01:35:49",
        "end_hhmmss": "01:35:50",
        "start": 5748.661,
        "end": 5750.119
      }
    },
    {
      "edge": "M1318",
      "attrs": {
        "text": "This is for your father's eyes alone...",
        "start_hhmmss": "01:35:53",
        "end_hhmmss": "01:35:55",
        "start": 5752.83,
        "end": 5754.874
      }
    },
    {
      "edge": "M1319",
      "attrs": {
        "text": "...and I'd appreciate it if you gave him the letter yourself.",
        "start_hhmmss": "01:35:55",
        "end_hhmmss": "01:35:58",
        "start": 5755.083,
        "end": 5758.462
      }
    },
    {
      "edge": "M1320",
      "attrs": {
        "text": "What a horrible man. How do you know him?",
        "start_hhmmss": "01:36:14",
        "end_hhmmss": "01:36:17",
        "start": 5773.81,
        "end": 5777.105
      }
    },
    {
      "edge": "M1321",
      "attrs": {
        "text": "What does this mean?",
        "start_hhmmss": "01:36:17",
        "end_hhmmss": "01:36:19",
        "start": 5777.314,
        "end": 5779.107
      }
    },
    {
      "edge": "M1322",
      "attrs": {
        "text": "\"Your daughter has been seduced by a dangerous radical...",
        "start_hhmmss": "01:36:19",
        "end_hhmmss": "01:36:23",
        "start": 5779.316,
        "end": 5782.944
      }
    },
    {
      "edge": "M1323",
      "attrs": {
        "text": "...named Marius Pontmercy.",
        "start_hhmmss": "01:36:23",
        "end_hhmmss": "01:36:26",
        "start": 5783.152,
        "end": 5785.739
      }
    },
    {
      "edge": "M1324",
      "attrs": {
        "text": "She betrays you every night.\"",
        "start_hhmmss": "01:36:26",
        "end_hhmmss": "01:36:29",
        "start": 5786.448,
        "end": 5788.60640625
      }
    },
    {
      "edge": "M1325",
      "attrs": {
        "text": "I don't know.",
        "start_hhmmss": "01:36:29",
        "end_hhmmss": "01:36:29",
        "start": 5788.60640625,
        "end": 5789.451
      }
    },
    {
      "edge": "M1326",
      "attrs": {
        "text": "Don't lie to me! Have you given yourself to this person?",
        "start_hhmmss": "01:36:30",
        "end_hhmmss": "01:36:33",
        "start": 5789.66,
        "end": 5792.787
      }
    },
    {
      "edge": "M1327",
      "attrs": {
        "text": "Is it true? Do you see him every night?",
        "start_hhmmss": "01:36:33",
        "end_hhmmss": "01:36:35",
        "start": 5792.996,
        "end": 5794.998
      }
    },
    {
      "edge": "M1328",
      "attrs": {
        "text": "Go ahead, hit me! Is that why I should tell you, because you'll hit me?",
        "start_hhmmss": "01:36:35",
        "end_hhmmss": "01:36:39",
        "start": 5795.206,
        "end": 5798.918
      }
    },
    {
      "edge": "M1329",
      "attrs": {
        "text": "Tell me the truth.",
        "start_hhmmss": "01:36:39",
        "end_hhmmss": "01:36:40",
        "start": 5799.127,
        "end": 5800.171842105264
      }
    },
    {
      "edge": "M1330",
      "attrs": {
        "text": "How dare you ask for the truth...",
        "start_hhmmss": "01:36:40",
        "end_hhmmss": "01:36:42",
        "start": 5800.171842105264,
        "end": 5801.963
      }
    },
    {
      "edge": "M1331",
      "attrs": {
        "text": "...when you only tell me lies?",
        "start_hhmmss": "01:36:42",
        "end_hhmmss": "01:36:44",
        "start": 5802.171,
        "end": 5803.798
      }
    },
    {
      "edge": "M1332",
      "attrs": {
        "text": "Why does a policeman frighten you out of your wits?",
        "start_hhmmss": "01:36:44",
        "end_hhmmss": "01:36:47",
        "start": 5804.007,
        "end": 5806.968
      }
    },
    {
      "edge": "M1333",
      "attrs": {
        "text": "Who is he? Who are you?",
        "start_hhmmss": "01:36:47",
        "end_hhmmss": "01:36:51",
        "start": 5807.176,
        "end": 5811.348
      }
    },
    {
      "edge": "M1334",
      "attrs": {
        "text": "You don't understand.",
        "start_hhmmss": "01:36:52",
        "end_hhmmss": "01:36:53",
        "start": 5811.557,
        "end": 5813.475
      }
    },
    {
      "edge": "M1335",
      "attrs": {
        "text": "You've ruined me. You've ruined us.",
        "start_hhmmss": "01:36:55",
        "end_hhmmss": "01:36:58",
        "start": 5815.018,
        "end": 5817.688
      }
    },
    {
      "edge": "M1336",
      "attrs": {
        "text": "You're right. I don't understand.",
        "start_hhmmss": "01:36:58",
        "end_hhmmss": "01:37:01",
        "start": 5818.062,
        "end": 5820.524
      }
    },
    {
      "edge": "M1337",
      "attrs": {
        "text": "How can I when you won't tell me the truth?",
        "start_hhmmss": "01:37:01",
        "end_hhmmss": "01:37:04",
        "start": 5820.733,
        "end": 5824.193
      }
    },
    {
      "edge": "M1338",
      "attrs": {
        "text": "What is it? Who are you?",
        "start_hhmmss": "01:37:04",
        "end_hhmmss": "01:37:08",
        "start": 5824.403,
        "end": 5827.905
      }
    },
    {
      "edge": "M1339",
      "attrs": {
        "text": "All right, I'm not going to lie.",
        "start_hhmmss": "01:37:11",
        "end_hhmmss": "01:37:13",
        "start": 5830.825,
        "end": 5833.454
      }
    },
    {
      "edge": "M1340",
      "attrs": {
        "text": "It's true, I love Marius. I'm not ashamed.",
        "start_hhmmss": "01:37:14",
        "end_hhmmss": "01:37:17",
        "start": 5833.662,
        "end": 5837.04
      }
    },
    {
      "edge": "M1341",
      "attrs": {
        "text": "I only have a corner of a bench to be with him...",
        "start_hhmmss": "01:37:18",
        "end_hhmmss": "01:37:22",
        "start": 5837.957,
        "end": 5841.628
      }
    },
    {
      "edge": "M1342",
      "attrs": {
        "text": "...but that corner is mine.",
        "start_hhmmss": "01:37:22",
        "end_hhmmss": "01:37:24",
        "start": 5841.836,
        "end": 5844.297
      }
    },
    {
      "edge": "M1343",
      "attrs": {
        "text": "It's my life.",
        "start_hhmmss": "01:37:25",
        "end_hhmmss": "01:37:26",
        "start": 5844.506,
        "end": 5846.425
      }
    },
    {
      "edge": "M1344",
      "attrs": {
        "text": "Is that what's going to ruin us?",
        "start_hhmmss": "01:37:27",
        "end_hhmmss": "01:37:30",
        "start": 5846.924,
        "end": 5849.844
      }
    },
    {
      "edge": "M1345",
      "attrs": {
        "text": "Please tell me what this is all about, Papa.",
        "start_hhmmss": "01:37:33",
        "end_hhmmss": "01:37:36",
        "start": 5852.556,
        "end": 5856.059
      }
    },
    {
      "edge": "M1346",
      "attrs": {
        "text": "Please.",
        "start_hhmmss": "01:37:36",
        "end_hhmmss": "01:37:38",
        "start": 5856.267,
        "end": 5858.269
      }
    },
    {
      "edge": "M1347",
      "attrs": {
        "text": "Please tell me. What is it?",
        "start_hhmmss": "01:37:38",
        "end_hhmmss": "01:37:41",
        "start": 5858.479,
        "end": 5861.44
      }
    },
    {
      "edge": "M1348",
      "attrs": {
        "text": "Please. Please.",
        "start_hhmmss": "01:37:42",
        "end_hhmmss": "01:37:46",
        "start": 5861.648,
        "end": 5866.487
      }
    },
    {
      "edge": "M1349",
      "attrs": {
        "text": "What is it?",
        "start_hhmmss": "01:37:47",
        "end_hhmmss": "01:37:49",
        "start": 5866.695,
        "end": 5868.946
      }
    },
    {
      "edge": "M1350",
      "attrs": {
        "text": "I....",
        "start_hhmmss": "01:37:51",
        "end_hhmmss": "01:37:53",
        "start": 5871.408,
        "end": 5873.201
      }
    },
    {
      "edge": "M1351",
      "attrs": {
        "text": "I am a convict.",
        "start_hhmmss": "01:37:54",
        "end_hhmmss": "01:37:55",
        "start": 5873.66,
        "end": 5875.412
      }
    },
    {
      "edge": "M1352",
      "attrs": {
        "text": "A convict?",
        "start_hhmmss": "01:37:57",
        "end_hhmmss": "01:37:59",
        "start": 5876.747,
        "end": 5879.207
      }
    },
    {
      "edge": "M1353",
      "attrs": {
        "text": "When I was young, just your age...",
        "start_hhmmss": "01:38:03",
        "end_hhmmss": "01:38:08",
        "start": 5883.42,
        "end": 5887.758
      }
    },
    {
      "edge": "M1354",
      "attrs": {
        "text": "...I was very poor. I was starving.",
        "start_hhmmss": "01:38:10",
        "end_hhmmss": "01:38:13",
        "start": 5889.51,
        "end": 5892.596
      }
    },
    {
      "edge": "M1355",
      "attrs": {
        "text": "One day I stood in front of a window.",
        "start_hhmmss": "01:38:13",
        "end_hhmmss": "01:38:16",
        "start": 5893.137,
        "end": 5896.224
      }
    },
    {
      "edge": "M1356",
      "attrs": {
        "text": "A window full of bread.",
        "start_hhmmss": "01:38:16",
        "end_hhmmss": "01:38:19",
        "start": 5896.433,
        "end": 5898.935
      }
    },
    {
      "edge": "M1357",
      "attrs": {
        "text": "There was just glass...",
        "start_hhmmss": "01:38:19",
        "end_hhmmss": "01:38:21",
        "start": 5899.395,
        "end": 5900.978
      }
    },
    {
      "edge": "M1358",
      "attrs": {
        "text": "...between me and not being hungry anymore.",
        "start_hhmmss": "01:38:21",
        "end_hhmmss": "01:38:26",
        "start": 5901.187,
        "end": 5905.9
      }
    },
    {
      "edge": "M1359",
      "attrs": {
        "text": "It was so easy.",
        "start_hhmmss": "01:38:27",
        "end_hhmmss": "01:38:29",
        "start": 5906.61,
        "end": 5909.195
      }
    },
    {
      "edge": "M1360",
      "attrs": {
        "text": "So I broke it and took what I wanted.",
        "start_hhmmss": "01:38:30",
        "end_hhmmss": "01:38:34",
        "start": 5909.987,
        "end": 5914.283
      }
    },
    {
      "edge": "M1361",
      "attrs": {
        "text": "And then they caught me...",
        "start_hhmmss": "01:38:35",
        "end_hhmmss": "01:38:37",
        "start": 5915.034,
        "end": 5917.496
      }
    },
    {
      "edge": "M1362",
      "attrs": {
        "text": "...and put me in chains for almost 20 years.",
        "start_hhmmss": "01:38:38",
        "end_hhmmss": "01:38:42",
        "start": 5917.704,
        "end": 5921.583
      }
    },
    {
      "edge": "M1363",
      "attrs": {
        "text": "They did things to me.",
        "start_hhmmss": "01:38:43",
        "end_hhmmss": "01:38:47",
        "start": 5923.376,
        "end": 5927.423
      }
    },
    {
      "edge": "M1364",
      "attrs": {
        "text": "I can't tell you about it.",
        "start_hhmmss": "01:38:49",
        "end_hhmmss": "01:38:52",
        "start": 5929.257,
        "end": 5932.343
      }
    },
    {
      "edge": "M1365",
      "attrs": {
        "text": "And I did things there in jail.",
        "start_hhmmss": "01:38:53",
        "end_hhmmss": "01:38:56",
        "start": 5932.927,
        "end": 5935.806
      }
    },
    {
      "edge": "M1366",
      "attrs": {
        "text": "Terrible things.",
        "start_hhmmss": "01:38:56",
        "end_hhmmss": "01:38:58",
        "start": 5936.013,
        "end": 5938.391
      }
    },
    {
      "edge": "M1367",
      "attrs": {
        "text": "I became an animal.",
        "start_hhmmss": "01:39:00",
        "end_hhmmss": "01:39:02",
        "start": 5939.768,
        "end": 5942.353
      }
    },
    {
      "edge": "M1368",
      "attrs": {
        "text": "They took my dignity.",
        "start_hhmmss": "01:39:04",
        "end_hhmmss": "01:39:07",
        "start": 5944.021,
        "end": 5947.024
      }
    },
    {
      "edge": "M1369",
      "attrs": {
        "text": "They took everything from me.",
        "start_hhmmss": "01:39:10",
        "end_hhmmss": "01:39:13",
        "start": 5949.862,
        "end": 5952.573
      }
    },
    {
      "edge": "M1370",
      "attrs": {
        "text": "Inspector, where do you want me tomorrow?",
        "start_hhmmss": "01:39:19",
        "end_hhmmss": "01:39:22",
        "start": 5959.455,
        "end": 5962.165
      }
    },
    {
      "edge": "M1371",
      "attrs": {
        "text": "Should I go back to the Café Musain?",
        "start_hhmmss": "01:39:22",
        "end_hhmmss": "01:39:25",
        "start": 5962.373,
        "end": 5964.543
      }
    },
    {
      "edge": "M1372",
      "attrs": {
        "text": "Not right away.",
        "start_hhmmss": "01:39:25",
        "end_hhmmss": "01:39:26",
        "start": 5964.751,
        "end": 5966.252
      }
    },
    {
      "edge": "M1373",
      "attrs": {
        "text": "Mingle with the crowd at the square, see where it takes you.",
        "start_hhmmss": "01:39:26",
        "end_hhmmss": "01:39:30",
        "start": 5966.462,
        "end": 5969.59
      }
    },
    {
      "edge": "M1374",
      "attrs": {
        "text": "All right.",
        "start_hhmmss": "01:39:30",
        "end_hhmmss": "01:39:31",
        "start": 5969.798,
        "end": 5970.841
      }
    },
    {
      "edge": "M1375",
      "attrs": {
        "text": "Lafitte, did you find out anything about his background?",
        "start_hhmmss": "01:39:32",
        "end_hhmmss": "01:39:35",
        "start": 5971.633,
        "end": 5975.178
      }
    },
    {
      "edge": "M1376",
      "attrs": {
        "text": "He's from Vigau, born and raised.",
        "start_hhmmss": "01:39:35",
        "end_hhmmss": "01:39:39",
        "start": 5975.386,
        "end": 5978.724
      }
    },
    {
      "edge": "M1377",
      "attrs": {
        "text": "Lafitte and his daughter Cosette lived there until 10 years ago.",
        "start_hhmmss": "01:39:39",
        "end_hhmmss": "01:39:43",
        "start": 5978.932,
        "end": 5982.603
      }
    },
    {
      "edge": "M1378",
      "attrs": {
        "text": "Cosette? You didn't tell me her name was Cosette.",
        "start_hhmmss": "01:39:43",
        "end_hhmmss": "01:39:46",
        "start": 5982.811,
        "end": 5985.898
      }
    },
    {
      "edge": "M1379",
      "attrs": {
        "text": "You didn't ask.",
        "start_hhmmss": "01:39:46",
        "end_hhmmss": "01:39:47",
        "start": 5986.105,
        "end": 5987.398
      }
    },
    {
      "edge": "M1380",
      "attrs": {
        "text": "Not up here, sir.",
        "start_hhmmss": "01:39:52",
        "end_hhmmss": "01:39:53",
        "start": 5991.904,
        "end": 5992.971600000001
      }
    },
    {
      "edge": "M1381",
      "attrs": {
        "text": "The place is empty, sir.",
        "start_hhmmss": "01:39:53",
        "end_hhmmss": "01:39:55",
        "start": 5992.971600000001,
        "end": 5994.573
      }
    },
    {
      "edge": "M1382",
      "attrs": {
        "text": "No one and nothing. Clean as a whistle.",
        "start_hhmmss": "01:39:56",
        "end_hhmmss": "01:39:59",
        "start": 5996.365,
        "end": 5998.785
      }
    },
    {
      "edge": "M1383",
      "attrs": {
        "text": "He moves fast.",
        "start_hhmmss": "01:40:00",
        "end_hhmmss": "01:40:02",
        "start": 5999.745,
        "end": 6002.121
      }
    },
    {
      "edge": "M1384",
      "attrs": {
        "text": "Yes, he does.",
        "start_hhmmss": "01:40:03",
        "end_hhmmss": "01:40:05",
        "start": 6002.831,
        "end": 6005.041
      }
    },
    {
      "edge": "M1385",
      "attrs": {
        "text": "But there's a way to find him.",
        "start_hhmmss": "01:40:05",
        "end_hhmmss": "01:40:08",
        "start": 6005.249,
        "end": 6007.753
      }
    },
    {
      "edge": "M1386",
      "attrs": {
        "text": "Marius. Have you seen my babies?",
        "start_hhmmss": "01:40:10",
        "end_hhmmss": "01:40:12",
        "start": 6010.046,
        "end": 6011.896
      }
    },
    {
      "edge": "M1387",
      "attrs": {
        "text": "Not now.",
        "start_hhmmss": "01:40:12",
        "end_hhmmss": "01:40:12",
        "start": 6011.896,
        "end": 6012.34
      }
    },
    {
      "edge": "M1388",
      "attrs": {
        "text": "Not tonight. We have to plan tomorrow's action.",
        "start_hhmmss": "01:40:13",
        "end_hhmmss": "01:40:16",
        "start": 6012.549,
        "end": 6015.719
      }
    },
    {
      "edge": "M1389",
      "attrs": {
        "text": "We are not having an action. A revolution.",
        "start_hhmmss": "01:40:16",
        "end_hhmmss": "01:40:18",
        "start": 6015.928,
        "end": 6018.095
      }
    },
    {
      "edge": "M1390",
      "attrs": {
        "text": "We can't tolerate this. We can't allow the king to bury Lamarque as his hero.",
        "start_hhmmss": "01:40:18",
        "end_hhmmss": "01:40:22",
        "start": 6018.304,
        "end": 6022.308
      }
    },
    {
      "edge": "M1391",
      "attrs": {
        "text": "I promise. One hour. One hour.",
        "start_hhmmss": "01:40:23",
        "end_hhmmss": "01:40:25",
        "start": 6022.518,
        "end": 6024.7695
      }
    },
    {
      "edge": "M1392",
      "attrs": {
        "text": "No. Marius, this is not a game.",
        "start_hhmmss": "01:40:25",
        "end_hhmmss": "01:40:27",
        "start": 6024.7695,
        "end": 6027.021000000001
      }
    },
    {
      "edge": "M1393",
      "attrs": {
        "text": "Tomorrow you have to mean it.",
        "start_hhmmss": "01:40:27",
        "end_hhmmss": "01:40:29",
        "start": 6027.23,
        "end": 6029.404266666666
      }
    },
    {
      "edge": "M1394",
      "attrs": {
        "text": "I mean it.",
        "start_hhmmss": "01:40:29",
        "end_hhmmss": "01:40:30",
        "start": 6029.404266666666,
        "end": 6030.066
      }
    },
    {
      "edge": "M1395",
      "attrs": {
        "text": "We'll plan our tactics when I get back.",
        "start_hhmmss": "01:40:30",
        "end_hhmmss": "01:40:32",
        "start": 6030.274,
        "end": 6032.276
      }
    },
    {
      "edge": "M1396",
      "attrs": {
        "text": "When those bastards try to bury Lamarque, we'll bury them instead.",
        "start_hhmmss": "01:40:32",
        "end_hhmmss": "01:40:36",
        "start": 6032.485,
        "end": 6036.155
      }
    },
    {
      "edge": "M1397",
      "attrs": {
        "text": "You hurry back. After tomorrow...",
        "start_hhmmss": "01:40:37",
        "end_hhmmss": "01:40:39",
        "start": 6037.156,
        "end": 6039.242
      }
    },
    {
      "edge": "M1398",
      "attrs": {
        "text": "...you can make love to her as a free man.",
        "start_hhmmss": "01:40:39",
        "end_hhmmss": "01:40:42",
        "start": 6039.45,
        "end": 6041.995
      }
    },
    {
      "edge": "M1399",
      "attrs": {
        "text": "Maybe.",
        "start_hhmmss": "01:40:42",
        "end_hhmmss": "01:40:44",
        "start": 6042.203,
        "end": 6044.163
      }
    },
    {
      "edge": "M1400",
      "attrs": {
        "text": "Cosette!",
        "start_hhmmss": "01:40:45",
        "end_hhmmss": "01:40:47",
        "start": 6044.54,
        "end": 6046.542
      }
    },
    {
      "edge": "M1401",
      "attrs": {
        "text": "Cosette!",
        "start_hhmmss": "01:40:48",
        "end_hhmmss": "01:40:51",
        "start": 6048.376,
        "end": 6051.087
      }
    },
    {
      "edge": "M1402",
      "attrs": {
        "text": "Cosette!",
        "start_hhmmss": "01:40:58",
        "end_hhmmss": "01:41:02",
        "start": 6058.427,
        "end": 6061.557
      }
    },
    {
      "edge": "M1403",
      "attrs": {
        "text": "\"Go to 18 Rue de L'Ouest.\"",
        "start_hhmmss": "01:41:23",
        "end_hhmmss": "01:41:26",
        "start": 6082.786,
        "end": 6085.581
      }
    },
    {
      "edge": "M1404",
      "attrs": {
        "text": "Why? Why?",
        "start_hhmmss": "01:41:46",
        "end_hhmmss": "01:41:49",
        "start": 6106.475,
        "end": 6109.021
      }
    },
    {
      "edge": "M1405",
      "attrs": {
        "text": "He has to leave. I have to go with him.",
        "start_hhmmss": "01:41:49",
        "end_hhmmss": "01:41:52",
        "start": 6109.228,
        "end": 6111.616088888889
      }
    },
    {
      "edge": "M1406",
      "attrs": {
        "text": "What's wrong, Cosette?",
        "start_hhmmss": "01:41:52",
        "end_hhmmss": "01:41:53",
        "start": 6111.616088888889,
        "end": 6113.066
      }
    },
    {
      "edge": "M1407",
      "attrs": {
        "text": "His life is at stake.",
        "start_hhmmss": "01:41:53",
        "end_hhmmss": "01:41:56",
        "start": 6113.274,
        "end": 6115.533076923077
      }
    },
    {
      "edge": "M1408",
      "attrs": {
        "text": "His life? How?",
        "start_hhmmss": "01:41:56",
        "end_hhmmss": "01:41:57",
        "start": 6115.533076923077,
        "end": 6116.945
      }
    },
    {
      "edge": "M1409",
      "attrs": {
        "text": "It's a secret, Marius, I can't give it away.",
        "start_hhmmss": "01:41:57",
        "end_hhmmss": "01:42:00",
        "start": 6117.153,
        "end": 6119.781
      }
    },
    {
      "edge": "M1410",
      "attrs": {
        "text": "I was an orphan. He saved me. He gave me everything.",
        "start_hhmmss": "01:42:00",
        "end_hhmmss": "01:42:03",
        "start": 6119.99,
        "end": 6122.826
      }
    },
    {
      "edge": "M1411",
      "attrs": {
        "text": "I can't leave him right now.",
        "start_hhmmss": "01:42:03",
        "end_hhmmss": "01:42:05",
        "start": 6123.035,
        "end": 6124.535857142857
      }
    },
    {
      "edge": "M1412",
      "attrs": {
        "text": "That means I'll never see you again.",
        "start_hhmmss": "01:42:05",
        "end_hhmmss": "01:42:07",
        "start": 6124.535857142857,
        "end": 6126.537
      }
    },
    {
      "edge": "M1413",
      "attrs": {
        "text": "I know what we can do. We'll talk to him. He'll agree.",
        "start_hhmmss": "01:42:07",
        "end_hhmmss": "01:42:10",
        "start": 6126.747,
        "end": 6129.582
      }
    },
    {
      "edge": "M1414",
      "attrs": {
        "text": "You can come with us to England.",
        "start_hhmmss": "01:42:10",
        "end_hhmmss": "01:42:12",
        "start": 6129.791,
        "end": 6131.6800625
      }
    },
    {
      "edge": "M1415",
      "attrs": {
        "text": "England?",
        "start_hhmmss": "01:42:12",
        "end_hhmmss": "01:42:12",
        "start": 6131.6800625,
        "end": 6132.209
      }
    },
    {
      "edge": "M1416",
      "attrs": {
        "text": "Cosette, are you crazy?",
        "start_hhmmss": "01:42:12",
        "end_hhmmss": "01:42:15",
        "start": 6132.418,
        "end": 6135.005
      }
    },
    {
      "edge": "M1417",
      "attrs": {
        "text": "Tomorrow we're going to fight. We're going to restore the Republic.",
        "start_hhmmss": "01:42:15",
        "end_hhmmss": "01:42:19",
        "start": 6135.212,
        "end": 6139.051
      }
    },
    {
      "edge": "M1418",
      "attrs": {
        "text": "I can't run away now. Why do you have to go to England? Why now? Why?",
        "start_hhmmss": "01:42:19",
        "end_hhmmss": "01:42:24",
        "start": 6139.258,
        "end": 6144.388
      }
    },
    {
      "edge": "M1419",
      "attrs": {
        "text": "He needs me, Marius. He needs me.",
        "start_hhmmss": "01:42:25",
        "end_hhmmss": "01:42:27",
        "start": 6144.597,
        "end": 6146.552720930233
      }
    },
    {
      "edge": "M1420",
      "attrs": {
        "text": "Why do you have to go now?",
        "start_hhmmss": "01:42:27",
        "end_hhmmss": "01:42:28",
        "start": 6146.552720930233,
        "end": 6148.101
      }
    },
    {
      "edge": "M1421",
      "attrs": {
        "text": "He took care of me, and now he needs me.",
        "start_hhmmss": "01:42:28",
        "end_hhmmss": "01:42:32",
        "start": 6148.309,
        "end": 6151.772
      }
    },
    {
      "edge": "M1422",
      "attrs": {
        "text": "I understand.",
        "start_hhmmss": "01:42:39",
        "end_hhmmss": "01:42:42",
        "start": 6159.362,
        "end": 6161.657
      }
    },
    {
      "edge": "M1423",
      "attrs": {
        "text": "I understand.",
        "start_hhmmss": "01:42:44",
        "end_hhmmss": "01:42:45",
        "start": 6163.574,
        "end": 6165.201
      }
    },
    {
      "edge": "M1424",
      "attrs": {
        "text": "Don't be sad, Marius. Please.",
        "start_hhmmss": "01:42:45",
        "end_hhmmss": "01:42:48",
        "start": 6165.409,
        "end": 6167.871
      }
    },
    {
      "edge": "M1425",
      "attrs": {
        "text": "Don't be sad, Marius.",
        "start_hhmmss": "01:42:48",
        "end_hhmmss": "01:42:51",
        "start": 6168.08,
        "end": 6170.707
      }
    },
    {
      "edge": "M1426",
      "attrs": {
        "text": "When? When? When do you leave?",
        "start_hhmmss": "01:42:59",
        "end_hhmmss": "01:43:03",
        "start": 6178.757,
        "end": 6182.803
      }
    },
    {
      "edge": "M1427",
      "attrs": {
        "text": "Tomorrow no one can leave Paris because of Lamarque's funeral.",
        "start_hhmmss": "01:43:06",
        "end_hhmmss": "01:43:09",
        "start": 6185.596,
        "end": 6189.101
      }
    },
    {
      "edge": "M1428",
      "attrs": {
        "text": "He's not sure. He said we might leave the next day.",
        "start_hhmmss": "01:43:09",
        "end_hhmmss": "01:43:13",
        "start": 6189.308,
        "end": 6192.979
      }
    },
    {
      "edge": "M1429",
      "attrs": {
        "text": "I'll be here tomorrow night.",
        "start_hhmmss": "01:43:15",
        "end_hhmmss": "01:43:18",
        "start": 6194.522,
        "end": 6197.943
      }
    },
    {
      "edge": "M1430",
      "attrs": {
        "text": "Promise me. Promise me you'll meet me here.",
        "start_hhmmss": "01:43:19",
        "end_hhmmss": "01:43:23",
        "start": 6198.985,
        "end": 6202.53
      }
    },
    {
      "edge": "M1431",
      "attrs": {
        "text": "It's obvious we have them outnumbered.",
        "start_hhmmss": "01:43:43",
        "end_hhmmss": "01:43:45",
        "start": 6223.135,
        "end": 6225.261
      }
    },
    {
      "edge": "M1432",
      "attrs": {
        "text": "There are 24,000 troops in the city...",
        "start_hhmmss": "01:43:45",
        "end_hhmmss": "01:43:48",
        "start": 6225.469,
        "end": 6227.513
      }
    },
    {
      "edge": "M1433",
      "attrs": {
        "text": "...and they can be reinforced by another 30,000 in two days.",
        "start_hhmmss": "01:43:48",
        "end_hhmmss": "01:43:51",
        "start": 6227.723,
        "end": 6230.851
      }
    },
    {
      "edge": "M1434",
      "attrs": {
        "text": "So the question is, where to deploy them?",
        "start_hhmmss": "01:43:51",
        "end_hhmmss": "01:43:54",
        "start": 6231.059,
        "end": 6233.561
      }
    },
    {
      "edge": "M1435",
      "attrs": {
        "text": "My informers say the critical moment is when the procession passes the square.",
        "start_hhmmss": "01:43:54",
        "end_hhmmss": "01:43:58",
        "start": 6233.77,
        "end": 6238.357
      }
    },
    {
      "edge": "M1436",
      "attrs": {
        "text": "That's where they'll start the fighting.",
        "start_hhmmss": "01:43:59",
        "end_hhmmss": "01:44:01",
        "start": 6238.566,
        "end": 6240.736
      }
    },
    {
      "edge": "M1437",
      "attrs": {
        "text": "Well, we won't fight them for every inch. We'll surround them.",
        "start_hhmmss": "01:44:01",
        "end_hhmmss": "01:44:07",
        "start": 6240.944,
        "end": 6246.574
      }
    },
    {
      "edge": "M1438",
      "attrs": {
        "text": "Long live the Republic! Long live....",
        "start_hhmmss": "01:44:07",
        "end_hhmmss": "01:44:10",
        "start": 6247.117,
        "end": 6249.745
      }
    },
    {
      "edge": "M1439",
      "attrs": {
        "text": "It's frightening, Papa.",
        "start_hhmmss": "01:44:10",
        "end_hhmmss": "01:44:12",
        "start": 6249.953,
        "end": 6251.747
      }
    },
    {
      "edge": "M1440",
      "attrs": {
        "text": "Why are they so angry about this?",
        "start_hhmmss": "01:44:12",
        "end_hhmmss": "01:44:14",
        "start": 6251.955,
        "end": 6253.874
      }
    },
    {
      "edge": "M1441",
      "attrs": {
        "text": "Lamarque was a hero who fought for the Republic.",
        "start_hhmmss": "01:44:14",
        "end_hhmmss": "01:44:17",
        "start": 6254.082,
        "end": 6256.709
      }
    },
    {
      "edge": "M1442",
      "attrs": {
        "text": "Why is the king giving Lamarque a state funeral?",
        "start_hhmmss": "01:44:17",
        "end_hhmmss": "01:44:21",
        "start": 6256.918,
        "end": 6260.546
      }
    },
    {
      "edge": "M1443",
      "attrs": {
        "text": "He's trying to claim Lamarque as his own hero.",
        "start_hhmmss": "01:44:21",
        "end_hhmmss": "01:44:23",
        "start": 6260.756,
        "end": 6263.34
      }
    },
    {
      "edge": "M1444",
      "attrs": {
        "text": "It's a lie, it's the final insult.",
        "start_hhmmss": "01:44:24",
        "end_hhmmss": "01:44:26",
        "start": 6263.549,
        "end": 6266.26
      }
    },
    {
      "edge": "M1445",
      "attrs": {
        "text": "That's why they're angry.",
        "start_hhmmss": "01:44:26",
        "end_hhmmss": "01:44:29",
        "start": 6266.469,
        "end": 6268.512
      }
    },
    {
      "edge": "M1446",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:44:29",
        "end_hhmmss": "01:44:30",
        "start": 6268.889,
        "end": 6270.182
      }
    },
    {
      "edge": "M1447",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:45:17",
        "end_hhmmss": "01:45:20",
        "start": 6316.644,
        "end": 6319.563
      }
    },
    {
      "edge": "M1448",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:45:21",
        "end_hhmmss": "01:45:23",
        "start": 6320.648,
        "end": 6322.614148148148
      }
    },
    {
      "edge": "M1449",
      "attrs": {
        "text": "Long live....",
        "start_hhmmss": "01:45:23",
        "end_hhmmss": "01:45:23",
        "start": 6322.614148148148,
        "end": 6323.442
      }
    },
    {
      "edge": "M1450",
      "attrs": {
        "text": "Long live Lamarque!",
        "start_hhmmss": "01:45:24",
        "end_hhmmss": "01:45:26",
        "start": 6323.651,
        "end": 6326.196
      }
    },
    {
      "edge": "M1451",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:45:26",
        "end_hhmmss": "01:45:29",
        "start": 6326.403,
        "end": 6329.406
      }
    },
    {
      "edge": "M1452",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:45:30",
        "end_hhmmss": "01:45:31",
        "start": 6329.615,
        "end": 6330.8875
      }
    },
    {
      "edge": "M1453",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:45:31",
        "end_hhmmss": "01:45:32",
        "start": 6330.8875,
        "end": 6332.16
      }
    },
    {
      "edge": "M1454",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:45:32",
        "end_hhmmss": "01:45:35",
        "start": 6332.368,
        "end": 6335.121
      }
    },
    {
      "edge": "M1455",
      "attrs": {
        "text": "Lamarque is ours!",
        "start_hhmmss": "01:45:37",
        "end_hhmmss": "01:45:39",
        "start": 6336.705,
        "end": 6338.6909000000005
      }
    },
    {
      "edge": "M1456",
      "attrs": {
        "text": "Come on!",
        "start_hhmmss": "01:45:39",
        "end_hhmmss": "01:45:40",
        "start": 6338.6909000000005,
        "end": 6339.542
      }
    },
    {
      "edge": "M1457",
      "attrs": {
        "text": "Let's bury Lamarque!",
        "start_hhmmss": "01:45:43",
        "end_hhmmss": "01:45:45",
        "start": 6343.088,
        "end": 6345.09
      }
    },
    {
      "edge": "M1458",
      "attrs": {
        "text": "Lamarque is our hero! Come on, everybody, pull!",
        "start_hhmmss": "01:45:51",
        "end_hhmmss": "01:45:56",
        "start": 6351.304,
        "end": 6355.808
      }
    },
    {
      "edge": "M1459",
      "attrs": {
        "text": "Come on!",
        "start_hhmmss": "01:45:57",
        "end_hhmmss": "01:45:59",
        "start": 6357.185,
        "end": 6359.02
      }
    },
    {
      "edge": "M1460",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:46:04",
        "end_hhmmss": "01:46:07",
        "start": 6364.067,
        "end": 6367.279
      }
    },
    {
      "edge": "M1461",
      "attrs": {
        "text": "To the barricades!",
        "start_hhmmss": "01:46:20",
        "end_hhmmss": "01:46:21",
        "start": 6379.665,
        "end": 6381.334
      }
    },
    {
      "edge": "M1462",
      "attrs": {
        "text": "Get down!",
        "start_hhmmss": "01:46:49",
        "end_hhmmss": "01:46:51",
        "start": 6408.777,
        "end": 6410.613
      }
    },
    {
      "edge": "M1463",
      "attrs": {
        "text": "Move up!",
        "start_hhmmss": "01:46:54",
        "end_hhmmss": "01:46:55",
        "start": 6413.741,
        "end": 6415.076
      }
    },
    {
      "edge": "M1464",
      "attrs": {
        "text": "Your information is as good as gold...",
        "start_hhmmss": "01:47:04",
        "end_hhmmss": "01:47:06",
        "start": 6423.542,
        "end": 6425.794
      }
    },
    {
      "edge": "M1465",
      "attrs": {
        "text": "...but the idiots in the municipal guard...",
        "start_hhmmss": "01:47:06",
        "end_hhmmss": "01:47:09",
        "start": 6426.004,
        "end": 6428.797
      }
    },
    {
      "edge": "M1466",
      "attrs": {
        "text": "...ignored your advice about the arsenal.",
        "start_hhmmss": "01:47:09",
        "end_hhmmss": "01:47:12",
        "start": 6429.007,
        "end": 6432.177
      }
    },
    {
      "edge": "M1467",
      "attrs": {
        "text": "Javert, why are you dressed like that?",
        "start_hhmmss": "01:47:14",
        "end_hhmmss": "01:47:16",
        "start": 6433.761,
        "end": 6436.472
      }
    },
    {
      "edge": "M1468",
      "attrs": {
        "text": "Because I'm on the trail of someone who is very dangerous.",
        "start_hhmmss": "01:47:17",
        "end_hhmmss": "01:47:20",
        "start": 6436.68,
        "end": 6439.725
      }
    },
    {
      "edge": "M1469",
      "attrs": {
        "text": "It will be an important arrest. Possibly the most important of my career.",
        "start_hhmmss": "01:47:20",
        "end_hhmmss": "01:47:24",
        "start": 6440.06,
        "end": 6443.98
      }
    },
    {
      "edge": "M1470",
      "attrs": {
        "text": "Indeed? Who is it?",
        "start_hhmmss": "01:47:24",
        "end_hhmmss": "01:47:27",
        "start": 6444.189,
        "end": 6446.523
      }
    },
    {
      "edge": "M1471",
      "attrs": {
        "text": "I'd rather not say until I've got him.",
        "start_hhmmss": "01:47:27",
        "end_hhmmss": "01:47:29",
        "start": 6446.732,
        "end": 6448.734
      }
    },
    {
      "edge": "M1472",
      "attrs": {
        "text": "At the very least, show me where you're going.",
        "start_hhmmss": "01:47:29",
        "end_hhmmss": "01:47:32",
        "start": 6449.277,
        "end": 6451.654
      }
    },
    {
      "edge": "M1473",
      "attrs": {
        "text": "Past the perimeter. Here.",
        "start_hhmmss": "01:47:32",
        "end_hhmmss": "01:47:34",
        "start": 6451.862,
        "end": 6454.448
      }
    },
    {
      "edge": "M1474",
      "attrs": {
        "text": "There are dozens of barricades.",
        "start_hhmmss": "01:47:35",
        "end_hhmmss": "01:47:37",
        "start": 6454.657,
        "end": 6456.993
      }
    },
    {
      "edge": "M1475",
      "attrs": {
        "text": "Anything could happen. We have no control in this area.",
        "start_hhmmss": "01:47:37",
        "end_hhmmss": "01:47:42",
        "start": 6457.202,
        "end": 6461.538
      }
    },
    {
      "edge": "M1476",
      "attrs": {
        "text": "It's under control, sir.",
        "start_hhmmss": "01:47:42",
        "end_hhmmss": "01:47:44",
        "start": 6461.998,
        "end": 6464.458
      }
    },
    {
      "edge": "M1477",
      "attrs": {
        "text": "As soon as it's dark, we'll go through the barrier. Hundreds are fleeing.",
        "start_hhmmss": "01:47:50",
        "end_hhmmss": "01:47:54",
        "start": 6470.298,
        "end": 6474.135
      }
    },
    {
      "edge": "M1478",
      "attrs": {
        "text": "Police don't care who leaves. More concerned about people coming in...",
        "start_hhmmss": "01:47:54",
        "end_hhmmss": "01:47:58",
        "start": 6474.344,
        "end": 6478.014
      }
    },
    {
      "edge": "M1479",
      "attrs": {
        "text": "...so it's a perfect opportunity. Cosette, please!",
        "start_hhmmss": "01:47:58",
        "end_hhmmss": "01:48:01",
        "start": 6478.223,
        "end": 6481.059
      }
    },
    {
      "edge": "M1480",
      "attrs": {
        "text": "How bad is the fighting?",
        "start_hhmmss": "01:48:03",
        "end_hhmmss": "01:48:04",
        "start": 6482.81,
        "end": 6484.478
      }
    },
    {
      "edge": "M1481",
      "attrs": {
        "text": "I didn't go anywhere near it. I went the other way.",
        "start_hhmmss": "01:48:05",
        "end_hhmmss": "01:48:08",
        "start": 6484.687,
        "end": 6487.983
      }
    },
    {
      "edge": "M1482",
      "attrs": {
        "text": "What are they saying?",
        "start_hhmmss": "01:48:09",
        "end_hhmmss": "01:48:10",
        "start": 6488.732,
        "end": 6490.0297872340425
      }
    },
    {
      "edge": "M1483",
      "attrs": {
        "text": "No one really knows what's happening.",
        "start_hhmmss": "01:48:10",
        "end_hhmmss": "01:48:12",
        "start": 6490.0297872340425,
        "end": 6492.32
      }
    },
    {
      "edge": "M1484",
      "attrs": {
        "text": "The streets are full of barricades. Everyone says something different.",
        "start_hhmmss": "01:48:13",
        "end_hhmmss": "01:48:16",
        "start": 6492.528,
        "end": 6496.199
      }
    },
    {
      "edge": "M1485",
      "attrs": {
        "text": "Whatever the truth is, a lot of people will die tonight.",
        "start_hhmmss": "01:48:16",
        "end_hhmmss": "01:48:20",
        "start": 6496.408,
        "end": 6499.618
      }
    },
    {
      "edge": "M1486",
      "attrs": {
        "text": "Is it too dangerous for us to wait till the morning?",
        "start_hhmmss": "01:48:20",
        "end_hhmmss": "01:48:23",
        "start": 6499.827,
        "end": 6502.538
      }
    },
    {
      "edge": "M1487",
      "attrs": {
        "text": "He's not in the barricades?",
        "start_hhmmss": "01:48:34",
        "end_hhmmss": "01:48:37",
        "start": 6514.3,
        "end": 6516.677
      }
    },
    {
      "edge": "M1488",
      "attrs": {
        "text": "I promised I'd wait.",
        "start_hhmmss": "01:48:38",
        "end_hhmmss": "01:48:40",
        "start": 6518.054,
        "end": 6520.056
      }
    },
    {
      "edge": "M1489",
      "attrs": {
        "text": "Even if he can't come, I have to wait.",
        "start_hhmmss": "01:48:40",
        "end_hhmmss": "01:48:43",
        "start": 6520.265,
        "end": 6522.683
      }
    },
    {
      "edge": "M1490",
      "attrs": {
        "text": "It hurts this much?",
        "start_hhmmss": "01:48:43",
        "end_hhmmss": "01:48:45",
        "start": 6523.101,
        "end": 6525.290318181818
      }
    },
    {
      "edge": "M1491",
      "attrs": {
        "text": "I'm sorry.",
        "start_hhmmss": "01:48:45",
        "end_hhmmss": "01:48:46",
        "start": 6525.290318181818,
        "end": 6526.312
      }
    },
    {
      "edge": "M1492",
      "attrs": {
        "text": "I've known him only a few weeks, that's what you think.",
        "start_hhmmss": "01:48:47",
        "end_hhmmss": "01:48:49",
        "start": 6526.52,
        "end": 6529.357
      }
    },
    {
      "edge": "M1493",
      "attrs": {
        "text": "I'm only a silly girl, he's little more than a stranger. But that's not how I feel.",
        "start_hhmmss": "01:48:50",
        "end_hhmmss": "01:48:55",
        "start": 6529.565,
        "end": 6534.82
      }
    },
    {
      "edge": "M1494",
      "attrs": {
        "text": "I understand, my dear.",
        "start_hhmmss": "01:48:55",
        "end_hhmmss": "01:49:00",
        "start": 6535.196,
        "end": 6539.783
      }
    },
    {
      "edge": "M1495",
      "attrs": {
        "text": "Your papers.",
        "start_hhmmss": "01:49:09",
        "end_hhmmss": "01:49:10",
        "start": 6548.584,
        "end": 6550.086
      }
    },
    {
      "edge": "M1496",
      "attrs": {
        "text": "Right.",
        "start_hhmmss": "01:49:13",
        "end_hhmmss": "01:49:15",
        "start": 6553.089,
        "end": 6554.882
      }
    },
    {
      "edge": "M1497",
      "attrs": {
        "text": "Marius. Not tonight.",
        "start_hhmmss": "01:49:55",
        "end_hhmmss": "01:49:56",
        "start": 6594.547,
        "end": 6596.006
      }
    },
    {
      "edge": "M1498",
      "attrs": {
        "text": "One hour.",
        "start_hhmmss": "01:49:58",
        "end_hhmmss": "01:49:59",
        "start": 6598.008,
        "end": 6599.219
      }
    },
    {
      "edge": "M1499",
      "attrs": {
        "text": "I'll be gone one hour.",
        "start_hhmmss": "01:50:00",
        "end_hhmmss": "01:50:03",
        "start": 6600.052,
        "end": 6602.555
      }
    },
    {
      "edge": "M1500",
      "attrs": {
        "text": "I found my boys.",
        "start_hhmmss": "01:50:07",
        "end_hhmmss": "01:50:08",
        "start": 6606.767,
        "end": 6607.625
      }
    },
    {
      "edge": "M1501",
      "attrs": {
        "text": "Well done, Gavroche.",
        "start_hhmmss": "01:50:08",
        "end_hhmmss": "01:50:09",
        "start": 6607.625,
        "end": 6608.769
      }
    },
    {
      "edge": "M1502",
      "attrs": {
        "text": "Marius.",
        "start_hhmmss": "01:50:12",
        "end_hhmmss": "01:50:14",
        "start": 6612.064,
        "end": 6613.982
      }
    },
    {
      "edge": "M1503",
      "attrs": {
        "text": "The law is here to protect you, Cosette...",
        "start_hhmmss": "01:50:36",
        "end_hhmmss": "01:50:39",
        "start": 6636.422,
        "end": 6638.966
      }
    },
    {
      "edge": "M1504",
      "attrs": {
        "text": "...from criminals like this scum.",
        "start_hhmmss": "01:50:39",
        "end_hhmmss": "01:50:42",
        "start": 6639.175,
        "end": 6641.885
      }
    },
    {
      "edge": "M1505",
      "attrs": {
        "text": "Is Valjean here? Is he alone?",
        "start_hhmmss": "01:50:45",
        "end_hhmmss": "01:50:48",
        "start": 6645.097,
        "end": 6648.226
      }
    },
    {
      "edge": "M1506",
      "attrs": {
        "text": "I'll never tell you anything.",
        "start_hhmmss": "01:50:48",
        "end_hhmmss": "01:50:50",
        "start": 6648.434,
        "end": 6650.06
      }
    },
    {
      "edge": "M1507",
      "attrs": {
        "text": "Do you know who and what you're protecting?",
        "start_hhmmss": "01:50:50",
        "end_hhmmss": "01:50:52",
        "start": 6650.27,
        "end": 6652.48
      }
    },
    {
      "edge": "M1508",
      "attrs": {
        "text": "Didn't he tell you he's a common thief?",
        "start_hhmmss": "01:50:53",
        "end_hhmmss": "01:50:55",
        "start": 6653.105,
        "end": 6655.191
      }
    },
    {
      "edge": "M1509",
      "attrs": {
        "text": "I know exactly who he is.",
        "start_hhmmss": "01:50:55",
        "end_hhmmss": "01:50:57",
        "start": 6655.4,
        "end": 6656.896355555556
      }
    },
    {
      "edge": "M1510",
      "attrs": {
        "text": "Oh, yes? Did he tell you who you are?",
        "start_hhmmss": "01:50:57",
        "end_hhmmss": "01:50:59",
        "start": 6656.896355555556,
        "end": 6658.944
      }
    },
    {
      "edge": "M1511",
      "attrs": {
        "text": "Did he tell you you're a bastard child?",
        "start_hhmmss": "01:50:59",
        "end_hhmmss": "01:51:02",
        "start": 6659.154,
        "end": 6661.614
      }
    },
    {
      "edge": "M1512",
      "attrs": {
        "text": "Did he tell you your mother was a whore?",
        "start_hhmmss": "01:51:02",
        "end_hhmmss": "01:51:04",
        "start": 6661.822,
        "end": 6664.367
      }
    },
    {
      "edge": "M1513",
      "attrs": {
        "text": "You're breaking the law.",
        "start_hhmmss": "01:51:11",
        "end_hhmmss": "01:51:12",
        "start": 6671.291,
        "end": 6672.387153846154
      }
    },
    {
      "edge": "M1514",
      "attrs": {
        "text": "Untie me.",
        "start_hhmmss": "01:51:12",
        "end_hhmmss": "01:51:13",
        "start": 6672.387153846154,
        "end": 6672.791
      }
    },
    {
      "edge": "M1515",
      "attrs": {
        "text": "There'll be no turning back.",
        "start_hhmmss": "01:51:13",
        "end_hhmmss": "01:51:15",
        "start": 6673.0,
        "end": 6675.127
      }
    },
    {
      "edge": "M1516",
      "attrs": {
        "text": "Who are you?",
        "start_hhmmss": "01:51:18",
        "end_hhmmss": "01:51:20",
        "start": 6678.339,
        "end": 6680.216
      }
    },
    {
      "edge": "M1517",
      "attrs": {
        "text": "Who are you?",
        "start_hhmmss": "01:51:24",
        "end_hhmmss": "01:51:25",
        "start": 6683.553,
        "end": 6684.596
      }
    },
    {
      "edge": "M1518",
      "attrs": {
        "text": "I'm Chief Inspector Javert. If you surrender, things will go better for you.",
        "start_hhmmss": "01:51:25",
        "end_hhmmss": "01:51:29",
        "start": 6684.803,
        "end": 6688.807
      }
    },
    {
      "edge": "M1519",
      "attrs": {
        "text": "Surrender? I'm taking you to face the people's justice.",
        "start_hhmmss": "01:51:29",
        "end_hhmmss": "01:51:32",
        "start": 6689.016,
        "end": 6692.437
      }
    },
    {
      "edge": "M1520",
      "attrs": {
        "text": "At the barricades?",
        "start_hhmmss": "01:51:36",
        "end_hhmmss": "01:51:38",
        "start": 6696.399,
        "end": 6698.484
      }
    },
    {
      "edge": "M1521",
      "attrs": {
        "text": "You fool. Don't you know your revolution has no chance?",
        "start_hhmmss": "01:51:39",
        "end_hhmmss": "01:51:43",
        "start": 6699.151,
        "end": 6702.863
      }
    },
    {
      "edge": "M1522",
      "attrs": {
        "text": "If we die, you die with us.",
        "start_hhmmss": "01:51:43",
        "end_hhmmss": "01:51:47",
        "start": 6703.071,
        "end": 6707.159
      }
    },
    {
      "edge": "M1523",
      "attrs": {
        "text": "Goodbye, Marius.",
        "start_hhmmss": "01:51:48",
        "end_hhmmss": "01:51:50",
        "start": 6707.993,
        "end": 6710.246
      }
    },
    {
      "edge": "M1524",
      "attrs": {
        "text": "I love you, Cosette.",
        "start_hhmmss": "01:51:52",
        "end_hhmmss": "01:51:55",
        "start": 6711.83,
        "end": 6714.542
      }
    },
    {
      "edge": "M1525",
      "attrs": {
        "text": "Go on!",
        "start_hhmmss": "01:51:58",
        "end_hhmmss": "01:52:00",
        "start": 6717.878,
        "end": 6719.963
      }
    },
    {
      "edge": "M1526",
      "attrs": {
        "text": "He came to say goodbye.",
        "start_hhmmss": "01:52:07",
        "end_hhmmss": "01:52:10",
        "start": 6726.845,
        "end": 6729.641
      }
    },
    {
      "edge": "M1527",
      "attrs": {
        "text": "He loves me, Papa.",
        "start_hhmmss": "01:52:10",
        "end_hhmmss": "01:52:13",
        "start": 6730.057,
        "end": 6732.602
      }
    },
    {
      "edge": "M1528",
      "attrs": {
        "text": "He loves me.",
        "start_hhmmss": "01:52:13",
        "end_hhmmss": "01:52:15",
        "start": 6733.06,
        "end": 6735.355
      }
    },
    {
      "edge": "M1529",
      "attrs": {
        "text": "Take her to our old house.",
        "start_hhmmss": "01:52:30",
        "end_hhmmss": "01:52:31",
        "start": 6749.619,
        "end": 6750.994
      }
    },
    {
      "edge": "M1530",
      "attrs": {
        "text": "It's going to be all right. I promise you.",
        "start_hhmmss": "01:52:33",
        "end_hhmmss": "01:52:36",
        "start": 6752.705,
        "end": 6755.916
      }
    },
    {
      "edge": "M1531",
      "attrs": {
        "text": "Fire at will!",
        "start_hhmmss": "01:52:59",
        "end_hhmmss": "01:53:00",
        "start": 6779.231,
        "end": 6780.275
      }
    },
    {
      "edge": "M1532",
      "attrs": {
        "text": "So here we are.",
        "start_hhmmss": "01:53:45",
        "end_hhmmss": "01:53:47",
        "start": 6825.068,
        "end": 6827.112
      }
    },
    {
      "edge": "M1533",
      "attrs": {
        "text": "I was right.",
        "start_hhmmss": "01:53:48",
        "end_hhmmss": "01:53:50",
        "start": 6827.946,
        "end": 6830.073
      }
    },
    {
      "edge": "M1534",
      "attrs": {
        "text": "You know him?",
        "start_hhmmss": "01:53:51",
        "end_hhmmss": "01:53:52",
        "start": 6830.742,
        "end": 6831.992
      }
    },
    {
      "edge": "M1535",
      "attrs": {
        "text": "When we have a spare bullet, we're going to kill him.",
        "start_hhmmss": "01:53:52",
        "end_hhmmss": "01:53:57",
        "start": 6832.2,
        "end": 6836.955
      }
    },
    {
      "edge": "M1536",
      "attrs": {
        "text": "What are you doing here? Where is Cosette?",
        "start_hhmmss": "01:54:14",
        "end_hhmmss": "01:54:18",
        "start": 6854.39,
        "end": 6857.518
      }
    },
    {
      "edge": "M1537",
      "attrs": {
        "text": "Waiting for you in the house where you fell in love.",
        "start_hhmmss": "01:54:18",
        "end_hhmmss": "01:54:21",
        "start": 6857.727,
        "end": 6861.021
      }
    },
    {
      "edge": "M1538",
      "attrs": {
        "text": "Go to her. Go to her.",
        "start_hhmmss": "01:54:22",
        "end_hhmmss": "01:54:23",
        "start": 6861.897,
        "end": 6863.41572
      }
    },
    {
      "edge": "M1539",
      "attrs": {
        "text": "I can't. Not now.",
        "start_hhmmss": "01:54:23",
        "end_hhmmss": "01:54:25",
        "start": 6863.41572,
        "end": 6864.609
      }
    },
    {
      "edge": "M1540",
      "attrs": {
        "text": "Not now.",
        "start_hhmmss": "01:54:25",
        "end_hhmmss": "01:54:26",
        "start": 6864.817,
        "end": 6865.6054
      }
    },
    {
      "edge": "M1541",
      "attrs": {
        "text": "She's your future.",
        "start_hhmmss": "01:54:26",
        "end_hhmmss": "01:54:27",
        "start": 6865.6054,
        "end": 6867.445
      }
    },
    {
      "edge": "M1542",
      "attrs": {
        "text": "If we can't win, then none of us have a future.",
        "start_hhmmss": "01:54:28",
        "end_hhmmss": "01:54:30",
        "start": 6867.653,
        "end": 6870.113
      }
    },
    {
      "edge": "M1543",
      "attrs": {
        "text": "You have love.",
        "start_hhmmss": "01:54:30",
        "end_hhmmss": "01:54:32",
        "start": 6870.322,
        "end": 6872.367
      }
    },
    {
      "edge": "M1544",
      "attrs": {
        "text": "That's the only future God gives us.",
        "start_hhmmss": "01:54:33",
        "end_hhmmss": "01:54:36",
        "start": 6873.033,
        "end": 6876.161
      }
    },
    {
      "edge": "M1545",
      "attrs": {
        "text": "Go.",
        "start_hhmmss": "01:54:37",
        "end_hhmmss": "01:54:39",
        "start": 6876.788,
        "end": 6878.539
      }
    },
    {
      "edge": "M1546",
      "attrs": {
        "text": "Gavroche, get back!",
        "start_hhmmss": "01:54:40",
        "end_hhmmss": "01:54:42",
        "start": 6880.29,
        "end": 6882.25
      }
    },
    {
      "edge": "M1547",
      "attrs": {
        "text": "Gavroche!",
        "start_hhmmss": "01:54:43",
        "end_hhmmss": "01:54:44",
        "start": 6883.419,
        "end": 6884.370199999999
      }
    },
    {
      "edge": "M1548",
      "attrs": {
        "text": "I need bullets.",
        "start_hhmmss": "01:54:44",
        "end_hhmmss": "01:54:46",
        "start": 6884.370199999999,
        "end": 6885.797
      }
    },
    {
      "edge": "M1549",
      "attrs": {
        "text": "Gavroche!",
        "start_hhmmss": "01:54:46",
        "end_hhmmss": "01:54:47",
        "start": 6886.004,
        "end": 6886.9698947368415
      }
    },
    {
      "edge": "M1550",
      "attrs": {
        "text": "Get back here!",
        "start_hhmmss": "01:54:47",
        "end_hhmmss": "01:54:48",
        "start": 6886.9698947368415,
        "end": 6888.298
      }
    },
    {
      "edge": "M1551",
      "attrs": {
        "text": "Come back!",
        "start_hhmmss": "01:54:50",
        "end_hhmmss": "01:54:52",
        "start": 6890.133,
        "end": 6891.636
      }
    },
    {
      "edge": "M1552",
      "attrs": {
        "text": "Gavroche!",
        "start_hhmmss": "01:54:52",
        "end_hhmmss": "01:54:52",
        "start": 6891.844,
        "end": 6892.405684210527
      }
    },
    {
      "edge": "M1553",
      "attrs": {
        "text": "Get back here!",
        "start_hhmmss": "01:54:52",
        "end_hhmmss": "01:54:53",
        "start": 6892.405684210527,
        "end": 6893.178
      }
    },
    {
      "edge": "M1554",
      "attrs": {
        "text": "Gavroche! Come back!",
        "start_hhmmss": "01:54:53",
        "end_hhmmss": "01:54:55",
        "start": 6893.388,
        "end": 6895.18
      }
    },
    {
      "edge": "M1555",
      "attrs": {
        "text": "Come back!",
        "start_hhmmss": "01:54:55",
        "end_hhmmss": "01:54:57",
        "start": 6895.39,
        "end": 6897.14
      }
    },
    {
      "edge": "M1556",
      "attrs": {
        "text": "Come back!",
        "start_hhmmss": "01:54:57",
        "end_hhmmss": "01:55:00",
        "start": 6897.349,
        "end": 6899.56
      }
    },
    {
      "edge": "M1557",
      "attrs": {
        "text": "Papa!",
        "start_hhmmss": "01:55:12",
        "end_hhmmss": "01:55:13",
        "start": 6912.114,
        "end": 6913.156
      }
    },
    {
      "edge": "M1558",
      "attrs": {
        "text": "Papa!",
        "start_hhmmss": "01:55:15",
        "end_hhmmss": "01:55:16",
        "start": 6914.7,
        "end": 6915.8675
      }
    },
    {
      "edge": "M1559",
      "attrs": {
        "text": "Papa.",
        "start_hhmmss": "01:55:16",
        "end_hhmmss": "01:55:17",
        "start": 6915.8675,
        "end": 6917.035
      }
    },
    {
      "edge": "M1560",
      "attrs": {
        "text": "Let's do it now.",
        "start_hhmmss": "01:55:22",
        "end_hhmmss": "01:55:24",
        "start": 6922.417,
        "end": 6923.501
      }
    },
    {
      "edge": "M1561",
      "attrs": {
        "text": "You proud of your work?",
        "start_hhmmss": "01:55:24",
        "end_hhmmss": "01:55:26",
        "start": 6924.0,
        "end": 6926.447999999999
      }
    },
    {
      "edge": "M1562",
      "attrs": {
        "text": "You're next.",
        "start_hhmmss": "01:55:26",
        "end_hhmmss": "01:55:28",
        "start": 6926.447999999999,
        "end": 6927.672
      }
    },
    {
      "edge": "M1563",
      "attrs": {
        "text": "Let me do it.",
        "start_hhmmss": "01:55:31",
        "end_hhmmss": "01:55:33",
        "start": 6931.383,
        "end": 6933.343
      }
    },
    {
      "edge": "M1564",
      "attrs": {
        "text": "You kill him in the alley.",
        "start_hhmmss": "01:55:37",
        "end_hhmmss": "01:55:38",
        "start": 6936.764,
        "end": 6938.474
      }
    },
    {
      "edge": "M1565",
      "attrs": {
        "text": "We don't want his blood in here with ours.",
        "start_hhmmss": "01:55:39",
        "end_hhmmss": "01:55:42",
        "start": 6938.683,
        "end": 6941.935
      }
    },
    {
      "edge": "M1566",
      "attrs": {
        "text": "A knife. That's right. It suits you better.",
        "start_hhmmss": "01:55:54",
        "end_hhmmss": "01:55:58",
        "start": 6954.364,
        "end": 6958.453
      }
    },
    {
      "edge": "M1567",
      "attrs": {
        "text": "Why? Why couldn't you leave me alone?",
        "start_hhmmss": "01:55:59",
        "end_hhmmss": "01:56:01",
        "start": 6958.661,
        "end": 6960.663
      }
    },
    {
      "edge": "M1568",
      "attrs": {
        "text": "I'm nothing. I'm no one!",
        "start_hhmmss": "01:56:01",
        "end_hhmmss": "01:56:03",
        "start": 6960.872,
        "end": 6962.523809523809
      }
    },
    {
      "edge": "M1569",
      "attrs": {
        "text": "Yes, but you've managed to beat me.",
        "start_hhmmss": "01:56:03",
        "end_hhmmss": "01:56:05",
        "start": 6962.523809523809,
        "end": 6965.208
      }
    },
    {
      "edge": "M1570",
      "attrs": {
        "text": "I'm not trying to beat you. I want to live in peace!",
        "start_hhmmss": "01:56:05",
        "end_hhmmss": "01:56:08",
        "start": 6965.417,
        "end": 6968.128
      }
    },
    {
      "edge": "M1571",
      "attrs": {
        "text": "Then hurry up and do it.",
        "start_hhmmss": "01:56:08",
        "end_hhmmss": "01:56:10",
        "start": 6968.336,
        "end": 6969.755
      }
    },
    {
      "edge": "M1572",
      "attrs": {
        "text": "Your friends need you.",
        "start_hhmmss": "01:56:10",
        "end_hhmmss": "01:56:13",
        "start": 6970.088,
        "end": 6972.508
      }
    },
    {
      "edge": "M1573",
      "attrs": {
        "text": "That way. Through the gate. You'll be safe.",
        "start_hhmmss": "01:56:29",
        "end_hhmmss": "01:56:33",
        "start": 6989.316,
        "end": 6993.445
      }
    },
    {
      "edge": "M1574",
      "attrs": {
        "text": "You plan to shoot me in the back.",
        "start_hhmmss": "01:56:34",
        "end_hhmmss": "01:56:36",
        "start": 6993.654,
        "end": 6995.576777777778
      }
    },
    {
      "edge": "M1575",
      "attrs": {
        "text": "I'm letting you go, Javert.",
        "start_hhmmss": "01:56:36",
        "end_hhmmss": "01:56:37",
        "start": 6995.576777777778,
        "end": 6997.115
      }
    },
    {
      "edge": "M1576",
      "attrs": {
        "text": "You'd better hurry.",
        "start_hhmmss": "01:56:38",
        "end_hhmmss": "01:56:40",
        "start": 6998.116,
        "end": 6999.827
      }
    },
    {
      "edge": "M1577",
      "attrs": {
        "text": "They won't be merciful.",
        "start_hhmmss": "01:56:40",
        "end_hhmmss": "01:56:42",
        "start": 7000.035,
        "end": 7002.078
      }
    },
    {
      "edge": "M1578",
      "attrs": {
        "text": "Go on.",
        "start_hhmmss": "01:56:44",
        "end_hhmmss": "01:56:46",
        "start": 7003.539,
        "end": 7005.5
      }
    },
    {
      "edge": "M1579",
      "attrs": {
        "text": "You should kill me.",
        "start_hhmmss": "01:56:46",
        "end_hhmmss": "01:56:49",
        "start": 7006.374,
        "end": 7008.628
      }
    },
    {
      "edge": "M1580",
      "attrs": {
        "text": "I won't stop.",
        "start_hhmmss": "01:56:50",
        "end_hhmmss": "01:56:52",
        "start": 7009.921,
        "end": 7012.088
      }
    },
    {
      "edge": "M1581",
      "attrs": {
        "text": "Understand?",
        "start_hhmmss": "01:56:52",
        "end_hhmmss": "01:56:54",
        "start": 7012.297,
        "end": 7014.466
      }
    },
    {
      "edge": "M1582",
      "attrs": {
        "text": "I won't let you go.",
        "start_hhmmss": "01:56:55",
        "end_hhmmss": "01:56:58",
        "start": 7015.008,
        "end": 7017.637
      }
    },
    {
      "edge": "M1583",
      "attrs": {
        "text": "You should end this.",
        "start_hhmmss": "01:56:58",
        "end_hhmmss": "01:56:59",
        "start": 7018.178,
        "end": 7019.262
      }
    },
    {
      "edge": "M1584",
      "attrs": {
        "text": "Kill me.",
        "start_hhmmss": "01:57:05",
        "end_hhmmss": "01:57:07",
        "start": 7025.06,
        "end": 7026.979
      }
    },
    {
      "edge": "M1585",
      "attrs": {
        "text": "You're dead, Javert.",
        "start_hhmmss": "01:57:18",
        "end_hhmmss": "01:57:19",
        "start": 7037.657,
        "end": 7038.95
      }
    },
    {
      "edge": "M1586",
      "attrs": {
        "text": "Get back!",
        "start_hhmmss": "01:57:31",
        "end_hhmmss": "01:57:32",
        "start": 7050.67,
        "end": 7051.520043478261
      }
    },
    {
      "edge": "M1587",
      "attrs": {
        "text": "Everybody, get back!",
        "start_hhmmss": "01:57:32",
        "end_hhmmss": "01:57:33",
        "start": 7051.520043478261,
        "end": 7053.463
      }
    },
    {
      "edge": "M1588",
      "attrs": {
        "text": "Yes, sir!",
        "start_hhmmss": "01:57:41",
        "end_hhmmss": "01:57:42",
        "start": 7061.221,
        "end": 7062.024684210526
      }
    },
    {
      "edge": "M1589",
      "attrs": {
        "text": "On the back! Back!",
        "start_hhmmss": "01:57:42",
        "end_hhmmss": "01:57:44",
        "start": 7062.024684210526,
        "end": 7063.766
      }
    },
    {
      "edge": "M1590",
      "attrs": {
        "text": "Take them in two!",
        "start_hhmmss": "01:57:44",
        "end_hhmmss": "01:57:45",
        "start": 7063.975,
        "end": 7065.308
      }
    },
    {
      "edge": "M1591",
      "attrs": {
        "text": "Have at them, lads!",
        "start_hhmmss": "01:58:04",
        "end_hhmmss": "01:58:06",
        "start": 7084.369,
        "end": 7085.997
      }
    },
    {
      "edge": "M1592",
      "attrs": {
        "text": "Surrender!",
        "start_hhmmss": "01:58:11",
        "end_hhmmss": "01:58:12",
        "start": 7090.835,
        "end": 7092.127
      }
    },
    {
      "edge": "M1593",
      "attrs": {
        "text": "Surrender or be shot!",
        "start_hhmmss": "01:58:13",
        "end_hhmmss": "01:58:15",
        "start": 7092.712,
        "end": 7094.88
      }
    },
    {
      "edge": "M1594",
      "attrs": {
        "text": "Well done! Men, search the building!",
        "start_hhmmss": "01:58:15",
        "end_hhmmss": "01:58:19",
        "start": 7095.255,
        "end": 7098.587
      }
    },
    {
      "edge": "M1595",
      "attrs": {
        "text": "Yes, sir!",
        "start_hhmmss": "01:58:19",
        "end_hhmmss": "01:58:19",
        "start": 7098.587,
        "end": 7099.301
      }
    },
    {
      "edge": "M1596",
      "attrs": {
        "text": "Stand. Stand.",
        "start_hhmmss": "01:58:20",
        "end_hhmmss": "01:58:22",
        "start": 7099.509,
        "end": 7101.721
      }
    },
    {
      "edge": "M1597",
      "attrs": {
        "text": "Look on the other side of the street!",
        "start_hhmmss": "01:58:22",
        "end_hhmmss": "01:58:25",
        "start": 7101.929,
        "end": 7104.876125
      }
    },
    {
      "edge": "M1598",
      "attrs": {
        "text": "Sir!",
        "start_hhmmss": "01:58:25",
        "end_hhmmss": "01:58:25",
        "start": 7104.876125,
        "end": 7105.181
      }
    },
    {
      "edge": "M1599",
      "attrs": {
        "text": "Follow me!",
        "start_hhmmss": "01:58:26",
        "end_hhmmss": "01:58:27",
        "start": 7105.515,
        "end": 7106.892
      }
    },
    {
      "edge": "M1600",
      "attrs": {
        "text": "You men in there, check that doorway!",
        "start_hhmmss": "01:58:40",
        "end_hhmmss": "01:58:43",
        "start": 7119.529,
        "end": 7122.532
      }
    },
    {
      "edge": "M1601",
      "attrs": {
        "text": "Come on. Do it. Jump.",
        "start_hhmmss": "01:58:46",
        "end_hhmmss": "01:58:49",
        "start": 7126.494,
        "end": 7129.497
      }
    },
    {
      "edge": "M1602",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:58:55",
        "end_hhmmss": "01:58:57",
        "start": 7135.087,
        "end": 7137.006
      }
    },
    {
      "edge": "M1603",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:58:58",
        "end_hhmmss": "01:59:00",
        "start": 7138.173,
        "end": 7139.613545454546
      }
    },
    {
      "edge": "M1604",
      "attrs": {
        "text": "This way, lads. Be quick about it.",
        "start_hhmmss": "01:59:00",
        "end_hhmmss": "01:59:02",
        "start": 7139.613545454546,
        "end": 7141.509
      }
    },
    {
      "edge": "M1605",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:59:02",
        "end_hhmmss": "01:59:04",
        "start": 7141.719,
        "end": 7143.763
      }
    },
    {
      "edge": "M1606",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:59:04",
        "end_hhmmss": "01:59:07",
        "start": 7143.971,
        "end": 7146.682
      }
    },
    {
      "edge": "M1607",
      "attrs": {
        "text": "Aim!",
        "start_hhmmss": "01:59:07",
        "end_hhmmss": "01:59:07",
        "start": 7147.223,
        "end": 7147.433681818182
      }
    },
    {
      "edge": "M1608",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:59:07",
        "end_hhmmss": "01:59:09",
        "start": 7147.433681818182,
        "end": 7148.768
      }
    },
    {
      "edge": "M1609",
      "attrs": {
        "text": "Long live the Republic!",
        "start_hhmmss": "01:59:09",
        "end_hhmmss": "01:59:11",
        "start": 7148.976,
        "end": 7150.518
      }
    },
    {
      "edge": "M1610",
      "attrs": {
        "text": "Fire!",
        "start_hhmmss": "01:59:11",
        "end_hhmmss": "01:59:12",
        "start": 7150.728,
        "end": 7151.812
      }
    },
    {
      "edge": "M1611",
      "attrs": {
        "text": "You two, look on the roof.",
        "start_hhmmss": "01:59:27",
        "end_hhmmss": "01:59:29",
        "start": 7166.952,
        "end": 7169.294181818182
      }
    },
    {
      "edge": "M1612",
      "attrs": {
        "text": "Sir.",
        "start_hhmmss": "01:59:29",
        "end_hhmmss": "01:59:30",
        "start": 7169.294181818182,
        "end": 7169.664
      }
    },
    {
      "edge": "M1613",
      "attrs": {
        "text": "Get some lanterns. Hurry.",
        "start_hhmmss": "01:59:35",
        "end_hhmmss": "01:59:37",
        "start": 7175.46,
        "end": 7177.212
      }
    },
    {
      "edge": "M1614",
      "attrs": {
        "text": "This way.",
        "start_hhmmss": "01:59:56",
        "end_hhmmss": "01:59:57",
        "start": 7196.231,
        "end": 7196.99036
      }
    },
    {
      "edge": "M1615",
      "attrs": {
        "text": "He's smarter than that.",
        "start_hhmmss": "01:59:57",
        "end_hhmmss": "01:59:59",
        "start": 7196.99036,
        "end": 7198.943
      }
    },
    {
      "edge": "M1616",
      "attrs": {
        "text": "He'll go downhill to the river. Come on.",
        "start_hhmmss": "01:59:59",
        "end_hhmmss": "02:00:02",
        "start": 7199.151,
        "end": 7201.904
      }
    },
    {
      "edge": "M1617",
      "attrs": {
        "text": "It's all right. It's all right.",
        "start_hhmmss": "02:00:21",
        "end_hhmmss": "02:00:24",
        "start": 7221.132,
        "end": 7223.801
      }
    },
    {
      "edge": "M1618",
      "attrs": {
        "text": "It's all right.",
        "start_hhmmss": "02:00:25",
        "end_hhmmss": "02:00:27",
        "start": 7225.218,
        "end": 7226.636
      }
    },
    {
      "edge": "M1619",
      "attrs": {
        "text": "Now, come on, help me.",
        "start_hhmmss": "02:00:34",
        "end_hhmmss": "02:00:37",
        "start": 7233.894,
        "end": 7236.604
      }
    },
    {
      "edge": "M1620",
      "attrs": {
        "text": "You must help me.",
        "start_hhmmss": "02:00:37",
        "end_hhmmss": "02:00:38",
        "start": 7236.814,
        "end": 7237.898
      }
    },
    {
      "edge": "M1621",
      "attrs": {
        "text": "Push.",
        "start_hhmmss": "02:00:40",
        "end_hhmmss": "02:00:41",
        "start": 7240.025,
        "end": 7241.068
      }
    },
    {
      "edge": "M1622",
      "attrs": {
        "text": "Push!",
        "start_hhmmss": "02:00:42",
        "end_hhmmss": "02:00:43",
        "start": 7241.651,
        "end": 7243.486
      }
    },
    {
      "edge": "M1623",
      "attrs": {
        "text": "Pull. Pull!",
        "start_hhmmss": "02:00:45",
        "end_hhmmss": "02:00:47",
        "start": 7244.654,
        "end": 7247.407
      }
    },
    {
      "edge": "M1624",
      "attrs": {
        "text": "Is he alive?",
        "start_hhmmss": "02:01:30",
        "end_hhmmss": "02:01:32",
        "start": 7290.159,
        "end": 7292.494
      }
    },
    {
      "edge": "M1625",
      "attrs": {
        "text": "Careful.",
        "start_hhmmss": "02:01:53",
        "end_hhmmss": "02:01:55",
        "start": 7313.389,
        "end": 7315.308
      }
    },
    {
      "edge": "M1626",
      "attrs": {
        "text": "Careful.",
        "start_hhmmss": "02:01:57",
        "end_hhmmss": "02:01:59",
        "start": 7316.811,
        "end": 7318.854
      }
    },
    {
      "edge": "M1627",
      "attrs": {
        "text": "He needs a doctor.",
        "start_hhmmss": "02:02:02",
        "end_hhmmss": "02:02:03",
        "start": 7322.107,
        "end": 7323.138333333333
      }
    },
    {
      "edge": "M1628",
      "attrs": {
        "text": "To make him healthy...",
        "start_hhmmss": "02:02:03",
        "end_hhmmss": "02:02:04",
        "start": 7323.138333333333,
        "end": 7324.317
      }
    },
    {
      "edge": "M1629",
      "attrs": {
        "text": "...for the firing squad?",
        "start_hhmmss": "02:02:05",
        "end_hhmmss": "02:02:06",
        "start": 7324.526,
        "end": 7325.777
      }
    },
    {
      "edge": "M1630",
      "attrs": {
        "text": "You know there'll be an amnesty in a few days. It's me you want.",
        "start_hhmmss": "02:02:06",
        "end_hhmmss": "02:02:10",
        "start": 7325.986,
        "end": 7329.865
      }
    },
    {
      "edge": "M1631",
      "attrs": {
        "text": "Yes.",
        "start_hhmmss": "02:02:10",
        "end_hhmmss": "02:02:11",
        "start": 7330.074,
        "end": 7330.585909090909
      }
    },
    {
      "edge": "M1632",
      "attrs": {
        "text": "Arrest me.",
        "start_hhmmss": "02:02:11",
        "end_hhmmss": "02:02:12",
        "start": 7330.585909090909,
        "end": 7331.951
      }
    },
    {
      "edge": "M1633",
      "attrs": {
        "text": "Let him go.",
        "start_hhmmss": "02:02:12",
        "end_hhmmss": "02:02:14",
        "start": 7332.159,
        "end": 7333.911
      }
    },
    {
      "edge": "M1634",
      "attrs": {
        "text": "Is that all you care about?",
        "start_hhmmss": "02:02:17",
        "end_hhmmss": "02:02:19",
        "start": 7337.372,
        "end": 7339.047058823529
      }
    },
    {
      "edge": "M1635",
      "attrs": {
        "text": "You've caught me.",
        "start_hhmmss": "02:02:19",
        "end_hhmmss": "02:02:20",
        "start": 7339.047058823529,
        "end": 7340.084
      }
    },
    {
      "edge": "M1636",
      "attrs": {
        "text": "That's what you care about.",
        "start_hhmmss": "02:02:20",
        "end_hhmmss": "02:02:23",
        "start": 7340.292,
        "end": 7342.585
      }
    },
    {
      "edge": "M1637",
      "attrs": {
        "text": "Let him take the boy where he wants. Then bring him back here to me.",
        "start_hhmmss": "02:02:30",
        "end_hhmmss": "02:02:34",
        "start": 7349.676,
        "end": 7353.889
      }
    },
    {
      "edge": "M1638",
      "attrs": {
        "text": "Marius. Marius.",
        "start_hhmmss": "02:03:06",
        "end_hhmmss": "02:03:07",
        "start": 7386.088,
        "end": 7387.4146
      }
    },
    {
      "edge": "M1639",
      "attrs": {
        "text": "He'll live.",
        "start_hhmmss": "02:03:07",
        "end_hhmmss": "02:03:08",
        "start": 7387.4146,
        "end": 7388.299
      }
    },
    {
      "edge": "M1640",
      "attrs": {
        "text": "Toussaint, find a doctor.",
        "start_hhmmss": "02:03:09",
        "end_hhmmss": "02:03:10",
        "start": 7388.506,
        "end": 7390.094387096774
      }
    },
    {
      "edge": "M1641",
      "attrs": {
        "text": "Yes, monsieur.",
        "start_hhmmss": "02:03:10",
        "end_hhmmss": "02:03:11",
        "start": 7390.094387096774,
        "end": 7390.968
      }
    },
    {
      "edge": "M1642",
      "attrs": {
        "text": "Marius.",
        "start_hhmmss": "02:03:11",
        "end_hhmmss": "02:03:13",
        "start": 7391.176,
        "end": 7392.51
      }
    },
    {
      "edge": "M1643",
      "attrs": {
        "text": "Take some money. Promise him more.",
        "start_hhmmss": "02:03:13",
        "end_hhmmss": "02:03:15",
        "start": 7392.719,
        "end": 7394.889
      }
    },
    {
      "edge": "M1644",
      "attrs": {
        "text": "Yes, monsieur.",
        "start_hhmmss": "02:03:15",
        "end_hhmmss": "02:03:17",
        "start": 7395.097,
        "end": 7396.809333333333
      }
    },
    {
      "edge": "M1645",
      "attrs": {
        "text": "Go, go!",
        "start_hhmmss": "02:03:17",
        "end_hhmmss": "02:03:17",
        "start": 7396.809333333333,
        "end": 7397.432
      }
    },
    {
      "edge": "M1646",
      "attrs": {
        "text": "I promised I would give you this.",
        "start_hhmmss": "02:03:33",
        "end_hhmmss": "02:03:35",
        "start": 7412.614,
        "end": 7414.532
      }
    },
    {
      "edge": "M1647",
      "attrs": {
        "text": "It was your mother's.",
        "start_hhmmss": "02:03:41",
        "end_hhmmss": "02:03:43",
        "start": 7421.414,
        "end": 7422.624
      }
    },
    {
      "edge": "M1648",
      "attrs": {
        "text": "She was a good woman.",
        "start_hhmmss": "02:03:53",
        "end_hhmmss": "02:03:56",
        "start": 7433.426,
        "end": 7435.637
      }
    },
    {
      "edge": "M1649",
      "attrs": {
        "text": "I loved her, Cosette.",
        "start_hhmmss": "02:03:56",
        "end_hhmmss": "02:03:58",
        "start": 7435.887,
        "end": 7438.307
      }
    },
    {
      "edge": "M1650",
      "attrs": {
        "text": "No.",
        "start_hhmmss": "02:04:04",
        "end_hhmmss": "02:04:04",
        "start": 7443.645,
        "end": 7443.849727272727
      }
    },
    {
      "edge": "M1651",
      "attrs": {
        "text": "I've told you everything.",
        "start_hhmmss": "02:04:04",
        "end_hhmmss": "02:04:06",
        "start": 7443.849727272727,
        "end": 7445.897
      }
    },
    {
      "edge": "M1652",
      "attrs": {
        "text": "Take care of him. Live a happy life.",
        "start_hhmmss": "02:04:06",
        "end_hhmmss": "02:04:08",
        "start": 7446.106,
        "end": 7448.125413793103
      }
    },
    {
      "edge": "M1653",
      "attrs": {
        "text": "No!",
        "start_hhmmss": "02:04:08",
        "end_hhmmss": "02:04:08",
        "start": 7448.125413793103,
        "end": 7448.275
      }
    },
    {
      "edge": "M1654",
      "attrs": {
        "text": "I made an arrangement, my dear. I have to go.",
        "start_hhmmss": "02:04:09",
        "end_hhmmss": "02:04:14",
        "start": 7448.9,
        "end": 7453.655
      }
    },
    {
      "edge": "M1655",
      "attrs": {
        "text": "Promise me you'll be happy.",
        "start_hhmmss": "02:04:14",
        "end_hhmmss": "02:04:15",
        "start": 7453.863,
        "end": 7455.4898571428575
      }
    },
    {
      "edge": "M1656",
      "attrs": {
        "text": "No. Not like this, Papa, not like this.",
        "start_hhmmss": "02:04:15",
        "end_hhmmss": "02:04:18",
        "start": 7455.4898571428575,
        "end": 7457.659
      }
    },
    {
      "edge": "M1657",
      "attrs": {
        "text": "This is right, my dear. I stole something, I did.",
        "start_hhmmss": "02:04:18",
        "end_hhmmss": "02:04:21",
        "start": 7457.867,
        "end": 7461.372
      }
    },
    {
      "edge": "M1658",
      "attrs": {
        "text": "I stole happiness with you. I don't mind paying.",
        "start_hhmmss": "02:04:22",
        "end_hhmmss": "02:04:25",
        "start": 7461.579,
        "end": 7464.749
      }
    },
    {
      "edge": "M1659",
      "attrs": {
        "text": "Go to him. He is your life now.",
        "start_hhmmss": "02:04:25",
        "end_hhmmss": "02:04:27",
        "start": 7464.959,
        "end": 7466.760642857143
      }
    },
    {
      "edge": "M1660",
      "attrs": {
        "text": "Please.",
        "start_hhmmss": "02:04:27",
        "end_hhmmss": "02:04:27",
        "start": 7466.760642857143,
        "end": 7467.252
      }
    },
    {
      "edge": "M1661",
      "attrs": {
        "text": "No.",
        "start_hhmmss": "02:04:27",
        "end_hhmmss": "02:04:29",
        "start": 7467.46,
        "end": 7468.836
      }
    },
    {
      "edge": "M1662",
      "attrs": {
        "text": "Bring him here.",
        "start_hhmmss": "02:05:27",
        "end_hhmmss": "02:05:29",
        "start": 7527.271,
        "end": 7529.356
      }
    },
    {
      "edge": "M1663",
      "attrs": {
        "text": "That is an important memo for the prefect.",
        "start_hhmmss": "02:05:35",
        "end_hhmmss": "02:05:37",
        "start": 7535.237,
        "end": 7537.489
      }
    },
    {
      "edge": "M1664",
      "attrs": {
        "text": "It explains what I've done with the prisoner.",
        "start_hhmmss": "02:05:38",
        "end_hhmmss": "02:05:40",
        "start": 7537.697,
        "end": 7540.034
      }
    },
    {
      "edge": "M1665",
      "attrs": {
        "text": "Make sure he sees it before breakfast.",
        "start_hhmmss": "02:05:40",
        "end_hhmmss": "02:05:43",
        "start": 7540.242,
        "end": 7543.170588235293
      }
    },
    {
      "edge": "M1666",
      "attrs": {
        "text": "Sir.",
        "start_hhmmss": "02:05:43",
        "end_hhmmss": "02:05:43",
        "start": 7543.170588235293,
        "end": 7543.454
      }
    },
    {
      "edge": "M1667",
      "attrs": {
        "text": "I'm glad I had time to myself.",
        "start_hhmmss": "02:05:48",
        "end_hhmmss": "02:05:51",
        "start": 7548.083,
        "end": 7550.877
      }
    },
    {
      "edge": "M1668",
      "attrs": {
        "text": "I needed to think about what you deserve.",
        "start_hhmmss": "02:05:51",
        "end_hhmmss": "02:05:56",
        "start": 7551.128,
        "end": 7555.798
      }
    },
    {
      "edge": "M1669",
      "attrs": {
        "text": "You're a difficult problem.",
        "start_hhmmss": "02:05:57",
        "end_hhmmss": "02:05:59",
        "start": 7556.716,
        "end": 7558.551
      }
    },
    {
      "edge": "M1670",
      "attrs": {
        "text": "Move to the edge.",
        "start_hhmmss": "02:06:02",
        "end_hhmmss": "02:06:04",
        "start": 7561.846,
        "end": 7563.723
      }
    },
    {
      "edge": "M1671",
      "attrs": {
        "text": "Why aren't you taking me in?",
        "start_hhmmss": "02:06:04",
        "end_hhmmss": "02:06:05",
        "start": 7563.931,
        "end": 7565.47282
      }
    },
    {
      "edge": "M1672",
      "attrs": {
        "text": "You're my prisoner. Do what I tell you!",
        "start_hhmmss": "02:06:05",
        "end_hhmmss": "02:06:08",
        "start": 7565.47282,
        "end": 7567.602
      }
    },
    {
      "edge": "M1673",
      "attrs": {
        "text": "You don't understand the importance of the law.",
        "start_hhmmss": "02:06:08",
        "end_hhmmss": "02:06:11",
        "start": 7567.81,
        "end": 7570.938
      }
    },
    {
      "edge": "M1674",
      "attrs": {
        "text": "I've given you an order. Obey it.",
        "start_hhmmss": "02:06:11",
        "end_hhmmss": "02:06:14",
        "start": 7571.148,
        "end": 7574.485
      }
    },
    {
      "edge": "M1675",
      "attrs": {
        "text": "Why didn't you kill me?",
        "start_hhmmss": "02:06:24",
        "end_hhmmss": "02:06:26",
        "start": 7583.826,
        "end": 7586.246
      }
    },
    {
      "edge": "M1676",
      "attrs": {
        "text": "I don't have the right to kill you.",
        "start_hhmmss": "02:06:27",
        "end_hhmmss": "02:06:30",
        "start": 7587.247,
        "end": 7589.791
      }
    },
    {
      "edge": "M1677",
      "attrs": {
        "text": "But you hate me.",
        "start_hhmmss": "02:06:30",
        "end_hhmmss": "02:06:33",
        "start": 7589.999,
        "end": 7592.544
      }
    },
    {
      "edge": "M1678",
      "attrs": {
        "text": "I don't hate you.",
        "start_hhmmss": "02:06:33",
        "end_hhmmss": "02:06:35",
        "start": 7592.752,
        "end": 7594.546
      }
    },
    {
      "edge": "M1679",
      "attrs": {
        "text": "I don't feel anything.",
        "start_hhmmss": "02:06:36",
        "end_hhmmss": "02:06:39",
        "start": 7596.298,
        "end": 7599.05
      }
    },
    {
      "edge": "M1680",
      "attrs": {
        "text": "You don't want to go back to the quarries, do you?",
        "start_hhmmss": "02:06:39",
        "end_hhmmss": "02:06:42",
        "start": 7599.259,
        "end": 7602.262
      }
    },
    {
      "edge": "M1681",
      "attrs": {
        "text": "Then for once, we agree.",
        "start_hhmmss": "02:06:54",
        "end_hhmmss": "02:06:56",
        "start": 7613.606,
        "end": 7616.151
      }
    },
    {
      "edge": "M1682",
      "attrs": {
        "text": "I'm going to spare you from a life in prison, Jean Valjean.",
        "start_hhmmss": "02:06:57",
        "end_hhmmss": "02:07:01",
        "start": 7616.859,
        "end": 7620.905
      }
    },
    {
      "edge": "M1683",
      "attrs": {
        "text": "It's a pity the rules don't allow me to be merciful.",
        "start_hhmmss": "02:07:02",
        "end_hhmmss": "02:07:07",
        "start": 7622.324,
        "end": 7626.578
      }
    },
    {
      "edge": "M1684",
      "attrs": {
        "text": "I've tried to live my life without breaking a single rule.",
        "start_hhmmss": "02:07:16",
        "end_hhmmss": "02:07:21",
        "start": 7636.13,
        "end": 7640.592
      }
    },
    {
      "edge": "M1685",
      "attrs": {
        "text": "You're free.",
        "start_hhmmss": "02:07:27",
        "end_hhmmss": "02:07:29",
        "start": 7647.098,
        "end": 7648.808
      }
    }
  ],
